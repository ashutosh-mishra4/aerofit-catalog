elative z-10 w-full max-w-[1240px] mx-auto px-12\" data-kid=\"1-3-1-3\">\n<div class=\"max-w-[640px]\" data-kid=\"1-3-1-3-1\">\n<p class=\"serif text-[190px] leading-[0.82] font-medium tracking-[-0.04em]\" data-kid=\"1-3-1-3-1-1\">120</p>\n<p class=\"mt-4 text-[13px] font-semibold tracking-[0.2em] uppercase opacity-90\" data-kid=\"1-3-1-3-1-2\">workout types tracked on Aero Fit Pro</p>\n<p class=\"mt-4 serif text-[56px] leading-[1.02] font-medium tracking-[-0.02em]\" data-kid=\"1-3-1-3-1-3\">Built-in GPS and <span class=\"italic\" data-kid=\"1-3-1-3-1-3-1\">ECG</span></p>\n<p class=\"mt-4 text-[18px] leading-[1.55] opacity-90 max-w-[42ch]\" data-kid=\"1-3-1-3-1-4\">Structured training without your phone. 10 days of battery, Heart Screener and Blood Pressure Insights included.</p>\n</div>\n</div>\n</div>\n<div class=\"panel sticky top-4 mx-4 mb-4 h-[880px] rounded-[28px] overflow-hidden bg-[#6B7B4E] flex items-center origin-top text-[#FAF8F6] locked\" data-kid=\"1-3-2\">\n<img alt=\"Hiker resting on a mountain ridge\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1745692607831-66df9207b8bc?auto=format&amp;w=1600&amp;q=80&amp;fit=crop\"/>\n<div class=\"absolute inset-0 bg-[#4F5C38]/65\" data-kid=\"1-3-2-2\"></div>\n<div class=\"panel-inner relative z-10 w-full max-w-[1240px] mx-auto px-12\" data-kid=\"1-3-2-3\">\n<div class=\"max-w-[680px]\" data-kid=\"1-3-2-3-1\">\n<p class=\"serif text-[190px] leading-[0.82] font-medium tracking-[-0.04em]\" data-kid=\"1-3-2-3-1-1\">14<span class=\"text-[80px] italic ml-3\" data-kid=\"1-3-2-3-1-1-1\">days</span></p>\n<p class=\"mt-4 text-[13px] font-semibold tracking-[0.2em] uppercase opacity-90\" data-kid=\"1-3-2-3-1-2\">on a single charge, Aero Fit Ultra</p>\n<p class=\"mt-6 serif italic text-[46px] leading-[1.1] max-w-[18ch]\" data-kid=\"1-3-2-3-1-3\">“A week of trail miles fits between charges.”<span class=\"block not-italic sans text-[16px] font-semibold mt-5 opacity-90\" data-kid=\"1-3-2-3-1-3-1\">Titanium case · dual-band GPS · 100 m water</span></p>\n</div>\n</div>\n</div>\n<div class=\"panel sticky top-4 mx-4 h-[880px] rounded-[28px] overflow-hidden bg-[#2A0B14] flex items-center origin-top text-[#FAF8F6] locked\" data-kid=\"1-3-3\">\n<img alt=\"Aero Fit Ultra box tied with a plum ribbon\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-3-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/57c05c7ee47e4f02aaba61dccc783f97.jpg\"/>\n<div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(42,11,20,0.9)_0%,rgba(42,11,20,0.7)_45%,rgba(42,11,20,0.25)_100%)]\" data-kid=\"1-3-3-2\"></div>\n<div class=\"panel-inner relative z-10 w-full max-w-[1240px] mx-auto px-12\" data-kid=\"1-3-3-3\">\n<div class=\"max-w-[640px]\" data-kid=\"1-3-3-3-1\">\n<p class=\"text-[12px] font-semibold tracking-[0.28em] uppercase text-[#F8F38A]\" data-kid=\"1-3-3-3-1-1\">Aero Fit Ultra</p>\n<p class=\"mt-4 serif text-[84px] leading-[0.98] font-medium tracking-[-0.03em]\" data-kid=\"1-3-3-3-1-2\">Ships from <span class=\"italic text-[#F8F38A]\" data-kid=\"1-3-3-3-1-2-1\">November 4</span></p>\n<p class=\"mt-5 text-[18px] leading-[1.55] opacity-90 max-w-[42ch]\" data-kid=\"1-3-3-3-1-3\">$399 one-time with free returns — or $0 for the band on an Aero Fit Life membership.</p>\n<div class=\"mt-9 flex gap-4\" data-kid=\"1-3-3-3-1-4\">\n<a class=\"lift h-14 px-8 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[15px] font-medium flex items-center gap-2\" data-kid=\"1-3-3-3-1-4-1\" href=\"#lineup\">Pre-order Ultra <i class=\"ti ti-arrow-right\" data-kid=\"1-3-3-3-1-4-1-1\"></i></a>\n<a class=\"lift h-14 px-7 rounded-full border border-white/40 text-[15px] font-medium flex items-center gap-2.5 hover:bg-white/10\" data-kid=\"1-3-3-3-1-4-2\" href=\"#plans\"><span class=\"starshape w-3.5 h-3.5 bg-[#F8F38A]\" data-kid=\"1-3-3-3-1-4-2-1\"></span>See memberships</a>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"max-w-[1240px] mx-auto px-8 pt-24\" data-kid=\"1-4\" id=\"compare\">\n<div class=\"flex justify-between items-end gap-10 mb-8 is-in\" data-kid=\"1-4-1\" id=\"cmpHead\">\n<div data-kid=\"1-4-1-1\">\n<h2 class=\"ev-h2 mt-3 serif text-[76px] leading-[0.98] font-medium tracking-[-0.03em]\" data-kid=\"1-4-1-1-1\">How the five <span class=\"italic text-[#C8553D]\" data-kid=\"1-4-1-1-1-1\">differ.</span></h2>\n<p class=\"mt-4 text-[15px] text-[#4A2A33]\" data-kid=\"1-4-1-1-2\" id=\"tableNote\"></p>\n</div>\n<div class=\"flex flex-wrap justify-end gap-2 max-w-[420px]\" data-kid=\"1-4-1-2\" id=\"useChips\"></div>\n</div>\n<div class=\"rounded-[24px] bg-white border border-[#EFEAE6] overflow-clip shadow-[0_10px_30px_rgba(42,11,20,0.06)]\" data-kid=\"1-4-2\">\n<div class=\"grid grid-cols-[260px_repeat(5,1fr)] border-b border-[#EFEAE6]\" data-kid=\"1-4-2-1\" id=\"tHead\"></div>\n<div data-kid=\"1-4-2-2\" id=\"tBody\"></div>\n<div class=\"border-t border-[#F3EFEC] p-4 flex justify-center\" data-kid=\"1-4-2-3\">\n<button class=\"h-11 px-5 rounded-full border border-[#2A0B14] text-[14px] font-medium hover:bg-[#2A0B14] hover:text-white transition\" data-act=\"more\" data-kid=\"1-4-2-3-1\" id=\"moreBtn\">Show all 16 specs</button>\n</div>\n</div>\n</section>\n<footer class=\"relative mx-4 mt-28 rounded-[28px] overflow-hidden bg-[#2A0B14] text-[#FAF8F6] pt-20 pb-10 bg-[radial-gradient(circle_at_15%_22%,rgba(248,243,138,0.07)_0%,transparent_38%),radial-gradient(circle_at_85%_78%,rgba(107,123,78,0.12)_0%,transparent_40%)]\" data-kid=\"1-5\">\n<span class=\"fshape starshape absolute top-10 left-14 w-[60px] h-[60px] bg-[#F8F38A] opacity-25 pointer-events-none\" data-depth=\"-30\" data-kid=\"1-5-1\"></span>\n<span class=\"fshape absolute top-28 right-28 w-[90px] h-[90px] rounded-full bg-[#C8553D] opacity-20 pointer-events-none\" data-depth=\"-60\" data-kid=\"1-5-2\"></span>\n<span class=\"fshape sparkle absolute bottom-36 left-[34%] w-11 h-11 bg-[#A3B47F] opacity-30 pointer-events-none\" data-depth=\"-45\" data-kid=\"1-5-3\"></span>\n<div class=\"relative z-10 max-w-[1240px] mx-auto px-8\" data-kid=\"1-5-4\">\n<div class=\"reveal grid grid-cols-[1.6fr_1fr_1fr_1fr_1fr] gap-7 text-[15px] rise\" data-kid=\"1-5-4-1\" id=\"footCols\">\n<div data-kid=\"1-5-4-1-1\">\n<div class=\"flex items-center gap-2.5 mb-4\" data-kid=\"1-5-4-1-1-1\"><img alt=\"Aero Fit logo\" class=\"w-9 h-9\" data-kid=\"1-5-4-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/><span class=\"serif text-[26px] font-medium\" data-kid=\"1-5-4-1-1-1-2\">Aero Fit</span></div>\n<p class=\"text-[13px] italic opacity-60 max-w-[30ch] leading-[1.6]\" data-kid=\"1-5-4-1-1-2\">Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease.</p>\n</div>\n<div data-kid=\"1-5-4-1-2\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-5-4-1-2-1\">Shop</p><ul class=\"space-y-2 opacity-85\" data-kid=\"1-5-4-1-2-2\"><li data-kid=\"1-5-4-1-2-2-1\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-2-2-1-1\" href=\"#\">Aero Fit Lite</a></li><li data-kid=\"1-5-4-1-2-2-2\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-2-2-2-1\" href=\"#\">Aero Fit Smart</a></li><li data-kid=\"1-5-4-1-2-2-3\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-2-2-3-1\" href=\"#\">Aero Fit Pro</a></li><li data-kid=\"1-5-4-1-2-2-4\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-2-2-4-1\" href=\"#\">Aero Fit Music</a></li><li data-kid=\"1-5-4-1-2-2-5\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-2-2-5-1\" href=\"#\">Aero Fit Ultra</a></li></ul></div>\n<div data-kid=\"1-5-4-1-3\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-5-4-1-3-1\">Memberships</p><ul class=\"space-y-2 opacity-85\" data-kid=\"1-5-4-1-3-2\"><li data-kid=\"1-5-4-1-3-2-1\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-3-2-1-1\" href=\"#\">Aero Fit One</a></li><li data-kid=\"1-5-4-1-3-2-2\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-3-2-2-1\" href=\"#\">Aero Fit Peak</a></li><li data-kid=\"1-5-4-1-3-2-3\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-3-2-3-1\" href=\"#\">Aero Fit Life</a></li><li data-kid=\"1-5-4-1-3-2-4\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-3-2-4-1\" href=\"#\">Compare plans</a></li></ul></div>\n<div data-kid=\"1-5-4-1-4\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-5-4-1-4-1\">Support</p><ul class=\"space-y-2 opacity-85\" data-kid=\"1-5-4-1-4-2\"><li data-kid=\"1-5-4-1-4-2-1\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-4-2-1-1\" href=\"#\">Help Center</a></li><li data-kid=\"1-5-4-1-4-2-2\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-4-2-2-1\" href=\"#\">Sizing guide</a></li><li data-kid=\"1-5-4-1-4-2-3\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-4-2-3-1\" href=\"#\">Accessories</a></li><li data-kid=\"1-5-4-1-4-2-4\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-5-4-1-4-2-4-1\" href=\"#\">Download App</a></li></ul></div>\n<div data-kid=\"1-5-4-1-5\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-5-4-1-5-1\">Connect</p>\n<div class=\"flex gap-3\" data-kid=\"1-5-4-1-5-2\">\n<a aria-label=\"Instagram\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-5-4-1-5-2-1\" href=\"#\"><i class=\"ti ti-brand-instagram\" data-kid=\"1-5-4-1-5-2-1-1\"></i></a>\n<a aria-label=\"YouTube\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-5-4-1-5-2-2\" href=\"#\"><i class=\"ti ti-brand-youtube\" data-kid=\"1-5-4-1-5-2-2-1\"></i></a>\n<a aria-label=\"Podcast\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-5-4-1-5-2-3\" href=\"#\"><i class=\"ti ti-microphone\" data-kid=\"1-5-4-1-5-2-3-1\"></i></a>\n<a aria-label=\"Contact\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-5-4-1-5-2-4\" href=\"#\"><i class=\"ti ti-mail\" data-kid=\"1-5-4-1-5-2-4-1\"></i></a>\n</div>\n</div>\n</div>\n<div class=\"mt-12 pt-6 border-t border-white/15 flex justify-between items-center text-[13px] italic opacity-70\" data-kid=\"1-5-4-2\">\n<span data-kid=\"1-5-4-2-1\">© 2026 Aero Fit · membership plans are billed annually with a 12-month minimum term</span>\n<div class=\"flex gap-6\" data-kid=\"1-5-4-2-2\"><a data-kid=\"1-5-4-2-2-1\" href=\"#\">Terms &amp; Conditions</a><a data-kid=\"1-5-4-2-2-2\" href=\"#\">Privacy Policy</a><a data-kid=\"1-5-4-2-2-3\" href=\"#\">Accessibility</a></div>\n</div>\n</div>\n</footer>\n</div>\n<script>\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',tag:'Ships Nov 4',line:'Titanium case, dual-band GPS and 14 days of battery for multi-day races.',peek:['14-day battery','Dual-band GPS','100 m water','Titanium · 32 g'],price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F8F38A 0%,#FBF4B8 40%,#F4F1EE 78%)',tc:'#F8F38A'},\n{id:'pro',n:'Pro',tag:'Training',line:'Built-in GPS and ECG for structured training without your phone.',peek:['10-day battery','Built-in GPS','ECG Heart Screener','Aluminum · 27 g'],price:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#EEF0E4 0%,#E3E7D6 55%,#D9DEC8 100%)',tc:'#A3B47F'},\n{id:'lite',n:'Lite',tag:'Lightest',line:'Featherweight tracking for sleep, steps and daily recovery.',peek:['5-day battery','GPS via phone','Mono OLED','Polymer · 18 g'],price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F0F2F4 0%,#E3E7EB 55%,#D6DCE2 100%)',tc:'#B9C3CD'},\n{id:'smart',n:'Smart',tag:'Everyday',line:'Everyday sleep, strain and recovery on an always-on display.',peek:['7-day battery','Skin temperature','AMOLED display','Aluminum · 24 g'],price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F6EEF0 0%,#EFE3E6 55%,#E6D6DA 100%)',tc:'#E3C3CB'},\n{id:'music',n:'Music',tag:'Offline',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',peek:['6-day battery','4 GB · ~500 songs','Bluetooth audio','Aluminum · 28 g'],price:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#FBEDE7 0%,#F6E0D8 55%,#EFD2C7 100%)',tc:'#E8907A'}];\nconst ORDER=['lite','smart','pro','music','ultra'];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={sleep:{n:'sleep',fit:['lite','smart'],rows:['sleep','temp','weight','battery']},training:{n:'training',fit:['pro','ultra'],rows:['gps','modes','ecg','recovery']},music:{n:'music',fit:['music','pro'],rows:['storage','bt','gps']},endurance:{n:'endurance',fit:['ultra','pro'],rows:['battery','gps','water','case']}};\nconst ROWS=[\n ['battery','Battery life',['5 days','7 days','10 days','6 days','14 days'],1],\n ['gps','GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],\n ['ecg','ECG with Heart Screener',[0,0,1,0,1],1],\n ['storage','Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],\n ['case','Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],\n ['weight','Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],\n ['outright','Buy outright',['$149','$199','$279','$299','$399'],1],\n ['incl','Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only'],1],\n ['display','Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],\n ['water','Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],\n ['sleep','Sleep stages & Sleep Performance',[1,1,1,1,1],0],\n ['recovery','Recovery & Strain scores',[1,1,1,1,1],0],\n ['temp','Skin temperature',[0,1,1,1,1],0],\n ['bp','Blood Pressure Insights',[0,0,1,0,1],0],\n ['modes','Workout types',['20','40','120','80','150'],0],\n ['bt','Bluetooth headphones',[0,0,0,1,0],0]];\nconst SIZE={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet mode='out',plan=2,use='endurance',filter='all',cart=0,more=false,q={use:'training',night:'light',pay:'mem'};\nconst $=id=>document.getElementById(id);const byId=i=>P.find(p=>p.id===i);\nfunction priceLine(p){\n if(mode==='out')return `<span class=\"serif text-[24px] font-semibold text-[#2A0B14]\">$${p.price}</span>`;\n if(plan>=p.min)return `<span class=\"serif text-[24px] font-semibold text-[#2A0B14]\">$0</span><span class=\"text-[12px] text-[#6B4F57] ml-1\">with ${PL[plan][0]}</span>`;\n return `<span class=\"text-[13px] font-medium text-[#C8553D]\">Needs ${PL[p.min][0]}</span>`;\n}\nfunction renderLineup(){\n if(!$('lineNote')||!$('bandGrid'))return;\n $('lineNote').innerHTML=mode==='out'?'Every band runs the same Aero Fit app, coaching and Recovery scores. Buy one outright and add a membership any time.':`On ${PL[plan][0]} ($${PL[plan][2]}/yr) bands it covers are $0. 12-month minimum.`;\n const f=(k,l)=>`<button data-act=\"filter\" data-f=\"${k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${filter===k?'bg-[#C8553D] text-white':'bg-[#F3EFEC] text-[#2A0B14] hover:bg-[#F8F38A]'}\">${l}</button>`;\n const m=(k,l)=>`<button data-act=\"mode\" data-mode=\"${k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${mode===k?'bg-[#F8F38A] text-[#2A0B14]':'border border-[#2A0B14]/20 text-[#2A0B14] hover:bg-[#F3EFEC]'}\">${l}</button>`;\n $('pills').innerHTML=f('all','All bands')+f('sleep','Sleep')+f('training','Training')+f('music','Music')+f('endurance','Endurance')+'<span class=\"w-px h-9 bg-[#2A0B14]/15 mx-1.5\"></span>'+m('out','Buy outright')+m('mem','With membership')+(mode==='mem'?[1,2,3].map(t=>`<button data-act=\"plan\" data-plan=\"${t}\" class=\"h-10 px-4 rounded-full text-[13px] transition ${t===plan?'bg-[#2A0B14]/[0.06] ring-1 ring-[#2A0B14] text-[#2A0B14] font-medium':'border border-[#2A0B14]/15 text-[#4A2A33] hover:bg-[#F3EFEC]'}\">${PL[t][0]} · $${PL[t][2]}/yr</button>`).join(''):'');\n $('bandGrid').innerHTML=P.map((p,i)=>{\n  const dim=filter!=='all'&&!USE[filter].fit.includes(p.id);const fit=filter!=='all'&&!dim;const blocked=mode==='mem'&&plan<p.min;\n  return `<article class=\"band ${dim?'!opacity-35':''}\">\n   <div class=\"relative aspect-[4/5] rounded-[22px] overflow-hidden shadow-[0_10px_28px_rgba(42,11,20,0.08)] flex items-center justify-center\" style=\"background:${p.tile}\">\n    <img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"w-[78%] h-[78%] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\">\n    <span class=\"absolute left-4 top-4 text-[12px] font-medium bg-white/90 text-[#2A0B14] rounded-full px-3 py-1\">${p.tag}</span>\n    ${fit?`<span class=\"absolute left-4 bottom-4 text-[12px] font-medium bg-[#F8F38A] text-[#2A0B14] rounded-full px-3 py-1\">Good for ${filter}</span>`:''}\n    <div class=\"peek absolute inset-3 rounded-[16px] bg-[#FAF8F6]/95 text-[#2A0B14] p-6 flex flex-col justify-end\"><p class=\"text-[11px] font-semibold tracking-[0.24em] uppercase text-[#6B7B4E] mb-3\">At a glance</p>${p.peek.map(s=>`<p class=\"serif italic text-[22px] leading-[1.3]\">${s}</p>`).join('')}</div>\n   </div>\n   <div class=\"mt-4\">\n    <h3 class=\"serif text-[28px] font-medium leading-none\">Aero Fit ${p.n}</h3>\n    <p class=\"mt-2 text-[14px] italic text-[#6B4F57] leading-[1.45]\">${p.line}</p>\n    <div class=\"mt-3 flex items-center justify-between\"><span class=\"text-[12px] font-semibold px-3 py-1 rounded-full\" style=\"background:${p.tc}40;color:#2A0B14\">${p.c[p.ci][0]}</span><div class=\"flex items-baseline\">${priceLine(p)}</div></div>\n    <div class=\"mt-4 flex items-center gap-2\">\n     <div class=\"flex gap-1\">${p.c.map((c,j)=>`<button data-act=\"color\" data-id=\"${p.id}\" data-i=\"${j}\" aria-label=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${j===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div>\n     <div class=\"h-10 p-1 rounded-full bg-[#F3EFEC] flex ml-1\">${['S','M','L'].map(s=>`<button data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" title=\"${SIZE[s]}\" class=\"w-8 rounded-full text-[12px] font-medium ${s===p.s?'bg-white text-[#2A0B14] shadow-[0_1px_4px_rgba(42,11,20,0.12)]':'text-[#6B4F57]'}\">${s}</button>`).join('')}</div>\n     ${blocked?`<button data-act=\"plan\" data-plan=\"${p.min}\" class=\"ml-auto h-10 px-4 rounded-full border border-[#2A0B14]/30 text-[13px] font-medium\">Switch to ${PL[p.min][0]}</button>`:`<button data-act=\"add\" data-id=\"${p.id}\" class=\"ml-auto h-10 px-4 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[13px] font-medium hover:bg-[#F2EB6A] transition flex items-center gap-1.5\">Add <i class=\"ti ti-plus\"></i></button>`}\n    </div>\n   </div></article>`}).join('');\n bindTilt();\n}\nfunction renderQuiz(){if(!$('quiz'))return;}\nfunction renderPlans(){if(!$('planList'))return;}\nfunction renderTable(){\n const U=USE[use];\n $('useChips').innerHTML=Object.keys(USE).map(k=>`<button data-act=\"use\" data-use=\"${k}\" class=\"h-10 px-4 rounded-full text-[14px] font-medium border transition ${k===use?'bg-[#2A0B14] text-white border-[#2A0B14]':'bg-white border-[#EFEAE6] hover:bg-[#F3EFEC]'}\">${k[0].toUpperCase()+k.slice(1)}</button>`).join('');\n $('tableNote').innerHTML=`The rows that decide most purchases come first. Rows for <span class=\"bg-[#F8F38A] px-1.5 rounded\">${U.n}</span> are highlighted.`;\n $('tHead').innerHTML='<div class=\"p-6 flex items-end text-[13px] text-[#6B4F57]\">'+(mode==='out'?'Buy outright':'With '+PL[plan][0]+' membership')+'</div>'+ORDER.map(i=>{const p=byId(i);const hp=mode==='out'?'$'+p.price:(plan>=p.min?'$0 band':'Needs '+PL[p.min][0]);const fit=U.fit.includes(i);return `<div class=\"p-5 flex flex-col items-center text-center\"><span class=\"w-[76px] h-[76px] rounded-full flex items-center justify-center\" style=\"background:${p.tile}\"><img src=\"${IMG[i]}\" alt=\"Aero Fit ${p.n}\" class=\"w-14 h-14 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"></span><p class=\"mt-3 serif text-[22px] font-medium leading-none\">${p.n}</p><p class=\"mt-1 text-[13px] text-[#6B4F57]\">${hp}</p>${fit?`<p class=\"mt-2 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-2.5 py-0.5\">Good for ${U.n}</p>`:''}</div>`}).join('');\n const cell=v=>v===1?'<span class=\"text-[18px] flex justify-center\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[16px] flex justify-center text-[#C9C0C2]\"><i class=\"ti ti-minus\"></i></span>':v;\n $('tBody').innerHTML=ROWS.filter(r=>r[3]||more).map(([k,l,v],ri)=>{const hi=U.rows.includes(k);return `<div class=\"grid grid-cols-[260px_repeat(5,1fr)] text-[14px] ${ri?'border-t border-[#F3EFEC]':''} ${hi?'bg-[#FBF7C8]':''}\"><p class=\"px-6 py-4 ${hi?'font-medium':'text-[#4A2A33]'}\">${l}</p>${v.map(x=>`<div class=\"py-4 px-2 text-center\">${cell(x)}</div>`).join('')}</div>`}).join('');\n $('moreBtn').textContent=more?'Show fewer specs':'Show all 16 specs';\n}\nfunction render(){renderLineup();renderQuiz();renderPlans();renderTable();observeAll();}\nfunction bindTilt(){\n const grid=$('bandGrid');if(!grid)return;const cards=grid.querySelectorAll('.band');\n cards.forEach((b,i)=>{b.style.transitionDelay=(i*0.08)+'s';});\n grid.onmousemove=e=>{const r=grid.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;cards.forEach(b=>{b.style.setProperty('--mx',x);b.style.setProperty('--my',y);});};\n grid.onmouseleave=()=>cards.forEach(b=>{b.style.setProperty('--mx',0);b.style.setProperty('--my',0);});\n}\ndocument.addEventListener('click',e=>{const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=byId(t.dataset.id);\n if(a==='use')use=t.dataset.use;else if(a==='filter')filter=t.dataset.f;else if(a==='mode')mode=t.dataset.mode;else if(a==='plan'){plan=+t.dataset.plan;mode='mem'}\n else if(a==='color')p.ci=+t.dataset.i;else if(a==='size')p.s=t.dataset.s;else if(a==='more')more=!more;else if(a==='q')q[t.dataset.k]=t.dataset.v;\n else if(a==='add'){cart++;$('cartCount').textContent=cart;$('cartCount').className='min-w-9 h-9 px-2 rounded-full bg-[#F8F38A] text-[13px] font-medium flex items-center justify-center';}\n render();\n document.querySelectorAll('.band,.ev').forEach(x=>x.classList.add('rise'));\n});\nconst io=new IntersectionObserver(es=>es.forEach(en=>{if(!en.isIntersecting)return;const t=en.target;\n if(['catHead','evHead','cmpHead'].includes(t.id))t.classList.add('is-in');\n else if(t.classList.contains('panel'))t.classList.add('locked');\n else t.classList.add('rise');\n io.unobserve(t);}),{threshold:0.12});\nfunction observeAll(){['catHead','evHead','cmpHead','newsBlock','footCols'].forEach(id=>{const e=$(id);if(e)io.observe(e)});document.querySelectorAll('.band,.ev,.panel').forEach(e=>{if(!e.classList.contains('rise')&&!e.classList.contains('locked'))io.observe(e)});}\nrender();\nconst hero=$('hero');requestAnimationFrame(()=>requestAnimationFrame(()=>hero.classList.add('is-in')));\nconst panels=[...document.querySelectorAll('.panel')];\nfunction update(){\n const vh=innerHeight,sy=scrollY;\n const hp=Math.min(1,Math.max(0,sy/(vh*0.9)));\n $('heroBg').parentElement.style.transform=`translateY(${hp*-40}px) scale(${1+hp*0.08})`;\n const cr=$('lineup').getBoundingClientRect();const cp=Math.min(1,Math.max(0,1-cr.top/vh));\n document.querySelectorAll('.band').forEach((b,i)=>b.style.setProperty('--zsep',(cp*(i%3)*22)+'px'));\n panels.forEach((p,i)=>{if(i<panels.length-1){const nr=panels[i+1].getBoundingClientRect();const prog=Math.min(1,Math.max(0,1-(nr.top-16)/vh));p.style.transform=`scale(${1-prog*0.04})`;}});\n const fr=document.querySelector('footer').getBoundingClientRect();\n document.querySelectorAll('.fshape').forEach(s=>s.style.transform=`translateY(${(vh-fr.top)/vh*(+s.dataset.depth)}px)`);\n}\nlet tick=false;addEventListener('scroll',()=>{if(!tick){requestAnimationFrame(()=>{update();tick=false});tick=true}},{passive:true});\nupdate();\n</script>\n<script>\n/* hero playlist: one 2s clip per band, matching headline + product card */\n(function(){\n const h=document.getElementById('hero');if(!h)return;\n const vids=[...h.querySelectorAll('.hv')],hls=[...h.querySelectorAll('.hl')],cards=[...h.querySelectorAll('.hc')],segs=[...h.querySelectorAll('.hseg span')];\n const N=vids.length,DUR=2000;let cur=-1;\n function show(n){\n  const v=vids[n];try{v.currentTime=0}catch(e){}const p=v.play();if(p&&p.catch)p.catch(()=>{});\n  [hls,cards].forEach(set=>set.forEach((el,i)=>{const on=i===n;el.classList.toggle('on',on);el.setAttribute('aria-hidden',on?'false':'true');if(el.tagName==='A')el.tabIndex=on?0:-1;}));\n  vids.forEach((el,i)=>{el.classList.toggle('on',i===n);el.classList.toggle('was',i===cur&&i!==n);});\n  segs.forEach((s,i)=>{s.style.transition='none';s.style.transform='scaleX('+(i<n?1:0)+')';});\n  void segs[n].offsetWidth;segs[n].style.transition='transform '+DUR+'ms linear';segs[n].style.transform='scaleX(1)';\n  const prev=cur;setTimeout(()=>{if(prev>=0&&prev!==n){vids[prev].classList.remove('was');vids[prev].pause();}},650);\n  cur=n;\n }\n show(0);setInterval(()=>show((cur+1)%N),DUR);\n})();\n</script>\n<script>\n(function(){\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',tag:'Ships Nov 4',line:'Titanium case, dual-band GPS and 14 days of battery for multi-day races.',peek:['14-day battery','Dual-band GPS','100 m water','Titanium · 32 g'],price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F8F38A 0%,#FBF4B8 40%,#F4F1EE 78%)',tc:'#F8F38A'},\n{id:'pro',n:'Pro',tag:'Training',line:'Built-in GPS and ECG for structured training without your phone.',peek:['10-day battery','Built-in GPS','ECG Heart Screener','Aluminum · 27 g'],price:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#EEF0E4 0%,#E3E7D6 55%,#D9DEC8 100%)',tc:'#A3B47F'},\n{id:'lite',n:'Lite',tag:'Lightest',line:'Featherweight tracking for sleep, steps and daily recovery.',peek:['5-day battery','GPS via phone','Mono OLED','Polymer · 18 g'],price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F0F2F4 0%,#E3E7EB 55%,#D6DCE2 100%)',tc:'#B9C3CD'},\n{id:'smart',n:'Smart',tag:'Everyday',line:'Everyday sleep, strain and recovery on an always-on display.',peek:['7-day battery','Skin temperature','AMOLED display','Aluminum · 24 g'],price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F6EEF0 0%,#EFE3E6 55%,#E6D6DA 100%)',tc:'#E3C3CB'},\n{id:'music',n:'Music',tag:'Offline',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',peek:['6-day battery','4 GB · ~500 songs','Bluetooth audio','Aluminum · 28 g'],price:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#FBEDE7 0%,#F6E0D8 55%,#EFD2C7 100%)',tc:'#E8907A'}];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={sleep:{fit:['lite','smart']},training:{fit:['pro','ultra']},music:{fit:['music','pro']},endurance:{fit:['ultra','pro']}};\nconst SIZE={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet mode='out',plan=2,filter='all',cart=0,addedId='';\nconst $=id=>document.getElementById(id),byId=id=>P.find(p=>p.id===id);\nfunction priceLine(p){\n if(mode==='out')return `<span class=\"serif text-[24px] font-semibold text-[#2A0B14]\">$${p.price}</span>`;\n if(plan>=p.min)return `<span class=\"serif text-[24px] font-semibold text-[#2A0B14]\">$0</span><span class=\"text-[12px] text-[#6B4F57] ml-1\">with ${PL[plan][0]}</span>`;\n return `<span class=\"text-[13px] font-medium text-[#C8553D]\">Needs ${PL[p.min][0]}</span>`;\n}\nfunction renderLineup(){\n const f=(k,l)=>`<button type=\"button\" data-act=\"filter\" data-f=\"${k}\" aria-pressed=\"${filter===k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${filter===k?'bg-[#C8553D] text-white':'bg-[#F3EFEC] text-[#2A0B14] hover:bg-[#F8F38A]'}\">${l}</button>`;\n const m=(k,l)=>`<button type=\"button\" data-act=\"mode\" data-mode=\"${k}\" aria-pressed=\"${mode===k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${mode===k?'bg-[#F8F38A] text-[#2A0B14]':'border border-[#2A0B14]/20 text-[#2A0B14] hover:bg-[#F3EFEC]'}\">${l}</button>`;\n $('pills').innerHTML=f('all','All bands')+f('sleep','Sleep')+f('training','Training')+f('music','Music')+f('endurance','Endurance')+'<span class=\"w-px h-9 bg-[#2A0B14]/15 mx-1.5\" aria-hidden=\"true\"></span>'+m('out','Buy outright')+m('mem','With membership')+(mode==='mem'?[1,2,3].map(t=>`<button type=\"button\" data-act=\"plan\" data-plan=\"${t}\" aria-pressed=\"${t===plan}\" class=\"h-10 px-4 rounded-full text-[13px] transition ${t===plan?'bg-[#2A0B14]/[0.06] ring-1 ring-[#2A0B14] text-[#2A0B14] font-medium':'border border-[#2A0B14]/15 text-[#4A2A33] hover:bg-[#F3EFEC]'}\">${PL[t][0]} · $${PL[t][2]}/yr</button>`).join(''):'');\n $('bandGrid').innerHTML=P.map(p=>{\n  const dim=filter!=='all'&&!USE[filter].fit.includes(p.id),fit=filter!=='all'&&!dim,blocked=mode==='mem'&&plan<p.min;\n  return `<article class=\"band ${dim?'!opacity-35':''}\">\n   <div class=\"relative aspect-[4/5] rounded-[22px] overflow-hidden shadow-[0_10px_28px_rgba(42,11,20,0.08)] flex items-center justify-center\" style=\"background:${p.tile}\">\n    <img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"w-[78%] h-[78%] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\">\n    <span class=\"absolute left-4 top-4 text-[12px] font-medium bg-white/90 text-[#2A0B14] rounded-full px-3 py-1\">${p.tag}</span>\n    ${fit?`<span class=\"absolute left-4 bottom-4 text-[12px] font-medium bg-[#F8F38A] text-[#2A0B14] rounded-full px-3 py-1\">Good for ${filter}</span>`:''}\n    <div class=\"peek absolute inset-3 rounded-[16px] bg-[#FAF8F6]/95 text-[#2A0B14] p-6 flex flex-col justify-end\"><p class=\"text-[11px] font-semibold tracking-[0.24em] uppercase text-[#6B7B4E] mb-3\">At a glance</p>${p.peek.map(s=>`<p class=\"serif italic text-[22px] leading-[1.3]\">${s}</p>`).join('')}</div>\n   </div>\n   <div class=\"mt-4\">\n    <h3 class=\"serif text-[28px] font-medium leading-none\">Aero Fit ${p.n}</h3>\n    <p class=\"mt-2 text-[14px] italic text-[#6B4F57] leading-[1.45]\">${p.line}</p>\n    <div class=\"mt-3 flex items-center justify-between\"><span class=\"text-[12px] font-semibold px-3 py-1 rounded-full\" style=\"background:${p.tc}40;color:#2A0B14\">${p.c[p.ci][0]}</span><div class=\"flex items-baseline\">${priceLine(p)}</div></div>\n    <div class=\"mt-4 flex flex-wrap items-center gap-2\">\n     <div class=\"flex gap-1\">${p.c.map((c,j)=>`<button type=\"button\" data-act=\"color\" data-id=\"${p.id}\" data-i=\"${j}\" aria-label=\"${p.n}: ${c[0]}\" aria-pressed=\"${j===p.ci}\" title=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${j===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div>\n     <div class=\"h-10 p-1 rounded-full bg-[#F3EFEC] flex ml-1\">${['S','M','L'].map(s=>`<button type=\"button\" data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" aria-label=\"${p.n}: size ${s}\" aria-pressed=\"${s===p.s}\" title=\"${SIZE[s]}\" class=\"w-8 rounded-full text-[12px] font-medium ${s===p.s?'bg-white text-[#2A0B14] shadow-[0_1px_4px_rgba(42,11,20,0.12)]':'text-[#6B4F57]'}\">${s}</button>`).join('')}</div>\n     ${blocked?`<button type=\"button\" data-act=\"plan\" data-plan=\"${p.min}\" class=\"ml-auto h-10 px-4 rounded-full border border-[#2A0B14]/30 text-[13px] font-medium\">Switch to ${PL[p.min][0]}</button>`:`<button type=\"button\" data-act=\"add\" data-id=\"${p.id}\" aria-label=\"Add Aero Fit ${p.n} to cart\" class=\"ml-auto h-10 px-4 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[13px] font-medium hover:bg-[#F2EB6A] transition flex items-center gap-1.5\">${addedId===p.id?'Added':'Add'} <i class=\"ti ${addedId===p.id?'ti-check':'ti-plus'}\" aria-hidden=\"true\"></i></button>`}\n    </div>\n   </div></article>`;\n }).join('');\n bindTilt();\n}\nfunction bindTilt(){\n const grid=$('bandGrid'),cards=grid.querySelectorAll('.band');\n grid.onmousemove=e=>{const r=grid.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;cards.forEach(b=>{b.style.setProperty('--mx',x);b.style.setProperty('--my',y)})};\n grid.onmouseleave=()=>cards.forEach(b=>{b.style.setProperty('--mx',0);b.style.setProperty('--my',0)});\n}\ndocument.getElementById('lineup').addEventListener('click',e=>{\n const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=byId(t.dataset.id);\n if(a==='filter'){filter=t.dataset.f;addedId=''}else if(a==='mode'){mode=t.dataset.mode;addedId=''}else if(a==='plan'){plan=+t.dataset.plan;mode='mem';addedId=''}else if(a==='color'){p.ci=+t.dataset.i;addedId=''}else if(a==='size'){p.s=t.dataset.s;addedId=''}else if(a==='add'){cart++;addedId=p.id;$('cartFeedback').textContent=`Aero Fit ${p.n}, ${p.c[p.ci][0]}, size ${p.s} added to cart. ${cart} item${cart===1?'':'s'} in cart.`}\n renderLineup();\n});\nrenderLineup();\n})();\n</script>",
      "comments": [],
      "created": "2026-10-28T09:33:58.126223+00:00",
