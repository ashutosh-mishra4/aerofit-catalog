      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.outline-text{color:transparent;-webkit-text-stroke:var(--sw,2px) var(--sc,#2A0B14);}\n.text-reveal{overflow:hidden;}\n.ticker-track{animation:marquee 26s linear infinite;}\n@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.hero-dot{transition:opacity .3s ease,transform .3s ease;}\n.hero-dot.active{opacity:1;transform:scale(1.6);}\n.strip{transition:transform .55s cubic-bezier(.22,.61,.36,1);}\n.strip:hover{transform:translateX(2.5vw);}\n.strip .strip-img{transition:transform .7s cubic-bezier(.22,.61,.36,1);}\n.strip:hover .strip-img{transform:scale(1.06) rotate(-2deg);}\n.bar-fill{transform:scaleY(.08);transform-origin:bottom;transition:transform .6s cubic-bezier(.22,.8,.36,1);}\n.stage-active .bar-fill{transform:scaleY(var(--h));}\n.gauge-fg{stroke-dasharray:264;stroke-dashoffset:264;transition:stroke-dashoffset 1.2s cubic-bezier(.22,.8,.36,1);}\n.stage-active .gauge-fg{stroke-dashoffset:115;}\n.prog-dot{opacity:.4;transition:opacity .35s ease,transform .35s ease;}\n.prog-dot.active{opacity:1;transform:translateX(-6px);}\n.prog-dot::after{content:\"\";display:inline-block;vertical-align:middle;margin-left:.6rem;width:1.5rem;height:1.5px;background:currentColor;transform:scaleX(.3);transform-origin:right center;transition:transform .35s ease;}\n.prog-dot.active::after{transform:scaleX(1);}\n.starshape{clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);}\n.sparkle{clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%);}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip pb-4\" data-kid=\"1\" data-name=\"page layout container\">\n<section class=\"relative mx-4 mt-4 h-[860px] rounded-[28px] overflow-hidden bg-[#F8F38A]\" data-kid=\"1-1\" data-name=\"hero carousel section with rotating slides\" id=\"hero\">\n<div class=\"absolute z-[60] top-5 left-5 right-5 h-[68px] rounded-full bg-white/92 backdrop-blur-md shadow-[0_8px_28px_rgba(42,11,20,0.10)] border border-white/60 pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"sticky frosted-glass top navigation bar\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-1-1-1\" data-name=\"navigation brand and links group\">\n<span class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and wordmark\"><img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>Aero Fit</span>\n<div class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-1-2\" data-name=\"primary category navigation links\">\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-1-2-1\" data-name=\"overview navigation link\" href=\"#\">Overview</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-1-2-2\" data-name=\"how it works navigation link\" href=\"#\">How it works</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-1-2-3\" data-name=\"shop bands navigation link\" href=\"#\">Shop bands</a>\n</div>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"header cart and signup actions\">\n<button class=\"h-[52px] pl-5 pr-2 rounded-full border border-[#EFEAE6] bg-white text-[14px] font-medium flex items-center gap-2 hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-1-2-1\" data-name=\"cart button with item count\"><span class=\"text-[18px] flex\" data-kid=\"1-1-1-2-1-1\" data-name=\"shopping bag icon wrapper\"><i class=\"ti ti-shopping-bag\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"shopping bag icon\"></i></span>Cart<span class=\"min-w-9 h-9 px-2 rounded-full bg-[#F3EFEC] text-[13px] flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-2\" data-name=\"cart item count badge\" data-reason=\"text and class replaced by cart counter script when items added\" id=\"cartCount\">0</span></button>\n<button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-1-2-2\" data-name=\"join for free call-to-action button\">Join Aero Fit free</button>\n</div>\n</div>\n<div class=\"absolute z-[55] right-8 top-1/2 -translate-y-1/2 flex flex-col gap-4 text-[#2A0B14]\" data-kid=\"1-1-2\" data-name=\"hero slide indicator dots\" id=\"heroDots\">\n<button aria-label=\"Slide 1\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-dynamic=\"true\" data-i=\"0\" data-kid=\"1-1-2-1\" data-name=\"slide 1 indicator dot\" data-reason=\"active class and opacity/scale toggled by carousel script\"></button>\n<button aria-label=\"Slide 2\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-dynamic=\"true\" data-i=\"1\" data-kid=\"1-1-2-2\" data-name=\"slide 2 indicator dot\" data-reason=\"active class and opacity/scale toggled by carousel script\"></button>\n<button aria-label=\"Slide 3\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-dynamic=\"true\" data-i=\"2\" data-kid=\"1-1-2-3\" data-name=\"slide 3 indicator dot\" data-reason=\"active class and opacity/scale toggled by carousel script\"></button>\n<button aria-label=\"Slide 4\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-dynamic=\"true\" data-i=\"3\" data-kid=\"1-1-2-4\" data-name=\"slide 4 indicator dot\" data-reason=\"active class and opacity/scale toggled by carousel script\"></button>\n<button aria-label=\"Slide 5\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-dynamic=\"true\" data-i=\"4\" data-kid=\"1-1-2-5\" data-name=\"slide 5 indicator dot\" data-reason=\"active class and opacity/scale toggled by carousel script\"></button>\n</div>\n<div class=\"hero-slide absolute inset-0 z-[1] bg-[#F8F38A] text-[#2A0B14]\" data-kid=\"1-1-3\" data-name=\"hero slide 1 endurance edition\">\n<div class=\"slide-image absolute inset-0\" data-kid=\"1-1-3-1\" data-name=\"slide 1 background photo\"><img alt=\"Trail runner checking his Aero Fit Ultra\" class=\"w-full h-full object-cover object-[70%_center]\" data-kid=\"1-1-3-1-1\" data-name=\"slide 1 photo of trail runner\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/e8e9b52b3aa4462b8d6ad53cd59b2ef3.jpg\"/><div class=\"absolute inset-0 bg-[linear-gradient(90deg,#F8F38A_0%,rgba(248,243,138,0.85)_30%,rgba(248,243,138,0)_56%)]\" data-kid=\"1-1-3-1-2\" data-name=\"slide 1 color gradient scrim\"></div></div>\n<div class=\"slide-text absolute left-0 top-0 bottom-0 w-[52%] flex flex-col justify-center pl-[72px] pt-20\" data-kid=\"1-1-3-2\" data-name=\"slide 1 headline text block\">\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-1\" data-name=\"slide 1 eyebrow reveal wrapper\"><span class=\"slide-eyebrow block pb-5 text-[12px] font-semibold tracking-[0.32em] uppercase opacity-60\" data-kid=\"1-1-3-2-1-1\" data-name=\"slide 1 eyebrow label\">Shop for endurance — 2026</span></div>\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-2\" data-name=\"slide 1 brand reveal wrapper\"><h1 class=\"slide-brand serif text-[164px] leading-[0.86] font-medium tracking-[-0.045em] pb-6\" data-kid=\"1-1-3-2-2-1\" data-name=\"slide 1 hero brand headline\">Aero Fit</h1></div>\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-3\" data-name=\"slide 1 tag