      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.starshape{clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);}\n.sparkle{clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%);}\n.clip-i{display:inline-block;clip-path:inset(0 100% 0 0);transition:clip-path 1s cubic-bezier(.16,.84,.44,1)}\n.is-in .clip-i{clip-path:inset(0 0 0 0)}\n.grid-scene{perspective:1500px}\n.band{transform-style:preserve-3d;transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(var(--zsep,0px));transition:transform .3s cubic-bezier(.16,.84,.44,1)}\n.band.rise{opacity:1}\n.band:hover{transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(calc(var(--zsep,0px) + 50px)) scale(1.02)}\n.band .peek{opacity:0;pointer-events:none;transition:opacity .4s ease}.band:hover .peek,.band:focus-within .peek{opacity:1}\n@media(max-width:700px){.band:hover{transform:none}}\n.panel-inner{transition:filter .7s cubic-bezier(.16,.84,.44,1),opacity .7s cubic-bezier(.16,.84,.44,1)}\n.panel.locked .panel-inner{filter:none;opacity:1}\n.ev{transition:opacity .8s ease,transform .8s cubic-bezier(.16,.84,.44,1)}\n.ev.rise{opacity:1;transform:none}\n.ev-h2{transform:translateY(34px) skewY(5deg);opacity:0;transition:transform 1s cubic-bezier(.16,.84,.44,1),opacity 1s ease}\n.is-in .ev-h2{transform:none;opacity:1}\n.reveal{transition:opacity .9s ease,transform .9s cubic-bezier(.16,.84,.44,1)}\n.reveal.rise{opacity:1;transform:none}\n.lift{transition:transform .35s cubic-bezier(.16,.84,.44,1),background .35s ease}\n.lift:hover{transform:translateY(-3px)}\n/* hero band playlist */\n.hv{opacity:0;transition:opacity .55s ease}\n.hv.on{opacity:1;z-index:2}\n.hv.was{opacity:1;z-index:1;transition:none}\n.hl{opacity:0;transform:translateY(-10px);transition:opacity .18s ease,transform .25s ease}\n.hl.on{opacity:1;transform:none;transition:opacity .45s ease .22s,transform .7s cubic-bezier(.16,.84,.44,1) .22s}\n.hl:not(.on){pointer-events:none}\n.hc{opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .18s ease,transform .25s ease,background-color .3s ease}\n.hc.on{opacity:1;transform:none;pointer-events:auto;transition:opacity .4s ease .2s,transform .6s cubic-bezier(.16,.84,.44,1) .2s,background-color .3s ease}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip pb-4\" data-kid=\"1\">\n<section class=\"hero relative mx-4 mt-4 h-[880px] rounded-[28px] overflow-hidden flex flex-col justify-center isolate bg-[#F3EDE9] is-in\" data-kid=\"1-1\" id=\"hero\">\n<div class=\"absolute inset-0 overflow-hidden\" data-kid=\"1-1-1\" data-name=\"hero background\">\n<video aria-label=\"Woman checking her Aero Fit Pro mid-workout in a gym\" autoplay=\"\" class=\"hv on absolute inset-0 w-full h-full object-cover object-left\" data-band=\"pro\" data-kid=\"1-1-1-1\" id=\"heroBg\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/e876560358da44b0adf65507683a795a.mp4\"></video>\n<video aria-label=\"Woman waking up wearing her Aero Fit Lite\" class=\"hv absolute inset-0 w-full h-full object-cover object-left\" data-band=\"lite\" data-kid=\"1-1-1-2\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/5f2c10d65df84821ae27987022fb2fd6.mp4\"></video>\n<video aria-label=\"Trekker checking his Aero Fit Ultra in heavy rain\" class=\"hv absolute inset-0 w-full h-full object-cover object-left\" data-band=\"ultra\" data-kid=\"1-1-1-3\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/0c70471eaeee4636a9c9e447b933cc86.mp4\"></video>\n<video aria-label=\"Woman glancing at her Aero Fit Smart over coffee\" class=\"hv absolute inset-0 w-full h-full object-cover object-left\" data-band=\"smart\" data-kid=\"1-1-1-4\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/bb9c975d23a24101bd7542fd08d01b19.mp4\"></video>\n<video aria-label=\"Runner in headphones tapping his Aero Fit Music\" class=\"hv absolute inset-0 w-full h-full object-cover object-left\" data-band=\"music\" data-kid=\"1-1-1-5\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/84404b9e6abd40bca2f7d3bb06eae21d.mp4\"></video>\n</div>\n<div class=\"absolute z-50 top-5 left-5 right-5 h-[68px] rounded-full bg-white/90 backdrop-blur-md shadow-[0_8px_28px_rgba(42,11,20,0.08)] border border-white/70 pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1-2\">\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1\">\n<img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n<span class=\"serif text-[22px] font-medium tracking-tight\" data-kid=\"1-1-2-1-2\">Aero Fit</span>\n<span class=\"text-[11px] italic text-[#6B4F57] leading-[1.3] max-w-[140px] ml-1\" data-kid=\"1-1-2-1-3\">five bands · one app · since 2016</span>\n</div>\n<div class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-2-2\">\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-2-2-1\" href=\"#lineup\">Lineup</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-2-2-2\" href=\"#guide\">Band finder</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-2-2-3\" href=\"#plans\">Memberships</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-2-2-4\" href=\"#compare\">Compare</a>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-2-3\">\n<button class=\"h-[52px] pl-5 pr-2 rounded-full border border-[#EFEAE6] bg-white text-[14px] font-medium flex items-center gap-2 hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-2-3-1\"><span class=\"text-[18px] flex\" data-kid=\"1-1-2-3-1-1\"><i class=\"ti ti-shopping-bag\" data-kid=\"1-1-2-3-1-1-1\"></i></span>Cart<span class=\"min-w-9 h-9 px-2 rounded-full bg-[#F3EFEC] text-[13px] flex items-center justify-center\" data-kid=\"1-1-2-3-1-2\" id=\"cartCount\">0</span></button>\n<button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-2-3-2\">Join Aero Fit free</button>\n</div>\n</div>\n<div class=\"absolute z-10 left-12 top-[150px] text-left\" data-kid=\"1-1-3\">\n<h1 class=\"serif text-[72px] leading-[1] font-medium tracking-[-0.03em] grid\" data-kid=\"1-1-3-1\">\n<span class=\"hl on col-start-1 row-start-1\" data-kid=\"1-1-3-1-1\">Leave the phone<br data-kid=\"1-1-3-1-1-1\"/>in the <span class=\"italic text-[#C8553D]\" data-kid=\"1-1-3-1-1-2\">locker.</span></span>\n<span aria-hidden=\"true\" class=\"hl col-start-1 row-start-1\" data-kid=\"1-1-3-1-2\">Wear it to bed.<br data-kid=\"1-1-3-1-2-1\"/><span class=\"italic text-[#C8553D]\" data-kid=\"1-1-3-1-2-2\">Wake up knowing.</span></span>\n<span aria-hidden=\"true\" class=\"hl col-start-1 row-start-1\" data-kid=\"1-1-3-1-3\">Built for the<br data-kid=\"1-1-3-1-3-1\"/><span class=\"italic text-[#C8553D]\" data-kid=\"1-1-3-1-3-2\">long way</span> round.</span>\n<span aria-hidden=\"true\" class=\"hl col-start-1 row-start-1\" data-kid=\"1