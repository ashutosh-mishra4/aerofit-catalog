    "var_69d88fa73f50": {
      "type": "variant",
      "label": "Lineup — Price Matrix",
      "parentId": "var_8d36871376e8",
      "themeId": null,
      "rect": {
        "x": 17339,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.serif{font-family:'Source Serif 4',serif}.sans{font-family:'Inter',sans-serif}\n.grid-scene{perspective:1500px}\n.band{transform-style:preserve-3d;transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg));transition:transform .3s cubic-bezier(.16,.84,.44,1),opacity .3s ease}\n.band:hover{transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(50px) scale(1.02)}\n.band .peek{opacity:0;pointer-events:none;transition:opacity .4s ease}.band:hover .peek,.band:focus-within .peek{opacity:1}\n.starshape{clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}\n@media(max-width:700px){.band:hover{transform:none}}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip pb-4 pt-4\" data-kid=\"1\" data-name=\"page layout container\">\n<section class=\"relative mx-4 rounded-[28px] overflow-hidden bg-white text-[#2A0B14] py-16 md:py-24\" data-kid=\"1-1\" data-name=\"band lineup section\" id=\"lineup\">\n<div class=\"max-w-[1240px] mx-auto px-6 md:px-8\" data-kid=\"1-1-1\" data-name=\"lineup content wrapper\">\n<div class=\"flex justify-between items-end gap-10 mb-9\" data-kid=\"1-1-1-1\" data-name=\"section header row\" id=\"catHead\">\n<h2 class=\"mt-3 serif text-[52px] md:text-[76px] leading-[0.98] font-medium tracking-[-0.03em]\" data-kid=\"1-1-1-1-1\" data-name=\"hero headline\"><span class=\"block\" data-kid=\"1-1-1-1-1-1\" data-name=\"headline first line text\">Five bands,</span><span class=\"block italic text-[#C8553D]\" data-kid=\"1-1-1-1-1-2\" data-name=\"headline accent line\">one app.</span></h2>\n</div>\n<div aria-label=\"Filter and payment options\" class=\"flex flex-wrap items-center gap-3 mb-12\" data-dynamic=\"true\" data-kid=\"1-1-1-2\" data-name=\"filter and pricing mode control bar\" data-reason=\"button children injected and re-rendered by script on every interaction\" id=\"pills\"></div>\n<div class=\"grid-scene\" data-kid=\"1-1-1-3\" data-name=\"3D tilt perspective scene wrapper\"><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8\" data-dynamic=\"true\" data-kid=\"1-1-1-3-1\" data-name=\"band product grid\" data-reason=\"band card children injected and re-rendered by script\" id=\"bandGrid\" style=\"transform-style:preserve-3d\"></div></div>\n<p class=\"mt-9 flex items-center gap-2.5 text-[14px] italic text-[#6B4F57]\" data-kid=\"1-1-1-4\" data-name=\"hint instruction text\"><span aria-hidden=\"true\" class=\"starshape w-3.5 h-3.5 bg-[#C8553D]\" data-kid=\"1-1-1-4-1\" data-name=\"decorative star icon\"></span>tilt your cursor across the shelf — hover any band to peek at its specs</p>\n<p aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-1-1-5\" data-name=\"screen reader cart status region\" data-reason=\"text written by script when items are added to cart\" id=\"cartFeedback\" role=\"status\"></p>\n</div>\n</section>\n</div>\n<script>\n(function(){\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',tag:'Ships Nov 4',line:'Titanium case, dual-band GPS and 14 days of battery for multi-day races.',peek:['14-day battery','Dual-band GPS','100 m water','Titanium · 32 g'],price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F8F38A 0%,#FBF4B8 40%,#F4F1EE 78%)',tc:'#F8F38A'},\n{id:'pro',n:'Pro',tag:'Training',line:'Built-in GPS and ECG for structured training without your phone.',peek:['10-day battery','Built-in GPS','ECG Heart Screener','Aluminum · 27 g'],price:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#EEF0E4 0%,#E3E7D6 55%,#D9DEC8 100%)',tc:'#A3B47F'},\n{id:'lite',n:'Lite',tag:'Lightest',line:'Featherweight tracking for sleep, steps and daily recovery.',peek:['5-day battery','GPS via phone','Mono OLED','Polymer · 18 g'],price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F0F2F4 0%,#E3E7EB 55%,#D6DCE2 100%)',tc:'#B9C3CD'},\n{id:'smart',n:'Smart',tag:'Everyday',line:'Everyday sleep, strain and recovery on an always-on display.',peek:['7-day battery','Skin temperature','AMOLED display','Aluminum · 24 g'],price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#F6EEF0 0%,#EFE3E6 55%,#E6D6DA 100%)',tc:'#E3C3CB'},\n{id:'music',n:'Music',tag:'Offline',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',peek:['6-day battery','4 GB · ~500 songs','Bluetooth audio','Aluminum · 28 g'],price:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',tile:'radial-gradient(circle at 50% 55%,#FBEDE7 0%,#F6E0D8 55%,#EFD2C7 100%)',tc:'#E8907A'}];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={sleep:{fit:['lite','smart']},training:{fit:['pro','ultra']},music:{fit:['music','pro']},endurance:{fit:['ultra','pro']}};\nconst SIZE={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet mode='out',plan=2,filter='all',cart=0,addedId='';\nconst $=id=>document.getElementById(id),byId=id=>P.find(p=>p.id===id);\nfunction priceLine(p){\n if(mode==='out')return `<span class=\"serif text-[24px] font-semibold text-[#2A0B14]\">$${p.price}</span>`;\n if(plan>=p.min)return `<span class=\"serif text-[24px] font-semibold text-[#2A0B14]\">$0</span><span class=\"text-[12px] text-[#6B4F57] ml-1\">with ${PL[plan][0]}</span>`;\n return `<span class=\"text-[13px] font-medium text-[#C8553D]\">Needs ${PL[p.min][0]}</span>`;\n}\nfunction renderLineup(){\n const f=(k,l)=>`<button type=\"button\" data-act=\"filter\" data-f=\"${k}\" aria-pressed=\"${filter===k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${filter===k?'bg-[#C8553D] text-white':'bg-[#F3EFEC] text-[#2A0B14] hover:bg-[#F8F38A]'}\">${l}</button>`;\n const m=(k,l)=>`<button type=\"button\" data-act=\"mode\" data-mode=\"${k}\" aria-pressed=\"${mode===k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${mode===k?'bg-[#F8F38A] text-[#2A0B14]':'border border-[#2A0B14]/20 text-[#2A0B14] hover:bg-[#F3EFEC]'}\">${l}</button>`;\n $('pills').innerHTML=f('all','All bands')+f('sleep','Sleep')+f('training','Training')+f('music','Music')+f('endurance','Endurance')+'<span class=\"w-px h-9 bg-[#2A0B14]/15 mx-1.5\" aria-hidden=\"true\"></span>'+m('out','Buy outright')+m('mem','With membership')+(mode==='mem'?[1,2,3].map(t=>`<button type=\"button\" data-act=\"plan\" data-plan=\"${t}\" aria-pressed=\"${t===plan}\" class=\"h-10 px-4 rounded-full text-[13px] transition ${t===plan?'bg-[#2A0B14]/[0.06] ring-1 ring-[#2A0B14] text-[#2A0B14] font-medium':'border border-[#2A0B14]/15 text-[#4A2A33] hover:bg-[#F3EFEC]'}\">${PL[t][0]} · $${PL[t][2]}/yr</button>`).join(''):'');\n $('bandGrid').innerHTML=P.map(p=>{\n  const dim=filter!=='all'&&!USE[filter].fit.includes(p.id),fit=filter!=='all'&&!dim,blocked=mode==='mem'&&plan<p.min;\n  return `<article class=\"band ${dim?'!opacity-35':''}\">\n   <div class=\"relative aspect-[4/5] rounded-[22px] overflow-hidden shadow-[0_10px_28px_rgba(42,11,20,0.08)] flex items-center justify-center\" style=\"background:${p.tile}\">\n    <img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"w-[78%] h-[78%] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\">\n    <span class=\"absolute left-4 top-4 text-[12px] font-medium bg-white/90 text-[#2A0B14] rounded-full px-3 py-1\">${p.tag}</span>\n    ${fit?`<span class=\"absolute left-4 bottom-4 text-[12px] font-medium bg-[#F8F38A] text-[#2A0B14] rounded-full px-3 py-1\">Good for ${filter}</span>`:''}\n    <div class=\"peek absolute inset-3 rounded-[16px] bg-[#FAF8F6]/95 text-[#2A0B14] p-6 flex flex-col justify-end\"><p class=\"text-[11px] font-semibold tracking-[0.24em] uppercase text-[#6B7B4E] mb-3\">At a glance</p>${p.peek.map(s=>`<p class=\"serif italic text-[22px] leading-[1.3]\">${s}</p>`).join('')}</div>\n   </div>\n   <div class=\"mt-4\">\n    <h3 class=\"serif text-[28px] font-medium leading-none\">Aero Fit ${p.n}</h3>\n    <p class=\"mt-2 text-[14px] italic text-[#6B4F57] leading-[1.45]\">${p.line}</p>\n    <div class=\"mt-3 flex items-center justify-between\"><span class=\"text-[12px] font-semibold px-3 py-1 rounded-full\" style=\"background:${p.tc}40;color:#2A0B14\">${p.c[p.ci][0]}</span><div class=\"flex items-baseline\">${priceLine(p)}</div></div>\n    <div class=\"mt-4 flex flex-wrap items-center gap-2\">\n     <div class=\"flex gap-1\">${p.c.map((c,j)=>`<button type=\"button\" data-act=\"color\" data-id=\"${p.id}\" data-i=\"${j}\" aria-label=\"${p.n}: ${c[0]}\" aria-pressed=\"${j===p.ci}\" title=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${j===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div>\n     <div class=\"h-10 p-1 rounded-full bg-[#F3EFEC] flex ml-1\">${['S','M','L'].map(s=>`<button type=\"button\" data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" aria-label=\"${p.n}: size ${s}\" aria-pressed=\"${s===p.s}\" title=\"${SIZE[s]}\" class=\"w-8 rounded-full text-[12px] font-medium ${s===p.s?'bg-white text-[#2A0B14] shadow-[0_1px_4px_rgba(42,11,20,0.12)]':'text-[#6B4F57]'}\">${s}</button>`).join('')}</div>\n     ${blocked?`<button type=\"button\" data-act=\"plan\" data-plan=\"${p.min}\" class=\"ml-auto h-10 px-4 rounded-full border border-[#2A0B14]/30 text-[13px] font-medium\">Switch to ${PL[p.min][0]}</button>`:`<button type=\"button\" data-act=\"add\" data-id=\"${p.id}\" aria-label=\"Add Aero Fit ${p.n} to cart\" class=\"ml-auto h-10 px-4 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[13px] font-medium hover:bg-[#F2EB6A] transition flex items-center gap-1.5\">${addedId===p.id?'Added':'Add'} <i class=\"ti ${addedId===p.id?'ti-check':'ti-plus'}\" aria-hidden=\"true\"></i></button>`}\n    </div>\n   </div></article>`;\n }).join('');\n bindTilt();\n}\nfunction bindTilt(){\n const grid=$('bandGrid'),cards=grid.querySelectorAll('.band');\n grid.onmousemove=e=>{const r=grid.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;cards.forEach(b=>{b.style.setProperty('--mx',x);b.style.setProperty('--my',y)})};\n grid.onmouseleave=()=>cards.forEach(b=>{b.style.setProperty('--mx',0);b.style.setProperty('--my',0)});\n}\ndocument.getElementById('lineup').addEventListener('click',e=>{\n const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=byId(t.dataset.id);\n if(a==='filter'){filter=t.dataset.f;addedId=''}else if(a==='mode'){mode=t.dataset.mode;addedId=''}else if(a==='plan'){plan=+t.dataset.plan;mode='mem';addedId=''}else if(a==='color'){p.ci=+t.dataset.i;addedId=''}else if(a==='size'){p.s=t.dataset.s;addedId=''}else if(a==='add'){cart++;addedId=p.id;$('cartFeedback').textContent=`Aero Fit ${p.n}, ${p.c[p.ci][0]}, size ${p.s} added to cart. ${cart} item${cart===1?'':'s'} in cart.`}\n renderLineup();\n});\nrenderLineup();\n})();\n</script>",
      "comments": [],
      "created": "2026-10-28T10:02:51.927281+00:00",
      "modified": "2026-10-28T10:04:56.069666+00:00",
      "id": "var_69d88fa73f50",
      "contentHeight": 1918
    },
    "var_df2b56805b08": {
      "type": "variant",
      "label": "Lineup — Split by Fit",
      "parentId": "var_8d36871376e8",
      "themeId": null,
      "rect": {
        "x": 18719,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n.serif{font-family:'Source Serif 4',serif}.sans{font-family:'Inter',sans-serif}.tnum{font-variant-numeric:tabular-nums}\n.ring-arc{transition:stroke-dashoffset 1s cubic-bezier(.16,.84,.44,1)}\n.fade{animation:fd .5s cubic-bezier(.16,.84,.44,1) both}@keyframes fd{from{opacity:0;transform:translateY(12px)}}\n</style>\n<section class=\"sans bg-[#FAF8F6] text-[#2A0B14] py-20 px-16\" data-kid=\"1\" data-name=\"lineup section container\" id=\"lineup\">\n<h2 class=\"serif text-[56px] leading-none font-medium tracking-[-0.02em]\" data-kid=\"1-1\" data-name=\"lineup headline\">Five bands, <span class=\"italic text-[#C8553D]\" data-kid=\"1-1-1\" data-name=\"italic accent text on headline\">one app</span></h2>\n<div class=\"mt-8 flex flex-wrap items-center gap-2\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"usage mode filter bar\" data-reason=\"buttons rendered by render() from USE state on load and on clicks\" id=\"bar\"></div>\n<p class=\"mt-4 text-[15px] text-[#2A0B14]/70\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"filter explanatory caption text\" data-reason=\"text set from USE[use].cap by render() on load and each click\" id=\"cap\"></p>\n<div class=\"mt-6 grid grid-cols-2 gap-6\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"featured band cards grid\" data-reason=\"two feature cards injected from P state by render() on load and each click\" id=\"top\"></div>\n<div class=\"mt-10\" data-dynamic=\"true\" data-kid=\"1-5\" data-name=\"remaining band list wrapper\" data-reason=\"children injected by render() on load and each click\" id=\"restWrap\"><p class=\"text-[13px] font-medium text-[#2A0B14]/65 mb-2\" data-dynamic=\"true\" data-kid=\"1-5-1\" data-name=\"remaining lineup label text\" data-reason=\"text set to fixed value by render() on load and each click\" id=\"restLabel\"></p><div class=\"bg-white rounded-[16px] divide-y divide-[#2A0B14]/8\" data-dynamic=\"true\" data-kid=\"1-5-2\" data-name=\"remaining band row list\" data-reason=\"rows injected from P state by render() on load and each click\" id=\"rest\"></div></div>\n</section>\n<script>\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst TINT={endurance:['oklch(32.1% 0.0529 284.5)','#fff'],training:['oklch(83.3% 0.0912 176.1)','#2A0B14'],sleep:['oklch(74.7% 0.0954 257.1)','#2A0B14'],music:['oklch(81.5% 0.0815 352.9)','#2A0B14'],all:['oklch(81.5% 0.0815 352.9)','#2A0B14']};\nconst P=[\n{id:'ultra',n:'Ultra',b:'Ships Nov 4',t:'Titanium case, dual-band GPS and 14 days of battery for multi-day races.',why:'14-day battery, dual-band GPS',bat:14,p:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']]},\n{id:'pro',n:'Pro',b:'Training',t:'Built-in GPS and ECG for structured training without your phone.',why:'Built-in GPS and ECG',bat:10,p:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']]},\n{id:'lite',n:'Lite',b:'Lightest',t:'Featherweight tracking for sleep, steps and daily recovery.',why:'18 g, the lightest band',bat:5,p:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']]},\n{id:'smart',n:'Smart',b:'Everyday',t:'Everyday sleep, strain and recovery on an always-on display.',why:'24 g with skin temperature',bat:7,p:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']]},\n{id:'music',n:'Music',b:'Offline',t:'Stores 500 songs and plays to Bluetooth headphones on the run.',why:'4 GB of onboard music',bat:6,p:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']]}];\nP.forEach(p=>{p.ci=0;p.s='M'});\nconst USE={all:{l:'All bands',fit:['ultra','pro'],cap:'Ultra and Pro are the most capable bands'},sleep:{l:'Sleep',fit:['lite','smart'],cap:'Lite and Smart suit this best'},training:{l:'Training',fit:['pro','ultra'],cap:'Pro and Ultra suit this best'},music:{l:'Music',fit:['music','pro'],cap:'Music and Pro suit this best'},endurance:{l:'Endurance',fit:['ultra','pro'],cap:'Ultra and Pro suit this best'}};\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};const SZ={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet use='endurance',mode='out',plan=2,cart={},exp={};\nconst $=i=>document.getElementById(i),byId=i=>P.find(p=>p.id===i);\nfunction price(p,big){const cls=big?'serif text-[34px] font-medium tnum':'serif text-[20px] font-medium tnum';\n if(mode==='out')return `<span class=\"${cls}\">$${p.p}</span>`;\n return plan>=p.min?`<span class=\"${cls}\">$0</span><span class=\"text-[13px] opacity-75 ml-1.5\">band with ${PL[plan][0]}</span>`:`<span class=\"text-[14px] font-medium text-[#C8553D]\">Needs ${PL[p.min][0]}</span>`}\nfunction btn(p,dark){return mode==='mem'&&plan<p.min?`<button data-pl=\"${p.min}\" class=\"h-9 px-4 rounded-full border ${dark?'border-white/50':'border-[#2A0B14]/30'} text-[13px] font-medium\">Switch to ${PL[p.min][0]}</button>`:`<button data-add=\"${p.id}\" class=\"h-9 px-4 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[13px] font-medium inline-flex items-center gap-1.5\"><i class=\"icon-plus\"></i>${cart[p.id]?'Added '+cart[p.id]:'Add'}</button>`}\nfunction ringSvg(p,col){const C=2*Math.PI*46,off=C*(1-p.bat/14);return `<svg viewBox=\"0 0 100 100\" class=\"absolute inset-0 w-full h-full -rotate-90\"><circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"${col}\" stroke-opacity=\".18\" stroke-width=\"1.6\"/><circle class=\"ring-arc\" cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"${col}\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-dasharray=\"${C}\" stroke-dashoffset=\"${off}\"/></svg>`}\nfunction config(p){return `<div class=\"flex items-center gap-3\"><div class=\"flex gap-1\">${p.c.map((c,j)=>`<button data-c=\"${p.id}\" data-i=\"${j}\" aria-label=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${j===p.ci?'border-current':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div><div class=\"h-9 p-1 rounded-full bg-black/5 flex\">${['S','M','L'].map(s=>`<button data-s=\"${p.id}\" data-v=\"${s}\" title=\"${SZ[s]}\" class=\"w-8 rounded-full text-[12px] font-medium ${s===p.s?'bg-white text-[#2A0B14] shadow-sm':'opacity-70'}\">${s}</button>`).join('')}</div><span class=\"text-[12px] opacity-75\">${p.c[p.ci][0]} · fits ${SZ[p.s]}</span></div>`}\nfunction render(){\n const U=USE[use];const [tc,tx]=TINT[use];\n $('bar').innerHTML=Object.keys(USE).map(k=>`<button data-u=\"${k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium transition ${k===use?'bg-[#C8553D] text-white':'bg-white hover:bg-[#F8F38A]'}\">${USE[k].l}</button>`).join('')+'<span class=\"w-px h-8 bg-[#2A0B14]/15 mx-2\"></span>'+[['out','Buy outright'],['mem','With membership']].map(([k,l])=>`<button data-m=\"${k}\" class=\"h-10 px-5 rounded-full text-[14px] font-medium ${mode===k?'bg-[#F8F38A]':'border border-[#2A0B14]/20'}\">${l}</button>`).join('')+(mode==='mem'?[1,2,3].map(t=>`<button data-pl=\"${t}\" class=\"h-10 px-4 rounded-full text-[13px] ${t===plan?'ring-1 ring-[#2A0B14] font-medium bg-white':'text-[#2A0B14]/70 hover:bg-white'}\">${PL[t][0]} · $${PL[t][2]}/yr</button>`).join(''):'');\n $('cap').textContent=U.cap+'.';\n $('top').innerHTML=U.fit.map(byId).map((p,i)=>`<article class=\"fade bg-white rounded-[16px] overflow-hidden shadow-[0_30px_60px_-30px_rgba(42,11,20,0.35)]\" style=\"animation-delay:${i*.08}s\">\n  <div class=\"relative h-[340px] flex items-center justify-center\" style=\"background:linear-gradient(180deg,${tc} 0%,${tc} 55%,#fff 100%);color:${tx}\">\n   <span class=\"absolute left-5 top-5 text-[12px] font-medium px-3 py-1 rounded-full bg-white/85 text-[#2A0B14]\">${p.b}</span>\n   <span class=\"absolute right-5 top-5 text-[12px] font-medium tnum\">${p.bat} days</span>\n   <div class=\"relative w-[260px] h-[260px] flex items-center justify-center\">${ringSvg(p,tx)}<span class=\"w-[210px] h-[210px] rounded-full bg-white flex items-center justify-center overflow-hidden\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"w-[190px] h-[190px] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\"></span></div>\n  </div>\n  <div class=\"p-6 pt-2\">\n   <div class=\"flex items-end justify-between\"><div><h3 class=\"serif text-[32px] font-medium leading-none\">Aero Fit ${p.n}</h3><p class=\"mt-2 text-[13px] font-medium px-2.5 py-0.5 rounded-full inline-block\" style=\"background:${tc};color:${tx}\">${p.why}</p></div><div class=\"text-right\">${price(p,true)}</div></div>\n   <p class=\"mt-3 text-[14px] text-[#2A0B14]/75\">${p.t}</p>\n   <div class=\"mt-5 flex items-center justify-between\">${config(p)}${btn(p)}</div>\n  </div></article>`).join('');\n const rest=P.filter(p=>!U.fit.includes(p.id));\n $('restLabel').textContent='Also in the lineup';\n $('rest').innerHTML=rest.map(p=>`<div class=\"px-5\">\n  <div class=\"h-[64px] flex items-center gap-4\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n}\" class=\"w-11 h-11 object-contain mix-blend-multiply\" decoding=\"async\" loading=\"lazy\">\n   <p class=\"serif text-[20px] font-medium w-[180px]\">Aero Fit ${p.n}</p><p class=\"text-[13px] text-[#2A0B14]/70 flex-1 truncate\">${p.t}</p><span class=\"text-[12px] text-[#2A0B14]/65 tnum w-[70px]\">${p.bat} days</span>\n   <div class=\"w-[200px] text-right\">${price(p)}</div>\n   <button data-x=\"${p.id}\" class=\"h-9 px-3 rounded-full text-[13px] border border-[#2A0B14]/20 inline-flex items-center gap-1\">Options <i class=\"icon-chevron-down ${exp[p.id]?'rotate-180':''}\"></i></button>${btn(p)}</div>\n  ${exp[p.id]?`<div class=\"pb-4 pl-[60px]\">${config(p)}</div>`:''}</div>`).join('');\n}\ndocument.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;const d=t.dataset;\n if(d.u)use=d.u;else if(d.m)mode=d.m;else if(d.pl){plan=+d.pl;mode='mem'}else if(d.c)byId(d.c).ci=+d.i;else if(d.s)byId(d.s).s=d.v;else if(d.x)exp[d.x]=!exp[d.x];else if(d.add)cart[d.add]=(cart[d.add]||0)+1;\n render();if(!d.u)document.querySelectorAll('.fade').forEach(x=>x.style.animation='none')});\nrender();\n</script>",
      "comments": [],
      "created": "2026-10-28T10:03:35.070060+00:00",
      "modified": "2026-10-28T10:04:56.078996+00:00",
      "id": "var_df2b56805b08",
      "contentHeight": 1137
    },
    "var_6cd95cb55333": {
      "type": "variant",
      "label": "Lineup — One Band at a Time",
      "parentId": "var_8d36871376e8",
      "themeId": null,
      "rect": {
        "x": 20099,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif}.sans{font-family:'Inter',sans-serif}.tnum{font-variant-numeric:tabular-nums}\n.flood{transition:height .7s cubic-bezier(.16,.84,.44,1)}\n.pin{animation:pi .45s cubic-bezier(.16,.84,.44,1) both}@keyframes pi{from{opacity:0;transform:translateX(14px)}}\n</style>\n<section class=\"sans bg-[#FAF8F6] text-[#2A0B14] py-20 px-16\" data-kid=\"1\" data-name=\"product lineup section false\" id=\"lineup\">\n<div class=\"flex items-end justify-between gap-8\" data-kid=\"1-1\" data-name=\"section header row\">\n<h2 class=\"serif text-[56px] leading-none font-medium tracking-[-0.02em]\" data-kid=\"1-1-1\" data-name=\"section headline\">Five bands, <span class=\"italic text-[#C8553D]\" data-kid=\"1-1-1-1\" data-name=\"italic accent phrase\">one app</span></h2>\n<div class=\"flex items-center gap-1 p-1.5 rounded-full bg-[oklch(85.5%_0.0687_303)] shadow-[0_10px_30px_rgba(42,11,20,0.12),inset_0_1px_0_rgba(255,255,255,0.6)]\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"purchase mode and plan toggle bar\" data-reason=\"innerHTML rebuilt by render script on every interaction\" id=\"bar\"></div>\n</div>\n<div class=\"mt-10 grid grid-cols-[300px_1fr] gap-6\" data-kid=\"1-2\" data-name=\"product browser grid\">\n<div class=\"flex flex-col gap-2\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"band selection tabs list\" data-reason=\"children rendered by render script from data array\" id=\"tabs\"></div>\n<div data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"product detail panel\" data-reason=\"innerHTML fully rewritten by render script per selected band\" id=\"panel\"></div>\n</div>\n</section>\n<script>\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',b:'Ships Nov 4',t:'Titanium case, dual-band GPS and 14 days of battery for multi-day races.',g:[['14 days','Battery'],['Dual-band','GPS'],['32 g','Weight'],['Titanium','Case']],p:399,min:3,tile:'oklch(86.9% 0.0592 42)',c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']]},\n{id:'pro',n:'Pro',b:'In stock',t:'Built-in GPS and ECG for structured training without your phone.',g:[['10 days','Battery'],['Built-in','GPS'],['27 g','Weight'],['Aluminum','Case']],p:279,min:2,tile:'oklch(90.4% 0.0408 155.4)',c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']]},\n{id:'lite',n:'Lite',b:'Lightest',t:'Featherweight tracking for sleep, steps and daily recovery.',g:[['5 days','Battery'],['Via phone','GPS'],['18 g','Weight'],['Polymer','Case']],p:149,min:1,tile:'oklch(90.4% 0.0408 155.4)',c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']]},\n{id:'smart',n:'Smart',b:'Everyday',t:'Everyday sleep, strain and recovery on an always-on display.',g:[['7 days','Battery'],['Via phone','GPS'],['24 g','Weight'],['Aluminum','Case']],p:199,min:1,tile:'oklch(86.9% 0.0592 42)',c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']]},\n{id:'music',n:'Music',b:'Offline',t:'Stores 500 songs and plays to Bluetooth headphones on the run.',g:[['6 days','Battery'],['Built-in','GPS'],['28 g','Weight'],['4 GB','Music']],p:299,min:2,tile:'oklch(86.9% 0.0592 42)',c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']]}];\nP.forEach(p=>{p.ci=0;p.s='M'});\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};const SZ={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet cur='ultra',mode='out',plan=2,cart=0,cmp=false;\nconst $=i=>document.getElementById(i),byId=i=>P.find(p=>p.id===i);\nconst cov=p=>mode==='mem'&&plan>=p.min;\nfunction tabPrice(p){return mode==='out'?'$'+p.p:(plan>=p.min?'$0':'Needs '+PL[p.min][0])}\nfunction render(){\n $('bar').innerHTML=[['out','Buy outright'],['mem','With membership']].map(([k,l])=>`<button data-m=\"${k}\" class=\"h-9 px-4 rounded-full text-[13px] font-medium ${mode===k?'bg-[#F8F38A] shadow-sm':'hover:bg-white/40'}\">${l}</button>`).join('')+'<span class=\"w-px h-6 bg-[#2A0B14]/20 mx-1\"></span>'+[1,2,3].map(t=>`<button data-pl=\"${t}\" class=\"h-9 px-3.5 rounded-full text-[13px] ${mode==='mem'&&t===plan?'bg-white font-medium shadow-[inset_0_1px_3px_rgba(42,11,20,0.15)]':'hover:bg-white/40'}\">${PL[t][0]} <span class=\"tnum opacity-75\">$${PL[t][2]}</span></button>`).join('');\n $('tabs').innerHTML=P.map(p=>{const on=p.id===cur;return `<button data-t=\"${p.id}\" class=\"h-[76px] px-4 rounded-[20px] flex items-center gap-3 text-left transition ${on?'bg-white shadow-[0_8px_24px_rgba(42,11,20,0.08)] ring-2 ring-[#F8F38A]':'hover:bg-white/70'}\">\n  <span class=\"w-12 h-12 rounded-full flex items-center justify-center ${cov(p)?'bg-[#2A0B14]':''}\" style=\"${cov(p)?'':'background:'+p.tile}\"><span class=\"w-10 h-10 rounded-full bg-white overflow-hidden flex items-center justify-center\"><img src=\"${IMG[p.id]}\" alt=\"\" class=\"w-10 h-10 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"></span></span>\n  <span class=\"flex-1\"><span class=\"block serif text-[20px] font-medium leading-none\">${p.n}</span><span class=\"block mt-1 text-[12px] ${p.min===3?'text-[#C8553D] font-medium':'text-[#2A0B14]/65'}\">${p.b}</span></span>\n  <span class=\"text-[15px] font-semibold tnum ${tabPrice(p).startsWith('Needs')?'text-[13px] text-[#C8553D]':''}\">${tabPrice(p)}</span></button>`}).join('')+\n  `<button data-cmp class=\"mt-2 h-11 rounded-full border border-[#2A0B14]/20 text-[14px] font-medium flex items-center justify-center gap-2\"><i class=\"ti ti-columns-3\"></i>${cmp?'Hide comparison':'Compare the five'}</button>`;\n const p=byId(cur),c=cov(p);\n $('panel').innerHTML=`<div class=\"pin bg-[oklch(97.9%_0.0203_81.8)] rounded-[24px] border border-[#2A0B14]/10 p-6 grid grid-cols-[400px_1fr] gap-8\">\n  <div class=\"relative h-[460px] rounded-[18px] overflow-hidden flex items-center justify-center\" style=\"background:${p.tile}\">\n   <div class=\"flood absolute left-0 right-0 bottom-0 bg-[#2A0B14]\" style=\"height:${c?'100%':'0%'}\"></div>\n   <span class=\"relative w-[300px] h-[300px] rounded-full bg-white flex items-center justify-center overflow-hidden\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"w-[270px] h-[270px] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\"></span>\n   <span class=\"absolute left-4 top-4 text-[12px] font-medium px-3 py-1 rounded-full bg-white/90\">${p.b}</span>\n   ${c?`<span class=\"absolute left-5 bottom-5 text-[#FAF8F6]\"><span class=\"serif text-[44px] font-medium leading-none\">$0</span><span class=\"block text-[13px] mt-1\">band with ${PL[plan][0]}</span></span>`:''}\n  </div>\n  <div class=\"flex flex-col\">\n   <h3 class=\"serif text-[44px] font-medium leading-none\">Aero Fit ${p.n}</h3>\n   <p class=\"mt-3 text-[15px] text-[#2A0B14]/75 max-w-[440px]\">${p.t}</p>\n   <div class=\"mt-6 grid grid-cols-2 gap-2 max-w-[360px]\">${p.g.map(([v,l])=>`<div class=\"rounded-[14px] bg-white px-3 py-3\"><p class=\"serif text-[17px] font-medium leading-tight whitespace-nowrap\">${v}</p><p class=\"mt-1 text-[12px] text-[#2A0B14]/65\">${l}</p></div>`).join('')}</div>\n   <p class=\"mt-6 text-[13px] text-[#2A0B14]/65\">Colour · <span class=\"text-[#2A0B14] font-medium\">${p.c[p.ci][0]}</span></p>\n   <div class=\"mt-2 flex gap-2\">${p.c.map((x,j)=>`<button data-c=\"${j}\" aria-label=\"${x[0]}\" class=\"w-10 h-10 rounded-full p-1 border-2 ${j===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${x[1]}\"></span></button>`).join('')}</div>\n   <p class=\"mt-5 text-[13px] text-[#2A0B14]/65\">Size ${p.s} fits wrists ${SZ[p.s]}</p>\n   <div class=\"mt-2 inline-flex self-start p-1 rounded-full bg-white shadow-[inset_0_2px_5px_rgba(42,11,20,0.1)]\">${['S','M','L'].map(s=>`<button data-s=\"${s}\" class=\"w-12 h-9 rounded-full text-[14px] font-medium ${s===p.s?'bg-[oklch(85.5%_0.0687_303)]':'text-[#2A0B14]/65'}\">${s}</button>`).join('')}</div>\n   <div class=\"mt-auto pt-6 border-t border-[#2A0B14]/10 flex items-center justify-between\">\n    <div>${mode==='out'?`<p class=\"serif text-[36px] font-medium tnum leading-none\">$${p.p}</p><p class=\"text-[13px] text-[#2A0B14]/65 mt-1\">One-time · free returns</p>`:c?`<p class=\"serif text-[36px] font-medium leading-none\">$0 band</p><p class=\"text-[13px] text-[#2A0B14]/65 mt-1\">With ${PL[plan][0]} · $${PL[plan][2]}/yr ($${PL[plan][1]}/mo)</p>`:`<p class=\"serif text-[26px] font-medium leading-none\">Included with ${PL[p.min][0]}</p><p class=\"text-[13px] text-[#2A0B14]/65 mt-1\">Not part of ${PL[plan][0]}</p>`}</div>\n    ${mode==='mem'&&!c?`<button data-pl=\"${p.min}\" class=\"h-12 px-6 rounded-full border border-[#2A0B14]/30 text-[15px] font-medium\">Switch to ${PL[p.min][0]}</button>`:`<button data-add class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium inline-flex items-center gap-2 hover:bg-[#45172A]\"><i class=\"ti ti-shopping-bag\"></i>${p.min===3&&mode==='out'?'Pre-order Ultra':'Add '+p.n+' to cart'}${cart?`<span class=\"ml-1 min-w-6 h-6 px-1.5 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[12px] flex items-center justify-center\">${cart}</span>`:''}</button>`}\n   </div>\n  </div></div>\n  ${cmp?`<div class=\"mt-4 bg-white rounded-[20px] border border-[#2A0B14]/10 overflow-hidden text-[14px]\">${[['Band',P.map(x=>x.n)],['Battery',P.map(x=>x.g[0][0])],['GPS',P.map(x=>x.g[1][0])],['Weight',P.map(x=>x.g[2][0])],['Outright',P.map(x=>'$'+x.p)],['Included with',P.map(x=>['','One, Peak, Life','Peak, Life','Life only'][x.min])]].map((r,i)=>`<div class=\"grid grid-cols-[140px_repeat(5,1fr)] ${i?'border-t border-[#2A0B14]/8':'bg-[oklch(97.9%_0.0203_81.8)] font-medium'}\"><span class=\"px-4 py-3 text-[#2A0B14]/65\">${r[0]}</span>${r[1].map((v,j)=>`<span class=\"px-3 py-3 ${P[j].id===cur?'bg-[#F8F38A]/40 font-medium':''}\">${v}</span>`).join('')}</div>`).join('')}</div>`:''}`;\n}\ndocument.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;const d=t.dataset,p=byId(cur);\n if(d.t)cur=d.t;else if(d.m)mode=d.m;else if(d.pl){plan=+d.pl;mode='mem'}else if(d.c!==undefined)p.ci=+d.c;else if(d.s)p.s=d.s;else if('add' in d)cart++;else if('cmp' in d)cmp=!cmp;\n render();if(!d.t)document.querySelector('.pin').style.animation='none'});\nrender();\n</script>",
