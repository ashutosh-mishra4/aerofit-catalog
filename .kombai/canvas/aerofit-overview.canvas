-y border-[#E3DDDA]\" data-kid=\"2-6-2-4\">\n        <p class=\"font-serif text-[28px] font-medium\" data-kid=\"2-6-2-4-1\">Life</p>\n        <p class=\"text-[26px] font-semibold tabular-nums\" data-kid=\"2-6-2-4-2\">$399<span class=\"ml-1 text-[14px] font-normal text-[#6B4F57]\" data-kid=\"2-6-2-4-2-1\">/year</span></p>\n        <div class=\"flex items-center gap-2\" data-kid=\"2-6-2-4-3\">\n          <span class=\"flex h-11 items-center gap-2 rounded-full bg-[#F4F1EE] pr-4 pl-1 text-[14px] font-medium\" data-kid=\"2-6-2-4-3-1\"><img class=\"size-9 rounded-full bg-white object-contain mix-blend-multiply\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg\" alt=\"\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-6-2-4-3-1-1\">Lite</span>\n          <span class=\"flex h-11 items-center gap-2 rounded-full bg-[#F4F1EE] pr-4 pl-1 text-[14px] font-medium\" data-kid=\"2-6-2-4-3-2\"><img class=\"size-9 rounded-full bg-white object-contain mix-blend-multiply\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\" alt=\"\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-6-2-4-3-2-1\">Smart</span>\n          <span class=\"flex h-11 items-center gap-2 rounded-full bg-[#F4F1EE] pr-4 pl-1 text-[14px] font-medium\" data-kid=\"2-6-2-4-3-3\"><img class=\"size-9 rounded-full bg-white object-contain mix-blend-multiply\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg\" alt=\"\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-6-2-4-3-3-1\">Pro</span>\n          <span class=\"flex h-11 items-center gap-2 rounded-full bg-[#F4F1EE] pr-4 pl-1 text-[14px] font-medium\" data-kid=\"2-6-2-4-3-4\"><img class=\"size-9 rounded-full bg-white object-contain mix-blend-multiply\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b666