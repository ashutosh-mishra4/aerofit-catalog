      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n@layer components {\n  .f-sans { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n  .f-serif { font-family: 'Source Serif 4', Georgia, serif; }\n  .f-mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .brk {\n    --b: #2A0B14;\n    background:\n      linear-gradient(var(--b),var(--b)) left top/9px 1px no-repeat,\n      linear-gradient(var(--b),var(--b)) left top/1px 9px no-repeat,\n      linear-gradient(var(--b),var(--b)) right top/9px 1px no-repeat,\n      linear-gradient(var(--b),var(--b)) right top/1px 9px no-repeat,\n      linear-gradient(var(--b),var(--b)) left bottom/9px 1px no-repeat,\n      linear-gradient(var(--b),var(--b)) left bottom/1px 9px no-repeat,\n      linear-gradient(var(--b),var(--b)) right bottom/9px 1px no-repeat,\n      linear-gradient(var(--b),var(--b)) right bottom/1px 9px no-repeat;\n  }\n  .signals-stage.is-stacked .recovery-panel { position: absolute; inset: 0; margin-top: 0; }\n  .js-day .day-row .dot { background: #FAF8F6; }\n  .js-day .day-row.is-on .dot { background: #2A0B14; }\n}\n</style>\n<link data-kid=\"1\" data-name=\"lenis smooth scroll styles\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"f-sans min-h-screen overflow-x-clip bg-[#FAF8F6] pt-5 pb-5 text-[#2A0B14] antialiased\" data-kid=\"2\" data-name=\"page layout container\">\n<!-- Navbar -->\n<header class=\"sticky top-5 z-50 mx-4 flex h-[68px] items-center justify-between rounded-full border border-[#EFEAE6] bg-white/85 pl-7 pr-2 shadow-[0_4px_18px_rgba(42,11,20,0.06)] backdrop-blur-md\" data-kid=\"2-1\" data-name=\"sticky top navigation bar\">\n<div class=\"flex items-center gap-8\" data-kid=\"2-1-1\" data-name=\"nav left group with logo and links\">\n<a aria-label=\"Aero Fit home\" class=\"flex items-center gap-2\" data-kid=\"2-1-1-1\" data-name=\"brand logo link to home\" href=\"#top\">\n<img alt=\"\" class=\"size-8\" data-kid=\"2-1-1-1-1\" data-name=\"Aero Fit logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n<span class=\"f-serif text-[22px] font-medium tracking-tight\" data-kid=\"2-1-1-1-2\" data-name=\"brand name wordmark\">Aero Fit</span>\n</a>\n<nav aria-label=\"Primary\" class=\"flex items-center gap-1.5\" data-kid=\"2-1-1-2\" data-name=\"primary navigation links\">\n<a class=\"flex h-10 items-center rounded-full bg-[#F8F38A] px-4 text-[14px] font-medium\" data-kid=\"2-1-1-2-1\" data-name=\"Overview nav link (active)\" href=\"#top\">Overview</a>\n<a class=\"flex h-10 items-center rounded-full bg-[#F3EFEC] px-4 text-[14px] font-medium transition hover:bg-[#ECE6E2]\" data-kid=\"2-1-1-2-2\" data-name=\"How it works nav link\" href=\"#\">How it works</a>\n<a class=\"flex h-10 items-center rounded-full bg-[#F3EFEC] px-4 text-[14px] font-medium transition hover:bg-[#ECE6E2]\" data-kid=\"2-1-1-2-3\" data-name=\"Shop bands nav link\" href=\"#\">Shop bands</a>\n</nav>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"2-1-2\" data-name=\"nav right group with cart and CTA\">\n<button aria-label=\"Cart, 0 items\" class=\"flex h-10 items-center gap-2 rounded-full bg-[#F3EFEC] pl-4 pr-1.5 text-[14px] font-medium transition hover:bg-[#ECE6E2]\" data-kid=\"2-1-2-1\" data-name=\"cart button with item count\">\n<i class=\"ti ti-shopping-bag text-[18px]\" data-kid=\"2-1-2-1-1\" data-name=\"shopping bag icon\"></i>Cart\n        <span class=\"grid size-7 place-items-center rounded-full bg-white text-[12px] font-semibold\" data-kid=\"2-1-2-1-2\" data-name=\"cart item count badge\">0</span>\n</button>\n<a class=\"flex h-11 items-center rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-1-2-2\" data-name=\"join free call-to-action link\" href=\"#\">Join Aero Fit free</a>\n</div>\n</header>\n<!-- Hero -->\n<section class=\"hero relative mx-4 mt-5 h-[704px] overflow-hidden rounded-[28px] bg-[#F3EDE9]\" data-kid=\"2-2\" data-name=\"hero section\" id=\"top\">\n<div class=\"hero-par absolute inset-0\" data-kid=\"2-2-1\" data-name=\"hero parallax media layer\">\n<div class=\"hero-media absolute inset-0 origin-[80%_50%]\" data-kid=\"2-2-1-1\" data-name=\"hero background media container\">\n<img alt=\"Woman stretching on a coastal road at sunrise wearing an Aero Fit band\" class=\"absolute inset-0 h-full w-full object-cover object-[50%_50%]\" data-kid=\"2-2-1-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/ff20317377ff42e99355401aec31e474.jpg\"/>\n<div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(250,248,246,0.96)_0%,rgba(250,248,246,0.82)_30%,rgba(250,248,246,0)_58%)]\" data-kid=\"2-2-1-1-2\" data-name=\"hero left fade gradient overlay\"></div>\n<!-- Lens over the wrist -->\n<div class=\"hero-lens absolute left-[1123px] top-[235px] size-[224px]\" data-kid=\"2-2-1-1-3\" data-name=\"wrist magnifier lens\">\n<div class=\"absolute -inset-[22px] rounded-full border border-dashed border-white/70\" data-kid=\"2-2-1-1-3-1\" data-name=\"dashed circle decoration around lens\"></div>\n<div class=\"relative size-full overflow-hidden rounded-full border-[1.5px] border-white shadow-[0_14px_36px_rgba(42,11,20,0.20)]\" data-kid=\"2-2-1-1-3-2\" data-name=\"lens clipped circular image\">\n<img alt=\"\" class=\"absolute max-w-none\" data-kid=\"2-2-1-1-3-2-1\" data-name=\"clipped zoom of wrist photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/ff20317377ff42e99355401aec31e474.jpg\" style=\"width:2534px;height:1426px;left:-2111px;top:-591px\"/>\n</div>\n</div>\n<!-- HUD tags -->\n<div class=\"hero-tag brk f-mono absolute left-[1192px] top-[150px] bg-[#FAF8F6]/80 px-3 py-2 text-[13px] uppercase tracking-[0.04em] backdrop-blur-sm\" data-kid=\"2-2-1-1-4\" data-name=\"sleep HUD tag\"><span class=\"text-[#6B4F57]\" data-dynamic=\"true\" data-kid=\"2-2-1-1-4-1\" data-name=\"sleep duration value\" data-reason=\"value reinitialized by script (count-up resets to 0 on load and animates)\">[7h 42m]</span> Sleep</div>\n<div class=\"hero-tag brk f-mono absolute left-[930px] top-[262px] bg-[#FAF8F6]/80 px-3 py-2 text-[13px] uppercase tracking-[0.04em] backdrop-blur-sm\" data-kid=\"2-2-1-1-5\" data-name=\"HRV HUD tag\"><span class=\"text-[#6B4F57]\" data-kid=\"2-2-1-1-5-1\" data-name=\"HRV duration value\">[64 ms]</span> HRV</div>\n<div class=\"hero-tag brk f-mono absolute left-[900px] top-[404px] bg-[#FAF8F6]/80 px-3 py-2 text-[13px] uppercase tracking-[0.04em] backdrop-blur-sm\" data-kid=\"2-2-1-1-6\" data-name=\"resting heart rate HUD tag\"><span class=\"text-[#6B4F57]\" data-kid=\"2-2-1-1-6-1\" data-name=\"resting heart rate value\">[52 bpm]</span> Resting HR</div>\n</div>\n</div>\n<div class=\"relative flex h-full items-center pl-[80px]\" data-kid=\"2-2-2\" data-name=\"hero copy container\">\n<div class=\"hero-copy max-w-[540px]\" data-kid=\"2-2-2-1\" data-name=\"hero copy column\">\n<h1 class=\"f-serif text-[64px] font-medium leading-[1.02] tracking-[-0.02em]\" data-kid=\"2-2-2-1-1\" data-name=\"hero headline\">Know what your body is ready for today.</h1>\n<p class=\"mt-6 max-w-[460px] text-[17px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-2-2-1-2\" data-name=\"hero subheadline description\">Aero Fit bands read your sleep, heart and effort around the clock. Each morning the app gives you one call: push, hold steady or recover.</p>\n<div class=\"mt-9 flex items-center gap-6\" data-kid=\"2-2-2-1-3\" data-name=\"hero action links row\">\n<a class=\"flex h-11 items-center rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-2-2-1-3-1\" data-name=\"primary see-how-membership-works button\" href=\"#\">See how membership works</a>\n<a class=\"text-[14px] font-medium underline underline-offset-4 transition hover:opacity-70\" data-kid=\"2-2-2-1-3-2\" data-name=\"shop bands secondary text link\" href=\"#bands\">Shop the five bands</a>\n</div>\n</div>\n</div>\n<!-- Morning plate -->\n<div class=\"hero-plate absolute bottom-7 right-7 w-[300px] rounded-[22px] bg-[#FAF8F6]/90 p-6 shadow-[0_14px_36px_rgba(42,11,20,0.10)] backdrop-blur-md\" data-kid=\"2-2-3\" data-name=\"morning recovery score card\">\n<div class=\"flex items-center justify-between\" data-kid=\"2-2-3-1\" data-name=\"recovery card header row\">\n<p class=\"text-[13px] text-[#6B4F57]\" data-kid=\"2-2-3-1-1\" data-name=\"recovery card caption label\">This morning</p>\n<span class=\"rounded-full border border-[#D9D0CB] px-2.5 py-0.5 text-[12px] text-[#6B4F57]\" data-kid=\"2-2-3-1-2\" data-name=\"example badge\">Example</span>\n</div>\n<div class=\"mt-3 flex items-end justify-between\" data-kid=\"2-2-3-2\" data-name=\"recovery card value row\">\n<p class=\"text-[15px] font-medium\" data-kid=\"2-2-3-2-1\" data-name=\"recovery card label\">Recovery</p>\n<p class=\"text-[44px] font-semibold leading-none tracking-[-0.02em] tabular-nums\" data-kid=\"2-2-3-2-2\" data-name=\"large recovery percentage value\">82<span class=\"text-[22px] font-medium text-[#6B4F57]\" data-kid=\"2-2-3-2-2-1\" data-name=\"recovery percentage sign\">%</span></p>\n</div>\n<div class=\"mt-4 h-1.5 rounded-full bg-[#2A0B14]/10\" data-kid=\"2-2-3-3\" data-name=\"recovery progress bar track\"><div class=\"h-full w-[82%] rounded-full bg-[#2A0B14]\" data-kid=\"2-2-3-3-1\" data-name=\"recovery progress bar fill\"></div></div>\n<p class=\"mt-4 inline-flex rounded-full bg-[#F8F38A] px-3 py-1 text-[13px] font-medium\" data-kid=\"2-2-3-4\" data-name=\"recovery card verdict badge\">Green light for intervals</p>\n</div>\n</section>\n<!-- Signals + Recovery (one pinned scene) -->\n<section aria-label=\"Signals and Recovery\" class=\"mt-16 px-4\" data-kid=\"2-3\" data-name=\"signals and recovery section\">\n<div class=\"signals-stage relative\" data-kid=\"2-3-1\" data-name=\"pinned scene stage\">\n<!-- Collage -->\n<div class=\"collage-panel relative h-[784px] overflow-hidden rounded-[28px] border border-[#EFEAE6] bg-white\" data-kid=\"2-3-1-1\" data-name=\"signals collage panel\">\n<figure class=\"cl-item absolute left-[72px] top-[96px] h-[180px] w-[260px]\" data-fx=\"-240\" data-fy=\"-150\" data-kid=\"2-3-1-1-1\" data-name=\"collage photo of runner\">\n<img alt=\"Runner checking his Aero Fit Ultra\" class=\"size-full rounded-[20px] object-cover\" data-kid=\"2-3-1-1-1-1\" data-name=\"collage runner photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/e8e9b52b3aa4462b8d6ad53cd59b2ef3.jpg\"/>\n</figure>\n<figure class=\"cl-item absolute left-[160px] top-[318px] h-[290px] w-[220px]\" data-fx=\"-280\" data-fy=\"110\" data-kid=\"2-3-1-1-2\" data-name=\"collage photo of headphone band\">\n<img alt=\"Runner in headphones wearing Aero Fit Music\" class=\"size-full rounded-[20px] object-cover\" data-kid=\"2-3-1-1-2-1\" data-name=\"collage headphone band photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/07bb0b4b98b3472387094f62ed418e87.jpg\"/>\n<figcaption class=\"brk f-mono absolute -right-[118px] top-8 bg-[#FAF8F6] px-3 py-2 text-[13px] uppercase tracking-[0.04em]\" data-kid=\"2-3-1-1-2-2\" data-name=\"HRV tag on collage\"><span class=\"text-[#6B4F57]\" data-kid=\"2-3-1-1-2-2-1\" data-name=\"HRV tag value\">[64 ms]</span> HRV</figcaption>\n</figure>\n<figure class=\"cl-item absolute right-[330px] top-[48px] h-[200px] w-[200px] overflow-hidden rounded-[20px] bg-[radial-gradient(circle,#F8F38A_0%,#FBF4B8_42%,#F4F1EE_78%)]\" data-fx=\"120\" data-fy=\"-230\" data-kid=\"2-3-1-1-3\" data-name=\"collage product image card\">\n<img alt=\"Aero Fit Pro\" class=\"size-full object-contain mix-blend-multiply brightness-110 contrast-105\" data-kid=\"2-3-1-1-3-1\" data-name=\"collage product image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg\"/>\n</figure>\n<figure class=\"cl-item absolute right-[64px] top-[190px] h-[170px] w-[250px]\" data-fx=\"280\" data-fy=\"-60\" data-kid=\"2-3-1-1-4\" data-name=\"collage product photo\">\n<img alt=\"Aero Fit Smart on a stone block\" class=\"size-full rounded-[20px] object-cover\" data-kid=\"2-3-1-1-4-1\" data-name=\"collage stone block product photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/7a47796ecb4f4ff7a78dc7db5db4e0e9.jpg\"/>\n</figure>\n<figure class=\"cl-item absolute bottom-[72px] right-[120px] h-[200px] w-[290px]\" data-fx=\"250\" data-fy=\"190\" data-kid=\"2-3-1-1-5\" data-name=\"collage product photo with tag\">\n<img alt=\"Aero Fit Ultra on a mossy summit rock\" class=\"size-full rounded-[20px] object-cover\" data-kid=\"2-3-1-1-5-1\" data-name=\"collage mossy summit product photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/1554a09252854047951ad166e87cafc5.jpg\"/>\n<figcaption class=\"brk f-mono absolute -top-[46px] left-0 bg-[#FAF8F6] px-3 py-2 text-[13px] uppercase tracking-[0.04em]\" data-kid=\"2-3-1-1-5-2\" data-name=\"resting HR tag on collage\"><span class=\"text-[#6B4F57]\" data-kid=\"2-3-1-1-5-2-1\" data-name=\"resting HR tag value\">[52 bpm]</span> Resting HR</figcaption>\n</figure>\n<figure class=\"cl-item absolute bottom-[48px] left-[470px] h-[130px] w-[190px]\" data-fx=\"-60\" data-fy=\"240\" data-kid=\"2-3-1-1-6\" data-name=\"collage product photo\">\n<img alt=\"Aero Fit Lite on morning linen\" class=\"size-full rounded-[20px] object-cover\" data-kid=\"2-3-1-1-6-1\" data-name=\"collage linen product photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/3543f8cd7d9d41538a82a53b258a38b1.jpg\"/>\n</figure>\n<div class=\"cl-copy absolute left-1/2 top-[276px] w-[560px] -translate-x-1/2 text-center\" data-kid=\"2-3-1-1-7\" data-name=\"collage centered copy\">\n<h2 class=\"f-serif text-[46px] font-medium leading-[1.08] tracking-[-0.01em]\" data-kid=\"2-3-1-1-7-1\" data-name=\"collage headline\">Built on what your body already tells you.</h2>\n<p class=\"mx-auto mt-5 max-w-[400px] text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-3-1-1-7-2\" data-name=\"collage subtext\">Heart rate, HRV, skin temperature and movement, read every few seconds, day and night.</p>\n<a class=\"mt-7 inline-flex h-11 items-center rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-3-1-1-7-3\" data-name=\"see-scores CTA button\" href=\"#scores\">See the four scores</a>\n</div>\n</div>\n<!-- Recovery -->\n<div class=\"recovery-panel relative mt-4 h-[784px] overflow-hidden rounded-[28px] bg-[#F3EDE9]\" data-kid=\"2-3-1-2\" data-name=\"recovery panel\">\n<h2 class=\"absolute left-14 top-14 max-w-[520px] f-serif text-[46px] font-medium leading-[1.08] tracking-[-0.01em]\" data-kid=\"2-3-1-2-1\" data-name=\"recovery headline\">One call before your feet hit the floor.</h2>\n<div class=\"absolute inset-x-0 top-[172px] flex items-center justify-center gap-14\" data-kid=\"2-3-1-2-2\" data-name=\"recovery hero row\">\n<p class=\"w-[150px] text-right text-[14px] font-medium uppercase tracking-[0.08em] text-[#6B4F57]\" data-kid=\"2-3-1-2-2-1\" data-name=\"recovery hero label: This morning\">This morning</p>\n<p aria-label=\"Recovery 82%\" class=\"text-[200px] font-medium leading-none tracking-[-0.05em] tabular-nums\" data-kid=\"2-3-1-2-2-2\" data-name=\"recovery hero big number\"><span class=\"rc-num\" data-dynamic=\"true\" data-kid=\"2-3-1-2-2-2-1\" data-name=\"recovery number value\" data-reason=\"text replaced every frame by gsap count-up during pinned scroll\">82</span><span class=\"text-[88px] tracking-normal text-[#6B4F57]\" data-kid=\"2-3-1-2-2-2-2\" data-name=\"recovery hero percent sign\">%</span></p>\n<p class=\"w-[150px] text-[14px] font-medium uppercase tracking-[0.08em] text-[#6B4F57]\" data-kid=\"2-3-1-2-2-3\" data-name=\"recovery hero label: Recovery\">Recovery</p>\n</div>\n<div class=\"absolute bottom-0 left-[calc(50%-400px)] h-[400px] w-[800px]\" data-kid=\"2-3-1-2-3\" data-name=\"recovery arc gauge container\">\n<svg aria-hidden=\"true\" class=\"absolute inset-0 size-full\" data-kid=\"2-3-1-2-3-1\" data-name=\"recovery arc gauge\" fill=\"none\" viewbox=\"0 0 800 400\">\n<path d=\"M 20 400 A 380 380 0 0 1 780 400\" pathlength=\"100\" stroke=\"#2A0B14\" stroke-opacity=\"0.12\" stroke-width=\"2\"></path>\n<path class=\"rc-arc\" d=\"M 20 400 A 380 380 0 0 1 780 400\" pathlength=\"100\" stroke=\"#2A0B14\" stroke-dasharray=\"100\" stroke-dashoffset=\"18\" stroke-linecap=\"round\" stroke-width=\"3\"></path>\n</svg>\n<span class=\"absolute bottom-3 left-0 text-[12px] text-[#6B4F57]\" data-kid=\"2-3-1-2-3-2\" data-name=\"recovery gauge lower bound label\">0</span>\n<span class=\"absolute bottom-3 right-0 text-[12px] text-[#6B4F57]\" data-kid=\"2-3-1-2-3-3\" data-name=\"recovery gauge upper bound label\">100</span>\n<div class=\"absolute bottom-[-24px] left-[235px] w-[330px]\" data-kid=\"2-3-1-2-3-4\" data-name=\"recovery gauge device container\">\n<img alt=\"Aero Fit Smart\" class=\"rc-device w-full mix-blend-multiply brightness-105 contrast-105\" data-kid=\"2-3-1-2-3-4-1\" data-name=\"recovery device photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\"/>\n</div>\n</div>\n<ul class=\"absolute bottom-14 left-14 w-[260px] divide-y divide-[#2A0B14]/10 border-y border-[#2A0B14]/10\" data-kid=\"2-3-1-2-4\" data-name=\"recovery metrics list\">\n<li class=\"rc-row flex h-14 items-center justify-between\" data-kid=\"2-3-1-2-4-1\" data-name=\"sleep metric row\"><span class=\"flex items-center gap-3 text-[14px] text-[#4A2A33]\" data-kid=\"2-3-1-2-4-1-1\" data-name=\"sleep metric label group\"><i class=\"ti ti-moon-stars text-[18px]\" data-kid=\"2-3-1-2-4-1-1-1\" data-name=\"moon-stars icon\"></i>Sleep</span><span class=\"text-[18px] font-semibold tabular-nums\" data-kid=\"2-3-1-2-4-1-2\" data-name=\"sleep metric value\">7h 42m</span></li>\n<li class=\"rc-row flex h-14 items-center justify-between\" data-kid=\"2-3-1-2-4-2\" data-name=\"HRV metric row\"><span class=\"flex items-center gap-3 text-[14px] text-[#4A2A33]\" data-kid=\"2-3-1-2-4-2-1\" data-name=\"HRV metric label group\"><i class=\"ti ti-wave-sine text-[18px]\" data-kid=\"2-3-1-2-4-2-1-1\" data-name=\"wave-sine icon\"></i>HRV</span><span class=\"text-[18px] font-semibold tabular-nums\" data-kid=\"2-3-1-2-4-2-2\" data-name=\"HRV metric value\">64 ms</span></li>\n<li class=\"rc-row flex h-14 items-center justify-between\" data-kid=\"2-3-1-2-4-3\" data-name=\"resting HR metric row\"><span class=\"flex items-center gap-3 text-[14px] text-[#4A2A33]\" data-kid=\"2-3-1-2-4-3-1\" data-name=\"resting HR metric label group\"><i class=\"ti ti-heartbeat text-[18px]\" data-kid=\"2-3-1-2-4-3-1-1\" data-name=\"heartbeat icon\"></i>Resting HR</span><span class=\"text-[18px] font-semibold tabular-nums\" data-kid=\"2-3-1-2-4-3-2\" data-name=\"resting HR metric value\">52 bpm</span></li>\n</ul>\n<div class=\"rc-verdict absolute bottom-14 right-14 flex flex-col items-end gap-3\" data-kid=\"2-3-1-2-5\" data-name=\"recovery verdict group\">\n<span class=\"rounded-full border border-[#D9D0CB] px-2.5 py-0.5 text-[12px] text-[#6B4F57]\" data-kid=\"2-3-1-2-5-1\" data-name=\"example badge\">Example</span>\n<p class=\"rounded-full bg-[#F8F38A] px-4 py-2 text-[15px] font-medium\" data-kid=\"2-3-1-2-5-2\" data-name=\"recovery verdict badge\">Green light for intervals</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Four scores -->\n<section class=\"mx-4 mt-24 overflow-hidden rounded-[28px] bg-[#2A0B14] py-24 text-[#FAF8F6]\" data-kid=\"2-4\" data-name=\"four scores section\" id=\"scores\">\n<h2 class=\"text-center f-serif text-[46px] font-medium leading-[1.08] tracking-[-0.01em]\" data-kid=\"2-4-1\" data-name=\"scores section headline\">A band that understands your body</h2>\n<div aria-label=\"Scores\" class=\"mt-10 flex justify-center gap-2\" data-kid=\"2-4-2\" data-name=\"score tabs list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"sc-tab h-10 rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white ring-1 ring-white/60\" data-i=\"0\" data-kid=\"2-4-2-1\" data-name=\"Sleep Performance tab\" role=\"tab\">Sleep Performance</button>\n<button aria-selected=\"false\" class=\"sc-tab h-10 rounded-full bg-[#F3EDE9] px-5 text-[14px] font-medium text-[#2A0B14] transition hover:bg-white\" data-i=\"1\" data-kid=\"2-4-2-2\" data-name=\"Recovery tab\" role=\"tab\">Recovery</button>\n<button aria-selected=\"false\" class=\"sc-tab h-10 rounded-full bg-[#F3EDE9] px-5 text-[14px] font-medium text-[#2A0B14] transition hover:bg-white\" data-i=\"2\" data-kid=\"2-4-2-3\" data-name=\"Strain tab\" role=\"tab\">Strain</button>\n<button aria-selected=\"false\" class=\"sc-tab h-10 rounded-full bg-[#F3EDE9] px-5 text-[14px] font-medium text-[#2A0B14] transition hover:bg-white\" data-i=\"3\" data-kid=\"2-4-2-4\" data-name=\"Heart health tab\" role=\"tab\">Heart health</button>\n</div>\n<div class=\"sc-view mt-12\" data-kid=\"2-4-3\" data-name=\"score view container\">\n<div class=\"sc-track flex gap-6 pl-[224px]\" data-kid=\"2-4-3-1\" data-name=\"score slide track\">\n<!-- Sleep -->\n<article class=\"sc-slide w-[960px] shrink-0\" data-kid=\"2-4-3-1-1\" data-name=\"sleep performance slide\">\n<div class=\"relative h-[480px] overflow-hidden rounded-[24px]\" data-kid=\"2-4-3-1-1-1\" data-name=\"sleep slide media\">\n<img alt=\"Woman resting with her Aero Fit Lite\" class=\"size-full object-cover object-[75%_center]\" data-kid=\"2-4-3-1-1-1-1\" data-name=\"sleep slide background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/989e11cd96844ee89265373e9d45e84c.jpg\"/>\n<div class=\"absolute bottom-6 left-6 w-[300px] rounded-[22px] bg-[#FAF8F6]/90 p-6 text-[#2A0B14] backdrop-blur-md\" data-kid=\"2-4-3-1-1-1-2\" data-name=\"sleep slide score card\">\n<p class=\"text-[13px] text-[#6B4F57]\" data-kid=\"2-4-3-1-1-1-2-1\" data-name=\"sleep score card label\">Sleep Performance</p>\n<p class=\"mt-1 text-[40px] font-semibold leading-none tabular-nums\" data-kid=\"2-4-3-1-1-1-2-2\" data-name=\"sleep score value\">86<span class=\"text-[20px] font-medium text-[#6B4F57]\" data-kid=\"2-4-3-1-1-1-2-2-1\" data-name=\"sleep score percent sign\">%</span></p>\n<div class=\"mt-5 flex h-12 items-end gap-1.5\" data-kid=\"2-4-3-1-1-1-2-3\" data-name=\"sleep score sparkline chart\">\n<span class=\"w-full rounded-full bg-[#2A0B14]/15\" data-kid=\"2-4-3-1-1-1-2-3-1\" data-name=\"sparkline bar (low)\" style=\"height:40%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-1-1-2-3-2\" data-name=\"sparkline bar\" style=\"height:70%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-1-1-2-3-3\" data-name=\"sparkline bar (high)\" style=\"height:90%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]/15\" data-kid=\"2-4-3-1-1-1-2-3-4\" data-name=\"sparkline bar (low)\" style=\"height:55%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-1-1-2-3-5\" data-name=\"sparkline bar\" style=\"height:80%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]/15\" data-kid=\"2-4-3-1-1-1-2-3-6\" data-name=\"sparkline bar (low)\" style=\"height:35%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-1-1-2-3-7\" data-name=\"sparkline bar\" style=\"height:65%\"></span><span class=\"w-full rounded-full bg-[#F8F38A] ring-1 ring-[#2A0B14]/40\" data-kid=\"2-4-3-1-1-1-2-3-8\" data-name=\"sparkline bar (highlighted)\" style=\"height:95%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]/15\" data-kid=\"2-4-3-1-1-1-2-3-9\" data-name=\"sparkline bar (low)\" style=\"height:50%\"></span><span class=\"w-full rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-1-1-2-3-10\" data-name=\"sparkline bar\" style=\"height:75%\"></span>\n</div>\n</div>\n</div>\n<div class=\"mt-6 flex items-center justify-between gap-10\" data-kid=\"2-4-3-1-1-2\" data-name=\"sleep slide footer\">\n<h3 class=\"flex items-center gap-3 f-serif text-[28px] font-medium\" data-kid=\"2-4-3-1-1-2-1\" data-name=\"sleep slide title row\"><span class=\"grid size-10 place-items-center rounded-full bg-[#F8F38A] text-[#2A0B14]\" data-kid=\"2-4-3-1-1-2-1-1\" data-name=\"sleep title icon badge\"><i class=\"ti ti-moon-stars text-[20px]\" data-kid=\"2-4-3-1-1-2-1-1-1\" data-name=\"moon-stars icon in badge\"></i></span>Sleep Performance</h3>\n<p class=\"max-w-[420px] text-[15px] leading-[1.55] text-[#FAF8F6]/80\" data-kid=\"2-4-3-1-1-2-2\" data-name=\"sleep slide description\">Built from sleep stages, skin temperature and breathing rate.</p>\n</div>\n</article>\n<!-- Recovery -->\n<article class=\"sc-slide w-[960px] shrink-0 opacity-35\" data-kid=\"2-4-3-1-2\" data-name=\"recovery score slide\">\n<div class=\"relative h-[480px] overflow-hidden rounded-[24px]\" data-kid=\"2-4-3-1-2-1\" data-name=\"recovery slide media\">\n<img alt=\"Woman with morning coffee wearing her Aero Fit Smart\" class=\"size-full object-cover object-[75%_center]\" data-kid=\"2-4-3-1-2-1-1\" data-name=\"recovery slide background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/87d408f175064ec88d083cb4a3861585.jpg\"/>\n<div class=\"absolute bottom-6 left-6 w-[300px] rounded-[22px] bg-[#FAF8F6]/90 p-6 text-[#2A0B14] backdrop-blur-md\" data-kid=\"2-4-3-1-2-1-2\" data-name=\"recovery slide score card\">\n<p class=\"text-[13px] text-[#6B4F57]\" data-kid=\"2-4-3-1-2-1-2-1\" data-name=\"recovery score card label\">Recovery</p>\n<p class=\"mt-1 text-[40px] font-semibold leading-none tabular-nums\" data-kid=\"2-4-3-1-2-1-2-2\" data-name=\"recovery score value\">82<span class=\"text-[20px] font-medium text-[#6B4F57]\" data-kid=\"2-4-3-1-2-1-2-2-1\" data-name=\"recovery score percent sign\">%</span></p>\n<div class=\"mt-5 h-2 rounded-full bg-[#2A0B14]/12\" data-kid=\"2-4-3-1-2-1-2-3\" data-name=\"recovery score progress track\"><div class=\"h-full w-[82%] rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-2-1-2-3-1\" data-name=\"recovery score progress fill\"></div></div>\n<p class=\"mt-4 inline-flex rounded-full bg-[#F8F38A] px-3 py-1 text-[13px] font-medium\" data-kid=\"2-4-3-1-2-1-2-4\" data-name=\"recovery score verdict badge\">Ready to push</p>\n</div>\n</div>\n<div class=\"mt-6 flex items-center justify-between gap-10\" data-kid=\"2-4-3-1-2-2\" data-name=\"recovery slide footer\">\n<h3 class=\"flex items-center gap-3 f-serif text-[28px] font-medium\" data-kid=\"2-4-3-1-2-2-1\" data-name=\"recovery slide title row\"><span class=\"grid size-10 place-items-center rounded-full bg-[#F8F38A] text-[#2A0B14]\" data-kid=\"2-4-3-1-2-2-1-1\" data-name=\"recovery title icon badge\"><i class=\"ti ti-bolt text-[20px]\" data-kid=\"2-4-3-1-2-2-1-1-1\" data-name=\"bolt icon in badge\"></i></span>Recovery</h3>\n<p class=\"max-w-[420px] text-[15px] leading-[1.55] text-[#FAF8F6]/80\" data-kid=\"2-4-3-1-2-2-2\" data-name=\"recovery slide description\">Built from heart rate variability, resting heart rate and sleep.</p>\n</div>\n</article>\n<!-- Strain -->\n<article class=\"sc-slide w-[960px] shrink-0 opacity-35\" data-kid=\"2-4-3-1-3\" data-name=\"strain score slide\">\n<div class=\"relative h-[480px] overflow-hidden rounded-[24px]\" data-kid=\"2-4-3-1-3-1\" data-name=\"strain slide media\">\n<img alt=\"Runner wearing Aero Fit Pro in the blocks on a track\" class=\"size-full object-cover object-[center_40%]\" data-kid=\"2-4-3-1-3-1-1\" data-name=\"strain slide background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/356b3e3c8d704bf4887b81203fda5357.jpg\"/>\n<div class=\"absolute bottom-6 left-6 w-[300px] rounded-[22px] bg-[#FAF8F6]/90 p-6 text-[#2A0B14] backdrop-blur-md\" data-kid=\"2-4-3-1-3-1-2\" data-name=\"strain score card\">\n<p class=\"text-[13px] text-[#6B4F57]\" data-kid=\"2-4-3-1-3-1-2-1\" data-name=\"strain score card label\">Strain</p>\n<p class=\"mt-1 text-[40px] font-semibold leading-none tabular-nums\" data-kid=\"2-4-3-1-3-1-2-2\" data-name=\"strain score value\">14.2<span class=\"text-[20px] font-medium text-[#6B4F57]\" data-kid=\"2-4-3-1-3-1-2-2-1\" data-name=\"strain score unit\"> / 21</span></p>\n<div class=\"mt-5 grid grid-cols-5 gap-1.5\" data-kid=\"2-4-3-1-3-1-2-3\" data-name=\"strain week progress segments\">\n<span class=\"h-2 rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-3-1-2-3-1\" data-name=\"weekday segment (active)\"></span><span class=\"h-2 rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-3-1-2-3-2\" data-name=\"weekday segment (active)\"></span><span class=\"h-2 rounded-full bg-[#2A0B14]\" data-kid=\"2-4-3-1-3-1-2-3-3\" data-name=\"weekday segment (active)\"></span><span class=\"h-2 rounded-full bg-[#F8F38A] ring-1 ring-[#2A0B14]/40\" data-kid=\"2-4-3-1-3-1-2-3-4\" data-name=\"weekday segment (today)\"></span><span class=\"h-2 rounded-full bg-[#2A0B14]/15\" data-kid=\"2-4-3-1-3-1-2-3-5\" data-name=\"weekday segment (off)\"></span>\n</div>\n<p class=\"mt-4 text-[13px] text-[#4A2A33]\" data-kid=\"2-4-3-1-3-1-2-4\" data-name=\"strain target hint\">Target today: 13–15</p>\n</div>\n</div>\n<div class=\"mt-6 flex items-center justify-between gap-10\" data-kid=\"2-4-3-1-3-2\" data-name=\"strain slide footer\">\n<h3 class=\"flex items-center gap-3 f-serif text-[28px] font-medium\" data-kid=\"2-4-3-1-3-2-1\" data-name=\"strain title row\"><span class=\"grid size-10 place-items-center rounded-full bg-[#F8F38A] text-[#2A0B14]\" data-kid=\"2-4-3-1-3-2-1-1\" data-name=\"strain title icon badge\"><i class=\"ti ti-flame text-[20px]\" data-kid=\"2-4-3-1-3-2-1-1-1\" data-name=\"flame icon in badge\"></i></span>Strain</h3>\n<p class=\"max-w-[420px] text-[15px] leading-[1.55] text-[#FAF8F6]/80\" data-kid=\"2-4-3-1-3-2-2\" data-name=\"strain slide description\">Built from heart rate zones, workout types and steps.</p>\n</div>\n</article>\n<!-- Heart -->\n<article class=\"sc-slide w-[960px] shrink-0 opacity-35\" data-kid=\"2-4-3-1-4\" data-name=\"heart health score slide\">\n<div class=\"relative h-[480px] overflow-hidden rounded-[24px]\" data-kid=\"2-4-3-1-4-1\" data-name=\"heart slide media\">\n<img alt=\"Athlete checking her pulse on her Aero Fit Pro\" class=\"size-full object-cover object-[70%_center]\" data-kid=\"2-4-3-1-4-1-1\" data-name=\"heart slide background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/b676a18a466145849599dd16012925dc.jpg\"/>\n<div class=\"absolute bottom-6 left-6 w-[300px] rounded-[22px] bg-[#FAF8F6]/90 p-6 text-[#2A0B14] backdrop-blur-md\" data-kid=\"2-4-3-1-4-1-2\" data-name=\"heart score card\">\n<p class=\"text-[13px] text-[#6B4F57]\" data-kid=\"2-4-3-1-4-1-2-1\" data-name=\"heart score label\">Resting heart rate</p>\n<p class=\"mt-1 text-[40px] font-semibold leading-none tabular-nums\" data-kid=\"2-4-3-1-4-1-2-2\" data-name=\"heart rate score value\">52<span class=\"text-[20px] font-medium text-[#6B4F57]\" data-kid=\"2-4-3-1-4-1-2-2-1\" data-name=\"heart rate unit\"> bpm</span></p>\n<svg aria-hidden=\"true\" class=\"mt-5 h-10 w-full\" data-kid=\"2-4-3-1-4-1-2-3\" data-name=\"heart rate sparkline\" fill=\"none\" viewbox=\"0 0 200 40\"><polyline points=\"0,28 20,26 40,30 60,22 80,24 100,18 120,20 140,14 160,16 180,12 200,13\" stroke=\"#2A0B14\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></polyline></svg>\n</div>\n</div>\n<div class=\"mt-6 flex items-center justify-between gap-10\" data-kid=\"2-4-3-1-4-2\" data-name=\"heart slide footer\">\n<h3 class=\"flex items-center gap-3 f-serif text-[28px] font-medium\" data-kid=\"2-4-3-1-4-2-1\" data-name=\"heart title row\"><span class=\"grid size-10 place-items-center rounded-full bg-[#F8F38A] text-[#2A0B14]\" data-kid=\"2-4-3-1-4-2-1-1\" data-name=\"heart title icon badge\"><i class=\"ti ti-heartbeat text-[20px]\" data-kid=\"2-4-3-1-4-2-1-1-1\" data-name=\"heartbeat icon in badge\"></i></span>Heart health</h3>\n<p class=\"max-w-[420px] text-[15px] leading-[1.55] text-[#FAF8F6]/80\" data-kid=\"2-4-3-1-4-2-2\" data-name=\"heart slide description\">Built from resting HR, ECG and blood pressure.</p>\n</div>\n</article>\n</div>\n</div>\n<div class=\"mt-12 flex items-center justify-center gap-6\" data-kid=\"2-4-4\" data-name=\"score carousel controls\">\n<button aria-label=\"Previous score\" class=\"sc-prev grid size-11 place-items-center rounded-full bg-white text-[#2A0B14] transition hover:bg-[#F3EFEC]\" data-kid=\"2-4-4-1\" data-name=\"previous score arrow button\"><i class=\"ti ti-arrow-left text-[18px]\" data-kid=\"2-4-4-1-1\" data-name=\"left arrow icon\"></i></button>\n<div class=\"flex items-center gap-2\" data-kid=\"2-4-4-2\" data-name=\"score carousel dot group\">\n<button aria-label=\"Sleep Performance\" class=\"sc-dot h-2 w-8 rounded-full bg-white transition-all\" data-i=\"0\" data-kid=\"2-4-4-2-1\" data-name=\"sleep score dot\"></button>\n<button aria-label=\"Recovery\" class=\"sc-dot h-2 w-2 rounded-full bg-white/35 transition-all\" data-i=\"1\" data-kid=\"2-4-4-2-2\" data-name=\"recovery score dot\"></button>\n<button aria-label=\"Strain\" class=\"sc-dot h-2 w-2 rounded-full bg-white/35 transition-all\" data-i=\"2\" data-kid=\"2-4-4-2-3\" data-name=\"strain score dot\"></button>\n<button aria-label=\"Heart health\" class=\"sc-dot h-2 w-2 rounded-full bg-white/35 transition-all\" data-i=\"3\" data-kid=\"2-4-4-2-4\" data-name=\"heart health score dot\"></button>\n</div>\n<button aria-label=\"Next score\" class=\"sc-next grid size-11 place-items-center rounded-full bg-white text-[#2A0B14] transition hover:bg-[#F3EFEC]\" data-kid=\"2-4-4-3\" data-name=\"next score arrow button\"><i class=\"ti ti-arrow-right text-[18px]\" data-kid=\"2-4-4-3-1\" data-name=\"right arrow icon\"></i></button>\n</div>\n</section>\n<!-- A day with Aero Fit -->\n<section class=\"day-sec mx-auto mt-28 max-w-[1248px]\" data-kid=\"2-5\" data-name=\"a-day-with-aero-fit section\">\n<h2 class=\"max-w-[820px] f-serif text-[46px] font-medium leading-[1.08] tracking-[-0.01em]\" data-kid=\"2-5-1\" data-name=\"a-day section headline\">Wear and forget it. Aero Fit only speaks up when there is something to act on.</h2>\n<div class=\"relative mt-16 flex flex-col gap-14\" data-kid=\"2-5-2\" data-name=\"day timeline container\">\n<span aria-hidden=\"true\" class=\"absolute bottom-3 left-[7px] top-3 w-px bg-[#E3DDDA]\" data-kid=\"2-5-2-1\" data-name=\"day timeline vertical rail\"></span>\n<div class=\"day-row grid grid-cols-[360px_800px] gap-x-[88px]\" data-kid=\"2-5-2-2\" data-name=\"day row: Wake to a plan\">\n<div class=\"relative pl-10 pt-1\" data-kid=\"2-5-2-2-1\" data-name=\"day row text column\">\n<span class=\"dot absolute left-0 top-[9px] size-[15px] rounded-full border-2 border-[#2A0B14] bg-[#2A0B14] transition-colors duration-300\" data-kid=\"2-5-2-2-1-1\" data-name=\"day timeline node dot\"></span>\n<h3 class=\"f-serif text-[24px] font-medium leading-[1.15]\" data-kid=\"2-5-2-2-1-2\" data-name=\"day row title\">Wake to a plan</h3>\n<p class=\"mt-3 max-w-[300px] text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-5-2-2-1-3\" data-name=\"day row description\">Your Recovery score is waiting, with a strain target sized to how well you slept.</p>\n</div>\n<img alt=\"Woman checking her morning Recovery score in bed\" class=\"h-[420px] w-full rounded-[24px] object-cover\" data-kid=\"2-5-2-2-2\" data-name=\"morning recovery photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/2dabe16266d04995a3144d175002d70b.jpg\"/>\n</div>\n<div class=\"day-row grid grid-cols-[360px_800px] gap-x-[88px]\" data-kid=\"2-5-2-3\" data-name=\"day row: Steady through the day\">\n<div class=\"relative pl-10 pt-1\" data-kid=\"2-5-2-3-1\" data-name=\"day row text column\">\n<span class=\"dot absolute left-0 top-[9px] size-[15px] rounded-full border-2 border-[#2A0B14] bg-[#2A0B14] transition-colors duration-300\" data-kid=\"2-5-2-3-1-1\" data-name=\"day timeline node dot\"></span>\n<h3 class=\"f-serif text-[24px] font-medium leading-[1.15]\" data-kid=\"2-5-2-3-1-2\" data-name=\"day row title\">Steady through the day</h3>\n<p class=\"mt-3 max-w-[300px] text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-5-2-3-1-3\" data-name=\"day row description\">Strain builds quietly in the background. A nudge arrives if you have been still too long.</p>\n</div>\n<img alt=\"Man stretching away from his desk at midday\" class=\"h-[300px] w-full rounded-[24px] object-cover\" data-kid=\"2-5-2-3-2\" data-name=\"desk stretching photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/86a131a0d4bc45ed8390ea519e3dfb4e.jpg\"/>\n</div>\n<div class=\"day-row grid grid-cols-[360px_800px] gap-x-[88px]\" data-kid=\"2-5-2-4\" data-name=\"day row: Train with feedback\">\n<div class=\"relative pl-10 pt-1\" data-kid=\"2-5-2-4-1\" data-name=\"day row text column\">\n<span class=\"dot absolute left-0 top-[9px] size-[15px] rounded-full border-2 border-[#2A0B14] bg-[#2A0B14] transition-colors duration-300\" data-kid=\"2-5-2-4-1-1\" data-name=\"day timeline node dot\"></span>\n<h3 class=\"f-serif text-[24px] font-medium leading-[1.15]\" data-kid=\"2-5-2-4-1-2\" data-name=\"day row title\">Train with feedback</h3>\n<p class=\"mt-3 max-w-[300px] text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-5-2-4-1-3\" data-name=\"day row description\">Live heart rate zones and GPS on your wrist, then a breakdown of what the session cost you.</p>\n</div>\n<div class=\"relative h-[540px] overflow-hidden rounded-[24px]\" data-kid=\"2-5-2-4-2\" data-name=\"run photo media container\">\n<img alt=\"Runner checking her watch on an evening coastal run\" class=\"size-full object-cover object-[50%_50%]\" data-kid=\"2-5-2-4-2-1\" data-name=\"evening run background photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/6c37160e3d2e460fbd5f3cd60e3cf18e.jpg\"/>\n<div class=\"day-lens absolute left-[347px] top-[230px] size-[168px]\" data-kid=\"2-5-2-4-2-2\" data-name=\"run watch magnifier lens\">\n<div class=\"absolute -inset-[16px] rounded-full border border-dashed border-white/70\" data-kid=\"2-5-2-4-2-2-1\" data-name=\"lens dashed circle\"></div>\n<div class=\"relative size-full overflow-hidden rounded-full border-[1.5px] border-white shadow-[0_14px_36px_rgba(42,11,20,0.25)]\" data-kid=\"2-5-2-4-2-2-2\" data-name=\"lens circular image\">\n<img alt=\"\" class=\"absolute max-w-none\" data-kid=\"2-5-2-4-2-2-2-1\" data-name=\"clipped zoom of watch photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/6c37160e3d2e460fbd5f3cd60e3cf18e.jpg\" style=\"width:1600px;height:1200px;left:-778px;top:-603px\"/>\n</div>\n</div>\n<div class=\"brk f-mono absolute left-[548px] top-[214px] bg-[#FAF8F6]/85 px-3 py-2 text-[13px] uppercase tracking-[0.04em] backdrop-blur-sm\" data-kid=\"2-5-2-4-2-3\" data-name=\"Heart rate zones HUD tag\">Heart rate zones</div>\n<div class=\"brk f-mono absolute left-[548px] top-[268px] bg-[#FAF8F6]/85 px-3 py-2 text-[13px] uppercase tracking-[0.04em] backdrop-blur-sm\" data-kid=\"2-5-2-4-2-4\" data-name=\"GPS route HUD tag\">GPS route</div>\n</div>\n</div>\n<div class=\"day-row grid grid-cols-[360px_800px] gap-x-[88px]\" data-kid=\"2-5-2-5\" data-name=\"day row: Wind down on time\">\n<div class=\"relative pl-10 pt-1\" data-kid=\"2-5-2-5-1\" data-name=\"day row text column\">\n<span class=\"dot absolute left-0 top-[9px] size-[15px] rounded-full border-2 border-[#2A0B14] bg-[#2A0B14] transition-colors duration-300\" data-kid=\"2-5-2-5-1-1\" data-name=\"day timeline node dot\"></span>\n<h3 class=\"f-serif text-[24px] font-medium leading-[1.15]\" data-kid=\"2-5-2-5-1-2\" data-name=\"day row title\">Wind down on time</h3>\n<p class=\"mt-3 max-w-[300px] text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-5-2-5-1-3\" data-name=\"day row description\">A bedtime suggestion based on tomorrow’s plan, so your sleep matches the day ahead.</p>\n</div>\n<div class=\"relative h-[440px] overflow-hidden rounded-[24px] bg-[#F4F1EE]\" data-kid=\"2-5-2-5-2\" data-name=\"bedtime video media container\">\n<video aria-label=\"Woman reading in bed before sleep, video by cottonbro studio on Pexels\" autoplay=\"\" class=\"day-video size-full object-cover\" data-kid=\"2-5-2-5-2-1\" data-name=\"bedtime video player\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/6863739/african-alone-bed-bed-linen-6863739.jpeg?auto=compress&amp;cs=tinysrgb&amp;fit=crop&amp;h=630&amp;w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/6863739/6863739-hd_2048_1080_25fps.mp4\"></video>\n<button aria-label=\"Pause video\" class=\"day-pause absolute right-5 top-5 grid size-10 place-items-center rounded-full bg-[#FAF8F6]/90 text-[#2A0B14] backdrop-blur-sm transition hover:bg-white\" data-kid=\"2-5-2-5-2-2\" data-name=\"video pause button\"><i class=\"ti ti-player-pause text-[16px]\" data-kid=\"2-5-2-5-2-2-1\" data-name=\"pause icon\"></i></button>\n<img alt=\"Man reading in bed under a warm lamp before sleep\" class=\"absolute bottom-6 right-6 h-[220px] w-[190px] rounded-[16px] border-4 border-[#FAF8F6] object-cover shadow-[0_14px_36px_rgba(42,11,20,0.16)]\" data-kid=\"2-5-2-5-2-3\" data-name=\"reading-in-bed inset photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/3c387915ade44e58919ec9a131736683.jpg\"/>\n</div>\n</div>\n</div>\n</section>\n<!-- Bands -->\n<section class=\"mt-28\" data-kid=\"2-6\" data-name=\"bands section\" id=\"bands\">\n<div class=\"mx-auto flex max-w-[1248px] items-end justify-between\" data-kid=\"2-6-1\" data-name=\"bands section header\">\n<h2 class=\"f-serif text-[46px] font-medium leading-[1.08] tracking-[-0.01em]\" data-kid=\"2-6-1-1\" data-name=\"bands section headline\">Pick the band that fits your needs.</h2>\n<a class=\"flex items-center gap-2 pb-2 text-[14px] font-medium underline underline-offset-4 transition hover:opacity-70\" data-kid=\"2-6-1-2\" data-name=\"compare-all-bands link\" href=\"#\">Compare all five bands<i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"2-6-1-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<!-- Lite -->\n<article class=\"band mx-4 mt-10 rounded-[28px] bg-[#F3EDE9] px-[80px] pb-[80px] pt-[72px]\" data-kid=\"2-6-2\" data-name=\"aero fit lite band card\">\n<div class=\"mx-auto max-w-[1248px]\" data-kid=\"2-6-2-1\" data-name=\"band card content\">\n<h3 class=\"f-serif text-[46px] font-medium leading-[1.08]\" data-kid=\"2-6-2-1-1\" data-name=\"band card title\">Aero Fit Lite</h3>\n<p class=\"mt-2 f-serif text-[28px] leading-[1.2] text-[#6B4F57]\" data-kid=\"2-6-2-1-2\" data-name=\"band card subtitle\">Featherweight tracking for sleep, steps and daily recovery.</p>\n<div class=\"mt-12 grid grid-cols-[600px_620px] gap-7\" data-kid=\"2-6-2-1-3\" data-name=\"band card two-column grid\">\n<div class=\"sticky top-[104px] self-start\" data-kid=\"2-6-2-1-3-1\" data-name=\"band sticky media column\">\n<div class=\"relative h-[560px] overflow-hidden rounded-[16px] bg-[#F4F1EE]\" data-kid=\"2-6-2-1-3-1-1\" data-name=\"band media container with swap\">\n<img alt=\"Aero Fit Lite on morning linen sheets\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"2-6-2-1-3-1-1-1\" data-name=\"band main photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/3543f8cd7d9d41538a82a53b258a38b1.jpg\"/>\n<div class=\"media-alt absolute inset-0 grid place-items-center bg-[#F4F1EE] opacity-0\" data-kid=\"2-6-2-1-3-1-1-2\" data-name=\"fallback product image container\">\n<img alt=\"Aero Fit Lite in Slate\" class=\"w-[72%] mix-blend-multiply brightness-110 contrast-105\" data-kid=\"2-6-2-1-3-1-1-2-1\" data-name=\"fallback cut-out image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg\"/>\n</div>\n</div>\n<div class=\"mt-6 flex items-center justify-between\" data-kid=\"2-6-2-1-3-1-2\" data-name=\"band price/actions row\">\n<div data-kid=\"2-6-2-1-3-1-2-1\" data-name=\"band price block\"><p class=\"text-[24px] font-semibold leading-none\" data-kid=\"2-6-2-1-3-1-2-1-1\" data-name=\"band price value\">$149</p><p class=\"mt-2 text-[14px] text-[#6B4F57]\" data-kid=\"2-6-2-1-3-1-2-1-2\" data-name=\"band membership price note\">or $0 with a One membership</p></div>\n<div class=\"flex gap-2\" data-kid=\"2-6-2-1-3-1-2-2\" data-name=\"band action buttons\">\n<button class=\"h-11 rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-6-2-1-3-1-2-2-1\" data-name=\"add to cart button\">Add to cart</button>\n<a class=\"flex h-11 items-center rounded-full border border-[#D9D0CB] bg-white px-5 text-[14px] font-medium transition hover:bg-[#F3EFEC]\" data-kid=\"2-6-2-1-3-1-2-2-2\" data-name=\"details button\" href=\"#\">Details</a>\n</div>\n</div>\n</div>\n<div class=\"rail flex flex-col gap-4\" data-kid=\"2-6-2-1-3-2\" data-name=\"band detail rail\">\n<div class=\"rounded-[24px] bg-white p-10\" data-kid=\"2-6-2-1-3-2-1\" data-name=\"band summary card\"><p class=\"f-serif text-[28px] leading-[1.35]\" data-kid=\"2-6-2-1-3-2-1-1\" data-name=\"band summary copy\">Our lightest band. A screenless tracker for sleep, steps and daily recovery that you will forget you are wearing.</p></div>\n<div class=\"relative grid h-[360px] place-items-center overflow-hidden rounded-[24px] bg-white\" data-kid=\"2-6-2-1-3-2-2\" data-name=\"battery feature card\">\n<svg aria-hidden=\"true\" class=\"absolute inset-0 size-full\" data-kid=\"2-6-2-1-3-2-2-1\" data-name=\"circular dashed decoration\" fill=\"none\" viewbox=\"0 0 620 360\"><ellipse cx=\"310\" cy=\"268\" rx=\"270\" ry=\"66\" stroke=\"#2A0B14\" stroke-dasharray=\"1.5 11\" stroke-linecap=\"round\" stroke-opacity=\"0.22\" stroke-width=\"5\"></ellipse><ellipse cx=\"310\" cy=\"268\" rx=\"190\" ry=\"44\" stroke=\"#2A0B14\" stroke-dasharray=\"1.5 11\" stroke-linecap=\"round\" stroke-opacity=\"0.14\" stroke-width=\"5\"></ellipse></svg>\n<div class=\"relative -mt-10 text-center\" data-kid=\"2-6-2-1-3-2-2-2\" data-name=\"battery feature text\"><p class=\"text-[120px] font-medium leading-none tracking-[-0.04em]\" data-kid=\"2-6-2-1-3-2-2-2-1\" data-name=\"battery feature big number\">5<span class=\"ml-2 text-[52px] tracking-[-0.02em]\" data-kid=\"2-6-2-1-3-2-2-2-1-1\" data-name=\"battery feature unit\">days</span></p><p class=\"mt-3 text-[15px] text-[#6B4F57]\" data-kid=\"2-6-2-1-3-2-2-2-2\" data-name=\"battery feature caption\">Battery on a single charge</p></div>\n</div>\n<div class=\"rounded-[24px] bg-white p-10\" data-kid=\"2-6-2-1-3-2-3\" data-name=\"band closer-look card\">\n<h4 class=\"f-serif text-[24px] font-medium leading-none\" data-kid=\"2-6-2-1-3-2-3-1\" data-name=\"band closer-look title\">A closer look at Aero Fit Lite</h4>\n<ul class=\"mt-6 divide-y divide-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-3-2\" data-name=\"band feature list\">\n<li class=\"flex gap-5 py-5\" data-kid=\"2-6-2-1-3-2-3-2-1\" data-name=\"feature row: battery\"><span class=\"grid size-11 shrink-0 place-items-center rounded-full bg-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-3-2-1-1\" data-name=\"feature icon badge\"><i class=\"ti ti-battery-4 text-[20px]\" data-kid=\"2-6-2-1-3-2-3-2-1-1-1\" data-name=\"battery icon\"></i></span><div data-kid=\"2-6-2-1-3-2-3-2-1-2\" data-name=\"feature text group\"><p class=\"text-[17px] font-medium\" data-kid=\"2-6-2-1-3-2-3-2-1-2-1\" data-name=\"feature title\">5 days of battery</p><p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"2-6-2-1-3-2-3-2-1-2-2\" data-name=\"feature description\">Charge once on the weekend and again mid-week.</p></div></li>\n<li class=\"flex gap-5 py-5\" data-kid=\"2-6-2-1-3-2-3-2-2\" data-name=\"feature row: sleep\"><span class=\"grid size-11 shrink-0 place-items-center rounded-full bg-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-3-2-2-1\" data-name=\"feature icon badge\"><i class=\"ti ti-moon-stars text-[20px]\" data-kid=\"2-6-2-1-3-2-3-2-2-1-1\" data-name=\"moon-stars icon\"></i></span><div data-kid=\"2-6-2-1-3-2-3-2-2-2\" data-name=\"feature text group\"><p class=\"text-[17px] font-medium\" data-kid=\"2-6-2-1-3-2-3-2-2-2-1\" data-name=\"feature title\">Sleep stages and Sleep Performance</p><p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"2-6-2-1-3-2-3-2-2-2-2\" data-name=\"feature description\">The same sleep scoring as every other band.</p></div></li>\n<li class=\"flex gap-5 pt-5\" data-kid=\"2-6-2-1-3-2-3-2-3\" data-name=\"feature row: water resistance\"><span class=\"grid size-11 shrink-0 place-items-center rounded-full bg-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-3-2-3-1\" data-name=\"feature icon badge\"><i class=\"ti ti-droplet text-[20px]\" data-kid=\"2-6-2-1-3-2-3-2-3-1-1\" data-name=\"droplet icon\"></i></span><div data-kid=\"2-6-2-1-3-2-3-2-3-2\" data-name=\"feature text group\"><p class=\"text-[17px] font-medium\" data-kid=\"2-6-2-1-3-2-3-2-3-2-1\" data-name=\"feature title\">Water resistant to 50 m</p><p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"2-6-2-1-3-2-3-2-3-2-2\" data-name=\"feature description\">Wear it in the shower, the pool and the rain.</p></div></li>\n</ul>\n</div>\n<div class=\"rounded-[24px] bg-white p-10\" data-kid=\"2-6-2-1-3-2-4\" data-name=\"band tabs container\" data-tabs=\"\">\n<div class=\"inline-flex h-12 items-center gap-1 rounded-full border border-[#EFEAE6] bg-white p-1\" data-kid=\"2-6-2-1-3-2-4-1\" data-name=\"band tabs group\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"h-10 rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white\" data-kid=\"2-6-2-1-3-2-4-1-1\" data-name=\"specifications tab\" data-tab=\"spec\">Specifications</button>\n<button aria-selected=\"false\" class=\"h-10 rounded-full px-5 text-[14px] font-medium transition hover:bg-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-4-1-2\" data-name=\"colours-and-sizes tab\" data-tab=\"col\">Colours and sizes</button>\n<button aria-selected=\"false\" class=\"h-10 rounded-full px-5 text-[14px] font-medium transition hover:bg-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-4-1-3\" data-name=\"membership tab\" data-tab=\"mem\">Membership</button>\n</div>\n<dl class=\"mt-6 text-[14px]\" data-kid=\"2-6-2-1-3-2-4-2\" data-name=\"specifications panel\" data-panel=\"spec\">\n<div class=\"flex h-14 items-center justify-between border-t border-[#F3EFEC]\" data-kid=\"2-6-2-1-3-2-4-2-1\" data-name=\"spec row: Display\"><dt class=\"text-[#4A2A33]\" data-kid=\"2-6-2-1-3-2-4-2-1-1\" data-name=\"spec label: Display\">Display</dt><dd class=\"font-medium\" data-kid=\"2-6-2-1-3-2-4-2-1-2\" data-name=\"spec value: Mono OLED\">Mono OLED</dd></d