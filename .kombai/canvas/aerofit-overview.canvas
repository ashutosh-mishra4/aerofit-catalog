  "nodes": {
    "node_4bba631d7b89": {
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.font-sans { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n.font-serif { font-family: 'Source Serif 4', ui-serif, Georgia, serif; }\n.score-tab { color: #2A0B14; transition: background-color 150ms, color 150ms; }\n.score-tab:hover { background: #F3EFEC; }\n.score-tab[data-active=\"true\"] { background: #2A0B14; color: #fff; }\n.pick-chip[data-active=\"true\"] { background: #2A0B14; color: #fff; border-color: #2A0B14; }\n.score-strip { transition: transform 700ms cubic-bezier(0.65, 0, 0.35, 1); }\n.score-frame { opacity: 0.4; transform: scale(0.94); transition: opacity 600ms, transform 600ms cubic-bezier(0.65, 0, 0.35, 1); }\n.score-frame[data-active=\"true\"] { opacity: 1; transform: none; }\n.score-plate { opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity 400ms, transform 400ms, visibility 400ms; }\n.score-plate[data-active=\"true\"] { opacity: 1; visibility: visible; transform: none; transition-delay: 200ms; }\n.dot { position: absolute; width: 5px; height: 5px; border-radius: 9999px; background: #2A0B14; }\n</style>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n\n<div data-name=\"overview page\" class=\"font-sans min-h-screen bg-[#FAF8F6] pt-4 text-[#2A0B14] antialiased\" style=\"overflow-x: clip;\" data-kid=\"2\">\n\n  <!-- Navbar (existing) -->\n  <header data-name=\"main navigation\" class=\"sticky top-4 z-50 mx-4 flex h-[68px] items-center justify-between rounded-full border border-[#EFEAE6] bg-white pr-2 pl-7 shadow-[0_4px_18px_rgba(42,11,20,0.06)]\" data-kid=\"2-1\">\n    <div class=\"flex items-center gap-6\" data-kid=\"2-1-1\">\n      <a href=\"#\" data-name=\"brand logo\" class=\"flex items-center gap-2 whitespace-nowrap\" data-kid=\"2-1-1-1\">\n        <img src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\" alt=\"\" class=\"size-8\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-1-1-1-1\">\n        <span class=\"font-serif text-[22px] font-medium tracking-tight\" data-kid=\"2-1-1-1-2\">Aero Fit</span>\n      </a>\n      <nav data-name=\"primary nav links\" class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"2-1-1-2\">\n        <a href=\"#\" class=\"flex h-10 items-center rounded-full bg-[#F8F38A] px-4\" data-kid=\"2-1-1-2-1\">Overview</a>\n        <a href=\"#\" class=\"flex h-10 items-center rounded-full bg-[#F3EFEC] px-4 transition hover:bg-[#ECE6E2]\" data-kid=\"2-1-1-2-2\">How it works</a>\n        <a href=\"#\" class=\"flex h-10 items-center rounded-full bg-[#F3EFEC] px-4 transition hover:bg-[#ECE6E2]\" data-kid=\"2-1-1-2-3\">Shop bands</a>\n      </nav>\n    </div>\n    <div class=\"flex items-center gap-2\" data-kid=\"2-1-2\">\n      <button data-name=\"cart button\" class=\"flex h-[52px] items-center gap-2 rounded-full border border-[#EFEAE6] bg-white pr-2 pl-5 text-[14px] font-medium transition hover:bg-[#F3EFEC]\" data-kid=\"2-1-2-1\">\n        <span class=\"text-[18px] leading-none\" data-kid=\"2-1-2-1-1\"><i class=\"ti ti-shopping-bag\" data-kid=\"2-1-2-1-1-1\"></i></span>\n        Cart\n        <span class=\"flex h-9 min-w-9 items-center justify-center rounded-full bg-[#F3EFEC] px-2 text-[13px]\" data-kid=\"2-1-2-1-2\">0</span>\n      </button>\n      <a href=\"#\" data-name=\"join call-to-action\" class=\"flex h-[52px] items-center rounded-full bg-[#2A0B14] px-6 text-[15px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-1-2-2\">Join Aero Fit free</a>\n    </div>\n  </header>\n\n  <!-- 1. Hero -->\n  <section data-name=\"hero panel\" class=\"hero relative mx-4 mt-5 h-[688px] overflow-hidden rounded-[28px] bg-[#F3EDE9]\" data-kid=\"2-2\">\n    <div class=\"hero-photo absolute inset-0\" data-kid=\"2-2-1\"><img data-name=\"hero lifestyle photo\" class=\"size-full -scale-x-100 object-cover object-center\" src=\"https://images.unsplash.com/photo-1722517625268-bde82603153e?auto=format&w=2000&q=80&fit=crop\" alt=\"Runner resting on stone steps after an early run, photo by note thanun on Unsplash\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-2-1-1\"></div>\n    <div aria-hidden=\"true\" class=\"absolute inset-0\" style=\"background-image: linear-gradient(90deg, rgba(250,248,246,0.97) 0%, rgba(250,248,246,0.9) 32%, rgba(250,248,246,0.4) 46%, rgba(250,248,246,0) 56%);\" data-kid=\"2-2-2\"></div>\n\n    <div data-name=\"hero copy column\" class=\"relative flex h-full max-w-[640px] flex-col justify-between pt-[60px] pb-14 pl-20\" data-kid=\"2-2-3\">\n      <div data-kid=\"2-2-3-1\">\n        <h1 data-name=\"hero headline\" class=\"font-serif text-[64px] leading-[1.02] font-medium tracking-[-0.02em]\" data-kid=\"2-2-3-1-1\">Sleep, recovery and effort. Tracked on your wrist.</h1>\n        <p data-name=\"hero supporting copy\" class=\"mt-6 max-w-[430px] text-[17px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-2-3-1-2\">Aero Fit bands record heart rate, HRV, skin temperature and movement day and night. The app turns those signals into four scores you check each morning.</p>\n      </div>\n      <div data-name=\"hero actions\" data-kid=\"2-2-3-2\">\n        <div class=\"flex items-center gap-6\" data-kid=\"2-2-3-2-1\">\n          <a href=\"#\" data-name=\"membership button\" class=\"flex h-11 items-center rounded-full bg-[#2A0B14] px-5 text-[14px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-2-3-2-1-1\">How membership works</a>\n          <a href=\"#\" data-name=\"shop bands link\" class=\"text-[14px] font-medium underline underline-offset-4 transition hover:opacity-70\" data-kid=\"2-2-3-2-1-2\">Shop bands</a>\n        </div>\n        <p data-name=\"price line\" class=\"mt-5 text-[13px] text-[#6B4F57]\" data-kid=\"2-2-3-2-2\">Memberships from <span class=\"font-semibold text-[#2A0B14]\" data-kid=\"2-2-3-2-2-1\">$199/year</span>. Eligible band included at <span class=\"font-semibold text-[#2A0B14]\" data-kid=\"2-2-3-2-2-2\">$0</span>.</p>\n      </div>\n    </div>\n\n    <!-- Lens + callouts -->\n    <div data-name=\"device lens group\" class=\"absolute top-[128px] left-[986px] size-[380px]\" data-kid=\"2-2-4\">\n      <div aria-hidden=\"true\" class=\"absolute -inset-[18px] rounded-full border border-white/70\" data-kid=\"2-2-4-1\"></div>\n      <div data-name=\"device lens\" class=\"hero-lens relative size-full overflow-hidden rounded-full border-[6px] border-white bg-[#F4F1EE] shadow-[0_14px_40px_rgba(42,11,20,0.16)]\" data-kid=\"2-2-4-2\">\n        <img data-name=\"ultra band cutout\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\" alt=\"Aero Fit Ultra in Titanium\" class=\"absolute top-1/2 left-1/2 size-[300px] -translate-x-1/2 -translate-y-1/2 object-contain mix-blend-multiply brightness-110 contrast-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-2-4-2-1\">\n      </div>\n\n      <div data-name=\"recovery callout\" class=\"hero-callout absolute -top-[52px] -left-[150px] flex items-center\" data-kid=\"2-2-4-3\">\n        <div class=\"relative rounded-[12px] border border-white bg-white/92 px-3.5 py-2.5 shadow-[0_4px_18px_rgba(42,11,20,0.06)]\" data-kid=\"2-2-4-3-1\">\n          <span class=\"dot -top-[3px] -left-[3px]\" data-kid=\"2-2-4-3-1-1\"></span><span class=\"dot -top-[3px] -right-[3px]\" data-kid=\"2-2-4-3-1-2\"></span><span class=\"dot -bottom-[3px] -left-[3px]\" data-kid=\"2-2-4-3-1-3\"></span><span class=\"dot -right-[3px] -bottom-[3px]\" data-kid=\"2-2-4-3-1-4\"></span>\n          <p class=\"text-[12px] text-[#6B4F57]\" data-kid=\"2-2-4-3-1-5\">Recovery</p>\n          <p class=\"text-[20px] leading-tight font-semibold tabular-nums\" data-kid=\"2-2-4-3-1-6\">82<span class=\"ml-0.5 text-[13px] font-medium text-[#6B4F57]\" data-kid=\"2-2-4-3-1-6-1\">%</span></p>\n        </div>\n        <span aria-hidden=\"true\" class=\"h-px w-[44px] bg-white\" data-kid=\"2-2-4-3-2\"></span>\n      </div>\n\n      <div data-name=\"hrv callout\" class=\"hero-callout absolute -right-[22px] -bottom-[40px] flex items-center\" data-kid=\"2-2-4-4\">\n        <div class=\"relative rounded-[12px] border border-white bg-white/92 px-3.5 py-2.5 shadow-[0_4px_18px_rgba(42,11,20,0.06)]\" data-kid=\"2-2-4-4-1\">\n          <span class=\"dot -top-[3px] -left-[3px]\" data-kid=\"2-2-4-4-1-1\"></span><span class=\"dot -top-[3px] -right-[3px]\" data-kid=\"2-2-4-4-1-2\"></span><span class=\"dot -bottom-[3px] -left-[3px]\" data-kid=\"2-2-4-4-1-3\"></span><span class=\"dot -right-[3px] -bottom-[3px]\" data-kid=\"2-2-4-4-1-4\"></span>\n          <p class=\"text-[12px] text-[#6B4F57]\" data-kid=\"2-2-4-4-1-5\">HRV</p>\n          <p class=\"text-[20px] leading-tight font-semibold tabular-nums\" data-kid=\"2-2-4-4-1-6\">64<span class=\"ml-1 text-[13px] font-medium text-[#6B4F57]\" data-kid=\"2-2-4-4-1-6-1\">ms</span></p>\n        </div>\n      </div>\n\n      <div data-name=\"resting heart rate callout\" class=\"hero-callout absolute bottom-[20px] -left-[170px] flex items-center\" data-kid=\"2-2-4-5\">\n        <div class=\"relative rounded-[12px] border border-white bg-white/92 px-3.5 py-2.5 shadow-[0_4px_18px_rgba(42,11,20,0.06)]\" data-kid=\"2-2-4-5-1\">\n          <span class=\"dot -top-[3px] -left-[3px]\" data-kid=\"2-2-4-5-1-1\"></span><span class=\"dot -top-[3px] -right-[3px]\" data-kid=\"2-2-4-5-1-2\"></span><span class=\"dot -bottom-[3px] -left-[3px]\" data-kid=\"2-2-4-5-1-3\"></span><span class=\"dot -right-[3px] -bottom-[3px]\" data-kid=\"2-2-4-5-1-4\"></span>\n          <p class=\"text-[12px] text-[#6B4F57]\" data-kid=\"2-2-4-5-1-5\">Resting HR</p>\n          <p class=\"text-[20px] leading-tight font-semibold tabular-nums\" data-kid=\"2-2-4-5-1-6\">52<span class=\"ml-1 text-[13px] font-medium text-[#6B4F57]\" data-kid=\"2-2-4-5-1-6-1\">bpm</span></p>\n        </div>\n        <span aria-hidden=\"true\" class=\"h-px w-[40px] bg-white\" data-kid=\"2-2-4-5-2\"></span>\n      </div>\n    </div>\n  </section>\n\n  <div data-name=\"scores jump link row\" class=\"flex h-24 items-center justify-center\" data-kid=\"2-3\">\n    <a href=\"#scores\" class=\"flex items-center gap-2 text-[14px] font-medium text-[#4A2A33] transition hover:opacity-70\" data-kid=\"2-3-1\">Explore the scores <span class=\"text-[16px] leading-none\" data-kid=\"2-3-1-1\"><i class=\"ti ti-arrow-down\" data-kid=\"2-3-1-1-1\"></i></span></a>\n  </div>\n\n  <!-- 2. Score stage (dark) -->\n  <section id=\"scores\" data-name=\"score stage\" class=\"score-stage mx-4\" data-kid=\"2-4\">\n    <div data-name=\"score stage panel\" class=\"score-stage-inner relative overflow-hidden rounded-[28px] bg-[#2A0B14] px-14 pt-12 pb-12 text-white\" data-kid=\"2-4-1\">\n      <div class=\"flex items-end justify-between gap-10\" data-kid=\"2-4-1-1\">\n        <h2 data-name=\"score stage heading\" class=\"max-w-[600px] font-serif text-[46px] leading-[1.08] font-medium tracking-[-0.01em]\" data-kid=\"2-4-1-1-1\">Four scores. Different parts of your day.</h2>\n        <p data-name=\"score stage note\" class=\"max-w-[400px] pb-1 text-[15px] leading-[1.55] text-white/75\" data-kid=\"2-4-1-1-2\">Every band records the signals behind all four scores. Pro and Ultra add ECG and Blood Pressure Insights.</p>\n      </div>\n\n      <div class=\"mt-7 flex items-center justify-between\" data-kid=\"2-4-1-2\">\n        <div data-name=\"score tabs\" role=\"tablist\" class=\"inline-flex h-12 items-center gap-1 rounded-full bg-white p-1 text-[14px] font-medium\" data-kid=\"2-4-1-2-1\">\n          <button class=\"score-tab flex h-10 items-center gap-2 rounded-full px-5\" data-index=\"0\" data-active=\"false\" data-dynamic=\"true\" data-reason=\"active state toggled by scroll position and tab clicks\" data-kid=\"2-4-1-2-1-1\"><span class=\"text-[16px] leading-none\" data-kid=\"2-4-1-2-1-1-1\"><i class=\"ti ti-moon-stars\" data-kid=\"2-4-1-2-1-1-1-1\"></i></span>Sleep Performance</button>\n          <button class=\"score-tab flex h-10 items-center gap-2 rounded-full px-5\" data-index=\"1\" data-active=\"true\" data-dynamic=\"true\" data-reason=\"active state toggled by scroll position and tab clicks\" data-kid=\"2-4-1-2-1-2\"><span class=\"text-[16px] leading-none\" data-kid=\"2-4-1-2-1-2-1\"><i class=\"ti ti-bolt\" data-kid=\"2-4-1-2-1-2-1-1\"></i></span>Recovery</button>\n          <button class=\"score-tab flex h-10 items-center gap-2 rounded-full px-5\" data-index=\"2\" data-active=\"false\" data-dynamic=\"true\" data-reason=\"active state toggled by scroll position and tab clicks\" data-kid=\"2-4-1-2-1-3\"><span class=\"text-[16px] leading-none\" data-kid=\"2-4-1-2-1-3-1\"><i class=\"ti ti-route\" data-kid=\"2-4-1-2-1-3-1-1\"></i></span>Strain</button>\n          <button class=\"score-tab flex h-10 items-center gap-2 rounded-full px-5\" data-index=\"3\" data-active=\"false\" data-dynamic=\"true\" data-reason=\"active state toggled by scroll position and tab clicks\" data-kid=\"2-4-1-2-1-4\"><span class=\"text-[16px] leading-none\" data-kid=\"2-4-1-2-1-4-1\"><i class=\"ti ti-activity-heartbeat\" data-kid=\"2-4-1-2-1-4-1-1\"></i></span>Heart health</button>\n        </div>\n        <a href=\"#\" data-name=\"how scores work link\" class=\"flex items-center gap-1.5 text-[14px] font-medium text-white underline underline-offset-4 transition hover:opacity-70\" data-kid=\"2-4-1-2-2\">How the scores work <span class=\"text-[16px] leading-none\" data-kid=\"2-4-1-2-2-1\"><i class=\"ti ti-arrow-right\" data-kid=\"2-4-1-2-2-1-1\"></i></span></a>\n      </div>\n\n      <!-- Strip -->\n      <div data-name=\"score photo carousel\" class=\"relative mt-8 h-[440px]\" data-kid=\"2-4-1-3\">\n        <div class=\"score-strip absolute top-0 left-0 flex h-full gap-6\" style=\"transform: translateX(-606px);\" data-dynamic=\"true\" data-reason=\"strip translated by scroll and tab selection\" data-kid=\"2-4-1-3-1\">\n          <figure data-name=\"sleep photo frame\" class=\"score-frame relative h-full w-[820px] shrink-0 overflow-hidden rounded-[22px]\" data-active=\"false\" data-kid=\"2-4-1-3-1-1\">\n            <img src=\"https://images.pexels.com/photos/6779227/pexels-photo-6779227.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\" alt=\"Woman opening bedroom curtains in morning light, photo by Artem Podrez on Pexels\" class=\"size-full object-cover object-[50%_35%]\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-4-1-3-1-1-1\">\n            <span class=\"absolute top-5 left-5 flex h-9 items-center gap-2 rounded-full bg-white px-3.5 text-[13px] font-medium text-[#2A0B14]\" data-kid=\"2-4-1-3-1-1-2\"><i class=\"ti ti-moon-stars\" data-kid=\"2-4-1-3-1-1-2-1\"></i>Sleep Performance <span class=\"font-semibold tabular-nums\" data-kid=\"2-4-1-3-1-1-2-2\">86%</span></span>\n          </figure>\n          <figure data-name=\"recovery photo frame\" class=\"score-frame relative h-full w-[820px] shrink-0 overflow-hidden rounded-[22px]\" data-active=\"true\" data-kid=\"2-4-1-3-1-2\">\n            <img src=\"https://images.pexels.com/photos/7880189/pexels-photo-7880189.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\" alt=\"Athlete catching his breath after a session, photo by MART PRODUCTION on Pexels\" class=\"size-full object-cover object-[50%_30%]\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-4-1-3-1-2-1\">\n          </figure>\n          <figure data-name=\"strain photo frame\" class=\"score-frame relative h-full w-[820px] shrink-0 overflow-hidden rounded-[22px]\" data-active=\"false\" data-kid=\"2-4-1-3-1-3\">\n            <img src=\"https://images.pexels.com/photos/7880090/pexels-photo-7880090.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\" alt=\"Man in sportswear on a park trail in afternoon light, photo by MART PRODUCTION on Pexels\" class=\"size-full object-cover\" decoding=\"async\" 