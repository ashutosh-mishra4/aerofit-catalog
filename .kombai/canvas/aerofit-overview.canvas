" data-kid=\"2-6-3-2-2\"><i class=\"ti ti-plus\" data-kid=\"2-6-3-2-2-1\"></i></span>\n        <span class=\"rounded-full bg-white px-4 py-2\" data-kid=\"2-6-3-2-3\">Lite <span class=\"font-semibold tabular-nums\" data-kid=\"2-6-3-2-3-1\">$0</span></span>\n        <span class=\"text-[16px] leading-none text-[#6B4F57]\" data-kid=\"2-6-3-2-4\"><i class=\"ti ti-equal\" data-kid=\"2-6-3-2-4-1\"></i></span>\n        <span data-kid=\"2-6-3-2-5\">First year <span class=\"font-semibold tabular-nums\" data-kid=\"2-6-3-2-5-1\">$199</span></span>\n      </div>\n    </div>\n  </section>\n\n  <!-- 5. Footer (existing) -->\n  <footer data-name=\"site footer\" class=\"mx-4 mt-28 mb-4 rounded-[28px] bg-[#F3EDE9] px-20 pt-14 pb-8\" data-kid=\"2-7\">\n    <a href=\"#\" data-name=\"footer logo\" class=\"flex items-center gap-2.5\" data-kid=\"2-7-1\">\n      <img src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\" alt=\"\" class=\"size-10\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-7-1-1\">\n      <span class=\"font-serif text-[32px] font-medium tracking-tight\" data-kid=\"2-7-1-2\">Aero Fit</span>\n    </a>\n    <div class=\"mt-12 grid grid-cols-[400px_1fr] gap-16\" data-kid=\"2-7-2\">\n      <div data-name=\"newsletter card\" class=\"rounded-[22px] bg-white p-6 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"2-7-2-1\">\n        <p class=\"text-[17px] font-medium\" data-kid=\"2-7-2-1-1\">Get health tips in your inbox</p>\n        <p class=\"mt-1.5 text-[13px] leading-[1.55] text-[#6B4F57]\" data-kid=\"2-7-2-1-2\">Sleep, recovery and training insights from the Aero Fit performance team, every week.</p>\n        <div class=\"mt-5 flex h-[52px] items-center gap-2 rounded-full border border-[#EFEAE6] bg-[#FAF8F6] pr-1.5 pl-5\" data-kid=\"2-7-2-1-3\">\n          <span class=\"flex-1 text-[14px] text-[#9A8E91]\" data-kid=\"2-7-2-1-3-1\">Email address</span>\n          <button class=\"flex h-10 items-center rounded-full bg-[#2A0B14] px-4 text-[14px] font-medium text-white\" data-kid=\"2-7-2-1-3-2\">Subscribe</button>\n        </div>\n      </div>\n      <div data-name=\"footer link columns\" class=\"grid grid-cols-3 gap-8 pt-2 text-[14px]\" data-kid=\"2-7-2-2\">\n        <nav data-kid=\"2-7-2-2-1\"><p class=\"mb-4 font-medium text-[#7A5B64]\" data-kid=\"2-7-2-2-1-1\">Shop</p><ul class=\"space-y-3\" data-kid=\"2-7-2-2-1-2\"><li data-kid=\"2-7-2-2-1-2-1\">Aero Fit Lite</li><li data-kid=\"2-7-2-2-1-2-2\">Aero Fit Smart</li><li data-kid=\"2-7-2-2-1-2-3\">Aero Fit Pro</li><li data-kid=\"2-7-2-2-1-2-4\">Aero Fit Music</li><li data-kid=\"2-7-2-2-1-2-5\">Aero Fit Ultra</li></ul></nav>\n        <nav data-kid=\"2-7-2-2-2\"><p class=\"mb-4 font-medium text-[#7A5B64]\" data-kid=\"2-7-2-2-2-1\">Memberships</p><ul class=\"space-y-3\" data-kid=\"2-7-2-2-2-2\"><li data-kid=\"2-7-2-2-2-2-1\">How it works</li><li data-kid=\"2-7-2-2-2-2-2\">Aero Fit One</li><li data-kid=\"2-7-2-2-2-2-3\">Aero Fit Peak</li><li data-kid=\"2-7-2-2-2-2-4\">Aero Fit Life</li></ul></nav>\n        <nav data-kid=\"2-7-2-2-3\"><p class=\"mb-4 font-medium text-[#7A5B64]\" data-kid=\"2-7-2-2-3-1\">Support</p><ul class=\"space-y-3\" data-kid=\"2-7-2-2-3-2\"><li data-kid=\"2-7-2-2-3-2-1\">Help Center</li><li data-kid=\"2-7-2-2-3-2-2\">Sizing guide</li><li data-kid=\"2-7-2-2-3-2-3\">Accessories</li><li data-kid=\"2-7-2-2-3-2-4\">Download App</li></ul></nav>\n      </div>\n    </div>\n    <div data-name=\"legal bar\" class=\"mt-12 flex h-14 items-center justify-between rounded-full bg-white px-6 text-[12px] text-[#6B4F57]\" data-kid=\"2-7-3\">\n      <nav class=\"flex gap-5\" data-kid=\"2-7-3-1\"><span data-kid=\"2-7-3-1-1\">Terms &amp; Conditions</span><span data-kid=\"2-7-3-1-2\">Privacy Policy</span><span data-kid=\"2-7-3-1-3\">Accessibility</span></nav>\n      <div class=\"flex items-center gap-4\" data-kid=\"2-7-3-2\">\n        <div class=\"flex items-center gap-1 text-[17px] text-[#4A2A33]\" data-kid=\"2-7-3-2-1\"><span class=\"flex size-8 items-center justify-center\" data-kid=\"2-7-3-2-1-1\"><i class=\"ti ti-brand-instagram\" data-kid=\"2-7-3-2-1-1-1\"></i></span><span class=\"flex size-8 items-center justify-center\" data-kid=\"2-7-3-2-1-2\"><i class=\"ti ti-brand-youtube\" data-kid=\"2-7-3-2-1-2-1\"></i></span><span class=\"flex size-8 items-center justify-center\" data-kid=\"2-7-3-2-1-3\"><i class=\"ti ti-microphone\" data-kid=\"2-7-3-2-1-3-1\"></i></span><span class=\"flex size-8 items-center justify-center\" data-kid=\"2-7-3-2-1-4\"><i class=\"ti ti-mail\" data-kid=\"2-7-3-2-1-4-1\"></i></span></div>\n        <span data-kid=\"2-7-3-2-2\">© 2026 Aero Fit. All rights reserved.</span>\n      </div>\n    </div>\n    <p data-name=\"wellness disclaimer\" class=\"mt-6 max-w-[900px] px-2 text-[11px] leading-[1.7] text-[#7A5B64]\" data-kid=\"2-7-4\">Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. Membership plans are billed annually with a 12-month minimum term.</p>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\">\nimport Lenis from \"https://esm.sh/lenis@1\"\n\n// Scroll choreography only runs inside a real device-height viewport.\nconst live = window.innerHeight < 1400;\n\n/* ---------- Score stage ---------- */\nconst STEP = 844, BASE = 238;\nconst strip = document.querySelector('.score-strip');\nconst frames = gsap.utils.toArray('.score-frame');\nconst plates = gsap.utils.toArray('.score-plate');\nconst tabs = gsap.utils.toArray('.score-tab');\nlet current = 1;\n\nfunction setScore(i) {\n  current = i;\n  strip.style.transform = 'translateX(' + (BASE - i * STEP) + 'px)';\n  frames.forEach((f, j) => f.dataset.active = String(j === i));\n  plates.forEach((p, j) => p.dataset.active = String(j === i));\n  tabs.forEach((t, j) => t.dataset.active = String(j === i));\n}\n\nlet scoreTrigger = null, lenis = null;\n\nif (live) {\n  lenis = new Lenis();\n  lenis.on('scroll', ScrollTrigger.update);\n  gsap.ticker.add((t) => lenis.raf(t * 1000));\n  gsap.ticker.lagSmoothing(0);\n\n  scoreTrigger = ScrollTrigger.create({\n    trigger: '.score-stage',\n    start: 'top 100px',\n    end: '+=2000',\n    pin: true,\n    onUpdate: (self) => {\n      const i = Math.min(3, Math.floor(self.progress * 4));\n      if (i !== current) setScore(i);\n    },\n  });\n\n  // Hero: photo settles on load, lens eases back as the hero leaves.\n  gsap.from('.hero-photo', { scale: 1.08, duration: 1.8, ease: 'power2.out' });\n  gsap.from('.hero-callout', { autoAlpha: 0, y: 10, duration: 0.6, stagger: 0.12, delay: 0.6, ease: 'power3.out' });\n  gsap.fromTo('.hero-lens', { scale: 1.08, y: 0 }, { scale: 1, y: -24, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } });\n\n  // Shelf devices rise into place.\n  gsap.fromTo('.shelf-img', { y: 56 }, { y: 0, ease: 'none', stagger: 0.06, scrollTrigger: { trigger: '.shelf', start: 'top 95%', end: 'top 40%', scrub: 0.6 } });\n\n  // Selected device: macro scale settles as the comparison enters.\n  gsap.fromTo('.split-device', { scale: 1.12 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.split', start: 'top 85%', end: 'top 25%', scrub: true } });\n}\n\ntabs.forEach((t, j) => t.addEventListener('click', () => {\n  if (scoreTrigger && lenis) {\n    const y = scoreTrigger.start + ((j + 0.5) / 4) * (scoreTrigger.end - scoreTrigger.start);\n    lenis.scrollTo(y, { duration: 1 });\n  } else {\n    setScore(j);\n  }\n}));\n\n/* ---------- Band picker ---------- */\nconst CDN = 'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/';\nconst BANDS = [\n  { name: 'Lite', days: 5, img: 'da32fd7c279245b5ab743623f57ddf23.jpg' },\n  { name: 'Smart', days: 7, img: '7754f0f6d49a4ed38f644dce2670c620.jpg' },\n  { name: 'Pro', days: 10, img: '72180f80b3a64de99cbdef213dc621cd.jpg' },\n  { name: 'Music', days: 6, img: '46a42b1d18d34403be756d1c74222484.jpg' },\n  { name: 'Ultra', days: 14, img: '76d7a24f75bc4dbeafec4d446b539a12.jpg' },\n];\nconst device = document.querySelector('.split-device');\nconst hl = document.querySelector('.col-hl');\nconst chips = gsap.utils.toArray('.pick-chip');\nchips.forEach((c, i) => c.addEventListener('click', () => {\n  const b = BANDS[i];\n  chips.forEach((x, k) => x.dataset.active = String(k === i));\n  gsap.to(device, { autoAlpha: 0, y: 12, duration: 0.2, onComplete: () => {\n    device.src = CDN + b.img;\n    device.alt = 'Aero Fit ' + b.name;\n    gsap.to(device, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'power2.out' });\n  } });\n  document.querySelector('.sel-name').textContent = b.name;\n  document.querySelector('.sel-battery').innerHTML = b.days + '<span class=\"ml-1.5 text-[17px] font-medium text-[#6B4F57]\">days</span>';\n  document.querySelector('.sel-shop').innerHTML = 'Shop ' + b.name + ' <i class=\"ti ti-arrow-right\"></i>';\n  hl.style.left = 'calc(180px + (100% - 180px) / 5 * ' + i + ')';\n}));\n\nwindow.addEventListener('load', () => ScrollTrigger.refresh());\n</script>\n",
