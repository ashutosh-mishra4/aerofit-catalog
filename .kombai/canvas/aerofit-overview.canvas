ull bg-[#8B8A87]\" data-kid=\"2-6-4-1-3-2-4-3-2-1-1\" data-name=\"Titanium swatch dot\"></span>Titanium</span><span class=\"flex items-center gap-2\" data-kid=\"2-6-4-1-3-2-4-3-2-2\" data-name=\"Black colour swatch\"><span class=\"size-7 rounded-full bg-[#1F1F1F]\" data-kid=\"2-6-4-1-3-2-4-3-2-2-1\" data-name=\"Black swatch dot\"></span>Black</span><span class=\"flex items-center gap-2\" data-kid=\"2-6-4-1-3-2-4-3-2-3\" data-name=\"Trail colour swatch\"><span class=\"size-7 rounded-full bg-[#6B7B4E]\" data-kid=\"2-6-4-1-3-2-4-3-2-3-1\" data-name=\"Trail swatch dot\"></span>Trail</span></div>\n<p class=\"mt-7 text-[13px] text-[#6B4F57]\" data-kid=\"2-6-4-1-3-2-4-3-3\" data-name=\"band sizes label\">Band sizes</p>\n<div class=\"mt-1 text-[14px]\" data-kid=\"2-6-4-1-3-2-4-3-4\" data-name=\"band sizes list\"><div class=\"flex h-14 items-center justify-between border-b border-[#EFEAE6]\" data-kid=\"2-6-4-1-3-2-4-3-4-1\" data-name=\"size row S\"><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-3-4-1-1\" data-name=\"size letter S\">S</span><span data-kid=\"2-6-4-1-3-2-4-3-4-1-2\" data-name=\"circumference range\">130–160 mm</span></div><div class=\"flex h-14 items-center justify-between border-b border-[#EFEAE6]\" data-kid=\"2-6-4-1-3-2-4-3-4-2\" data-name=\"size row M\"><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-3-4-2-1\" data-name=\"size letter M\">M</span><span data-kid=\"2-6-4-1-3-2-4-3-4-2-2\" data-name=\"circumference range\">150–190 mm</span></div><div class=\"flex h-14 items-center justify-between\" data-kid=\"2-6-4-1-3-2-4-3-4-3\" data-name=\"size row L\"><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-3-4-3-1\" data-name=\"size letter L\">L</span><span data-kid=\"2-6-4-1-3-2-4-3-4-3-2\" data-name=\"circumference range\">180–220 mm</span></div></div>\n</div>\n<div class=\"mt-6 text-[14px]\" data-kid=\"2-6-4-1-3-2-4-4\" data-name=\"membership panel (hidden)\" data-panel=\"mem\" hidden=\"\">\n<div class=\"flex h-14 items-center justify-between border-t border-[#EFEAE6]\" data-kid=\"2-6-4-1-3-2-4-4-1\" data-name=\"membership row One\"><span data-kid=\"2-6-4-1-3-2-4-4-1-1\" data-name=\"membership plan name and price\"><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-4-1-1-1\" data-name=\"membership plan name\">One</span> <span class=\"text-[#6B4F57]\" data-kid=\"2-6-4-1-3-2-4-4-1-1-2\" data-name=\"membership price\">$199/yr</span></span><span class=\"rounded-full border border-[#D9D0CB] px-2.5 py-1 text-[12px] text-[#6B4F57]\" data-kid=\"2-6-4-1-3-2-4-4-1-2\" data-name=\"not included badge\">Not included</span></div>\n<div class=\"flex h-14 items-center justify-between border-t border-[#EFEAE6]\" data-kid=\"2-6-4-1-3-2-4-4-2\" data-name=\"membership row Peak\"><span data-kid=\"2-6-4-1-3-2-4-4-2-1\" data-name=\"membership plan name and price\"><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-4-2-1-1\" data-name=\"membership plan name\">Peak</span> <span class=\"text-[#6B4F57]\" data-kid=\"2-6-4-1-3-2-4-4-2-1-2\" data-name=\"membership price\">$299/yr</span></span><span class=\"rounded-full border border-[#D9D0CB] px-2.5 py-1 text-[12px] text-[#6B4F57]\" data-kid=\"2-6-4-1-3-2-4-4-2-2\" data-name=\"not included badge\">Not included</span></div>\n<div class=\"flex h-14 items-center justify-between border-t border-[#EFEAE6]\" data-kid=\"2-6-4-1-3-2-4-4-3\" data-name=\"membership row Life\"><span data-kid=\"2-6-4-1-3-2-4-4-3-1\" data-name=\"membership plan name and price\"><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-4-3-1-1\" data-name=\"membership plan name\">Life</span> <span class=\"text-[#6B4F57]\" data-kid=\"2-6-4-1-3-2-4-4-3-1-2\" data-name=\"membership price\">$399/yr</span></span><span class=\"rounded-full bg-[#2A0B14] px-2.5 py-1 text-[12px] text-white\" data-kid=\"2-6-4-1-3-2-4-4-3-2\" data-name=\"band included badge\">Band $0</span></div>\n<div class=\"flex h-14 items-center justify-between border-t border-[#EFEAE6]\" data-kid=\"2-6-4-1-3-2-4-4-4\" data-name=\"outright purchase row\"><span class=\"text-[#4A2A33]\" data-kid=\"2-6-4-1-3-2-4-4-4-1\" data-name=\"outright label\">Buy outright</span><span class=\"font-medium\" data-kid=\"2-6-4-1-3-2-4-4-4-2\" data-name=\"outright price\">$399</span></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</article>\n</section>\n<!-- Membership close -->\n<section class=\"mx-4 mt-28 grid grid-cols-[1fr_440px] overflow-hidden rounded-[28px] bg-[#F3EDE9]\" data-kid=\"2-7\" data-name=\"membership section\">\n<div class=\"px-[80px] py-20\" data-kid=\"2-7-1\" data-name=\"membership copy column\">\n<h2 class=\"max-w-[560px] f-serif text-[46px] font-medium leading-[1.08] tracking-[-0.01em]\" data-kid=\"2-7-1-1\" data-name=\"membership headline\">You pay for the membership. The band comes with it.</h2>\n<div class=\"mt-10 flex items-end gap-10\" data-kid=\"2-7-1-2\" data-name=\"membership price block\">\n<p class=\"text-[64px] font-medium leading-none tracking-[-0.03em]\" data-kid=\"2-7-1-2-1\" data-name=\"membership price value\">$199<span class=\"ml-1 text-[20px] tracking-normal text-[#6B4F57]\" data-kid=\"2-7-1-2-1-1\" data-name=\"membership price unit\">/ year</span></p>\n<ul class=\"flex flex-col gap-2 pb-1 text-[15px] text-[#4A2A33]\" data-kid=\"2-7-1-2-2\" data-name=\"membership perks list\">\n<li class=\"flex items-center gap-2\" data-kid=\"2-7-1-2-2-1\" data-name=\"perk row: band included\"><i class=\"ti ti-check text-[18px] text-[#2A0B14]\" data-kid=\"2-7-1-2-2-1-1\" data-name=\"checkmark icon\"></i>Lite or Smart included at $0</li>\n<li class=\"flex items-center gap-2\" data-kid=\"2-7-1-2-2-2\" data-name=\"perk row: 12-month term\"><i class=\"ti ti-calendar text-[18px] text-[#2A0B14]\" data-kid=\"2-7-1-2-2-2-1\" data-name=\"calendar icon\"></i>12-month minimum term</li>\n</ul>\n</div>\n<p class=\"mt-8 max-w-[480px] text-[16px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-7-1-3\" data-name=\"membership subtext\">One yearly charge, no separate bill for the hardware.</p>\n<div class=\"mt-9 flex gap-3\" data-kid=\"2-7-1-4\" data-name=\"membership action links\">\n<a class=\"flex h-12 items-center rounded-full bg-[#2A0B14] px-6 text-[15px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"2-7-1-4-1\" data-name=\"how-membership-works button\" href=\"#\">How membership works</a>\n<a class=\"flex h-12 items-center rounded-full border border-[#D9D0CB] bg-white px-6 text-[15px] font-medium transition hover:bg-[#F3EFEC]\" data-kid=\"2-7-1-4-2\" data-name=\"compare-plans button\" href=\"#\">Compare plans</a>\n</div>\n</div>\n<img alt=\"Aero Fit band in its open box with a welcome card\" class=\"h-full w-full object-cover\" data-kid=\"2-7-2\" data-name=\"band unboxing photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/5c5f0134e1a34895b7cb2cd92d3ecde7.jpg\"/>\n</section>\n<!-- Footer -->\n<footer class=\"mx-4 mt-6 rounded-[28px] bg-[#2A0B14] px-[80px] pb-10 pt-20 text-[#FAF8F6]\" data-kid=\"2-8\" data-name=\"site footer\">\n<div class=\"grid grid-cols-[1.5fr_1fr_1fr_1fr_1fr] gap-10\" data-kid=\"2-8-1\" data-name=\"footer link grid\">\n<div data-kid=\"2-8-1-1\" data-name=\"footer brand column\">\n<div class=\"flex items-center gap-2.5\" data-kid=\"2-8-1-1-1\" data-name=\"footer logo group\"><img alt=\"\" class=\"size-9\" data-kid=\"2-8-1-1-1-1\" data-name=\"footer logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/><span class=\"f-serif text-[26px] font-medium tracking-tight\" data-kid=\"2-8-1-1-1-2\" data-name=\"footer brand name\">Aero Fit</span></div>\n<p class=\"mt-6 max-w-[30ch] text-[13px] italic leading-[1.6] text-[#FAF8F6]/70\" data-kid=\"2-8-1-1-2\" data-name=\"footer medical disclaimer\">Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease.</p>\n</div>\n<div data-kid=\"2-8-1-2\" data-name=\"shop links column\"><p class=\"text-[12px] font-medium uppercase tracking-[0.08em] text-[#F8F38A]\" data-kid=\"2-8-1-2-1\" data-name=\"shop column heading\">Shop</p><ul class=\"mt-5 flex flex-col gap-3 text-[14px]\" data-kid=\"2-8-1-2-2\" data-name=\"shop links list\"><li data-kid=\"2-8-1-2-2-1\" data-name=\"shop link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-2-2-1-1\" data-name=\"Aero Fit Lite link\" href=\"#\">Aero Fit Lite</a></li><li data-kid=\"2-8-1-2-2-2\" data-name=\"shop link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-2-2-2-1\" data-name=\"Aero Fit Smart link\" href=\"#\">Aero Fit Smart</a></li><li data-kid=\"2-8-1-2-2-3\" data-name=\"shop link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-2-2-3-1\" data-name=\"Aero Fit Pro link\" href=\"#\">Aero Fit Pro</a></li><li data-kid=\"2-8-1-2-2-4\" data-name=\"shop link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-2-2-4-1\" data-name=\"Aero Fit Music link\" href=\"#\">Aero Fit Music</a></li><li data-kid=\"2-8-1-2-2-5\" data-name=\"shop link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-2-2-5-1\" data-name=\"Aero Fit Ultra link\" href=\"#\">Aero Fit Ultra</a></li></ul></div>\n<div data-kid=\"2-8-1-3\" data-name=\"memberships links column\"><p class=\"text-[12px] font-medium uppercase tracking-[0.08em] text-[#F8F38A]\" data-kid=\"2-8-1-3-1\" data-name=\"memberships column heading\">Memberships</p><ul class=\"mt-5 flex flex-col gap-3 text-[14px]\" data-kid=\"2-8-1-3-2\" data-name=\"memberships links list\"><li data-kid=\"2-8-1-3-2-1\" data-name=\"member link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-3-2-1-1\" data-name=\"Aero Fit One link\" href=\"#\">Aero Fit One</a></li><li data-kid=\"2-8-1-3-2-2\" data-name=\"member link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-3-2-2-1\" data-name=\"Aero Fit Peak link\" href=\"#\">Aero Fit Peak</a></li><li data-kid=\"2-8-1-3-2-3\" data-name=\"member link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-3-2-3-1\" data-name=\"Aero Fit Life link\" href=\"#\">Aero Fit Life</a></li><li data-kid=\"2-8-1-3-2-4\" data-name=\"member link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-3-2-4-1\" data-name=\"Compare plans link\" href=\"#\">Compare plans</a></li></ul></div>\n<div data-kid=\"2-8-1-4\" data-name=\"support links column\"><p class=\"text-[12px] font-medium uppercase tracking-[0.08em] text-[#F8F38A]\" data-kid=\"2-8-1-4-1\" data-name=\"support column heading\">Support</p><ul class=\"mt-5 flex flex-col gap-3 text-[14px]\" data-kid=\"2-8-1-4-2\" data-name=\"support links list\"><li data-kid=\"2-8-1-4-2-1\" data-name=\"support link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-4-2-1-1\" data-name=\"Help Center link\" href=\"#\">Help Center</a></li><li data-kid=\"2-8-1-4-2-2\" data-name=\"support link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-4-2-2-1\" data-name=\"Sizing guide link\" href=\"#\">Sizing guide</a></li><li data-kid=\"2-8-1-4-2-3\" data-name=\"support link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-4-2-3-1\" data-name=\"Accessories link\" href=\"#\">Accessories</a></li><li data-kid=\"2-8-1-4-2-4\" data-name=\"support link item\"><a class=\"hover:opacity-70\" data-kid=\"2-8-1-4-2-4-1\" data-name=\"Download App link\" href=\"#\">Download App</a></li></ul></div>\n<div data-kid=\"2-8-1-5\" data-name=\"connect/social column\"><p class=\"text-[12px] font-medium uppercase tracking-[0.08em] text-[#F8F38A]\" data-kid=\"2-8-1-5-1\" data-name=\"connect column heading\">Connect</p><div class=\"mt-5 flex gap-2\" data-kid=\"2-8-1-5-2\" data-name=\"social icon row\"><a aria-label=\"Instagram\" class=\"grid size-10 place-items-center rounded-full bg-white/10 hover:bg-white/20\" data-kid=\"2-8-1-5-2-1\" data-name=\"Instagram link icon\" href=\"#\"><i class=\"ti ti-brand-instagram text-[18px]\" data-kid=\"2-8-1-5-2-1-1\" data-name=\"Instagram icon\"></i></a><a aria-label=\"YouTube\" class=\"grid size-10 place-items-center rounded-full bg-white/10 hover:bg-white/20\" data-kid=\"2-8-1-5-2-2\" data-name=\"YouTube link icon\" href=\"#\"><i class=\"ti ti-brand-youtube text-[18px]\" data-kid=\"2-8-1-5-2-2-1\" data-name=\"YouTube icon\"></i></a><a aria-label=\"Podcast\" class=\"grid size-10 place-items-center rounded-full bg-white/10 hover:bg-white/20\" data-kid=\"2-8-1-5-2-3\" data-name=\"Podcast link icon\" href=\"#\"><i class=\"ti ti-microphone text-[18px]\" data-kid=\"2-8-1-5-2-3-1\" data-name=\"microphone icon\"></i></a><a aria-label=\"Contact\" class=\"grid size-10 place-items-center rounded-full bg-white/10 hover:bg-white/20\" data-kid=\"2-8-1-5-2-4\" data-name=\"Contact link icon\" href=\"#\"><i class=\"ti ti-mail text-[18px]\" data-kid=\"2-8-1-5-2-4-1\" data-name=\"mail icon\"></i></a></div></div>\n</div>\n<div class=\"mt-16 flex items-center justify-between border-t border-white/15 pt-6 text-[13px] italic text-[#FAF8F6]/70\" data-kid=\"2-8-2\" data-name=\"footer bottom bar\">\n<p data-kid=\"2-8-2-1\" data-name=\"footer copyright text\">© 2026 Aero Fit. Membership plans are billed annually with a 12-month minimum term.</p>\n<nav aria-label=\"Legal\" class=\"flex gap-6\" data-kid=\"2-8-2-2\" data-name=\"footer legal nav\"><a class=\"hover:opacity-70\" data-kid=\"2-8-2-2-1\" data-name=\"Terms and Conditions link\" href=\"#\">Terms &amp; Conditions</a><a class=\"hover:opacity-70\" data-kid=\"2-8-2-2-2\" data-name=\"Privacy Policy link\" href=\"#\">Privacy Policy</a><a class=\"hover:opacity-70\" data-kid=\"2-8-2-2-3\" data-name=\"Accessibility link\" href=\"#\">Accessibility</a></nav>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\">\nimport Lenis from \"https://esm.sh/lenis@1\";\n\nconst lenis = new Lenis({ lerp: 0.1 });\nlenis.on('scroll', ScrollTrigger.update);\ngsap.ticker.add((t) => lenis.raf(t * 1000));\ngsap.ticker.lagSmoothing(0);\n\ndocument.querySelectorAll('a[href^=\"#\"]').forEach((a) => {\n  a.addEventListener('click', (e) => {\n    const id = a.getAttribute('href');\n    if (id.length < 2) return;\n    const el = document.querySelector(id);\n    if (!el) return;\n    e.preventDefault();\n    lenis.scrollTo(el, { offset: -104 });\n  });\n});\n\n/* Score carousel: tabs, arrows, dots */\nconst slides = [...document.querySelectorAll('.sc-slide')];\nconst track = document.querySelector('.sc-track');\nconst tabs = [...document.querySelectorAll('.sc-tab')];\nconst dots = [...document.querySelectorAll('.sc-dot')];\nconst ACTIVE_TAB = ['bg-[#2A0B14]', 'text-white', 'ring-1', 'ring-white/60'];\nconst IDLE_TAB = ['bg-[#F3EDE9]', 'text-[#2A0B14]'];\nlet current = 0;\nfunction goTo(i) {\n  current = (i + slides.length) % slides.length;\n  const step = slides[1].offsetLeft - slides[0].offsetLeft;\n  gsap.to(track, { x: -current * step, duration: 0.7, ease: 'power3.out' });\n  slides.forEach((s, j) => gsap.to(s, { opacity: j === current ? 1 : 0.35, duration: 0.5 }));\n  tabs.forEach((t, j) => {\n    const on = j === current;\n    t.setAttribute('aria-selected', on);\n    ACTIVE_TAB.forEach((c) => t.classList.toggle(c, on));\n    IDLE_TAB.forEach((c) => t.classList.toggle(c, !on));\n  });\n  dots.forEach((d, j) => {\n    const on = j === current;\n    d.classList.toggle('w-8', on); d.classList.toggle('w-2', !on);\n    d.classList.toggle('bg-white', on); d.classList.toggle('bg-white/35', !on);\n  });\n}\ntabs.forEach((t) => t.addEventListener('click', () => goTo(+t.dataset.i)));\ndots.forEach((d) => d.addEventListener('click', () => goTo(+d.dataset.i)));\ndocument.querySelector('.sc-prev').addEventListener('click', () => goTo(current - 1));\ndocument.querySelector('.sc-next').addEventListener('click', () => goTo(current + 1));\nslides.forEach((s, j) => s.addEventListener('click', () => { if (j !== current) goTo(j); }));\n\n/* Band detail tabs */\ndocument.querySelectorAll('[data-tabs]').forEach((g) => {\n  const btns = g.querySelectorAll('[data-tab]');\n  const panels = g.querySelectorAll('[data-panel]');\n  btns.forEach((b) => b.addEventListener('click', () => {\n    btns.forEach((x) => {\n      const on = x === b;\n      x.setAttribute('aria-selected', on);\n      x.classList.toggle('bg-[#2A0B14]', on);\n      x.classList.toggle('text-white', on);\n    });\n    panels.forEach((p) => { p.hidden = p.dataset.panel !== b.dataset.tab; });\n    ScrollTrigger.refresh();\n  }));\n});\n\n/* Video pause */\nconst vid = document.querySelector('.day-video');\nconst pauseBtn = document.querySelector('.day-pause');\npauseBtn.addEventListener('click', () => {\n  const icon = pauseBtn.querySelector('i');\n  if (vid.paused) { vid.play(); icon.className = 'ti ti-player-pause text-[16px]'; pauseBtn.setAttribute('aria-label', 'Pause video'); }\n  else { vid.pause(); icon.className = 'ti ti-player-play text-[16px]'; pauseBtn.setAttribute('aria-label', 'Play video'); }\n});\n\n/* Day timeline dots */\ndocument.querySelector('.day-sec').classList.add('js-day');\ndocument.querySelectorAll('.day-row').forEach((row) => {\n  ScrollTrigger.create({ trigger: row, start: 'top 65%', end: 'bottom 35%', toggleClass: { targets: row, className: 'is-on' } });\n});\n\nconst mm = gsap.matchMedia();\nmm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {\n  /* Hero intro + parallax */\n  gsap.from('.hero-media', { scale: 1.06, duration: 1.8, ease: 'power2.out' });\n  gsap.from('.hero-lens', { scale: 0.85, autoAlpha: 0, duration: 0.9, delay: 0.5, ease: 'power3.out' });\n  gsap.from('.hero-tag', { autoAlpha: 0, x: -12, duration: 0.5, delay: 0.9, stagger: 0.12, ease: 'power2.out' });\n  gsap.from('.hero-plate', { autoAlpha: 0, y: 24, duration: 0.7, delay: 1.1, ease: 'power3.out' });\n  gsap.to('.hero-copy', { y: -60, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top 100px', end: 'bottom top', scrub: true } });\n\n  /* Signals → Recovery pinned scene */\n  const stage = document.querySelector('.signals-stage');\n  stage.classList.add('is-stacked');\n  const num = document.querySelector('.rc-num');\n  const count = { v: 0 };\n  num.textContent = '0';\n  const tl = gsap.timeline({\n    scrollTrigger: { trigger: stage, start: 'top 100px', end: '+=2600', pin: true, scrub: 0.8, anticipatePin: 1 },\n  });\n  tl.from('.cl-item', { x: (i, el) => +el.dataset.fx, y: (i, el) => +el.dataset.fy, scale: 1.12, autoAlpha: 0.55, duration: 1, stagger: 0.05, ease: 'power2.out' }, 0)\n    .from('.cl-copy', { y: 28, duration: 0.6, ease: 'power2.out' }, 0.2)\n    .to({}, { duration: 0.6 })\n    .fromTo('.recovery-panel', { yPercent: 104 }, { yPercent: 0, duration: 1, ease: 'power2.inOut' })\n    .to('.collage-panel', { scale: 0.94, autoAlpha: 0.3, duration: 1, ease: 'none' }, '<')\n    .from('.rc-device', { yPercent: 70, autoAlpha: 0, duration: 1, ease: 'power2.out' }, '-=0.35')\n    .fromTo('.rc-arc', { strokeDashoffset: 100 }, { strokeDashoffset: 18, duration: 1.2, ease: 'power1.inOut' }, '<')\n    .to(count, { v: 82, duration: 1.2, ease: 'power1.inOut', onUpdate: () => { num.textContent = Math.round(count.v); } }, '<')\n    .from('.rc-row', { autoAlpha: 0, y: 16, stagger: 0.15, duration: 0.4 }, '-=0.5')\n    .from('.rc-verdict', { autoAlpha: 0, y: 16, duration: 0.4 }, '<0.2')\n    .to({}, { duration: 0.5 });\n\n  /* Band media swaps photo → cut-out as the rail scrolls */\n  document.querySelectorAll('.band').forEach((b) => {\n    const alt = b.querySelector('.media-alt');\n    const rail = b.querySelector('.rail');\n    gsap.fromTo(alt, { opacity: 0 }, { opacity: 1, ease: 'none', scrollTrigger: { trigger: rail, start: '45% center', end: '58% center', scrub: true } });\n  });\n\n  /* Ultra: device rises into a volt charge arc */\n  gsap.timeline({ scrollTrigger: { trigger: '.u-media', start: 'top 90%', end: 'top 20%', scrub: 0.6 } })\n    .fromTo('.u-arc', { strokeDashoffset: 100 }, { strokeDashoffset: 0, ease: 'none' }, 0)\n    .from('.u-device', { yPercent: 45, ease: 'power2.out' }, 0);\n\n  return () => { stage.classList.remove('is-stacked'); num.textContent = '82'; };\n});\n\nwindow.addEventListener('load', () => ScrollTrigger.refresh());\n</script>",
