plan row\" class=\"grid h-[104px] grid-cols-[180px_200px_1fr_120px] items-center gap-6 border-t border-[#E3DDDA]\" data-kid=\"2-6-2-2\">\n        <p class=\"font-serif text-[28px] font-medium\" data-kid=\"2-6-2-2-1\">One</p>\n        <p class=\"text-[26px] font-semibold tabular-nums\" data-kid=\"2-6-2-2-2\">$199<span class=\"ml-1 text-[14px] font-normal text-[#6B4F57]\" data-kid=\"2-6-2-2-2-1\">/year</span></p>\n        <div class=\"flex items-center gap-2\" data-kid=\"2-6-2-2-3\">\n          <span class=\"flex h-11 items-center gap-2 rounded-full bg-[#F4F1EE] pr-4 pl-1 text-[14px] font-medium\" data-kid=\"2-6-2-2-3-1\"><img class=\"size-9 rounded-full bg-white object-contain mix-blend-multiply\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg\" alt=\"\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-6-2-2-3-1-1\">Lite</span>\n          <span class=\"flex h-11 items-center gap-2 rounded-full bg-[#F4F1EE] pr-4 pl-1 text-[14px] font-medium\" data-kid=\"2-6-2-2-3-2\"><img class=\"size-9 rounded-full bg-white object-contain mix-blend-multiply\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\" alt=\"\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-6-2-2-3-2-1\">Smart</span>\n        </div>\n        <p class=\"text-right text-[20px] font-semibold tabular-nums\" data-kid=\"2-6-2-2-4\">$0</p>\n      </div>\n\n      <div data-name=\"peak plan row\" class=\"grid h-[104px] grid-cols-[180px_200px_1fr_120px] items-center gap-6 border-t border-[#E3DDDA]\" data-kid=\"2-6-2-3\">\n        <p class=\"font-serif text-[28px] font-medium\" data-kid=\"2-6-2-3-1\">Peak</p>\n        <p class=\"text-[26px] font-semibold tabular-nums\" data-kid=\"2-6-2-3-2\">$299<span class=\"ml-1 text-[14px] font-normal text-[#6B4F57]\" data-kid=\"2-6-2-3-2-1\">/year</span></p>\n        <div class=\"flex items-center gap-2\" data-kid=\"2-6-2-