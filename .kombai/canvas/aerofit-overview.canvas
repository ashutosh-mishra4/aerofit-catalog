medium text-[#6B4F57]\" data-kid=\"2-4-1-3-2-4-2-1\">bpm</span></p>\n            <dl class=\"mt-4 grid grid-cols-3 gap-3 border-t border-[#E3DDDA] pt-3 text-[13px]\" data-kid=\"2-4-1-3-2-4-3\">\n              <div data-kid=\"2-4-1-3-2-4-3-1\"><dt class=\"text-[#6B4F57]\" data-kid=\"2-4-1-3-2-4-3-1-1\">30-day avg</dt><dd class=\"text-[15px] font-semibold tabular-nums\" data-kid=\"2-4-1-3-2-4-3-1-2\">54 bpm</dd></div>\n              <div data-kid=\"2-4-1-3-2-4-3-2\"><dt class=\"text-[#6B4F57]\" data-kid=\"2-4-1-3-2-4-3-2-1\">ECG</dt><dd class=\"text-[15px] font-semibold\" data-kid=\"2-4-1-3-2-4-3-2-2\">Pro, Ultra</dd></div>\n              <div data-kid=\"2-4-1-3-2-4-3-3\"><dt class=\"text-[#6B4F57]\" data-kid=\"2-4-1-3-2-4-3-3-1\">BP Insights</dt><dd class=\"text-[15px] font-semibold\" data-kid=\"2-4-1-3-2-4-3-3-2\">Pro, Ultra</dd></div>\n            </dl>\n            <div class=\"mt-4\" data-kid=\"2-4-1-3-2-4-4\">\n              <p class=\"text-[12px] text-[#6B4F57]\" data-kid=\"2-4-1-3-2-4-4-1\">Resting HR, bpm, last 7 mornings</p>\n              <div class=\"mt-2 grid grid-cols-[22px_1fr] gap-2\" data-kid=\"2-4-1-3-2-4-4-2\">\n                <div class=\"flex h-[64px] flex-col justify-between text-right text-[10px] text-[#7A5B64] tabular-nums\" data-kid=\"2-4-1-3-2-4-4-2-1\"><span data-kid=\"2-4-1-3-2-4-4-2-1-1\">58</span><span data-kid=\"2-4-1-3-2-4-4-2-1-2\">53</span><span data-kid=\"2-4-1-3-2-4-4-2-1-3\">48</span></div>\n                <div class=\"flex h-[64px] items-end justify-between border-b border-[#D9D0CB] px-1\" data-kid=\"2-4-1-3-2-4-4-2-2\">\n                  <span class=\"w-5 rounded-t-[4px] bg-[#2A0B14]/20\" style=\"height:45px\" data-kid=\"2-4-1-3-2-4-4-2-2-1\"></span><span class=\"w-5 rounded-t-[4px] bg-[#2A0B14]/20\" style=\"height:38px\" data-kid=\"2-4-1-3-2-4-4-2-2-2\"></span><span class=\"w-5 rounded-t-[4px] bg-[#2A0B14]/20\" style=\"height:32px\" data-kid=\"2-4-1-3-2-4-4-2-2-3\"></span><span class=\"w-5 rounded-t-[4px] bg-[#2A0B14]/20\" style=\"height:38px\" data-kid=\"2-4-1-3-2-4-4-2-2-4\"></span><span class=\"w-5 rounded-t-[4px] bg-[#2A0B14]/20\" style=\"height:26px\" data-kid=\"2-4-1-3-2-4-4-2-2-5\"></span><span class=\"w-5 rounded-t-[4px] bg-[#2A0B14]/20\" style=\"height:32px\" data-kid=\"2-4-1-3-2-4-4-2-2-6\"></span><span class=\"relative w-5 rounded-t-[4px] bg-[#2A0B14]\" style=\"height:26px\" data-kid=\"2-4-1-3-2-4-4-2-2-7\"><span class=\"absolute -top-[22px] left-1/2 -translate-x-1/2 rounded-full bg-[#F8F38A] px-1.5 text-[10px] font-semibold tabular-nums\" data-kid=\"2-4-1-3-2-4-4-2-2-7-1\">52</span></span>\n                </div>\n                <span data-kid=\"2-4-1-3-2-4-4-2-3\"></span>\n                <div class=\"flex justify-between px-1 text-[10px] text-[#7A5B64]\" data-kid=\"2-4-1-3-2-4-4-2-4\"><span class=\"w-5 text-center\" data-kid=\"2-4-1-3-2-4-4-2-4-1\">W</span><span class=\"w-5 text-center\" data-kid=\"2-4-1-3-2-4-4-2-4-2\">T</span><span class=\"w-5 text-center\" data-kid=\"2-4-1-3-2-4-4-2-4-3\">F</span><span class=\"w-5 text-center\" data-kid=\"2-4-1-3-2-4-4-2-4-4\">S</span><span class=\"w-5 text-center\" data-kid=\"2-4-1-3-2-4-4-2-4-5\">S</span><span class=\"w-5 text-center\" data-kid=\"2-4-1-3-2-4-4-2-4-6\">M</span><span class=\"w-5 text-center font-semibold text-[#2A0B14]\" data-kid=\"2-4-1-3-2-4-4-2-4-7\">T</span></div>\n              </div>\n            </div>\n            <ul class=\"mt-4 flex gap-1.5 text-[12px] font-medium whitespace-nowrap text-[#4A2A33]\" data-kid=\"2-4-1-3-2-4-5\"><li class=\"rounded-full bg-white px-2.5 py-1\" data-kid=\"2-4-1-3-2-4-5-1\">Resting HR</li><li class=\"rounded-full bg-white px-2.5 py-1\" data-kid=\"2-4-1-3-2-4-5-2\">ECG</li><li class=\"rounded-full bg-white px-2.5 py-1\" data-kid=\"2-4-1-3-2-4-5-3\">Blood pressure</li></ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 3. Hardware stage -->\n  <section data-name=\"hardware stage\" class=\"hardware relative z-10 mx-4 mt-6 rounded-[28px] bg-[#F3EDE9] px-14 pt-20 pb-20\" data-kid=\"2-5\">\n    <div class=\"flex items-end justify-between gap-10\" data-kid=\"2-5-1\">\n      <h2 data-name=\"hardware heading\" class=\"max-w-[640px] font-serif text-[46px] leading-[1.08] font-medium tracking-[-0.01em]\" data-kid=\"2-5-1-1\">The same scores. Five ways to wear them.</h2>\n      <p data-name=\"hardware note\" class=\"max-w-[380px] pb-1 text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"2-5-1-2\">Each band is $0 with the membership that includes it, or you can buy it outright.</p>\n    </div>\n\n    <!-- Shelf -->\n    <ul data-name=\"band shelf\" class=\"shelf mt-12 grid grid-cols-5 gap-4\" data-kid=\"2-5-2\">\n      <li data-name=\"lite shelf column\" data-kid=\"2-5-2-1\">\n        <div class=\"flex h-[270px] items-center justify-center rounded-[16px] bg-white\" data-kid=\"2-5-2-1-1\"><img class=\"shelf-img h-[230px] w-[200px] object-contain mix-blend-multiply brightness-110 contrast-105\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg\" alt=\"Aero Fit Lite in Slate\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-5-2-1-1-1\"></div>\n        <p class=\"mt-4 font-serif text-[24px] leading-none font-medium\" data-kid=\"2-5-2-1-2\">Lite</p>\n        <p class=\"mt-2 text-[14px] text-[#4A2A33]\" data-kid=\"2-5-2-1-3\">18 g, the lightest band</p>\n        <div class=\"mt-4 flex items-baseline justify-between border-t border-[#E3DDDA] pt-3 text-[13px]\" data-kid=\"2-5-2-1-4\"><span class=\"text-[#6B4F57]\" data-kid=\"2-5-2-1-4-1\">Included from One</span><span class=\"font-semibold tabular-nums\" data-kid=\"2-5-2-1-4-2\">$199/yr</span></div>\n      </li>\n      <li data-name=\"smart shelf column\" data-kid=\"2-5-2-2\">\n        <div class=\"flex h-[270px] items-center justify-center rounded-[16px] bg-white\" data-kid=\"2-5-2-2-1\"><img class=\"shelf-img h-[230px] w-[200px] object-contain mix-blend-multiply brightness-110 contrast-105\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\" alt=\"Aero Fit Smart in Black\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-5-2-2-1-1\"></div>\n        <p class=\"mt-4 font-serif text-[24px] leading-none font-medium\" data-kid=\"2-5-2-2-2\">Smart</p>\n        <p class=\"mt-2 text-[14px] text-[#4A2A33]\" data-kid=\"2-5-2-2-3\">Always-on AMOLED display</p>\n        <div class=\"mt-4 flex items-baseline justify-between border-t border-[#E3DDDA] pt-3 text-[13px]\" data-kid=\"2-5-2-2-4\"><span class=\"text-[#6B4F57]\" data-kid=\"2-5-2-2-4-1\">Included from One</span><span class=\"font-semibold tabular-nums\" data-kid=\"2-5-2-2-4-2\">$199/yr</span></div>\n      </li>\n      <li data-name=\"pro shelf column\" data-kid=\"2-5-2-3\">\n        <div class=\"flex h-[270px] items-center justify-center rounded-[16px] bg-white\" data-kid=\"2-5-2-3-1\"><img class=\"shelf-img h-[230px] w-[200px] object-contain mix-blend-multiply brightness-110 contrast-105\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg\" alt=\"Aero Fit Pro in Graphite\" decoding=\"async\" loading=\"lazy\" data-kid=\"2-5-2-3-1-1\"></div>\n        <p class=\"mt-4 font-serif text-[24px] leading-none font-medium\" data-kid=\"2-5-2-3-2\">Pro</p>\n        <p class=\"mt-2 text-[14px] text-[#4A2A33]\" data-kid=\"2-5-2-3-3\">Built-in GPS and ECG</p>\n        <div class=\"mt-4 flex items-baseline justify-between border-t border-[#E3DDDA] pt-3 text-[13px]\" data-kid=\"2-5-2-3-4\"><span class=\"text-[#6B4F57]\" data-kid=\"2-5-2-3-4-1\">Included from Peak</span><span class=\"font-semibold tabular-nums\" data-kid=\"2-5-2-3-4-2\">$299/yr</span></div>\n      </li>\n      <li data-name=\"music shelf column\" data-kid=\"2-5-2-4\">\n        <div class=\"flex h-[270px] items-center justify-center rounded-[16px] bg-white\" data-kid=\"2-5-2-4-1\"><img class=\"shelf-img h-