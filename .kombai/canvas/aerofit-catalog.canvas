 Ultra outright · $399\n                </button>\n                <p class=\"mt-3 text-[14px] text-white/70\" data-kid=\"1-9-1-2-2\">\n                    Included with Life · $33/month\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- Comparison -->\n    <section class=\"max-w-[1180px] mx-auto px-[20px] pt-28 pb-24\" data-kid=\"1-10\" id=\"compare\">\n        <h2 class=\"serif text-[44px] leading-[1.1] font-medium tracking-[-0.01em]\" data-kid=\"1-10-1\">\n            All five, side by side\n        </h2>\n        <div class=\"mt-8 rounded-[24px] bg-white border border-[#EFEAE6]\" data-kid=\"1-10-2\">\n            <table class=\"w-full text-[14px] border-separate border-spacing-0\" data-kid=\"1-10-2-1\">\n                <thead class=\"sticky top-0 z-10\" data-dynamic=\"true\" data-kid=\"1-10-2-1-1\" data-name=\"comparison table header\" data-reason=\"header row rendered by renderTable() from scripted spec data\" id=\"specHead\">\n                </thead>\n                <tbody data-dynamic=\"true\" data-kid=\"1-10-2-1-2\" data-name=\"comparison table body\" data-reason=\"spec rows rendered and re-rendered by renderTable() from scripted data\" id=\"specBody\">\n                </tbody>\n            </table>\n            <div class=\"p-5 border-t border-[#F0EBE8] text-center\" data-kid=\"1-10-2-2\">\n                <button class=\"h-11 px-5 rounded-full border border-[#2A0B14] text-[14px] font-medium hover:bg-[#2A0B14] hover:text-white transition\" data-dynamic=\"true\" data-kid=\"1-10-2-2-1\" data-name=\"show all specifications toggle button\" data-reason=\"button label text replaced in renderTable() on toggle\" id=\"showAll\">\n                    Show all 16 specifications\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"mx-4 rounded-[28px] bg-[#F3EDE9] px-[80px] pt-14 pb-8\" data-kid=\"1-11\">\n        <a class=\"flex items-center gap-2.5\" data-kid=\"1-11-1\" href=\"#overview\">\n            <img alt=\"Aero Fit logo\" class=\"w-10 h-10\" data-kid=\"1-11-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/aerofit-mark.svg\"/>\n            <span class=\"serif text-[32px] font-medium tracking-tight\" data-kid=\"1-11-1-2\">\n                Aero Fit\n            </span>\n        </a>\n        <div class=\"mt-12 grid grid-cols-[400px_1fr] gap-16\" data-kid=\"1-11-2\">\n            <div class=\"bg-white rounded-[22px] p-6 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"1-11-2-1\">\n                <p class=\"text-[17px] font-medium\" data-kid=\"1-11-2-1-1\">\n                    Get health tips in your inbox\n                </p>\n                <p class=\"mt-1.5 text-[13px] leading-[1.55] text-[#6B4F57]\" data-kid=\"1-11-2-1-2\">\n                    Sleep, recovery and training insights from the Aero Fit performance team, every week.\n                </p>\n                <label class=\"block mt-5 text-[13px] font-medium\" data-kid=\"1-11-2-1-3\" for=\"nlC\">\n                    Email address\n                </label>\n                <form class=\"mt-2 h-[52px] rounded-full bg-[#FAF8F6] border border-[#EFEAE6] pl-5 pr-1.5 flex items-center gap-2\" data-kid=\"1-11-2-1-4\">\n                    <input class=\"flex-1 bg-transparent outline-hidden text-[14px] placeholder:text-[#9A8E91]\" data-kid=\"1-11-2-1-4-1\" id=\"nlC\" placeholder=\"you@example.com\" type=\"email\"/>\n                    <button class=\"h-10 px-5 rounded-full bg-[#2A0B14] text-white text-[13px] font-medium\" data-kid=\"1-11-2-1-4-2\" type=\"button\">\n                        Subscribe\n                    </button>\n                </form>\n            </div>\n            <div class=\"grid grid-cols-4 gap-8 text-[14px] pt-2\" data-kid=\"1-11-2-2\">\n                <div data-kid=\"1-11-2-2-1\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-11-2-2-1-1\">\n                        Memberships\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-11-2-2-1-2\">\n                        <li data-kid=\"1-11-2-2-1-2-1\">\n                            Aero Fit One\n                        </li>\n                        <li data-kid=\"1-11-2-2-1-2-2\">\n                            Aero Fit Peak\n                        </li>\n                        <li data-kid=\"1-11-2-2-1-2-3\">\n                            Aero Fit Life\n                        </li>\n                        <li data-kid=\"1-11-2-2-1-2-4\">\n                            Compare plans\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-11-2-2-2\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-11-2-2-2-1\">\n                        Shop\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-11-2-2-2-2\">\n                        <li data-kid=\"1-11-2-2-2-2-1\">\n                            Lite\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-2\">\n                            Smart\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-3\">\n                            Music\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-4\">\n                            Pro\n                        </li>\n                        <li data-kid=\"1-11-2-2-2-2-5\">\n                            Ultra\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-11-2-2-3\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-11-2-2-3-1\">\n                        Support\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-11-2-2-3-2\">\n                        <li data-kid=\"1-11-2-2-3-2-1\">\n                            Help Center\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-2\">\n                            Sizing\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-3\">\n                            Accessories\n                        </li>\n                        <li data-kid=\"1-11-2-2-3-2-4\">\n                            Download App\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-11-2-2-4\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-11-2-2-4-1\">\n                        Connect\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-11-2-2-4-2\">\n                        <li data-kid=\"1-11-2-2-4-2-1\">\n                            Instagram\n                        </li>\n                        <li data-kid=\"1-11-2-2-4-2-2\">\n                            YouTube\n                        </li>\n                        <li data-kid=\"1-11-2-2-4-2-3\">\n                            Podcast\n                        </li>\n                        <li data-kid=\"1-11-2-2-4-2-4\">\n                            Contact\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-12 h-14 rounded-full bg-white px-6 flex items-center justify-between text-[13px] text-[#6B4F57]\" data-kid=\"1-11-3\">\n            <div class=\"flex gap-5\" data-kid=\"1-11-3-1\">\n                <span data-kid=\"1-11-3-1-1\">\n                    Terms & Conditions\n                </span>\n                <span data-kid=\"1-11-3-1-2\">\n                    Privacy Policy\n                </span>\n                <span data-kid=\"1-11-3-1-3\">\n                    Accessibility\n                </span>\n            </div>\n            <span data-kid=\"1-11-3-2\">\n                © 2026 Aero Fit. All rights reserved.\n            </span>\n        </div>\n        <p class=\"mt-6 px-2 text-[12px] leading-[1.7] text-[#7A5B64] max-w-[900px]\" data-kid=\"1-11-4\">\n            Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease.\n        </p>\n    </footer>\n</div>\n<script>\n    const N=[['lite','Lite',149,'One · $16/mo'],['smart','Smart',199,'One · $16/mo'],['pro','Pro',299,'Peak · $25/mo'],['music','Music',279,'Peak · $25/mo'],['ultra','Ultra',399,'Life · $33/mo']];\nconst ROWS=[['Battery life',['5 days','7 days','10 days','6 days','14 days'],1],['GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],['ECG with Heart Screener',[0,0,1,0,1],1],['Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],['Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],['Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],['Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],['Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],['Sleep stages & Sleep Performance',[1,1,1,1,1],0],['Recovery & Strain scores',[1,1,1,1,1],0],['Skin temperature',[0,1,1,1,1],0],['Blood Pressure Insights',[0,0,1,0,1],0],['Workout types',['20','40','120','80','150'],0],['Bluetooth headphones',[0,0,0,1,0],0]];\nlet showAll=false;\nconst cell=v=>v===1?'<span class=\"text-[17px]\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[#C9C0C2]\">—</span>':v;\nfunction renderTable(){\n  document.getElementById('specHead').innerHTML=`<tr><th class=\"bg-white rounded-tl-[24px] text-left font-medium text-[#6B4F57] p-5 w-[240px] border-b border-[#F0EBE8] align-bottom\">Specification</th>${N.map((n,i)=>`<th class=\"bg-white p-5 text-left font-normal border-b border-[#F0EBE8] ${i===4?'rounded-tr-[24px]':''}\"><a href=\"#${n[0]}\" class=\"serif text-[22px] font-medium leading-none hover:underline\">${n[1]}</a><p class=\"mt-2 text-[14px] font-medium\">$${n[2]} outright</p><p class=\"text-[13px] text-[#6B4F57]\">or with ${n[3]}</p></th>`).join('')}</tr>`;\n  document.getElementById('specBody').innerHTML=ROWS.filter(r=>showAll||r[2]).map(r=>`<tr><td class=\"px-5 py-3.5 border-b border-[#F3EFEC] text-[#4A2A33]\">${r[0]}</td>${r[1].map(v=>`<td class=\"px-5 py-3.5 border-b border-[#F3EFEC]\">${cell(v)}</td>`).join('')}</tr>`).join('');\n  document.getElementById('showAll').textContent=showAll?'Show 6 key specifications':'Show all 14 specifications';\n}\ndocument.getElementById('showAll').onclick=()=>{showAll=!showAll;renderTable();};\nrenderTable();\n</script>\n",
