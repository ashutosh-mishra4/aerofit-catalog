    },
    "var_76dd17e29d33": {
      "type": "variant",
      "label": "Catalog C — Product stories",
      "parentId": "var_97e0fc53588e",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip py-5\" data-kid=\"1\">\n    <!-- Nav -->\n    <header class=\"mx-4 h-[68px] rounded-full bg-white shadow-[0_4px_18px_rgba(42,11,20,0.06)] border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-6\" data-kid=\"1-1-1\">\n            <a class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2\" data-kid=\"1-1-1-1\" href=\"#overview\">\n                <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/aerofit-mark.svg\"/>\n                Aero Fit\n            </a>\n            <nav class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-2\">\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] hover:bg-[#ECE6E2] flex items-center transition\" data-kid=\"1-1-1-2-1\" href=\"#overview\">\n                    Overview\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] hover:bg-[#ECE6E2] flex items-center transition\" data-kid=\"1-1-1-2-2\" href=\"#how-it-works\">\n                    How it works\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-2-3\" href=\"#shop\">\n                    Shop bands\n                </a>\n            </nav>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-2\">\n            <a class=\"h-[52px] px-4 rounded-full border border-[#EFEAE6] flex items-center gap-2 text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-2-1\" href=\"#cart\">\n                <span class=\"text-[18px]\" data-kid=\"1-1-2-1-1\">\n                    <i class=\"ti ti-shopping-bag\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                Cart · 0\n            </a>\n            <button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-2-2\">\n                Join Aero Fit free\n            </button>\n        </div>\n    </header>\n    <!-- Hero: poster-scale Ultra -->\n    <section class=\"mx-4 mt-5 relative h-[640px] rounded-[28px] bg-[#EFEBE6] overflow-hidden\" data-kid=\"1-2\">\n        <img alt=\"Aero Fit Ultra in titanium with trail-green strap, showing a topographic route on its display\" class=\"absolute right-[40px] top-1/2 -translate-y-1/2 w-[640px] h-[640px] object-cover [mask-image:linear-gradient(90deg,transparent,#000_18%,#000_85%,transparent)]\" data-kid=\"1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/>\n        <h1 class=\"serif absolute left-[80px] top-[60px] text-[104px] leading-[0.94] font-medium tracking-[-0.035em]\" data-kid=\"1-2-2\">\n            14 days.\n            <br data-kid=\"1-2-2-1\"/>\n            Dual-band\n            <br data-kid=\"1-2-2-2\"/>\n            GPS.\n        </h1>\n        <div class=\"absolute left-[80px] bottom-[48px] w-[540px] rounded-[22px] bg-white/85 backdrop-blur-md p-6 shadow-[0_14px_40px_rgba(42,11,20,0.10)]\" data-kid=\"1-2-3\">\n            <p class=\"serif text-[26px] font-medium leading-none\" data-kid=\"1-2-3-1\">\n                Aero Fit Ultra\n            </p>\n            <p class=\"mt-2 text-[15px] text-[#4A2A33] leading-[1.5]\" data-kid=\"1-2-3-2\">\n                A titanium case rated to 100 m, for multi-day races and long training blocks. Ships Nov 4.\n            </p>\n            <div class=\"mt-5 flex items-center gap-4\" data-kid=\"1-2-3-3\">\n                <button class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium whitespace-nowrap hover:bg-[#45172A] transition\" data-kid=\"1-2-3-3-1\" data-name=\"primary buy Ultra button\">\n                    Buy Ultra outright · $399\n                </button>\n                <a class=\"text-[14px] whitespace-nowrap underline underline-offset-4 hover:opacity-70\" data-kid=\"1-2-3-3-2\" data-name=\"Ultra subscription price link\" href=\"#plans\">\n                    Included with Life · $33/month\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- Lineup index -->\n    <nav aria-label=\"Product lineup\" class=\"max-w-[1180px] mx-auto px-[20px] pt-16\" data-kid=\"1-3\">\n        <div class=\"grid grid-cols-5 gap-4\" data-kid=\"1-3-1\">\n            <a class=\"group flex items-center gap-3 rounded-[18px] p-2 pr-3 hover:bg-white transition\" data-kid=\"1-3-1-1\" href=\"#lite\">\n                <div class=\"w-[72px] h-[72px] rounded-[14px] bg-[#EFEBE6] overflow-hidden shrink-0\" data-kid=\"1-3-1-1-1\">\n                    <img alt=\"Aero Fit Lite\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg\"/>\n                </div>\n                <div data-kid=\"1-3-1-1-2\">\n                    <p class=\"serif text-[21px] font-medium leading-none\" data-kid=\"1-3-1-1-2-1\">\n                        Lite\n                    </p>\n                    <p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"1-3-1-1-2-2\">\n                        $149\n                    </p>\n                </div>\n                <span class=\"ml-auto text-[16px] opacity-0 group-hover:opacity-100 transition\" data-kid=\"1-3-1-1-3\">\n                    <i class=\"ti ti-arrow-down\" data-kid=\"1-3-1-1-3-1\">\n                    </i>\n                </span>\n            </a>\n            <a class=\"group flex items-center gap-3 rounded-[18px] p-2 pr-3 hover:bg-white transition\" data-kid=\"1-3-1-2\" href=\"#smart\">\n                <div class=\"w-[72px] h-[72px] rounded-[14px] bg-[#EFEBE6] overflow-hidden shrink-0\" data-kid=\"1-3-1-2-1\">\n                    <img alt=\"Aero Fit Smart\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\"/>\n                </div>\n                <div data-kid=\"1-3-1-2-2\">\n                    <p class=\"serif text-[21px] font-medium leading-none\" data-kid=\"1-3-1-2-2-1\">\n                        Smart\n                    </p>\n                    <p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"1-3-1-2-2-2\">\n                        $199\n                    </p>\n                </div>\n                <span class=\"ml-auto text-[16px] opacity-0 group-hover:opacity-100 transition\" data-kid=\"1-3-1-2-3\">\n                    <i class=\"ti ti-arrow-down\" data-kid=\"1-3-1-2-3-1\">\n                    </i>\n                </span>\n            </a>\n            <a class=\"group flex items-center gap-3 rounded-[18px] p-2 pr-3 hover:bg-white transition\" data-kid=\"1-3-1-3\" href=\"#music\">\n                <div class=\"w-[72px] h-[72px] rounded-[14px] bg-[#EFEBE6] overflow-hidden shrink-0\" data-kid=\"1-3-1-3-1\">\n                    <img alt=\"Aero Fit Music\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg\"/>\n                </div>\n                <div data-kid=\"1-3-1-3-2\">\n                    <p class=\"serif text-[21px] font-medium leading-none\" data-kid=\"1-3-1-3-2-1\">\n                        Music\n                    </p>\n                    <p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"1-3-1-3-2-2\">\n                        $279\n                    </p>\n                </div>\n                <span class=\"ml-auto text-[16px] opacity-0 group-hover:opacity-100 transition\" data-kid=\"1-3-1-3-3\">\n                    <i class=\"ti ti-arrow-down\" data-kid=\"1-3-1-3-3-1\">\n                    </i>\n                </span>\n            </a>\n            <a class=\"group flex items-center gap-3 rounded-[18px] p-2 pr-3 hover:bg-white transition\" data-kid=\"1-3-1-4\" href=\"#pro\">\n                <div class=\"w-[72px] h-[72px] rounded-[14px] bg-[#EFEBE6] overflow-hidden shrink-0\" data-kid=\"1-3-1-4-1\">\n                    <img alt=\"Aero Fit Pro\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg\"/>\n                </div>\n                <div data-kid=\"1-3-1-4-2\">\n                    <p class=\"serif text-[21px] font-medium leading-none\" data-kid=\"1-3-1-4-2-1\">\n                        Pro\n                    </p>\n                    <p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"1-3-1-4-2-2\">\n                        $299\n                    </p>\n                </div>\n                <span class=\"ml-auto text-[16px] opacity-0 group-hover:opacity-100 transition\" data-kid=\"1-3-1-4-3\">\n                    <i class=\"ti ti-arrow-down\" data-kid=\"1-3-1-4-3-1\">\n                    </i>\n                </span>\n            </a>\n            <a class=\"group flex items-center gap-3 rounded-[18px] p-2 pr-3 hover:bg-white transition\" data-kid=\"1-3-1-5\" href=\"#ultra\">\n                <div class=\"w-[72px] h-[72px] rounded-[14px] bg-[#EFEBE6] overflow-hidden shrink-0\" data-kid=\"1-3-1-5-1\">\n                    <img alt=\"Aero Fit Ultra\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-5-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/>\n                </div>\n                <div data-kid=\"1-3-1-5-2\">\n                    <p class=\"serif text-[21px] font-medium leading-none\" data-kid=\"1-3-1-5-2-1\">\n                        Ultra\n                    </p>\n                    <p class=\"mt-1 text-[14px] text-[#6B4F57]\" data-kid=\"1-3-1-5-2-2\">\n                        $399\n                    </p>\n                </div>\n                <span class=\"ml-auto text-[16px] opacity-0 group-hover:opacity-100 transition\" data-kid=\"1-3-1-5-3\">\n                    <i class=\"ti ti-arrow-down\" data-kid=\"1-3-1-5-3-1\">\n                    </i>\n                </span>\n            </a>\n        </div>\n    </nav>\n    <!-- Lite chapter: weight as hero number -->\n    <section class=\"max-w-[1180px] mx-auto px-[20px] pt-32\" data-kid=\"1-4\" id=\"lite\">\n        <div class=\"grid grid-cols-[1fr_520px] gap-12 items-end\" data-kid=\"1-4-1\">\n            <div data-kid=\"1-4-1-1\">\n                <p class=\"serif text-[220px] leading-[0.8] font-medium tracking-[-0.05em]\" data-kid=\"1-4-1-1-1\">\n                    18\n                    <span class=\"text-[90px] tracking-normal ml-2\" data-kid=\"1-4-1-1-1-1\">\n                        g\n                    </span>\n                </p>\n                <h2 class=\"serif mt-10 text-[44px] leading-[1.1] font-medium tracking-[-0.01em]\" data-kid=\"1-4-1-1-2\">\n                    Lite. The band you forget you're wearing.\n                </h2>\n                <p class=\"mt-4 text-[16px] leading-[1.6] text-[#4A2A33] max-w-[520px]\" data-kid=\"1-4-1-1-3\">\n                    Featherweight tracking for sleep, steps and daily recovery. A woven strap and a 5-day battery, for anyone who mostly wants to sleep better.\n                </p>\n                <div class=\"mt-8 flex items-center gap-5\" data-kid=\"1-4-1-1-4\">\n                    <button class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-4-1-1-4-1\">\n                        Buy Lite outright · $149\n                    </button>\n                    <a class=\"text-[14px] underline underline-offset-4\" data-kid=\"1-4-1-1-4-2\" href=\"#plans\">\n                        Included with One · $16/month\n                    </a>\n                </div>\n                <a class=\"mt-5 inline-flex items-center gap-1 text-[14px] text-[#6B4F57] hover:text-[#2A0B14]\" data-kid=\"1-4-1-1-5\" href=\"#compare\">\n                    Compare with Smart\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-4-1-1-5-1\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"h-[560px] rounded-[28px] bg-[#EFEBE6] overflow-hidden\" data-kid=\"1-4-1-2\">\n                <img alt=\"Aero Fit Lite in slate woven strap\" class=\"w-full h-full object-cover\" data-kid=\"1-4-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg\"/>\n            </div>\n        </div>\n    </section>\n    <!-- Smart chapter: centered with flanking facts -->\n    <section class=\"pt-16\" data-kid=\"1-5\" id=\"smart\">\n        <div class=\"mx-4 rounded-[28px] bg-[linear-gradient(180deg,#FAF8F6_0%,#F3EDE9_100%)] pt-20 pb-16 text-center\" data-kid=\"1-5-1\">\n            <h2 class=\"serif text-[52px] leading-[1.08] font-medium tracking-[-0.015em]\" data-kid=\"1-5-1-1\">\n                Smart. Your night, readable at a glance.\n            </h2>\n            <p class=\"mt-4 text-[16px] leading-[1.6] text-[#4A2A33] max-w-[560px] mx-auto\" data-kid=\"1-5-1-2\">\n                Everyday sleep, strain and recovery on an always-on display, now with skin temperature.\n            </p>\n            <div class=\"mt-12 grid grid-cols-[1fr_440px_1fr] items-center max-w-[1100px] mx-auto\" data-kid=\"1-5-1-3\">\n                <div class=\"text-right pr-10\" data-kid=\"1-5-1-3-1\">\n                    <p class=\"serif text-[40px] font-medium leading-none\" data-kid=\"1-5-1-3-1-1\">\n                        AMOLED\n                    </p>\n                    <p class=\"mt-2 text-[15px] text-[#4A2A33]\" data-kid=\"1-5-1-3-1-2\">\n                        Always-on display.\n                        <br data-kid=\"1-5-1-3-1-2-1\"/>\n                        See Recovery without a tap.\n                    </p>\n                </div>\n                <div class=\"h-[440px] rounded-full bg-[#EFEBE6] overflow-hidden\" data-kid=\"1-5-1-3-2\">\n                    <img alt=\"Aero Fit Smart in black with always-on display\" class=\"w-full h-full object-cover\" data-kid=\"1-5-1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\"/>\n                </div>\n                <div class=\"text-left pl-10\" data-kid=\"1-5-1-3-3\">\n                    <p class=\"serif text-[40px] font-medium leading-none\" data-kid=\"1-5-1-3-3-1\">\n                        Skin temp\n                    </p>\n                    <p class=\"mt-2 text-[15px] text-[#4A2A33]\" data-kid=\"1-5-1-3-3-2\">\n                        Nightly temperature trend.\n                        <br data-kid=\"1-5-1-3-3-2-1\"/>\n                        Spot changes in how you feel.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-12 flex items-center justify-center gap-5\" data-kid=\"1-5-1-4\">\n                <button class=\"h-12 px-6 rounded-full bg-[#