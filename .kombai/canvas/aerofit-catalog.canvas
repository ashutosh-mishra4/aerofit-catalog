                    <i class=\"ti ti-arrow-right\" data-kid=\"1-7-1-1-4-1\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"bg-[#EFEBE6]\" data-kid=\"1-7-1-2\">\n                <img alt=\"Aero Fit Music playing a song with headphones connected\" class=\"w-full h-full object-cover\" data-kid=\"1-7-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg\"/>\n            </div>\n        </div>\n    </section>\n    <!-- Pro chapter: technical list -->\n    <section class=\"max-w-[1180px] mx-auto px-[20px] pt-28\" data-kid=\"1-8\" id=\"pro\">\n        <div class=\"grid grid-cols-[480px_1fr] gap-16 items-center\" data-kid=\"1-8-1\">\n            <div class=\"h-[540px] rounded-[28px] bg-[#EFEBE6] overflow-hidden\" data-kid=\"1-8-1-1\">\n                <img alt=\"Aero Fit Pro in graphite tracking a GPS run\" class=\"w-full h-full object-cover\" data-kid=\"1-8-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg\"/>\n            </div>\n            <div data-kid=\"1-8-1-2\">\n                <h2 class=\"serif text-[52px] leading-[1.06] font-medium tracking-[-0.015em]\" data-kid=\"1-8-1-2-1\">\n                    Pro. Leave the phone at home.\n                </h2>\n                <p class=\"mt-4 text-[16px] leading-[1.6] text-[#4A2A33] max-w-[480px]\" data-kid=\"1-8-1-2-2\">\n                    Built-in GPS and ECG for structured training, with Blood Pressure Insights each morning.\n                </p>\n                <dl class=\"mt-8 divide-y divide-[#E3DDDA] border-y border-[#E3DDDA] text-[15px]\" data-kid=\"1-8-1-2-3\">\n                    <div class=\"flex items-center gap-4 py-4\" data-kid=\"1-8-1-2-3-1\">\n                        <span class=\"text-[20px] w-6\" data-kid=\"1-8-1-2-3-