      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip py-5\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Nav -->\n    <header class=\"mx-4 h-[68px] rounded-full bg-white shadow-[0_4px_18px_rgba(42,11,20,0.06)] border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1\" data-name=\"main navigation header\">\n        <div class=\"flex items-center gap-6\" data-kid=\"1-1-1\" data-name=\"brand and navigation group\">\n            <a class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2\" data-kid=\"1-1-1-1\" data-name=\"brand logo link with wordmark\" href=\"#overview\">\n                <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/aerofit-mark.svg\"/>\n                Aero Fit\n            </a>\n            <nav class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"primary navigation\">\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] hover:bg-[#ECE6E2] flex items-center transition\" data-kid=\"1-1-1-2-1\" data-name=\"overview nav link\" href=\"#overview\">\n                    Overview\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] hover:bg-[#ECE6E2] flex items-center transition\" data-kid=\"1-1-1-2-2\" data-name=\"how it works nav link\" href=\"#how-it-works\">\n                    How it works\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-2-3\" data-name=\"shop bands nav link\" href=\"#shop\">\n                    Shop bands\n                </a>\n            </nav>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-2\" data-name=\"nav actions group\">\n            <a class=\"h-[52px] px-4 rounded-full border border-[#EFEAE6] flex items-center gap-2 text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-2-1\" data-name=\"cart link with item count\" href=\"#cart\">\n                <span class=\"text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"shopping bag icon wrapper\">\n                    <i class=\"ti ti-shopping-bag\" data-kid=\"1-1-2-1-1-1\" data-name=\"shopping bag icon\">\n                    </i>\n                </span>\n                Cart · 0\n            </a>\n            <button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-2-2\" data-name=\"join free call-to-action button\">\n                Join Aero Fit free\n            </button>\n        </div>\n    </header>\n    <!-- Hero: featured Ultra -->\n    <section class=\"mx-4 mt-5 rounded-[28px] bg-[#EFEBE6] overflow-hidden grid grid-cols-[1fr_520px] h-[520px]\" data-kid=\"1-2\" data-name=\"hero section featuring Ultra band\">\n        <div class=\"pl-[96px] pr-8 flex flex-col justify-center\" data-kid=\"1-2-1\" data-name=\"hero content column\">\n            <h1 class=\"serif text-[60px] leading-[1.04] font-medium tracking-[-0.02em]\" data-kid=\"1-2-1-1\" data-name=\"hero headline text\">\n                Ultra. Fourteen days\n                <br data-kid=\"1-2-1-1-1\" data-name=\"line break\"/>\n                between charges.\n            </h1>\n            <p class=\"mt-5 text-[16px] leading-[1.55] text-[#4A2A33] max-w-[460px]\" data-kid=\"1-2-1-2\" data-name=\"hero product description\">\n                Titanium case, dual-band GPS and 14 days of battery for multi-day races and long training blocks.\n            </p>\n            <dl class=\"mt-8 flex gap-10\" data-kid=\"1-2-1-3\" data-name=\"hero spec stats list\">\n                <div data-kid=\"1-2-1-3-1\" data-name=\"battery stat item\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-3-1-1\" data-name=\"battery stat label\">\n                        Battery\n                    </dt>\n                    <dd class=\"serif text-[30px] font-medium leading-tight\" data-kid=\"1-2-1-3-1-2\" data-name=\"battery stat value\">\n                        14 days\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-1-3-2\" data-name=\"GPS stat item\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-3-2-1\" data-name=\"GPS stat label\">\n                        GPS\n                    </dt>\n                    <dd class=\"serif text-[30px] font-medium leading-tight\" data-kid=\"1-2-1-3-2-2\" data-name=\"GPS stat value\">\n                        Dual-band\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-1-3-3\" data-name=\"water resistance stat item\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-3-3-1\" data-name=\"water stat label\">\n                        Water\n                    </dt>\n                    <dd class=\"serif text-[30px] font-medium leading-tight\" data-kid=\"1-2-1-3-3-2\" data-name=\"water stat value\">\n                        100 m\n                    </dd>\n                </div>\n            </dl>\n            <div class=\"mt-8 flex items-center gap-5\" data-kid=\"1-2-1-4\" data-name=\"hero actions row\">\n                <button class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-2-1-4-1\" data-name=\"buy Ultra call-to-action button\">\n                    Buy Ultra for $399\n                </button>\n                <a class=\"text-[15px] font-medium underline underline-offset-4 hover:opacity-70\" data-kid=\"1-2-1-4-2\" data-name=\"compare with Pro link\" href=\"#compare\">\n                    Compare Ultra with Pro\n                </a>\n            </div>\n            <p class=\"mt-4 text-[14px] text-[#4A2A33]\" data-kid=\"1-2-1-5\" data-name=\"membership bundle note\">\n                Or band included with Life membership · $33/month · Ships Nov 4\n            </p>\n        </div>\n        <div class=\"relative\" data-kid=\"1-2-2\" data-name=\"hero image area with glow\">\n            <div class=\"absolute inset-10 rounded-full bg-[radial-gradient(circle,#F8F38A_0%,rgba(248,243,138,0.35)_40%,transparent_70%)] blur-[20px]\" data-kid=\"1-2-2-1\" data-name=\"radial yellow glow blob\">\n            </div>\n            <img alt=\"Aero Fit Ultra with titanium case and trail-green strap, showing a topographic route\" class=\"relative w-full h-full object-cover mix-blend-multiply\" data-kid=\"1-2-2-2\" data-name=\"Ultra band product image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/>\n        </div>\n    </section>\n    <!-- Goal selector + recommendation -->\n    <section class=\"max-w-[1160px] mx-auto px-[40px] pt-28\" data-kid=\"1-3\" data-name=\"goal selection and recommendation section\">\n        <h2 class=\"serif text-[48px] leading-[1.1] font-medium tracking-[-0.015em] max-w-[900px]\" data-kid=\"1-3-1\" data-name=\"section heading false\">\n            What do you want your band to do best?\n        </h2>\n        <p class=\"mt-4 text-[16px] text-[#4A2A33] max-w-[560px]\" data-kid=\"1-3-2\" data-name=\"section subtitle text\">\n            Pick one. We'll put the two bands that fit side by side and show the difference that matters.\n        </p>\n        <div class=\"mt-10 grid grid-cols-4 gap-4\" data-dynamic=\"true\" data-kid=\"1-3-3\" data-name=\"goal selector grid\" data-reason=\"goal cards rendered by renderGoals script\" id=\"goals\">\n        </div>\n        <div class=\"mt-8 rounded-[28px] bg-white border border-[#EFEAE6] shadow-[0_10px_40px_rgba(42,11,20,0.05)] grid grid-cols-[340px_1fr]\" data-kid=\"1-3-4\" data-name=\"recommendation panel\">\n            <div class=\"p-9 border-r border-[#F0EBE8] flex flex-col\" data-kid=\"1-3-4-1\" data-name=\"recommendation summary column\">\n                <p class=\"text-[14px] font-medium text-[#6B4F57]\" data-dynamic=\"true\" data-kid=\"1-3-4-1-1\" data-name=\"recommended goal label\" data-reason=\"text set by renderRec script\" id=\"recGoal\">\n                    Best for training\n                </p>\n                <p class=\"serif mt-3 text-[28px] leading-[1.25] font-medium\" data-dynamic=\"true\" data-kid=\"1-3-4-1-2\" data-name=\"recommendation difference text\" data-reason=\"text set by renderRec script\" id=\"recDiff\">\n                </p>\n                <p class=\"mt-auto pt-8 text-[14px] leading-[1.55] text-[#6B4F57]\" data-kid=\"1-3-4-1-3\" data-name=\"shared features note\">\n                    Every band tracks sleep stages, Recovery and Strain. Differences are in battery, sensors and storage.\n                </p>\n            </div>\n            <div class=\"p-6\" data-dynamic=\"true\" data-kid=\"1-3-4-2\" data-name=\"recommended band comparison table container\" data-reason=\"table HTML injected by renderRec script\" id=\"recTable\">\n            </div>\n        </div>\n    </section>\n    <!-- Full lineup -->\n    <section class=\"max-w-[1160px] mx-auto px-[40px] pt-28\" data-kid=\"1-4\" data-name=\"full product lineup section\">\n        <div class=\"flex items-end justify-between\" data-kid=\"1-4-1\" data-name=\"lineup header row\">\n            <h2 class=\"serif text-[44px] leading-[1.1] font-medium tracking-[-0.01em]\" data-kid=\"1-4-1-1\" data-name=\"lineup section heading\">\n                All five bands\n            </h2>\n            <p class=\"text-[15px] text-[#4A2A33] pb-2\" data-kid=\"1-4-1-2\" data-name=\"lineup subtitle text\">\n                Buy outright, or get the band included with a membership.\n            </p>\n        </div>\n        <div class=\"mt-10 grid grid-cols-5 gap-5\" data-dynamic=\"true\" data-kid=\"1-4-2\" data-name=\"product lineup grid\" data-reason=\"band cards rendered by renderLineup script\" id=\"lineup\">\n        </div>\n    </section>\n    <!-- Comparison table -->\n    <section class=\"max-w-[1160px] mx-auto px-[40px] pt-28 pb-24\" data-kid=\"1-5\" data-name=\"spec comparison section\" id=\"compare\">\n        <h2 class=\"serif text-[44px] leading-[1.1] font-medium tracking-[-0.01em]\" data-kid=\"1-5-1\" data-name=\"comparison heading\">\n            Compare every spec\n        </h2>\n        <p class=\"mt-3 text-[15px] text-[#4A2A33]\" data-kid=\"1-5-2\" data-name=\"comparison note with highlight text\">\n            Rows for your goal are highlighted.\n            <span class=\"font-medium\" data-dynamic=\"true\" data-kid=\"1-5-2-1\" data-name=\"highlighted goal note\" data-reason=\"text set by renderTable script\" id=\"hlNote\">\n            </span>\n        </p>\n        <div class=\"mt-8 rounded-[24px] bg-white border border-[#EFEAE6]\" data-kid=\"1-5-3\" data-name=\"comparison table container\">\n            <table class=\"w-full text-[14px] border-separate border-spacing-0\" data-kid=\"1-5-3-1\" data-name=\"specification comparison table\">\n                <thead class=\"sticky top-0 z-10\" data-dynamic=\"true\" data-kid=\"1-5-3-1-1\" data-name=\"table header with band names\" data-reason=\"header row injected by renderTable script\" id=\"specHead\">\n                </thead>\n                <tbody data-dynamic=\"true\" data-kid=\"1-5-3-1-2\" data-name=\"table body with spec rows\" data-reason=\"body rows injected by renderTable script\" id=\"specBody\">\n                </tbody>\n            </table>\n            <div class=\"p-5 border-t border-[#F0EBE8] text-center\" data-kid=\"1-5-3-2\" data-name=\"toggle button row\">\n                <button class=\"h-11 px-5 rounded-full border border-[#2A0B14] text-[14px] font-medium hover:bg-[#2A0B14] hover:text-white transition\" data-dynamic=\"true\" data-kid=\"1-5-3-2-1\" data-name=\"show all specifications toggle button\" data-reason=\"button label toggled by showAll script\" id=\"showAll\">\n                    Show all 16 specifications\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"mx-4 rounded-[28px] bg-[#F3EDE9] px-[80px] pt-14 pb-8\" data-kid=\"1-6\" data-name=\"footer\">\n        <a class=\"flex items-center gap-2.5\" data-kid=\"1-6-1\" data-name=\"footer brand logo link\" href=\"#overview\">\n            <img alt=\"Aero Fit logo\" class=\"w-10 h-10\" data-kid=\"1-6-1-1\" data-name=\"footer brand logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/aerofit-mark.svg\"/>\n            <span class=\"serif text-[32px] font-medium tracking-tight\" data-kid=\"1-6-1-2\" data-name=\"footer brand wordmark\">\n                Aero Fit\n            </span>\n        </a>\n        <div class=\"mt-12 grid grid-cols-[400px_1fr] gap-16\" data-kid=\"1-6-2\" data-name=\"footer columns area\">\n            <div class=\"bg-white rounded-[22px] p-6 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"1-6-2-1\" data-name=\"newsletter subscription card\">\n                <p class=\"text-[17px] font-medium\" data-kid=\"1-6-2-1-1\" data-name=\"newsletter heading\">\n                    Get health tips in your inbox\n                </p>\n                <p class=\"mt-1.5 text-[13px] leading-[1.55] text-[#6B4F57]\" data-kid=\"1-6-2-1-2\" data-name=\"newsletter description\">\n                    Sleep, recovery and training insights from the Aero Fit performance team, every week.\n                </p>\n                <label class=\"block mt-5 text-[13px] font-medium\" data-kid=\"1-6-2-1-3\" data-name=\"email field label\" for=\"nlA\">\n                    Email address\n                </label>\n                <form class=\"mt-2 h-[52px] rounded-full bg-[#FAF8F6] border border-[#EFEAE6] pl-5 pr-1.5 flex items-center gap-2\" data-kid=\"1-6-2-1-4\" data-name=\"newsletter subscription form\">\n                    <input class=\"flex-1 bg-transparent outline-hidden text-[14px] placeholder:text-[#9A8E91]\" data-kid=\"1-6-2-1-4-1\" data-name=\"email address input field\" id=\"nlA\" placeholder=\"you@example.com\" type=\"email\"/>\n                    <button class=\"h-10 px-5 rounded-full bg-[#2A0B14] text-white text-[13px] font-medium\" data-kid=\"1-6-2-1-4-2\" data-name=\"subscribe button\" type=\"button\">\n                        Subscribe\n                    </button>\n                </form>\n            </div>\n            <div class=\"grid grid-cols-4 gap-8 text-[14px] pt-2\" data-kid=\"1-6-2-2\" data-name=\"footer link columns\">\n                <div data-kid=\"1-6-2-2-1\" data-name=\"memberships link column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-1-1\" data-name=\"Memberships column heading\">\n                        Memberships\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-1-2\" data-name=\"memberships links list\">\n                        <li data-kid=\"1-6-2-2-1-2-1\" data-name=\"One plan link item\">\n                            Aero Fit One\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-2\" data-name=\"Peak plan link item\">\n                            Aero Fit Peak\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-3\" data-name=\"Life plan link item\">\n                            Aero Fit Life\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-4\" data-name=\"compare plans link item\">\n                            Compare plans\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-2\" data-name=\"shop link column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-2-1\" data-name=\"Shop column heading\">\n                        Shop\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-2-2\" data-name=\"shop product links list\">\n                        <li data-kid=\"1-6-2-2-2-2-1\" data-name=\"Lite product link item\">\n                            Lite\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-2\" data-name=\"Smart product link item\">\n                            Smart\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-3\" data-name=\"Music product link item\">\n                            Music\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-4\" data-name=\"Pro product link item\">\n                            Pro\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-5\" data-name=\"Ultra product link item\">\n                            Ultra\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-3\" data-name=\"support link column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-3-1\" data-name=\"Support column heading\">\n                        Support\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-3-2\" data-name=\"support links list\">\n                        <li data-kid=\"1-6-2-2-3-2-1\" data-name=\"Help Center link item\">\n                            Help Center\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-2\" data-name=\"Sizing link item\">\n                            Sizing\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-3\" data-name=\"Accessories link item\">\n                            Accessories\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-4\" data-name=\"Download App link item\">\n                            Download App\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-4\" data-name=\"connect link column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-4-1\" data-name=\"Connect column heading\">\n                        Connect\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-4-2\" data-name=\"social links list\">\n                        <li data-kid=\"1-6-2-2-4-2-1\" data-name=\"Instagram link item\">\n                            Instagram\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-2\" data-name=\"YouTube link item\">\n                            YouTube\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-3\" data-name=\"Podcast link item\">\n                            Podcast\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-4\" data-name=\"Contact link item\">\n                            Contact\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-12 h-14 rounded-full bg-white px-6 flex items-center justify-between text-[13px] text-[#6B4F57]\" data-kid=\"1-6-3\" data-name=\"legal bar\">\n            <div class=\"flex gap-5\" data-kid=\"1-6-3-1\" data-name=\"legal links group\">\n                <span data-kid=\"1-6-3-1-1\" data-name=\"terms & conditions link text\">\n                    Terms & Conditions\n                </span>\n                <span data-kid=\"1-6-3-1-2\" data-name=\"privacy policy link text\">\n                    Privacy Policy\n                </span>\n                <span data-kid=\"1-6-3-1-3\" data-name=\"accessibility link text\">\n                    Accessibility\n                </span>\n            </div>\n            <span data-kid=\"1-6-3-2\" data-name=\"copyright notice\">\n                © 2026 Aero Fit. All rights reserved.\n            </span>\n        </div>\n        <p class=\"mt-6 px-2 text-[12px] leading-[1.7] text-[#7A5B64] max-w-[900px]\" data-kid=\"1-6-4\" data-name=\"medical disclaimer text\">\n            Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease.\n        </p>\n    </footer>\n</div>\n<script>\n    const CDN='https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/';\nconst P={\n  lite:{n:'Lite',price:149,plan:'One',mo:16,img:CDN+'da32fd7c279245b5ab743623f57ddf23.jpg',fact:'18 g, the lightest band',alt:'Aero Fit Lite in slate woven strap'},\n  smart:{n:'Smart',price:199,plan:'One',mo:16,img:CDN+'7754f0f6d49a4ed38f644dce2670c620.jpg',fact:'Always-on display, skin temperature',alt:'Aero Fit Smart in black with always-on display'},\n  pro:{n:'Pro',price:299,plan:'Peak',mo:25,img:CDN+'72180f80b3a64de99cbdef213dc621cd.jpg',fact:'Built-in GPS and ECG',alt:'Aero Fit Pro in graphite showing a GPS run'},\n  music:{n:'Music',price:279,plan:'Peak',mo:25,img:CDN+'46a42b1d18d34403be756d1c74222484.jpg',fact:'4 GB, about 500 songs',alt:'Aero Fit Music in black playing a song'},\n  ultra:{n:'Ultra',price:399,plan:'Life',mo:33,img:CDN+'76d7a24f75bc4dbeafec4d446b539a12.jpg',fact:'14-day battery, dual-band GPS',alt:'Aero Fit Ultra in titanium with trail strap'}\n};\nconst ORDER=['lite','smart','pro','music','ultra'];\nconst ROWS=[\n ['battery','Battery life',['5 days','7 days','10 days','6 days','14 days'],1],\n ['gps','GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],\n ['ecg','ECG with Heart Screener',[0,0,1,0,1],1],\n ['storage','Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],\n ['case','Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],\n ['weight','Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],\n ['outright','Buy outright',['$149','$199','$299','$279','$399'],1],\n ['included','Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only'],1],\n ['display','Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],\n ['water','Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],\n ['sleep','Sleep stages & Sleep Performance',[1,1,1,1,1],0],\n ['recovery','Recovery & Strain scores',[1,1,1,1,1],0],\n ['temp','Skin temperature',[0,1,1,1,1],0],\n ['bp','Blood Pressure Insights',[0,0,1,0,1],0],\n ['modes','Workout types',['20','40','120','80','150'],0],\n ['bluetooth','Bluetooth headphones',[0,0,0,1,0],0]\n];\nconst GOALS={\n sleep:{label:'Sleep',img:'https://images.pexels.com/photos/6963181/pexels-photo-6963181.jpeg?auto=compress&cs=tinysrgb&w=600&q=80',alt:'Hand reaching for the bedside in morning light, photo by cottonbro studio on Pexels',fit:['lite','smart'],rows:['sleep','temp','weight','battery'],\n   why:{lite:'At 18 g it is the easiest band to forget you are wearing overnight.',smart:'Adds skin temperature, which helps flag a rough night or an illness coming on.'},\n   diff:'Smart adds skin temperature for $50 more. Lite is 6 g lighter on the wrist.'},\n training:{label:'Training',img:'https://images.unsplash.com/photo-1630254608294-d844a0242357?auto=format&w=600&q=80&fit=crop',alt:'Man training on a forest path, photo by Alex Gagareen on Unsplash',fit:['pro','ultra'],rows:['gps','modes','ecg','recovery'],\n   why:{pro:'Built-in GPS and ECG with 120 workout types, so you can leave your phone behind.',ultra:'Dual-band GPS stays accurate under trees and between buildings, with 150 workout types.'},\n   diff:'Ultra adds dual-band GPS, 4 more days of battery and a titanium case for $100 more.'},\n music:{label:'Music',img:'https://images.pexels.com/photos/18823179/pexels-photo-18823179.jpeg?auto=compress&cs=tinysrgb&w=600&q=80',alt:'Woman walking with headphones, photo by Fatih Güney on Pexels',fit:['music','pro'],rows:['storage','bluetooth','gps'],\n   why:{music:'The only band that stores music: 4 GB, about 500 songs, played straight to Bluetooth headphones.',pro:'No onboard music, but adds ECG and Blood Pressure Insights for structured training.'},\n   diff:'Only Music stores songs. Pro gives up music for ECG and 4 more days of battery.'},\n endurance:{label:'Endurance',img:'https://images.unsplash.com/photo-1745692607831-66df9207b8bc?auto=format&w=600&q=80&fit=crop',alt:'Hiker resting on a mountain ridge, photo by Haroon Khalid on Unsplash',fit:['ultra','pro'],rows:['battery','gps','water','case'],\n   why:{ultra:'14 days of battery, rated to 100 m, and a titanium case built for multi-day races.',pro:'10 days of battery and built-in GPS for most long weekends, at $100 less.'},\n   diff:'Ultra lasts 4 days longer and is rated to 100 m. Pro costs $100 less.'}\n};\nlet goal='training', showAll=false;\nconst cell=v=>v===1?'<span class=\"text-[17px]\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[#C9C0C2]\">—</span>':v;\n\nfunction renderGoals(){\n  document.getElementById('goals').innerHTML=Object.entries(GOALS).map(([k,g])=>{\n    const on=k===goal;\n    return `<button data-g=\"${k}\" class=\"text-left rounded-[22px] p-2 pb-4 transition ${on?'bg-[#2A0B14] text-white':'bg-white border border-[#EFEAE6] hover:border-[#2A0B14]'}\">\n      <div class=\"h-[150px] rounded-[16px] overflow-hidden\"><img src=\"${g.img}\" alt=\"${g.alt}\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\"></div>\n      <div class=\"px-3 pt-4 flex items-center justify-between\"><span class=\"serif text-[24px] font-medium\">${g.label}</span><span class=\"text-[13px] ${on?'text-[#F8F38A]':'text-[#6B4F57]'}\">${g.fit.map(f=>P[f].n).join(' or ')}</span></div>\n    </button>`}).join('');\n  document.querySelectorAll('[data-g]').forEach(b=>b.onclick=()=>{goal=b.dataset.g;render();});\n}\nfunction renderRec(){\n  const g=GOALS[goal];\n  document.getElementById('recGoal').textContent='Best for '+g.label.toLowerCase()+': '+g.fit.map(f=>P[f].n).join(' and ');\n  document.getElementById('recDiff').textContent=g.diff;\n  const rows=ROWS.filter(r=>g.rows.includes(r[0]));\n  const col=f=>{const p=P[f];return `<div class=\"flex-1 px-4\">\n    <div class=\"flex items-center gap-4\"><div class=\"w-[96px] h-[96px] rounded-[16px] bg-[#EFEBE6] overflow-hidden shrink-0\"><img src=\"${p.img}\" alt=\"${p.alt}\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\"></div>\n    <div><p class=\"serif text-[30px] font-medium leading-none\">${p.n}</p><p class=\"mt-2 text-[14px] text-[#4A2A33] leading-[1.45]\">${g.why[f]}</p></div></div>\n    <dl class=\"mt-5 divide-y divide-[#F0EBE8] text-[14px]\">${rows.map(r=>`<div class=\"flex justify-between py-2.5\"><dt class=\"text-[#6B4F57]\">${r[1]}</dt><dd class=\"font-medium\">${cell(r[2][ORDER.indexOf(f)])}</dd></div>`).join('')}</dl>\n    <div class=\"mt-5 space-y-2\">\n      <button class=\"w-full h-11 rounded-full bg-[#2A0B14] text-white text-[14px] font-medium hover:bg-[#45172A] transition\">Buy ${p.n} for $${p.price}</button>\n      <a href=\"#plans\" class=\"block text-center text-[14px] underline underline-offset-4 hover:opacity-70\">Or included with ${p.plan} · $${p.mo}/month</a>\n    </div></div>`};\n  document.getElementById('recTable').innerHTML=`<div class=\"flex divide-x divide-[#F0EBE8]\">${col(g.fit[0])}${col(g.fit[1])}</div>`;\n}\nfunction renderLineup(){\n  document.getElementById('lineup').innerHTML=ORDER.map(f=>{const p=P[f];const fit=GOALS[goal].fit.includes(f);\n    return `<a href=\"#${f}\" class=\"group block\">\n      <div class=\"relative h-[220px] rounded-[20px] bg-[#EFEBE6] overflow-hidden ${fit?'ring-2 ring-[#2A0B14]':''}\"><img src=\"${p.img}\" alt=\"${p.alt}\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\">\n      ${fit?`<span class=\"absolute left-3 top-3 text-[12px] font-medium bg-[#F8F38A] rounded-full px-2.5 py-1\">Fits ${GOALS[goal].label.toLowerCase()}</span>`:''}</div>\n      <p class=\"serif mt-4 text-[24px] font-medium leading-none flex items-center gap-1\">${p.n}<span class=\"text-[16px] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition\"><i class=\"ti ti-arrow-right\"></i></span></p>\n      <p class=\"mt-1.5 text-[14px] text-[#4A2A33]\">${p.fact}</p>\n      <p class=\"mt-3 text-[15px] font-medium\">$${p.price} outright</p>\n      <p class=\"text-[13px] text-[#6B4F57]\">Included from ${p.plan} · $${p.mo}/mo</p>\n    </a>`}).join('');\n}\nfunction renderTable(){\n  const g=GOALS[goal];\n  document.getElementById('hlNote').textContent='Showing '+g.label.toLowerCase()+'.';\n  document.getElementById('specHead').innerHTML=`<tr><th class=\"bg-white rounded-tl-[24px] text-left font-medium text-[#6B4F57] p-5 w-[260px] border-b border-[#F0EBE8]\">Specification</th>${ORDER.map((f,i)=>{const fit=g.fit.includes(f);return `<th class=\"bg-white p-5 text-left border-b border-[#F0EBE8] ${i===4?'rounded-tr-[24px]':''}\"><div class=\"flex items-center gap-3\"><div class=\"w-11 h-11 rounded-[10px] bg-[#EFEBE6] overflow-hidden\"><img src=\"${P[f].img}\" alt=\"\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\"></div><div><p class=\"serif text-[19px] font-medium leading-none ${fit?'underline decoration-[#F8F38A] decoration-[5px] underline-offset-[3px]':''}\">${P[f].n}</p><p class=\"mt-1 text-[13px] font-normal text-[#6B4F57]\">$${P[f].price}</p></div></div></th>`}).join('')}</tr>`;\n  document.getElementById('specBody').innerHTML=ROWS.filter(r=>showAll||r[3]).map(r=>{const hl=g.rows.includes(r[0]);\n    return `<tr class=\"${hl?'bg-[#FBF7C8]':''}\"><td class=\"px-5 py-3.5 border-b border-[#F3EFEC] ${hl?'font-medium':'text-[#4A2A33]'}\">${r[1]}</td>${r[2].map(v=>`<td class=\"px-5 py-3.5 border-b border-[#F3EFEC]\">${cell(v)}</td>`).join('')}</tr>`}).join('');\n  document.getElementById('showAll').textContent=showAll?'Show 8 key specifications':'Show all 16 specifications';\n}\ndocument.getElementById('showAll').onclick=()=>{showAll=!showAll;renderTable();};\nfunction render(){renderGoals();renderRec();renderLineup();renderTable();}\nrender();\n</script>\n",
      "comments": [],
      "created": "2026-10-16T10:26:20.619996+00:00",
      "modified": "2026-10-16T10:27:43.908995+00:00",
      "id": "var_97e0fc53588e",
      "contentHeight": 3649
    },
    "var_fa2a3875953c": {
      "type": "variant",
      "label": "Catalog B — Browse and buy",
      "parentId": "var_97e0fc53588e",
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip py-5\" data-kid=\"1\">\n    <!-- Nav -->\n    <header class=\"mx-4 h-[68px] rounded-full bg-white shadow-[0_4px_18px_rgba(42,11,20,0.06)] border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-6\" data-kid=\"1-1-1\">\n            <a class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2\" data-kid=\"1-1-1-1\" href=\"#overview\">\n                <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/aerofit-mark.svg\"/>\n                Aero Fit\n            </a>\n            <nav class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-2\">\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] hover:bg-[#ECE6E2] flex items-center transition\" data-kid=\"1-1-1-2-1\" href=\"#overview\">\n                    Overview\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] hover:bg-[#ECE6E2] flex items-center transition\" data-kid=\"1-1-1-2-2\" href=\"#how-it-works\">\n                    How it works\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-2-3\" href=\"#shop\">\n                    Shop bands\n                </a>\n            </nav>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-2\">\n            <a class=\"h-[52px] px-4 rounded-full border border-[#EFEAE6] flex items-center gap-2 text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-2-1\" href=\"#cart\">\n                <span class=\"text-[18px]\" data-kid=\"1-1-2-1-1\">\n                    <i class=\"ti ti-shopping-cart\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                Cart ·\n                <span data-kid=\"1-1-2-1-2\" id=\"cartCount\">\n                    0\n                </span>\n            </a>\n            <button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-2-2\">\n                Join Aero Fit free\n            </button>\n        </div>\n    </header>\n    <!-- Ultra merch strip -->\n    <section class=\"mx-4 mt-5 rounded-[28px] bg-[#2A0B14] text-white grid grid-cols-[360px_1fr_auto] items-center gap-12 pr-14 overflow-hidden\" data-kid=\"1-2\">\n        <div class=\"h-[300px] bg-[#EFEBE6]\" data-kid=\"1-2-1\">\n            <img alt=\"Aero Fit Ultra in titanium with trail-green strap\" class=\"w-full h-full object-cover\" data-kid=\"1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/>\n        </div>\n        <div data-kid=\"1-2-2\">\n            <p class=\"text-[14px] text-[#F8F38A] font-medium\" data-kid=\"1-2-2-1\">\n                Ultra · Ships Nov 4\n            </p>\n            <h1 class=\"serif mt-2 text-[44px] leading-[1.05] font-medium tracking-[-0.015em]\" data-kid=\"1-2-2-2\" data-name=\"ultra headline text\">\n                Built for multi-day races.\n            </h1>\n            <dl class=\"mt-6 flex gap-10 text-[15px]\" data-kid=\"1-2-2-3\">\n                <div data-kid=\"1-2-2-3-1\">\n                    <dt class=\"text-white/60 text-[13px]\" data-kid=\"1-2-2-3-1-1\">\n                        Battery\n                    </dt>\n                    <dd class=\"font-medium mt-0.5\" data-kid=\"1-2-2-3-1-2\">\n                        14 days\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-2-3-2\">\n                    <dt class=\"text-white/60 text-[13px]\" data-kid=\"1-2-2-3-2-1\">\n                        GPS\n                    </dt>\n                    <dd class=\"font-medium mt-0.5\" data-kid=\"1-2-2-3-2-2\">\n                        Dual-band\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-2-3-3\">\n                    <dt class=\"text-white/60 text-[13px]\" data-kid=\"1-2-2-3-3-1\">\n                        Water\n                    </dt>\n                    <dd class=\"font-medium mt-0.5\" data-kid=\"1-2-2-3-3-2\">\n                        100 m\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-2-3-4\">\n                    <dt class=\"text-white/60 text-[13px]\" data-kid=\"1-2-2-3-4-1\">\n                        Case\n                    </dt>\n                    <dd class=\"font-medium mt-0.5\" data-kid=\"1-2-2-3-4-2\">\n                        Titanium\n                    </dd>\n                </div>\n            </dl>\n        </div>\n        <div class=\"text-right\" data-kid=\"1-2-3\">\n            <p class=\"serif text-[40px] font-medium leading-none\" data-kid=\"1-2-3-1\">\n                $399\n            </p>\n            <p class=\"mt-2 text-[14px] text-white/70\" data-kid=\"1-2-3-2\">\n                outright, or included with Life · $33/month\n            </p>\n            <a class=\"mt-5 inline-flex h-12 px-6 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[15px] font-medium items-center hover:bg-[#F2EB6A] transition\" data-kid=\"1-2-3-3\" href=\"#p-ultra\">\n                Configure Ultra\n            </a>\n        </div>\n    </section>\n    <!-- Toolbar -->\n    <section class=\"max-w-[1200px] mx-auto px-[24px] pt-16\" data-kid=\"1-3\" id=\"shop\">\n        <div class=\"flex items-end justify-between\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <h2 class=\"serif text-[44px] leading-[1.1] font-medium tracking-[-0.01em]\" data-kid=\"1-3-1-1-1\">\n                    Shop all bands\n                </h2>\n                <p class=\"mt-2 text-[15px] text-[#4A2A33]\" data-kid=\"1-3-1-1-2\">\n                    5 bands · pick a color, size and how you want to pay.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-3 text-[14px]\" data-kid=\"1-3-1-2\">\n                <span class=\"text-[#6B4F57]\" data-kid=\"1-3-1-2-1\">\n                    Sort by\n                </span>\n                <div class=\"flex gap-1 p-1 rounded-full bg-[#F3EFEC]\" data-kid=\"1-3-1-2-2\" id=\"sort\">\n                    <button class=\"h-9 px-4 rounded-full bg-white shadow-xs font-medium\" data-kid=\"1-3-1-2-2-1\" data-s=\"price\">\n                        Price: low to high\n                    </button>\n                    <button class=\"h-9 px-4 rounded-full font-medium text-[#6B4F57] hover:text-[#2A0B14]\" data-kid=\"1-3-1-2-2-2\" data-s=\"battery\">\n                        Battery life\n                    </button>\n                    <button class=\"h-9 px-4 rounded-full font-medium text-[#6B4F57] hover:text-[#2A0B14]\" data-kid=\"1-3-1-2-2-3\" data-s=\"weight\">\n                        Lightest\n                    </button>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-8 grid grid-cols-3 gap-5\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"band product grid container\" data-reason=\"product cards and size guide injected by renderGrid script\" id=\"grid\">\n        </div>\n    </section>\n    <!-- Shop by goal -->\n    <section class=\"max-w-[1200px] mx-auto px-[24px] pt-24\" data-kid=\"1-4\">\n        <div class=\"rounded-[28px] bg-[#F3EDE9] p-10 grid grid-cols-[300px_1fr] gap-10 items-center\" data-kid=\"1-4-1\">\n            <div data-kid=\"1-4-1-1\">\n                <h2 class=\"serif text-[36px] leading-[1.1] font-medium\" data-kid=\"1-4-1-1-1\">\n                    Not sure which band?\n                </h2>\n                <p class=\"mt-3 text-[15px] text-[#4A2A33] leading-[1.55]\" data-kid=\"1-4-1-1-2\">\n                    Pick a goal and we'll mark the two bands that fit best in the grid above.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-4 gap-3\" data-dynamic=\"true\" data-kid=\"1-4-1-2\" data-name=\"goal selection grid\" data-reason=\"goal buttons rendered by renderGoals script\" id=\"goals\">\n            </div>\n        </div>\n    </section>\n    <!-- Spec table -->\n    <section class=\"max-w-[1200px] mx-auto px-[24px] pt-24 pb-24\" data-kid=\"1-5\">\n        <h2 class=\"serif text-[44px] leading-[1.1] font-medium tracking-[-0.01em]\" data-kid=\"1-5-1\">\n            Compare specs\n        </h2>\n        <div class=\"mt-8 rounded-[24px] bg-white border border-[#EFEAE6]\" data-kid=\"1-5-2\">\n            <table class=\"w-full text-[14px] border-separate border-spacing-0\" data-kid=\"1-5-2-1\">\n                <thead class=\"sticky top-0 z-10\" data-dynamic=\"true\" data-kid=\"1-5-2-1-1\" data-name=\"spec table header row\" data-reason=\"header cells and product columns injected by renderTable script\" id=\"specHead\">\n                </thead>\n                <tbody data-dynamic=\"true\" data-kid=\"1-5-2-1-2\" data-name=\"spec table body rows\" data-reason=\"row cells and count rewritten by renderTable on toggle\" id=\"specBody\">\n                </tbody>\n            </table>\n            <div class=\"p-5 border-t border-[#F0EBE8] text-center\" data-kid=\"1-5-2-2\">\n                <button class=\"h-11 px-5 rounded-full border border-[#2A0B14] text-[14px] font-medium hover:bg-[#2A0B14] hover:text-white transition\" data-dynamic=\"true\" data-kid=\"1-5-2-2-1\" data-name=\"show all specifications toggle button\" data-reason=\"button label swapped by renderTable when toggled\" id=\"showAll\">\n                    Show all 16 specifications\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"mx-4 rounded-[28px] bg-[#F3EDE9] px-[80px] pt-14 pb-8\" data-kid=\"1-6\">\n        <a class=\"flex items-center gap-2.5\" data-kid=\"1-6-1\" href=\"#overview\">\n            <img alt=\"Aero Fit logo\" class=\"w-10 h-10\" data-kid=\"1-6-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/aerofit-mark.svg\"/>\n            <span class=\"serif text-[32px] font-medium tracking-tight\" data-kid=\"1-6-1-2\">\n                Aero Fit\n            </span>\n        </a>\n        <div class=\"mt-12 grid grid-cols-[400px_1fr] gap-16\" data-kid=\"1-6-2\">\n            <div class=\"bg-white rounded-[22px] p-6 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"1-6-2-1\">\n                <p class=\"text-[17px] font-medium\" data-kid=\"1-6-2-1-1\">\n                    Get health tips in your inbox\n                </p>\n                <p class=\"mt-1.5 text-[13px] leading-[1.55] text-[#6B4F57]\" data-kid=\"1-6-2-1-2\">\n                    Sleep, recovery and training insights from the Aero Fit performance team, every week.\n                </p>\n                <label class=\"block mt-5 text-[13px] font-medium\" data-kid=\"1-6-2-1-3\" for=\"nlB\">\n                    Email address\n                </label>\n                <form class=\"mt-2 h-[52px] rounded-full bg-[#FAF8F6] border border-[#EFEAE6] pl-5 pr-1.5 flex items-center gap-2\" data-kid=\"1-6-2-1-4\">\n                    <input class=\"flex-1 bg-transparent outline-hidden text-[14px] placeholder:text-[#9A8E91]\" data-kid=\"1-6-2-1-4-1\" id=\"nlB\" placeholder=\"you@example.com\" type=\"email\"/>\n                    <button class=\"h-10 px-5 rounded-full bg-[#2A0B14] text-white text-[13px] font-medium\" data-kid=\"1-6-2-1-4-2\" type=\"button\">\n                        Subscribe\n                    </button>\n                </form>\n            </div>\n            <div class=\"grid grid-cols-4 gap-8 text-[14px] pt-2\" data-kid=\"1-6-2-2\">\n                <div data-kid=\"1-6-2-2-1\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-1-1\">\n                        Memberships\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-1-2\">\n                        <li data-kid=\"1-6-2-2-1-2-1\">\n                            Aero Fit One\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-2\">\n                            Aero Fit Peak\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-3\">\n                            Aero Fit Life\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-4\">\n                            Compare plans\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-2\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-2-1\">\n                        Shop\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-2-2\">\n                        <li data-kid=\"1-6-2-2-2-2-1\">\n                            Lite\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-2\">\n                            Smart\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-3\">\n                            Music\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-4\">\n                            Pro\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-5\">\n                            Ultra\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-3\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-3-1\">\n                        Support\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-3-2\">\n                        <li data-kid=\"1-6-2-2-3-2-1\">\n                            Help Center\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-2\">\n                            Sizing\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-3\">\n                            Accessories\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-4\">\n                            Download App\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-4\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-4-1\">\n                        Connect\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-4-2\">\n                        <li data-kid=\"1-6-2-2-4-2-1\">\n                            Instagram\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-2\">\n                            YouTube\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-3\">\n                            Podcast\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-4\">\n                            Contact\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-12 h-14 rounded-full bg-white px-6 flex items-center justify-between text-[13px] text-[#6B4F57]\" data-kid=\"1-6-3\">\n            <div class=\"flex gap-5\" data-kid=\"1-6-3-1\">\n                <span data-kid=\"1-6-3-1-1\">\n                    Terms & Conditions\n                </span>\n                <span data-kid=\"1-6-3-1-2\">\n                    Privacy Policy\n                </span>\n                <span data-kid=\"1-6-3-1-3\">\n                    Accessibility\n                </span>\n            </div>\n            <span data-kid=\"1-6-3-2\">\n                © 2026 Aero Fit. All rights reserved.\n            </span>\n        </div>\n        <p class=\"mt-6 px-2 text-[12px] leading-[1.7] text-[#7A5B64] max-w-[900px]\" data-kid=\"1-6-4\">\n            Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease.\n        </p>\n    </footer>\n    <!-- Toast -->\n    <div class=\"fixed left-1/2 -translate-x-1/2 bottom-6 z-50 hidden items-center gap-3 rounded-full bg-[#2A0B14] text-white pl-3 pr-5 h-14 shadow-[0_14px_40px_rgba(42,11,20,0.3)]\" data-dynamic=\"true\" data-kid=\"1-7\" data-name=\"add to cart toast notification\" data-reason=\"text and visibility set by cart add script on click\" id=\"toast\">\n        <span class=\"w-8 h-8 rounded-full bg-[#F8F38A] text-[#2A0B14] flex items-center justify-center text-[16px]\" data-kid=\"1-7-1\">\n            <i class=\"ti ti-shopping-cart\" data-kid=\"1-7-1-1\">\n            </i>\n        </span>\n        <span class=\"text-[14px] font-medium\" data-dynamic=\"true\" data-kid=\"1-7-2\" data-name=\"toast message text\" data-reason=\"message text set by script when item added to cart\" id=\"toastText\">\n        </span>\n        <a class=\"text-[14px] underline underline-offset-4 text-[#F8F38A]\" data-kid=\"1-7-3\" href=\"#cart\">\n            View cart\n        </a>\n    </div>\n</div>\n<script>\n    const CDN='https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/';\nconst P={\n  lite:{n:'Lite',price:149,plan:'One',mo:16,bat:5,g:18,img:CDN+'da32fd7c279245b5ab743623f57ddf23.jpg',fact:'18 g, the lightest band · 5-day battery',colors:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']]},\n  smart:{n:'Smart',price:199,plan:'One',mo:16,bat:7,g:24,img:CDN+'7754f0f6d49a4ed38f644dce2670c620.jpg',fact:'Always-on AMOLED and skin temperature',colors:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']]},\n  music:{n:'Music',price:279,plan:'Peak',mo:25,bat:6,g:28,img:CDN+'46a42b1d18d34403be756d1c74222484.jpg',fact:'Stores ~500 songs for Bluetooth headphones',colors:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']]},\n  pro:{n:'Pro',price:299,plan:'Peak',mo:25,bat:10,g:27,img:CDN+'72180f80b3a64de99cbdef213dc621cd.jpg',fact:'Built-in GPS and ECG · 10-day battery',colors:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']]},\n  ultra:{n:'Ultra',price:399,plan:'Life',mo:33,bat:14,g:32,img:CDN+'76d7a24f75bc4dbeafec4d446b539a12.jpg',fact:'Titanium, dual-band GPS · 14-day battery',colors:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']]}\n};\nconst SIZES={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nconst state={};Object.keys(P).forEach(k=>state[k]={c:0,size:null,mode:'out',err:false});\nlet order=['lite','smart','music','pro','ultra'], hl=[], cart=0;\n\nfunction card(k){\n  const p=P[k],s=state[k],on=hl.includes(k);\n  return `<article id=\"p-${k}\" class=\"rounded-[24px] bg-white border ${on?'border-[#2A0B14] ring-2 ring-[#2A0B14]':'border-[#EFEAE6]'} p-3 pb-5 flex flex-col\">\n    <div class=\"relative h-[260px] rounded-[18px] bg-[#EFEBE6] overflow-hidden\"><img src=\"${p.img}\" alt=\"Aero Fit ${p.n} wearable\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\">\n      ${on?`<span class=\"absolute left-3 top-3 text-[13px] font-medium bg-[#F8F38A] rounded-full px-3 py-1\">Fits your goal</span>`:''}</div>\n    <div class=\"px-3 pt-5 flex-1 flex flex-col\">\n      <div class=\"flex items-baseline justify-between\"><h3 class=\"serif text-[28px] font-medium leading-none\">${p.n}</h3><span class=\"text-[17px] font-semibold\">$${p.price}</span></div>\n      <p class=\"mt-2 text-[14px] text-[#4A2A33]\">${p.fact}</p>\n\n      <div class=\"mt-5 flex items-center justify-between\">\n        <p class=\"text-[13px] text-[#6B4F57]\">Color: <span class=\"font-medium text-[#2A0B14]\">${p.colors[s.c][0]}</span></p>\n        <div class=\"flex gap-2\">${p.colors.map((c,i)=>`<button aria-label=\"${c[0]}\" data-k=\"${k}\" data-c=\"${i}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${i===s.c?'border-[#2A0B14]':'border-transparent hover:border-[#D9D0CB]'}\"><span class=\"block w-full h-full rounded-full border border-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div>\n      </div>\n\n      <div class=\"mt-4\">\n        <div class=\"flex items-center justify-between\"><p class=\"text-[13px] ${s.err?'text-[#C2334F] font-medium':'text-[#6B4F57]'}\">${s.err?'Choose a band size':'Size'+(s.size?': <span class=\"font-medium text-[#2A0B14]\">'+s.size+' · '+SIZES[s.size]+'</span>':'')}</p><a href=\"#size-guide\" class=\"text-[13px] underline underline-offset-2 flex items-center gap-1\"><i class=\"ti ti-ruler-measure\"></i>Size guide</a></div>\n        <div class=\"mt-2 grid grid-cols-3 gap-1.5\">${Object.keys(SIZES).map(z=>`<button data-k=\"${k}\" data-z=\"${z}\" class=\"h-10 rounded-full text-[14px] font-medium border ${s.size===z?'bg-[#2A0B14] text-white border-[#2A0B14]':(s.err?'border-[#E8A3B1] bg-[#FDF3F5]':'border-[#E3DDDA] hover:border-[#2A0B14]')}\">${z}</button>`).join('')}</div>\n      </div>\n\n      <div class=\"mt-4 space-y-1.5 text-[14px]\">\n        ${[['out',`Buy outright · $${p.price}`,'One-time payment'],['mem',`Included with ${p.plan} · $${p.mo}/month`,'Band ships with your membership']].map(([m,t,sub])=>`<button data-k=\"${k}\" data-m=\"${m}\" class=\"w-full flex items-center gap-3 rounded-[14px] px-3.5 py-2.5 border text-left ${s.mode===m?'border-[#2A0B14] bg-[#FAF8F6]':'border-[#EFEAE6] hover:border-[#D9D0CB]'}\">\n          <span class=\"w-[18px] h-[18px] rounded-full border-2 ${s.mode===m?'border-[#2A0B14]':'border-[#C9C0C2]'} flex items-center justify-center shrink-0\">${s.mode===m?'<span class=\"w-2 h-2 rounded-full bg-[#2A0B14]\"></span>':''}</span>\n          <span><span class=\"block font-medium\">${t}</span><span class=\"block text-[13px] text-[#6B4F57]\">${sub}</span></span></button>`).join('')}\n      </div>\n\n      <button data-add=\"${k}\" class=\"mt-5 h-12 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition flex items-center justify-center gap-2\"><i class=\"ti ti-shopping-cart\"></i>Add ${p.n} to cart</button>\n    </div>\n  </article>`;\n}\nfunction sizeGuide(){\n  return `<aside id=\"size-guide\" class=\"rounded-[24px] bg-[#F3EDE9] p-7 flex flex-col\">\n    <span class=\"text-[26px]\"><i class=\"ti ti-ruler-measure\"></i></span>\n    <h3 class=\"serif mt-3 text-[28px] font-medium leading-tight\">Find your band size</h3>\n    <p class=\"mt-2 text-[14px] text-[#4A2A33] leading-[1.55]\">Wrap a soft tape just above your wrist bone. Every band comes in three sizes.</p>\n    <table class=\"mt-6 w-full text-[14px]\"><tbody>${Object.entries(SIZES).map(([z,r])=>`<tr class=\"border-b border-[#E3DDDA]\"><td class=\"py-3 font-semibold w-12\">${z}</td><td class=\"py-3 text-[#4A2A33]\">${r} wrist</td></tr>`).join('')}</tbody></table>\n    <p class=\"mt-auto pt-6 text-[14px] text-[#4A2A33]\">Between sizes? Pick the larger one. Exchanges are free for 30 days.</p>\n  </aside>`;\n}\nfunction renderGrid(){\n  const g=document.getElementById('grid');\n  g.innerHTML=order.map(card).join('')+sizeGuide();\n  g.querySelectorAll('[data-c]').forEach(b=>b.onclick=()=>{state[b.dataset.k].c=+b.dataset.c;renderGrid();});\n  g.querySelectorAll('[data-z]').forEach(b=>b.onclick=()=>{const s=state[b.dataset.k];s.size=b.dataset.z;s.err=false;renderGrid();});\n  g.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>{state[b.dataset.k].mode=b.dataset.m;renderGrid();});\n  g.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{const k=b.dataset.add,s=state[k];\n    if(!s.size){s.err=true;renderGrid();return;}\n    cart++;document.getElementById('cartCount').textContent=cart;\n    const t=document.getElementById('toast');document.getElementById('toastText').textContent=`${P[k].n} · ${P[k].colors[s.c][0]} · ${s.size} added to cart`;\n    t.classList.remove('hidden');t.classList.add('flex');clearTimeout(window._tt);window._tt=setTimeout(()=>{t.classList.add('hidden');t.classList.remove('flex')},3000);});\n}\ndocument.querySelectorAll('#sort button').forEach(b=>b.onclick=()=>{\n  const s=b.dataset.s;order=Object.keys(P).sort((a,c)=>s==='price'?P[a].price-P[c].price:s==='battery'?P[c].bat-P[a].bat:P[a].g-P[c].g);\n  document.querySelectorAll('#sort button').forEach(x=>x.className='h-9 px-4 rounded-full font-medium '+(x===b?'bg-white shadow-xs':'text-[#6B4F57] hover:text-[#2A0B14]'));renderGrid();});\n\nconst GOALS=[['sleep','Sleep',['lite','smart'],'https://images.pexels.com/photos/6963181/pexels-photo-6963181.jpeg?auto=compress&cs=tinysrgb&w=400&q=80','Hand reaching for the bedside in morning light, photo by cottonbro studio on Pexels'],\n ['training','Training',['pro','ultra'],'https://images.unsplash.com/photo-1630254608294-d844a0242357?auto=format&w=400&q=80&fit=crop','Man training on a forest path, photo by Alex Gagareen on Unsplash'],\n ['music','Music',['music','pro'],'https://images.pexels.com/photos/18823179/pexels-photo-18823179.jpeg?auto=compress&cs=tinysrgb&w=400&q=80','Woman walking with headphones, photo by Fatih Güney on Pexels'],\n ['endurance','Endurance',['ultra','pro'],'https://images.unsplash.com/photo-1745692607831-66df9207b8bc?auto=format&w=400&q=80&fit=crop','Hiker resting on a mountain ridge, photo by Haroon Khalid on Unsplash']];\nlet goal=null;\nfunction renderGoals(){\n  const el=document.getElementById('goals');\n  el.innerHTML=GOALS.map(([k,l,fit,img,alt])=>`<button data-goal=\"${k}\" class=\"text-left rounded-[18px] p-2 pb-3 transition ${goal===k?'bg-[#2A0B14] text-white':'bg-white hover:ring-1 hover:ring-[#2A0B14]'}\">\n    <div class=\"h-[110px] rounded-[12px] overflow-hidden\"><img src=\"${img}\" alt=\"${alt}\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\"></div>\n    <p class=\"px-2 pt-3 text-[16px] font-medium\">${l}</p><p class=\"px-2 text-[13px] ${goal===k?'text-[#F8F38A]':'text-[#6B4F57]'}\">${fit.map(f=>P[f].n).join(' or ')}</p></button>`).join('');\n  el.querySelectorAll('[data-goal]').forEach(b=>b.onclick=()=>{goal=b.dataset.goal;hl=GOALS.find(g=>g[0]===goal)[2];renderGoals();renderGrid();document.getElementById('p-'+hl[0]).scrollIntoView({behavior:'smooth',block:'center'});});\n}\n\nconst ORDER=['lite','smart','pro','music','ultra'];\nconst ROWS=[['Battery life',['5 days','7 days','10 days','6 days','14 days'],1],['GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],['ECG with Heart Screener',[0,0,1,0,1],1],['Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],['Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],['Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],['Buy outright',['$149','$199','$299','$279','$399'],1],['Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only'],1],['Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],['Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],['Sleep stages & Sleep Performance',[1,1,1,1,1],0],['Recovery & Strain scores',[1,1,1,1,1],0],['Skin temperature',[0,1,1,1,1],0],['Blood Pressure Insights',[0,0,1,0,1],0],['Workout types',['20','40','120','80','150'],0],['Bluetooth headphones',[0,0,0,1,0],0]];\nlet showAll=false;\nconst cell=v=>v===1?'<span class=\"text-[17px]\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[#C9C0C2]\">—</span>':v;\nfunction renderTable(){\n  document.getElementById('specHead').innerHTML=`<tr><th class=\"bg-white rounded-tl-[24px] text-left font-medium text-[#6B4F57] p-5 w-[260px] border-b border-[#F0EBE8]\">Specification</th>${ORDER.map((f,i)=>`<th class=\"bg-white p-5 text-left border-b border-[#F0EBE8] ${i===4?'rounded-tr-[24px]':''}\"><p class=\"serif text-[20px] font-medium leading-none\">${P[f].n}</p><a href=\"#p-${f}\" class=\"mt-1.5 inline-block text-[13px] font-medium underline underline-offset-2\">Add · $${P[f].price}</a></th>`).join('')}</tr>`;\n  document.getElementById('specBody').innerHTML=ROWS.filter(r=>showAll||r[2]).map(r=>`<tr><td class=\"px-5 py-3.5 border-b border-[#F3EFEC] text-[#4A2A33]\">${r[0]}</td>${r[1].map(v=>`<td class=\"px-5 py-3.5 border-b border-[#F3EFEC]\">${cell(v)}</td>`).join('')}</tr>`).join('');\n  document.getElementById('showAll').textContent=showAll?'Show 8 key specifications':'Show all 16 specifications';\n}\ndocument.getElementById('showAll').onclick=()=>{showAll=!showAll;renderTable();};\nrenderGrid();renderGoals();renderTable();\n</script>\n",
      "comments": [],
      "created": "2026-10-16T10:27:45.583596+00:00",
