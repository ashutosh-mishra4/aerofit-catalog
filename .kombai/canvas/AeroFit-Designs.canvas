d=\"1-8-1-1-2-1\" data-name=\"close X icon\">\n                    </i>\n                </button>\n            </div>\n            <p class=\"mt-2 text-[13px] text-[#6B4F57]\" data-kid=\"1-8-1-2\" data-name=\"modal description text\">\n                Choose a 30-minute session to review your store and growth goals.\n            </p>\n            <div class=\"mt-5 grid grid-cols-2 gap-2.5\" data-kid=\"1-8-1-3\" data-name=\"meeting slot grid\">\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-8-1-3-1\" data-name=\"meeting slot option\">\n                    <span class=\"block font-medium\" data-kid=\"1-8-1-3-1-1\" data-name=\"slot weekday label\">\n                        Tomorrow\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-8-1-3-1-2\" data-name=\"slot time label\">\n                        10:30 AM\n                    </span>\n                </button>\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-8-1-3-2\" data-name=\"meeting slot option\">\n                    <span class=\"block font-medium\" data-kid=\"1-8-1-3-2-1\" data-name=\"slot weekday label\">\n                        Tomorrow\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-8-1-3-2-2\" data-name=\"slot time label\">\n                        2:00 PM\n                    </span>\n                </button>\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-8-1-3-3\" data-name=\"meeting slot option\">\n                    <span class=\"block font-medium\" data-kid=\"1-8-1-3-3-1\" data-name=\"slot weekday label\">\n                        Thursday\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-8-1-3-3-2\" data-name=\"slot time label\">\n                        11:00 AM\n                    </span>\n                </button>\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-8-1-3-4\" data-name=\"meeting slot option\">\n                    <span class=\"block font-medium\" data-kid=\"1-8-1-3-4-1\" data-name=\"slot weekday label\">\n                        Friday\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-8-1-3-4-2\" data-name=\"slot time label\">\n                        3:30 PM\n                    </span>\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    const prices={shopify:{analytics:1000,optimization:2000},woocommerce:{analytics:1000,optimization:2000},both:{analytics:1800,optimization:3600}};\nconst names={shopify:'Shopify',woocommerce:'WooCommerce',both:'Shopify + WooCommerce'};\nlet platform='shopify',plan='analytics',annual=true;const money=v=>'$'+Math.round(v).toLocaleString('en-US');\nconst tabOn='platform-tab flex h-12 items-center justify-center gap-2 rounded-full bg-[#F8F38A] text-[14px] font-medium text-[#2A0B14]';\nconst tabOff='platform-tab flex h-12 items-center justify-center gap-2 rounded-full text-[14px] font-medium text-[#6B4F57] transition hover:bg-[#F3EFEC]';\nconst cOn='plan-card relative flex min-h-[380px] flex-col rounded-[26px] border-[1.5px] border-[#2A0B14] bg-[radial-gradient(ellipse_at_100%_0%,#FBF4B8_0%,#FFFDF2_40%,#FFFFFF_75%)] p-7 text-left shadow-[0_18px_44px_rgba(42,11,20,0.10)]';\nconst cOff='plan-card relative flex min-h-[380px] flex-col rounded-[26px] border-[1.5px] border-[#EFEAE6] bg-white p-7 text-left transition hover:border-[#D9D0CB]';\nfunction render(){\n  document.querySelectorAll('.platform-tab').forEach(t=>{const a=t.dataset.platform===platform;t.setAttribute('aria-selected',String(a));t.className=a?tabOn:tabOff;});\n  document.querySelectorAll('.plan-card').forEach(c=>{const a=c.dataset.plan===plan;c.setAttribute('aria-pressed',String(a));c.className=a?cOn:cOff;\n    const d=c.querySelector('.choice-dot');d.className=a?'choice-dot absolute right-6 top-6 grid size-6 place-items-center rounded-full bg-[#2A0B14]':'choice-dot absolute right-6 top-6 size-6 rounded-full border-[1.5px] border-[#D9D0CB] bg-white';d.innerHTML=a?'<span class=\"size-2.5 rounded-full bg-[#F8F38A]\"></span>':'';\n    c.querySelector('.plan-icon').className=a?'plan-icon grid size-11 place-items-center rounded-full bg-[#F8F38A] text-[20px] text-[#2A0B14]':'plan-icon grid size-11 place-items-center rounded-full bg-[#F3EFEC] text-[20px] text-[#4A2A33]';\n    const base=prices[platform][c.dataset.plan];c.querySelector('.price').textContent=money(annual?base*.8:base);\n    const n=c.querySelector('.billing-note');n.textContent=annual?'Billed annually · save '+money(base*12*.2):'Billed monthly · cancel anytime';n.className=annual?'billing-note mt-1.5 text-[11.5px] font-medium text-[#1E7A52]':'billing-note mt-1.5 text-[11.5px] font-medium text-[#6B4F57]';});\n  const base=prices[platform][plan],shown=annual?base*.8:base,pn=plan==='analytics'?'Analytics':'Optimization';\n  document.getElementById('platformContext').textContent=names[platform]+' selected';\n  document.getElementById('summaryPlatform').textContent=names[platform];document.getElementById('summaryPlan').textContent=pn;\n  document.getElementById('summaryPrice').textContent=money(shown);\n  document.getElementById('summarySavings').textContent=annual?'You save '+money(base*12*.2)+'/year':'Flexible monthly billing';\n  document.getElementById('summaryBillingNote').textContent=(annual?'Annual':'Monthly')+' billing · Cancel anytime';\n  document.getElementById('bottomSummary').textContent=names[platform]+' · '+pn;\n  document.getElementById('bottomPrice').textContent=money(shown)+'/month, '+(annual?'billed annually':'billed monthly');\n  const tg=document.getElementById('billingToggle');tg.setAttribute('aria-checked',String(annual));tg.className=annual?'relative h-7 w-12 rounded-full bg-[#2A0B14]':'relative h-7 w-12 rounded-full bg-[#D9D0CB]';\n  document.getElementById('billingKnob').className=annual?'absolute right-1 top-1 size-5 rounded-full bg-[#F8F38A]':'absolute left-1 top-1 size-5 rounded-full bg-white';\n}\ndocument.querySelectorAll('.platform-tab').forEach(t=>t.addEventListener('click',()=>{platform=t.dataset.platform;render();}));\ndocument.querySelectorAll('.plan-card').forEach(c=>c.addEventListener('click',()=>{plan=c.dataset.plan;render();}));\ndocument.getElementById('billingToggle').addEventListener('click',()=>{annual=!annual;render();});\nconst toast=document.getElementById('toast');function proceed(){toast.classList.remove('opacity-0','translate-y-3');setTimeout(()=>toast.classList.add('opacity-0','translate-y-3'),2200);}\ndocument.getElementById('continueButton').addEventListener('click',proceed);document.getElementById('bottomContinue').addEventListener('click',proceed);\nconst modal=document.getElementById('meetingModal');function openM(){modal.classList.remove('hidden');modal.classList.add('flex');}\ndocument.getElementById('meetingButton').addEventListener('click',openM);document.getElementById('meetingHeader').addEventListener('click',openM);\ndocument.getElementById('closeModal').addEventListener('click',()=>{modal.classList.add('hidden');modal.classList.remove('flex');});\nmodal.addEventListener('click',e=>{if(e.target===modal){modal.classList.add('hidden');modal.classList.remove('flex');}});\nrender();\n</script>\n",
