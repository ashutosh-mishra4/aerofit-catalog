        </aside>\n        </div>\n        <section class=\"mt-8 grid grid-cols-[240px_1fr] items-center gap-8 rounded-[22px] bg-[#F3EDE9] px-7 py-5\" data-kid=\"1-3-3\" data-name=\"bottom reassurance band\">\n            <div class=\"text-[12.5px] leading-[1.55] text-[#6B4F57]\" data-kid=\"1-3-3-1\" data-name=\"reassurance message with emphasis\">\n                Move forward with confidence.\n                <br data-kid=\"1-3-3-1-1\" data-name=\"line break\"/>\n                <strong class=\"font-medium text-[#2A0B14]\" data-kid=\"1-3-3-1-2\" data-name=\"bold reassurance emphasis text\">\n                    Everything is reviewable before payment.\n                </strong>\n            </div>\n            <div class=\"flex justify-between gap-5 text-[13px] font-medium text-[#4A2A33]\" data-kid=\"1-3-3-2\" data-name=\"benefits row\">\n                <span class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-2-1\" data-name=\"Guided onboarding benefit\">\n                    <span class=\"grid size-8 place-items-center rounded-full bg-white text-[16px]\" data-kid=\"1-3-3-2-1-1\" data-name=\"rosette discount icon circle\">\n                        <i class=\"ti ti-rosette-discount-check\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"rosette discount check icon\">\n                        </i>\n                    </span>\n                    Guided onboarding\n                </span>\n                <span class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-2-2\" data-name=\"Unlimited team members benefit\">\n                    <span class=\"grid size-8 place-items-center rounded-full bg-white text-[16px]\" data-kid=\"1-3-3-2-2-1\" data-name=\"users icon circle\">\n                        <i class=\"ti ti-users\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"users icon\">\n                        </i>\n                    </span>\n                    Unlimited team members\n                </span>\n                <span class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-