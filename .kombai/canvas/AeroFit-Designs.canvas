('hidden'),1800)}\n  const pOn='platform flex min-h-[68px] items-center gap-3 rounded-[18px] border border-transparent bg-[#F8F38A] py-3.5 pl-3.5 pr-4 text-left shadow-[0_6px_18px_rgba(42,11,20,0.08)]';\n  const pOff='platform flex min-h-[68px] items-center gap-3 rounded-[18px] border border-[#EFEAE6] bg-white py-3.5 pl-3.5 pr-4 text-left transition hover:border-[#D9D0CB]';\n  const cOn='plan-card relative flex min-h-[430px] flex-col rounded-[26px] border-[1.5px] border-[#2A0B14] bg-[radial-gradient(ellipse_at_100%_0%,#FBF4B8_0%,#FFFDF2_38%,#FFFFFF_72%)] p-6 text-left shadow-[0_18px_44px_rgba(42,11,20,0.10)]';\n  const cOff='plan-card relative flex min-h-[430px] flex-col rounded-[26px] border-[1.5px] border-[#EFEAE6] bg-white p-6 text-left transition hover:border-[#D9D0CB]';\n  function render(){\n    const p=pricing[state.platform],annual=state.billing==='annual',f=annual?.8:1,base=p[state.plan],monthly=base*f;\n    document.querySelectorAll('[data-platform]').forEach(el=>{const on=el.dataset.platform===state.platform;el.className=on?pOn:pOff;el.setAttribute('aria-checked',on);\n      el.querySelector('.p-icon').className=on?'p-icon grid size-9 shrink-0 place-items-center rounded-full bg-white/80 text-[17px] text-[#2A0B14]':'p-icon grid size-9 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[17px] text-[#4A2A33]';\n      el.querySelector('.p-price').className=on?'p-price text-[11px] text-[#4A2A33]':'p-price text-[11px] text-[#9A8E91]';});\n    document.querySelectorAll('[data-billing]').forEach(el=>{const on=el.dataset.billing===state.billing;el.className=on?'bill-btn h-9 rounded-full bg-[#2A0B14] px-4 text-[12px] font-medium text-white':'bill-btn h-9 rounded-full px-4 text-[12px] font-medium text-[#6B4F57] hover:bg-[#F3EFEC]';});\n    document.querySelectorAll('[data-plan]').forEach(el=>{const on=el.dataset.plan===state.plan;el.className=on?cOn:cOff;el.setAttribute('aria-checked',on);\n      el.querySelector('.plan-icon').className=on?'plan-icon grid size-10 shrink-0 place-items-center rounded-full bg-[#F8F38A] text-[19px] text-[#2A0B14]':'plan-icon grid size-10 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[19px] text-[#4A2A33]';\n      const r=el.querySelector('.radio');r.className=on?'radio ml-auto grid size-5 place-items-center rounded-full bg-[#2A0B14]':'radio ml-auto size-5 rounded-full border-[1.5px] border-[#D9D0CB] bg-white';r.innerHTML=on?'<span class=\"size-2 rounded-full bg-[#F8F38A]\"></span>':'';});\n    ['analytics','optimization'].forEach(plan=>{const v=p[plan]*f,nm=plan==='analytics'?'Analytics':'Optimization',on=plan===state.plan;\n      document.getElementById(plan+'Price').textContent=money(v);\n      document.getElementById(plan+'Note').textContent=annual?money(v*12)+' billed once yearly.':'Billed monthly. Cancel anytime.';\n      const ch=document.getElementById(plan+'Choose');ch.className=on?'choose mt-auto flex h-11 items-center justify-center gap-2 rounded-full bg-[#2A0B14] text-[13px] font-medium text-white':'choose mt-auto flex h-11 items-center justify-center gap-2 rounded-full border border-[#D9D0CB] bg-white text-[13px] font-medium text-[#2A0B14]';\n      ch.innerHTML=on?'<span class=\"text-[15px] text-[#F8F38A]\"><i class=\"ti ti-check\"></i></span>'+nm+' selected':'Select '+nm+' <span class=\"text-[15px]\"><i class=\"ti ti-arrow-right\"></i></span>';});\n    document.getElementById('summaryPlatform').textContent=p.label;document.getElementById('summaryPlan').textContent=state.plan==='analytics'?'Analytics':'Optimization';\n    document.getElementById('billingTag').textContent=annual?'Annual':'Monthly';\n    document.getElementById('subtotal').textContent=money(state.platform==='both'?p[state.plan]/.9:p[state.plan]);\n    document.getElementById('bundleRow').style.display=state.platform==='both'?'flex':'none';document.getElementById('bundleSaving').textContent='−'+money(state.plan==='analytics'?200:400);\n    document.getElementById('annualRow').style.display=annual?'flex':'none';document.getElementById('annualSaving').textContent='−'+money(base*.2);\n    document.getElementById('total').textContent=money(monthly);document.getElementById('charge').textContent=annual?money(monthly*12)+' billed annually · USD':money(monthly)+' billed monthly · USD';\n    const yearly=base*12*.2,n=document.getElementById('annualNudge');n.innerHTML=annual?'You’re saving '+money(yearly)+' per year <span class=\"text-[13px]\"><i class=\"ti ti-check\"></i></span>':'Save '+money(yearly)+'/year with annual billing <span class=\"text-[13px]\"><i class=\"ti ti-arrow-right\"></i></span>';n.disabled=annual;\n  }\n  document.querySelectorAll('[data-platform]').forEach(el=>el.addEventListener('click',()=>{state.platform=el.dataset.platform;render();showToast(pricing[state.platform].label+' selected')}));\n  document.querySelectorAll('[data-billing]').forEach(el=>el.addEventListener('click',()=>{state.billing=el.dataset.billing;render();showToast(state.billing==='annual'?'20% annual discount applied':'Monthly billing selected')}));\n  document.querySelectorAll('[data-plan]').forEach(el=>el.addEventListener('click',()=>{state.plan=el.dataset.plan;render();}));\n  document.getElementById('annualNudge').addEventListener('click',()=>{state.billing='annual';render();showToast('20% annual discount applied')});\n  document.getElementById('continueButton').addEventListener('click',()=>showToast('Selection ready · continuing to Payment'));\n  render();\n})();\n</script>\n",
