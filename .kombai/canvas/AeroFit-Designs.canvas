    "inspiration_node_817e63f21f8f": {
      "type": "variant",
      "id": "inspiration_node_817e63f21f8f",
      "label": "Little Orrery",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:18920/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/AeroFit-Designs.canvas\", nodeId: \"inspiration_node_817e63f21f8f\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><link href=\"https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&amp;family=Cinzel:wght@500;600;700;800;900&amp;family=Fredoka:wght@400;500;600;700&amp;family=Quicksand:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n<style>\n  :root{\n    --night:#16183A; --paper:#F4ECDA; --ink:#1A1B33; --cream:#F6EFE0;\n    --tangerine:#FF6A2B; --aqua:#1FB6C4; --marigold:#F4B92E;\n    --ease:cubic-bezier(.16,.84,.44,1);\n    --spring:cubic-bezier(.34,1.56,.64,1);\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Quicksand',sans-serif; background:var(--paper); color:var(--ink);\n    line-height:1.6; overflow-x:hidden; -webkit-font-smoothing:antialiased;\n  }\n  .disp{font-family:'Fredoka',sans-serif;}\n  /* painted paper texture */\n  .paper-tex{\n    background-color:var(--paper);\n    background-image:\n      radial-gradient(circle at 18% 28%, rgba(244,185,46,.05) 0%, transparent 42%),\n      radial-gradient(circle at 82% 72%, rgba(31,182,196,.05) 0%, transparent 42%),\n      radial-gradient(circle at 50% 50%, rgba(255,106,43,.035) 0%, transparent 55%);\n  }\n  .night-tex{\n    background-color:var(--night);\n    background-image:\n      radial-gradient(circle at 15% 22%, rgba(244,185,46,.07) 0%, transparent 38%),\n      radial-gradient(circle at 85% 78%, rgba(31,182,196,.08) 0%, transparent 40%),\n      radial-gradient(circle at 60% 40%, rgba(255,106,43,.05) 0%, transparent 50%);\n  }\n  .wrap{max-width:1240px;margin:0 auto;padding:0 32px}\n  .eyebrow{font-family:'Fredoka',sans-serif;font-weight:500;text-transform:uppercase;\n    letter-spacing:.28em;font-size:.72rem;}\n  a{color:inherit;text-decoration:none}\n  button{font-family:inherit;cursor:pointer;border:none}\n  /* cinematic plaque buttons — squared, engraved gold keyline, uppercase */\n  .btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;\n    background:var(--tangerine);color:var(--cream);font-family:'Fredoka',sans-serif;\n    font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;\n    padding:14px 26px;border-radius:5px;\n    box-shadow:inset 0 0 0 1.5px rgba(244,185,46,.7), 0 10px 26px rgba(255,106,43,.3);\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease);}\n  .btn-primary:hover{background:#ec5a1d;transform:translateY(-3px);\n    box-shadow:inset 0 0 0 1.5px var(--marigold), 0 14px 34px rgba(255,106,43,.45);}\n  .btn-primary:focus-visible,.btn-text:focus-visible,a:focus-visible,input:focus-visible{\n    outline:3px solid var(--aqua);outline-offset:3px}\n  .btn-text{display:inline-flex;align-items:center;gap:10px;background:none;color:inherit;\n    font-family:'Fredoka',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:.74rem;\n    padding:13px 22px;border-radius:5px;box-shadow:inset 0 0 0 1px currentColor;\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease);}\n  .btn-text:hover{transform:translateY(-3px);box-shadow:inset 0 0 0 1px var(--marigold)}\n  .star{display:inline-block;width:1em;height:1em;background:var(--marigold);\n    clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}\n\n  /* NAV */\n  nav.bar{display:flex;align-items:center;justify-content:space-between;padding:22px 0;position:relative;z-index:50}\n  .logo-dot{width:38px;height:38px;border-radius:50%;background:var(--night);position:relative;flex:0 0 auto}\n  .logo-dot i{position:absolute;border-radius:50%}\n  .logo-dot .d1{width:8px;height:8px;background:var(--marigold);top:6px;left:8px}\n  .logo-dot .d2{width:5px;height:5px;background:var(--cream);bottom:8px;right:8px}\n  .logo-dot .d3{width:6px;height:6px;background:var(--tangerine);top:12px;right:7px}\n  .brandrow{display:flex;align-items:center;gap:12px}\n  .brandname{font-family:'Fredoka',sans-serif;font-weight:700;font-size:1.5rem;letter-spacing:-.01em}\n  .brandtag{font-size:.72rem;color:rgba(26,27,51,.6);font-style:italic;max-width:160px;line-height:1.3}\n  .navlinks{display:flex;gap:28px;font-weight:500;font-size:.92rem}\n  .navlinks a:hover{color:var(--tangerine)}\n  .navright{display:flex;align-items:center;gap:14px}\n  .signin{background:none;font-weight:500;font-size:.92rem}\n\n  /* HERO — looping cosmos video (Mode B) */\n  .hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:center;\n    overflow:hidden;background:var(--night);color:var(--cream);isolation:isolate}\n  /* layer 0: CSS cosmos fallback (shows until/if hero.mp4 + hero.png exist) */\n  .hero-sky{position:absolute;inset:0;z-index:0;\n    background:\n      radial-gradient(ellipse 80% 60% at 72% 16%, rgba(31,182,196,.20), transparent 60%),\n      radial-gradient(ellipse 75% 55% at 20% 82%, rgba(255,106,43,.18), transparent 62%),\n      radial-gradient(circle at 50% 42%, #1e2356 0%, var(--night) 72%)}\n  .hero-sky::before{content:\"\";position:absolute;inset:0;animation:twinkle 6s ease-in-out infinite;\n    background-repeat:no-repeat;background-image:\n      radial-gradient(1.6px 1.6px at 18% 28%, rgba(246,239,224,.95), transparent),\n      radial-gradient(1.2px 1.2px at 64% 20%, rgba(246,239,224,.7), transparent),\n      radial-gradient(1.6px 1.6px at 82% 58%, rgba(244,185,46,.85), transparent),\n      radial-gradient(1.1px 1.1px at 38% 70%, rgba(246,239,224,.6), transparent),\n      radial-gradient(1.1px 1.1px at 11% 78%, rgba(246,239,224,.55), transparent),\n      radial-gradient(1.6px 1.6px at 90% 33%, rgba(246,239,224,.75), transparent),\n      radial-gradient(1.2px 1.2px at 54% 48%, rgba(31,182,196,.75), transparent),\n      radial-gradient(1.1px 1.1px at 30% 14%, rgba(246,239,224,.5), transparent),\n      radial-gradient(1.3px 1.3px at 74% 80%, rgba(246,239,224,.6), transparent)}\n  @keyframes twinkle{0%,100%{opacity:.5}50%{opacity:1}}\n  /* revolving planets */\n  .hero-orbit{position:absolute;z-index:0;top:48%;left:50%;width:min(128vh,1180px);aspect-ratio:1;\n    transform:translate(-50%,-50%);pointer-events:none}\n  .hero-orbit .ring{position:absolute;top:50%;left:50%;border-radius:50%;transform:translate(-50%,-50%);\n    border:1px solid rgba(246,239,224,.09)}\n  .hero-orbit .r1{width:100%;height:100%;animation:spin 64s linear infinite}\n  .hero-orbit .r2{width:68%;height:68%;border-color:rgba(31,182,196,.14);animation:spin 44s linear infinite reverse}\n  .hero-orbit .r3{width:40%;height:40%;border-color:rgba(244,185,46,.14);animation:spin 30s linear infinite}\n  .hero-orbit .planet{position:absolute;top:-9px;left:50%;width:18px;height:18px;border-radius:50%;transform:translateX(-50%)}\n  .hero-orbit .p1{background:radial-gradient(circle at 34% 30%, #6675f4, var(--ultramarine,#1B34D8) 72%);box-shadow:0 0 18px rgba(31,182,196,.45)}\n  .hero-orbit .p2{width:13px;height:13px;top:-7px;background:radial-gradient(circle at 34% 30%, var(--aqua), #0c7681 72%);box-shadow:0 0 14px rgba(31,182,196,.5)}\n  .hero-orbit .p3{width:11px;height:11px;top:-6px;background:radial-gradient(circle at 34% 30%, var(--marigold), #ad7a11 72%);box-shadow:0 0 13px rgba(244,185,46,.55)}\n  @keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}\n  /* layer 1: the video */\n  .hero-video{position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;\n    opacity:0;transition:opacity 1.2s var(--ease)}\n  .hero-video.ready{opacity:1}\n  /* layer 2: center-weighted legibility scrim — tames the busy painted\n     cosmos behind the text while keeping the corner planets vivid */\n  .hero-scrim{position:absolute;inset:0;z-index:2;pointer-events:none;\n    background:\n      radial-gradient(ellipse 70% 74% at 50% 50%, rgba(22,24,58,.66) 0%, rgba(22,24,58,.28) 52%, rgba(22,24,58,.08) 78%),\n      linear-gradient(to bottom, rgba(22,24,58,.5) 0%, rgba(22,24,58,.2) 26%, rgba(22,24,58,.2) 60%, rgba(22,24,58,.66) 100%)}\n  /* layer 3: content — center aligned */\n  .hero-inner{position:relative;z-index:3;padding-top:96px;padding-bottom:24px;text-align:center}\n  .hero-eyebrow{color:var(--aqua);margin-bottom:20px;letter-spacing:.34em}\n  .hero-h1{font-family:'Cinzel Decorative','Cinzel',serif;font-weight:700;font-size:clamp(1.9rem,5vw,4.3rem);\n    line-height:1.16;letter-spacing:.012em;max-width:17ch;margin:0 auto;text-shadow:0 2px 30px rgba(22,24,58,.6)}\n  .hero-h1 .ln{display:block;overflow:hidden;padding-bottom:.08em}\n  .hero-h1 .ln>span{display:block;transform:translateY(116%);transform-origin:center top;\n    transition:transform 1s var(--ease)}\n  .hero-h1 .ln:nth-child(2)>span{transition-delay:.12s}\n  .hero.is-in .hero-h1 .ln>span{transform:translateY(0)}\n  .hero-h1 .tang{color:var(--tangerine);font-style:normal}\n  .hero-sub{margin:24px auto 0;max-width:46ch;font-size:clamp(1rem,1.4vw,1.18rem);color:var(--cream);opacity:.92;text-shadow:0 1px 14px rgba(22,24,58,.6)}\n  .hero-ctas{margin-top:36px;display:flex;align-items:stretch;justify-content:center;gap:18px;flex-wrap:wrap}\n  /* cinematic CTAs — squared plaques with an engraved gold keyline */\n  .hero-ctas .btn-primary{display:inline-flex;align-items:center;gap:9px;border-radius:5px;\n    padding:0 32px;min-height:56px;background:var(--tangerine);color:var(--cream);\n    font-family:'Fredoka',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.16em;font-size:.8rem;\n    box-shadow:inset 0 0 0 1.5px rgba(244,185,46,.7), 0 12px 30px rgba(255,106,43,.34);\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease)}\n  .hero-ctas .btn-primary:hover{background:#ec5a1d;transform:translateY(-3px);\n    box-shadow:inset 0 0 0 1.5px var(--marigold), 0 16px 40px rgba(255,106,43,.48)}\n  .hero-ctas .btn-text{display:inline-flex;align-items:center;gap:11px;border-radius:5px;\n    padding:0 26px;min-height:56px;background:rgba(246,239,224,.04);color:var(--cream);\n    font-family:'Fredoka',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.16em;font-size:.78rem;\n    box-shadow:inset 0 0 0 1px rgba(246,239,224,.42);\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease)}\n  .hero-ctas .btn-text:hover{background:rgba(246,239,224,.1);transform:translateY(-3px);\n    box-shadow:inset 0 0 0 1px var(--marigold)}\n  .hero-ctas .btn-text .star{background:var(--marigold)}\n  .hero-proof{position:relative;z-index:3;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:14px 18px;\n    padding-top:22px;padding-bottom:30px;font-size:.82rem;color:var(--cream);opacity:.92;text-shadow:0 1px 12px rgba(22,24,58,.7)}\n  .hero-proof i{width:4px;height:4px;border-radius:50%;background:var(--marigold);opacity:.7}\n  .hero-proof b{font-family:'Fredoka',sans-serif;font-weight:700;color:var(--marigold);font-style:normal}\n  .hero-scroll{position:absolute;z-index:3;left:50%;bottom:22px;transform:translateX(-50%);\n    width:42px;height:42px;border-radius:50%;border:1px solid rgba(246,239,224,.35);color:var(--cream);\n    display:flex;align-items:center;justify-content:center;font-size:1.1rem;animation:bob 2.4s var(--ease) infinite}\n  .hero-scroll:hover{background:rgba(246,239,224,.12)}\n  @keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,7px)}}\n  /* staged reveal of supporting copy after the headline lands */\n  .hero-eyebrow,.hero-sub,.hero-ctas,.hero-proof{opacity:0;transform:translateY(16px);\n    transition:opacity .8s var(--ease),transform .8s var(--ease)}\n  .hero.is-in .hero-eyebrow{opacity:1;transform:none;transition-delay:.05s}\n  .hero.is-in .hero-sub{opacity:.92;transform:none;transition-delay:.5s}\n  .hero.is-in .hero-ctas{opacity:1;transform:none;transition-delay:.62s}\n  .hero.is-in .hero-proof{opacity:.88;transform:none;transition-delay:.74s}\n  /* nav overlays the hero on a transparent bar */\n  header.wrap{position:absolute;top:0;left:0;right:0;z-index:50}\n  header.wrap .brandname,header.wrap .navlinks a,header.wrap .signin,header.wrap .brandtag{text-shadow:0 1px 12px rgba(22,24,58,.65)}\n  header.wrap .brandname,header.wrap .navlinks a,header.wrap .signin{color:var(--cream)}\n  header.wrap .brandtag{color:rgba(246,239,224,.7)}\n  header.wrap .navlinks a:hover{color:var(--marigold)}\n  header.wrap .logo-dot{background:rgba(246,239,224,.14);box-shadow:inset 0 0 0 1px rgba(246,239,224,.3)}\n\n  /* CATALOG */\n  .catalog{color:var(--cream);padding:96px 0;position:relative;overflow:hidden}\n  .cat-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:34px;flex-wrap:wrap}\n  .cat-head .eyebrow{color:var(--marigold)}\n  .cat-head h2{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.95;margin-top:10px;max-width:11ch}\n  .cat-head h2 .clip{display:inline-block;overflow:hidden;vertical-align:bottom;max-width:100%}\n  .cat-head h2 .clip i{display:inline-block;clip-path:inset(0 100% 0 0);transition:clip-path 1s var(--ease);font-style:normal;white-space:normal}\n  .is-in h2 .clip i{clip-path:inset(0 0 0 0)}\n  .cat-head h2 .tang{color:var(--tangerine);font-weight:500;font-style:italic}\n  .cat-intro{max-width:34ch;font-size:.92rem;color:rgba(246,239,224,.65);text-align:right;font-style:italic}\n  .pills{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:48px}\n  .pill{background:var(--cream);color:var(--ink);font-weight:500;font-size:.85rem;padding:10px 20px;\n    border-radius:999px;transition:background .3s var(--ease),color .3s var(--ease)}\n  .pill.active{background:var(--tangerine);color:var(--cream);font-weight:600}\n  .pill:hover{background:var(--aqua);color:var(--cream)}\n  .pill-sep{width:1px;height:36px;background:rgba(246,239,224,.2);margin:0 6px;align-self:center}\n  .grid-scene{perspective:1500px}\n  .bookgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;transform-style:preserve-3d}\n  .book{position:relative;transform-style:preserve-3d;will-change:transform;\n    transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(var(--zsep,0px));\n    transition:transform .3s var(--ease);opacity:0}\n  .book.rise{opacity:1}\n  .book .cover{position:relative;aspect-ratio:2/3;border-radius:12px;overflow:hidden;\n    box-shadow:0 14px 34px rgba(0,0,0,.34);background:var(--aqua)}\n  .book .cover img{width:100%;height:100%;object-fit:cover;display:block}\n  .book .peek{position:absolute;inset:0;display:flex;align-items:flex-end;padding:14px;\n    background:rgba(22,24,58,.7);color:var(--cream);font-style:italic;font-size:.8rem;\n    opacity:0;transition:opacity .4s var(--ease)}\n  .book:hover{transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(calc(var(--zsep,0px) + 50px)) scale(1.02)}\n  .book:hover .peek{opacity:1}\n  .book .meta{margin-top:14px}\n  .book .title{font-family:'Fredoka',sans-serif;font-weight:600;font-size:1.15rem;line-height:1.05}\n  .book .by{font-size:.78rem;color:rgba(246,239,224,.6);font-style:italic;margin-top:4px}\n  .book .row{margin-top:12px;display:flex;align-items:center;justify-content:space-between}\n  .tag{font-size:.7rem;padding:4px 11px;border-radius:999px;font-weight:600}\n  .price{font-family:'Fredoka',sans-serif;font-weight:700;font-size:1.1rem;color:var(--marigold)}\n  .seeall{display:flex;align-items:center;justify-content:center;text-align:center;border-radius:12px;\n    aspect-ratio:2/3;background:rgba(244,185,46,.14);border:2px dashed rgba(244,185,46,.4)}\n  .seeall .disp{font-size:1.5rem;color:var(--marigold)}\n  .cat-foot{margin-top:30px;font-style:italic;font-size:.9rem;color:rgba(246,239,224,.7);display:flex;align-items:center;gap:10px}\n\n  /* CLASSROOM sticky stack */\n  .classroom-outer{position:relative;height:400vh}\n  .panel{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;align-items:center;\n    border-radius:0;transform-origin:center top;will-change:transform}\n  .panel-inner{width:100%;max-width:1240px;margin:0 auto;padding:0 48px;position:relative;z-index:3;\n    filter:blur(10px);opacity:0;transition:filter .7s var(--ease),opacity .7s var(--ease)}\n  .panel.locked .panel-inner{filter:blur(0);opacity:1}\n  .panel .bgphoto{position:absolute;inset:0}\n  .panel .bgphoto img{width:100%;height:100%;object-fit:cover;display:block}\n  .panel .bgphoto::after{content:'';position:absolute;inset:0}\n  .p1{background:var(--paper)}\n  .p2{background:var(--tangerine)} .p2 .bgphoto::after{background:rgba(255,106,43,.55)}\n  .p3{background:var(--aqua)} .p3 .bgphoto::after{background:rgba(31,182,196,.55)}\n  .p4{background:var(--night)} .p4 .bgphoto::after{background:rgba(22,24,58,.62)}\n  .p1 .eyebrow{color:var(--aqua)}\n  .p1 h2{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.4rem,5.2vw,4.2rem);line-height:.95;margin-top:10px;max-width:14ch}\n  .p1 h2 .tang{color:var(--tangerine);font-style:italic;font-weight:500}\n  .p1 .lead{margin-top:20px;max-width:46ch;font-size:1.05rem;color:rgba(26,27,51,.78)}\n  .checks{margin-top:24px;display:flex;flex-direction:column;gap:12px;max-width:42ch}\n  .checks li{list-style:none;display:flex;gap:12px;align-items:flex-start;font-size:.95rem}\n  .checks .ck{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--aqua);color:var(--cream);\n    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;margin-top:2px}\n  .p1 .ctas{margin-top:32px;display:flex;gap:20px;align-items:center;flex-wrap:wrap}\n  .bignum{font-family:'Fredoka',sans-serif;font-weight:700;color:var(--cream);\n    font-size:clamp(5rem,14vw,11rem);line-height:.82}\n  .panel.dark .panel-content{color:var(--cream)}\n  .panel-content{max-width:620px}\n  .panel-content .lab{font-family:'Fredoka',sans-serif;text-transform:uppercase;letter-spacing:.2em;\n    font-weight:500;font-size:.78rem;color:var(--cream);opacity:.85}\n  .panel-content .big{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2rem,4.6vw,3.6rem);\n    line-height:1.02;margin-top:14px;color:var(--cream)}\n  .panel-content .big .it{font-style:italic;font-weight:500}\n  .panel-content .sub{margin-top:16px;font-size:1.05rem;color:var(--cream);opacity:.92;max-width:40ch}\n  .p4 .ctas{margin-top:32px;display:flex;gap:20px;align-items:center;flex-wrap:wrap}\n  .quoteline{font-family:'Fredoka',sans-serif;font-weight:500;font-style:italic;\n    font-size:clamp(1.6rem,3.6vw,2.8rem);line-height:1.12;color:var(--cream);max-width:18ch}\n  .quoteline .who{display:block;font-style:normal;font-weight:600;font-size:1rem;margin-top:18px;opacity:.9;font-family:'Quicksand',sans-serif}\n\n  /* EVENTS timeline */\n  .events{padding:96px 0;position:relative}\n  .ev-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:60px;flex-wrap:wrap}\n  .ev-head .eyebrow{color:var(--tangerine)}\n  .ev-head h2{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.4rem,5vw,4rem);\n    line-height:.95;margin-top:10px;transform:translateY(34px) skewY(5deg);opacity:0;\n    transition:transform 1s var(--ease),opacity 1s var(--ease)}\n  .ev-head.is-in h2{transform:translateY(0) skewY(0);opacity:1}\n  .ev-head h2 .aqua{color:var(--aqua);font-style:italic;font-weight:500}\n  .ev-intro{max-width:30ch;font-size:.92rem;color:rgba(26,27,51,.6);font-style:italic;text-align:right}\n  .thread{position:relative;padding-left:84px}\n  .spine{position:absolute;left:30px;top:6px;bottom:6px;width:4px;border-radius:4px;\n    background:repeating-linear-gradient(180deg,var(--aqua) 0 10px,transparent 10px 18px);\n    transform:scaleY(0);transform-origin:top center;will-change:transform}\n  .ev{position:relative;margin-bottom:34px;opacity:0;transform:translateY(28px);\n    transition:opacity .8s var(--ease),transform .8s var(--ease)}\n  .ev.rise{opacity:1;transform:translateY(0)}\n  .ev .marker{position:absolute;left:-66px;top:18px;width:30px;height:30px}\n  .ev .card2{background:#fff;border-radius:18px;padding:26px 30px;display:grid;\n    grid-template-columns:auto 1fr auto;gap:26px;align-items:center;\n    box-shadow:0 10px 30px rgba(22,24,58,.1)}\n  .ev .date .mo{font-family:'Fredoka',sans-serif;text-transform:uppercase;letter-spacing:.16em;\n    font-weight:500;font-size:.8rem;color:var(--tangerine)}\n  .ev .date .dy{font-family:'Fredoka',sans-serif;font-weight:700;font-size:3.2rem;line-height:.85}\n  .ev .date .tm{font-size:.78rem;font-style:italic;color:rgba(26,27,51,.65);margin-top:4px}\n  .ev .body .venue{font-size:.84rem;font-style:italic;color:rgba(26,27,51,.7)}\n  .ev .body .ti{font-family:'Fredoka',sans-serif;font-weight:600;font-size:1.35rem;line-height:1.12;margin-top:4px}\n  .ev .body .det{font-size:.84rem;font-style:italic;color:rgba(26,27,51,.7);margin-top:8px}\n  .ev .who2{display:flex;align-items:center;gap:14px;text-align:right;will-change:transform}\n  .ev .who2 .nm{font-weight:600;font-size:.9rem}\n  .ev .who2 .rl{font-size:.8rem;font-style:italic;color:rgba(26,27,51,.7)}\n  .portrait{width:56px;height:56px;border-radius:50%;overflow:hidden;flex:0 0 auto;background:var(--marigold)}\n  .portrait img{width:100%;height:100%;object-fit:cover;display:block}\n  .pstack{display:flex}\n  .pstack .portrait{margin-left:-16px;border:3px solid var(--paper)}\n  .pstack .portrait:first-child{margin-left:0}\n  .ev-foot{text-align:center;margin-top:30px}\n  .ev-foot a{color:var(--tangerine);font-weight:600;border-bottom:2px solid var(--tangerine);padding-bottom:2px}\n\n  /* FOOTER */\n  footer{color:var(--cream);position:relative;overflow:hidden;padding:84px 0 40px}\n  .fshape{position:absolute;will-change:transform;pointer-events:none}\n  .fs1{top:40px;left:60px;width:60px;height:60px;background:var(--marigold);opacity:.22;\n    clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}\n  .fs2{top:120px;right:120px;width:90px;height:90px;border-radius:50%;background:var(--tangerine);opacity:.14}\n  .fs3{bottom:140px;left:34%;width:44px;height:44px;background:var(--aqua);opacity:.24;\n    clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%)}\n  .news{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:start;position:relative;z-index:3}\n  .news .eyebrow{color:var(--marigold)}\n  .news h3{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2rem,4.4vw,3.2rem);\n    line-height:.98;margin-top:10px}\n  .news h3 .tang{color:var(--tangerine);font-style:italic;font-weight:500}\n  .news p{margin-top:18px;max-width:42ch;font-style:italic;font-size:.92rem;opacity:.72}\n  .subrow{margin-top:14px;display:flex;gap:12px;align-items:center;max-width:480px}\n  .subrow input{flex:1;background:transparent;border:none;border-bottom:2px solid rgba(246,239,224,.3);\n    color:var(--cream);font-family:'Fredoka',sans-serif;font-size:1.15rem;padding:10px 4px}\n  .subrow input::placeholder{color:rgba(246,239,224,.4)}\n  .subrow input:focus{border-bottom-color:var(--marigold);outline:none}\n  .join{margin-top:18px;display:flex;align-items:baseline;gap:16px}\n  .join .n{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.6rem,7vw,4.6rem);\n    color:var(--marigold);line-height:.8}\n  .join .t{font-style:italic;font-size:.9rem;opacity:.78;max-width:18ch}\n  .fdiv{height:2px;background:rgba(246,239,224,.18);margin:54px 0;position:relative;z-index:3}\n  .cols{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:28px;position:relative;z-index:3}\n  .cols .brandrow{margin-bottom:14px}\n  .cols .brandname{color:var(--cream)}\n  .cols .blurb{font-size:.78rem;font-style:italic;opacity:.6;max-width:30ch;line-height:1.6}\n  .cols h4{font-family:'Fredoka',sans-serif;text-transform:uppercase;letter-spacing:.18em;\n    font-weight:500;font-size:.7rem;color:var(--marigold);margin-bottom:14px}\n  .cols ul{list-style:none}\n  .cols li{margin-bottom:8px;opacity:.82;font-size:.9rem}\n  .cols li a:hover{color:var(--marigold)}\n  .social{display:flex;gap:14px}\n  .social a{width:34px;height:34px;border-radius:50%;background:rgba(246,239,224,.12);\n    display:flex;align-items:center;justify-content:center;transition:background .3s var(--ease)}\n  .social a:hover{background:var(--marigold)}\n  .social svg{width:18px;height:18px;fill:var(--cream)}\n  .finefoot{margin-top:48px;padding-top:24px;border-top:1px solid rgba(246,239,224,.15);\n    display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;\n    font-size:.82rem;font-style:italic;opacity:.7;position:relative;z-index:3}\n  .finefoot .legal{display:flex;gap:22px}\n\n  .reveal{opacity:0;transform:translateY(26px);transition:opacity .9s var(--ease),transform .9s var(--ease)}\n  .reveal.rise{opacity:1;transform:translateY(0)}\n\n  /* magical section headings — Cinzel Decorative across the page */\n  .cat-head h2,.p1 h2,.ev-head h2,.news h3,.panel-content .big{\n    font-family:'Cinzel Decorative','Cinzel',serif;font-weight:700;line-height:1.16;letter-spacing:.012em}\n  /* Cinzel Decorative has no italic — keep accent words upright (colour carries the emphasis) */\n  .p1 h2 .tang,.ev-head h2 .aqua,.news h3 .tang,.panel-content .big .it{font-style:normal}\n\n  /* RESPONSIVE */\n  @media(max-width:980px){\n    .news{grid-template-columns:1fr;gap:32px}\n    .cols{grid-template-columns:1fr 1fr 1fr}\n    .bookgrid{grid-template-columns:repeat(2,1fr)}\n    .brandtag{display:none}\n    .hero-h1{font-size:clamp(2.6rem,9vw,4rem)}\n    .hero-orbit{width:140vw}\n  }\n  @media(max-width:768px){\n    .navlinks,.signin{display:none}\n    .wrap{padding:0 20px}\n    .cat-intro,.ev-intro{text-align:left}\n    .cat-head,.ev-head{flex-direction:column;align-items:flex-start}\n    /* sticky stack -> normal stacked full-height sections */\n    .classroom-outer{height:auto}\n    .panel{position:relative;height:auto;min-height:88vh;padding:60px 0}\n    .panel-inner{filter:none;opacity:1}\n    .panel-content,.p1 h2{max-width:100%}\n    .ev .card2{grid-template-columns:1fr;gap:14px}\n    .ev .who2{justify-content:flex-start;text-align:left}\n    .thread{padding-left:54px}\n    .spine{left:18px}\n    .ev .marker{left:-50px}\n    .panel-inner{padding:0 20px}\n    .bookgrid{grid-template-columns:1fr}\n    .cols{grid-template-columns:1fr 1fr}\n  }\n  </style>\n\n\n<!-- NAV -->\n<header class=\"wrap\">\n  <nav class=\"bar\">\n    <div class=\"brandrow\">\n      <span class=\"logo-dot\"><i class=\"d1\"></i><i class=\"d2\"></i><i class=\"d3\"></i></span>\n      <span class=\"brandname disp\">Little Orrery</span>\n      <span class=\"brandtag\">est. 2014 · children's astronomy books</span>\n    </div>\n    <div class=\"navlinks\">\n      <a href=\"#catalog\">Catalog</a><a href=\"#classroom\">Classroom</a>\n      <a href=\"#authors\">Authors</a><a href=\"#events\">Events</a><a href=\"#journal\">Journal</a>\n    </div>\n    <div class=\"navright\">\n      <button class=\"signin\">Sign in</button>\n      <button class=\"btn-primary\">Browse Books</button>\n    </div>\n  </nav>\n</header>\n\n<!-- HERO — looping cosmos video -->\n<section class=\"hero\" id=\"hero\">\n  <div class=\"hero-sky\" aria-hidden=\"true\"></div>\n  <div class=\"hero-orbit\" aria-hidden=\"true\">\n    <span class=\"ring r1\"><span class=\"planet p1\"></span></span>\n    <span class=\"ring r2\"><span class=\"planet p2\"></span></span>\n    <span class=\"ring r3\"><span class=\"planet p3\"></span></span>\n  </div>\n  <video class=\"hero-video\" id=\"heroVideo\" autoplay=\"\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/hero.png\">\n    <source src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/hero.mp4\" type=\"video/mp4\">\n  </video>\n  <div class=\"hero-scrim\" aria-hidden=\"true\"></div>\n\n  <div class=\"hero-inner wrap\">\n    <div class=\"eyebrow hero-eyebrow\">Featured Volume · No. 24</div>\n    <h1 class=\"hero-h1 disp\" id=\"heroH1\" aria-label=\"A field guide to starlight.\">\n      <span class=\"ln\"><span>A field guide</span></span>\n      <span class=\"ln\"><span>to <span class=\"tang\">starlight.</span></span></span>\n    </h1>\n    <p class=\"hero-sub\">Watercolor picture books that carry young readers from the bedroom window to the edge of the observable universe.</p>\n    <div class=\"hero-ctas\">\n      <button class=\"btn-primary\">Explore the Universe&nbsp;→</button>\n      <button class=\"btn-text\"><span class=\"star\"></span> Watch the trailer</button>\n    </div>\n  </div>\n\n  <div class=\"hero-proof wrap\">\n    <span>★ <b>4.9</b> · 2,400 reviews</span><i></i>\n    <span><b>Caldecott</b> Honor 2024</span><i></i>\n    <span><b>142</b> titles · 18 languages</span><i></i>\n    <span><b>3.2M</b> young stargazers</span>\n  </div>\n\n  <a class=\"hero-scroll\" href=\"#catalog\" aria-label=\"Scroll to the catalog\">↓</a>\n</section>\n\n<!-- CATALOG -->\n<section class=\"catalog night-tex\" id=\"catalog\">\n  <div class=\"wrap\">\n    <div class=\"cat-head\" id=\"catHead\">\n      <div>\n        <div class=\"eyebrow\">The Catalog</div>\n        <h2><span style=\"display:block\">Discover</span><span class=\"clip\"><i class=\"tang\">new worlds.</i></span></h2>\n      </div>\n      <p class=\"cat-intro\">Filter by age, topic, or constellation. Wander through the full library — 142 painted volumes and counting.</p>\n    </div>\n\n    <div class=\"pills\">\n      <button class=\"pill active\">All books</button>\n      <button class=\"pill\">Ages 3–5</button>\n      <button class=\"pill\">Ages 6–8</button>\n      <button class=\"pill\">Ages 9–12</button>\n      <span class=\"pill-sep\"></span>\n      <button class=\"pill\">Constellations</button>\n      <button class=\"pill\">Space Exploration</button>\n      <button class=\"pill\">Planets &amp; Moons</button>\n      <button class=\"pill\">Mythology</button>\n    </div>\n\n    <div class=\"grid-scene\">\n      <div class=\"bookgrid\" id=\"bookgrid\">\n        <article class=\"book\">\n          <div class=\"cover\" style=\"background:var(--aqua)\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/drawing-night-sky.png\" alt=\"Drawing the Night Sky cover\" loading=\"lazy\" onerror=\"this.style.display='none'\">\n            <div class=\"peek\">page 14 · \"the milky way\"</div>\n          </div>\n          <div class=\"meta\">\n            <div class=\"title\">Drawing the Night Sky</div>\n            <div class=\"by\">by Halima Okafor · ages 6–8 · 48 pp.</div>\n            <div class=\"row\"><span class=\"tag\" style=\"background:rgba(31,182,196,.22);color:var(--aqua)\">Constellations</span><span class=\"price\">$18</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\">\n          <div class=\"cover\" style=\"background:var(--tangerine)\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/if-i-lived-on-mars.png\" alt=\"If I Lived on Mars cover\" loading=\"lazy\" onerror=\"this.style.display='none'\">\n            <div class=\"peek\">page 22 · \"the dunes of mars\"</div>\n          </div>\n          <div class=\"meta\">\n            <div class=\"title\">If I Lived on Mars</div>\n            <div class=\"by\">by Theo Lindqvist · ages 4–7 · 36 pp.</div>\n            <div class=\"row\"><span class=\"tag\" style=\"background:rgba(255,106,43,.22);color:var(--tangerine)\">Planets</span><span class=\"price\">$16</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\">\n          <div class=\"cover\" style=\"background:var(--marigold)\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/nine-bright-neighbours.png\" alt=\"Nine Bright Neighbours cover\" loading=\"lazy\" onerror=\"this.style.display='none'\">\n            <div class=\"peek\">page 8 · \"the solar family\"</div>\n          </div>\n          <div class=\"meta\">\n            <div class=\"title\">Nine Bright Neighbours</div>\n            <div class=\"by\">by Priya Raghavan · ages 5–8 · 52 pp.</div>\n            <div class=\"row\"><span class=\"tag\" style=\"background:rgba(244,185,46,.22);color:var(--marigold)\">Planets</span><span class=\"price\">$18</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\">\n          <div class=\"cover\" style=\"background:var(--aqua)\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/moonbook.png\" alt=\"Moonbook cover\" loading=\"lazy\" onerror=\"this.style.display='none'\">\n            <div class=\"peek\">page 31 · \"the dark side\"</div>\n          </div>\n          <div class=\"meta\">\n            <div class=\"title\">Moonbook</div>\n            <div class=\"by\">by Wren Hollister · ages 3–5 · 24 pp.</div>\n            <div class=\"row\"><span class=\"tag\" style=\"background:rgba(31,182,196,.22);color:var(--aqua)\">Our Moon</span><span class=\"price\">$14</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\">\n          <div class=\"cover\" style=\"background:var(--tangerine)\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/the-long-voyage.png\" alt=\"The Long Voyage cover\" loading=\"lazy\" onerror=\"this.style.display='none'\">\n            <div class=\"peek\">page 5 · \"first stars\"</div>\n          </div>\n          <div class=\"meta\">\n            <div class=\"title\">The Long Voyage</div>\n            <div class=\"by\">by Sam Beauregard · ages 9–12 · 96 pp.</div>\n            <div class=\"row\"><span class=\"tag\" style=\"background:rgba(255,106,43,.22);color:var(--tangerine)\">Exploration</span><span class=\"price\">$22</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\">\n          <a class=\"seeall\" href=\"#catalog\">\n            <div class=\"disp\">See all 142<br><span style=\"font-style:italic\">titles&nbsp;→</span></div>\n          </a>\n        </article>\n      </div>\n    </div>\n    <div class=\"cat-foot\"><span class=\"star\"></span> tilt your cursor across the shelf — hover any cover to peek inside</div>\n  </div>\n</section>\n\n<!-- CLASSROOM sticky-stacked-panels -->\n<section id=\"classroom\">\n<div class=\"classroom-outer\" id=\"classroomOuter\">\n\n  <div class=\"panel p1\" data-panel=\"0\">\n    <div class=\"panel-inner\">\n      <div class=\"eyebrow\">For Schools &amp; Libraries</div>\n      <h2>Bring the <span class=\"tang\">cosmos</span> to the classroom.</h2>\n      <p class=\"lead\">Curated bundles of our painted volumes, paired with teacher guides, classroom posters, and a year of monthly star-maps. Built with educators across 1,200 schools.</p>\n      <ul class=\"checks\">\n        <li><span class=\"ck\">✓</span><span>Aligned to Common Core &amp; NGSS K–5 science standards</span></li>\n        <li><span class=\"ck\">✓</span><span>Includes 30-book bundle, 12 lesson plans, wall-sized orrery print</span></li>\n        <li><span class=\"ck\">✓</span><span>Title I schools receive 35% off &amp; free shipping</span></li>\n      </ul>\n      <div class=\"ctas\">\n        <button class=\"btn-primary\">Request a Classroom Quote</button>\n        <button class=\"btn-text\" style=\"color:var(--ink)\"><span class=\"star\"></span> Download sample lesson (PDF)</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"panel p2 dark\" data-panel=\"1\">\n    <div class=\"bgphoto\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/classroom/panel-classroom.png\" alt=\"Children reading painted astronomy books in a classroom\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n    <div class=\"panel-inner\">\n      <div class=\"panel-content\">\n        <div class=\"bignum\">30</div>\n        <div class=\"lab\">books per bundle, spanning ages 4 to 12</div>\n        <div class=\"big\">Teacher Guides <span class=\"it\">included</span></div>\n        <div class=\"sub\">12 lessons + printables packed beside every wall-sized orrery print.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"panel p3 dark\" data-panel=\"2\">\n    <div class=\"bgphoto\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/classroom/panel-bundle.png\" alt=\"A bundle of painted picture books with an orrery print\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n    <div class=\"panel-inner\">\n      <div class=\"panel-content\">\n        <div class=\"bignum\">1,247</div>\n        <div class=\"lab\">schools currently using Little Orrery sets</div>\n        <div class=\"quoteline\">\"The kids ask to read these every single afternoon.\"\n          <span class=\"who\">Maple Grove Elementary, Vermont</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"panel p4 dark\" data-panel=\"3\">\n    <div class=\"bgphoto\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/classroom/panel-ship.png\" alt=\"A wrapped parcel of books ready to ship\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n    <div class=\"panel-inner\">\n      <div class=\"panel-content\">\n        <div class=\"big\">Ships within <span class=\"it\">5 days</span></div>\n        <div class=\"sub\">Free over $250 — to every school and library in the country.</div>\n        <div class=\"ctas\">\n          <button class=\"btn-primary\">Request a Classroom Quote</button>\n          <button class=\"btn-text\"><span class=\"star\"></span> Download sample lesson (PDF)</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>\n</section>\n\n<!-- EVENTS timeline -->\n<section class=\"events wrap\" id=\"events\">\n  <div class=\"ev-head\" id=\"evHead\">\n    <div>\n      <div class=\"eyebrow\">Visiting Authors · Autumn 2025</div>\n      <h2>Readings &amp; <span class=\"aqua\">stargazings.</span></h2>\n    </div>\n    <p class=\"ev-intro\">Free, family-friendly evenings at bookshops, planetariums, and libraries across the country. Bring a blanket — most readings end outside, under the stars.</p>\n  </div>\n\n  <div class=\"thread\" id=\"thread\">\n    <div class=\"spine\" id=\"spine\"></div>\n\n    <div class=\"ev\" id=\"authors\">\n      <div class=\"marker\"><span class=\"star\" style=\"width:30px;height:30px\"></span></div>\n      <div class=\"card2\">\n        <div class=\"date\"><div class=\"mo\">Oct</div><div class=\"dy disp\" style=\"color:var(--tangerine)\">14</div><div class=\"tm\">Tuesday, 6:30pm</div></div>\n        <div class=\"body\">\n          <div class=\"venue\">Brookline Booksmith · Boston, MA</div>\n          <div class=\"ti\">\"Drawing the Night Sky\" — a reading &amp; constellation workshop</div>\n          <div class=\"det\">with Halima Okafor · ages 6+ welcome · free, RSVP required</div>\n        </div>\n        <div class=\"who2\">\n          <div><div class=\"nm\">Halima Okafor</div><div class=\"rl\">author &amp; illustrator</div></div>\n          <div class=\"portrait\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/halima.png\" alt=\"Portrait of Halima Okafor\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev\">\n      <div class=\"marker\"><span class=\"star\" style=\"width:30px;height:30px;background:var(--aqua)\"></span></div>\n      <div class=\"card2\">\n        <div class=\"date\"><div class=\"mo\">Oct</div><div class=\"dy disp\" style=\"color:var(--aqua)\">22</div><div class=\"tm\">Wednesday, 7:00pm</div></div>\n        <div class=\"body\">\n          <div class=\"venue\">Adler Planetarium · Chicago, IL</div>\n          <div class=\"ti\">A dome-reading of \"If I Lived on Mars,\" under the stars</div>\n          <div class=\"det\">with Theo Lindqvist · ages 4–9 · $8 family ticket</div>\n        </div>\n        <div class=\"who2\">\n          <div><div class=\"nm\">Theo Lindqvist</div><div class=\"rl\">author</div></div>\n          <div class=\"portrait\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/theo.png\" alt=\"Portrait of Theo Lindqvist\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev\">\n      <div class=\"marker\"><span class=\"star\" style=\"width:30px;height:30px;background:var(--tangerine)\"></span></div>\n      <div class=\"card2\">\n        <div class=\"date\"><div class=\"mo\">Nov</div><div class=\"dy disp\" style=\"color:var(--tangerine)\">05</div><div class=\"tm\">Saturday, 11:00am</div></div>\n        <div class=\"body\">\n          <div class=\"venue\">Powell's City of Books · Portland, OR</div>\n          <div class=\"ti\">Launch of \"The Pocket Almanac of Meteor Showers\"</div>\n          <div class=\"det\">with Elena Marín &amp; Wren Hollister · all ages · free</div>\n        </div>\n        <div class=\"who2\">\n          <div class=\"pstack\">\n            <div class=\"portrait\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/elena.png\" alt=\"Portrait of Elena Marín\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n            <div class=\"portrait\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/wren.png\" alt=\"Portrait of Wren Hollister\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n          </div>\n          <div><div class=\"nm\">Marín &amp; Hollister</div><div class=\"rl\">duo reading</div></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev\">\n      <div class=\"marker\"><span class=\"star\" style=\"width:30px;height:30px;background:var(--marigold)\"></span></div>\n      <div class=\"card2\">\n        <div class=\"date\"><div class=\"mo\">Nov</div><div class=\"dy disp\" style=\"color:var(--aqua)\">19</div><div class=\"tm\">Saturday, 4:30pm</div></div>\n        <div class=\"body\">\n          <div class=\"venue\">Brooklyn Public Library · Brooklyn, NY</div>\n          <div class=\"ti\">\"Nine Bright Neighbours\" sing-along &amp; watercolor demo</div>\n          <div class=\"det\">with Priya Raghavan · ages 3–7 · free, drop-in</div>\n        </div>\n        <div class=\"who2\">\n          <div><div class=\"nm\">Priya Raghavan</div><div class=\"rl\">illustrator</div></div>\n          <div class=\"portrait\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/priya.png\" alt=\"Portrait of Priya Raghavan\" loading=\"lazy\" onerror=\"this.style.display='none'\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev-foot\"><a href=\"#events\">See the full tour calendar (24 dates)</a></div>\n  </div>\n</section>\n\n<!-- FOOTER -->\n<footer class=\"night-tex\" id=\"journal\">\n  <span class=\"fshape fs1\" data-depth=\"-30\"></span>\n  <span class=\"fshape fs2\" data-depth=\"-60\"></span>\n  <span class=\"fshape fs3\" data-depth=\"-45\"></span>\n  <div class=\"wrap\">\n    <div class=\"news reveal\" id=\"newsBlock\">\n      <div>\n        <div class=\"eyebrow\">The Stargazer Newsletter</div>\n        <h3>Once a month, a <span class=\"tang\">small parcel of sky</span> in your inbox.</h3>\n        <p>Activity printables, behind-the-easel sketches from our illustrators, new releases, and the next meteor shower's exact peak time. No spam — we promise on Polaris.</p>\n      </div>\n      <div>\n        <form class=\"subrow\" onsubmit=\"return false\">\n          <input type=\"email\" placeholder=\"you@stargazer.com\" aria-label=\"Your email address\">\n          <button class=\"btn-primary\" type=\"submit\">Subscribe ✦</button>\n        </form>\n        <div class=\"join\">\n          <span class=\"n disp\" id=\"joinNum\" data-target=\"84000\">0</span>\n          <span class=\"t\">parents, teachers, and small astronomers have joined.</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"fdiv\"></div>\n\n    <div class=\"cols reveal\" id=\"footCols\">\n      <div>\n        <div class=\"brandrow\">\n          <span class=\"logo-dot\"><i class=\"d1\"></i><i class=\"d2\"></i><i class=\"d3\"></i></span>\n          <span class=\"brandname disp\">Little Orrery</span>\n        </div>\n        <p class=\"blurb\">An independent children's astronomy book publisher, painting the cosmos one page at a time since 2014. Based in Asheville, NC.</p>\n      </div>\n      <div><h4>Shop</h4><ul><li><a href=\"#catalog\">Picture books</a></li><li><a href=\"#catalog\">Activity kits</a></li><li><a href=\"#catalog\">Prints &amp; posters</a></li><li><a href=\"#catalog\">Gift cards</a></li></ul></div>\n      <div><h4>For</h4><ul><li><a href=\"#classroom\">Schools</a></li><li><a href=\"#classroom\">Libraries</a></li><li><a href=\"#classroom\">Booksellers</a></li><li><a href=\"#authors\">Authors</a></li></ul></div>\n      <div><h4>House</h4><ul><li><a href=\"#journal\">Our story</a></li><li><a href=\"#authors\">Illustrators</a></li><li><a href=\"#journal\">Press</a></li><li><a href=\"#journal\">Contact</a></li></ul></div>\n      <div><h4>Follow</h4>\n        <div class=\"social\">\n          <a href=\"#\" aria-label=\"Instagram\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.95.24 2.4.4.6.24 1.04.52 1.5.98.46.46.74.9.98 1.5.16.45.35 1.23.4 2.4.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.17-.24 1.95-.4 2.4a4 4 0 0 1-.98 1.5 4 4 0 0 1-1.5.98c-.45.16-1.23.35-2.4.4-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.17-.05-1.95-.24-2.4-.4a4 4 0 0 1-1.5-.98 4 4 0 0 1-.98-1.5c-.16-.45-.35-1.23-.4-2.4C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.17.24-1.95.4-2.4.24-.6.52-1.04.98-1.5.46-.46.9-.74 1.5-.98.45-.16 1.23-.35 2.4-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.5 0-4.74.07-.9.04-1.38.19-1.7.31-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.32-.27.8-.31 1.7C3.43 8.5 3.43 8.86 3.43 12s0 3.5.07 4.74c.04.9.19 1.38.31 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.12.8.27 1.7.31 1.24.07 1.6.07 4.74.07s3.5 0 4.74-.07c.9-.04 1.38-.19 1.7-.31.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.32.27-.8.31-1.7.07-1.24.07-1.6.07-4.74s0-3.5-.07-4.74c-.04-.9-.19-1.38-.31-1.7a2.9 2.9 0 0 0-.69-1.06 2.9 2.9 0 0 0-1.06-.69c-.32-.12-.8-.27-1.7-.31C15.5 4 15.14 4 12 4zm0 3.06A4.94 4.94 0 1 1 12 16.94 4.94 4.94 0 0 1 12 7.06zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28zm5.14-.96a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3z\"></path></svg></a>\n          <a href=\"#\" aria-label=\"YouTube\"><svg viewBox=\"0 0 24 24\"><path d=\"M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.5 31 31 0 0 0-.5-4.5zM9.75 15.5v-7l6 3.5-6 3.5z\"></path></svg></a>\n          <a href=\"#\" aria-label=\"Pinterest\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2a10 10 0 0 0-3.6 19.3c-.08-.8-.16-2.06.03-2.94l1.2-5.1s-.3-.6-.3-1.5c0-1.42.82-2.48 1.85-2.48.87 0 1.3.65 1.3 1.44 0 .88-.56 2.2-.85 3.42-.24 1.02.5 1.85 1.5 1.85 1.82 0 3.2-1.92 3.2-4.68 0-2.45-1.76-4.16-4.27-4.16a4.43 4.43 0 0 0-4.62 4.44c0 .88.34 1.82.76 2.33a.3.3 0 0 1 .07.3l-.28 1.14c-.04.18-.15.22-.34.13-1.25-.58-2.03-2.4-2.03-3.86 0-3.14 2.28-6.02 6.58-6.02 3.46 0 6.14 2.46 6.14 5.76 0 3.43-2.16 6.2-5.17 6.2-1 0-1.96-.52-2.28-1.14l-.62 2.36c-.22.86-.82 1.94-1.23 2.6A10 10 0 1 0 12 2z\"></path></svg></a>\n          <a href=\"#\" aria-label=\"RSS\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11zm0 4a5 5 0 0 1 5 5h2.5A7.5 7.5 0 0 0 4 12.5V15zm1.75 5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5z\"></path></svg></a>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"finefoot\">\n      <div>© 2025 Little Orrery Press · all illustrations hand-painted, never gradient-rendered</div>\n      <div class=\"legal\"><a href=\"#\">Privacy</a><a href=\"#\">Terms</a><a href=\"#\">Accessibility</a></div>\n    </div>\n  </div>\n</footer>\n\n<script>\n(function(){\n  const reduce = false;\n  var isTouch = window.matchMedia('(hover: none)').matches || ('ontouchstart' in window);\n\n  /* ---- Hero entrance reveal ---- */\n  var hero = document.getElementById('hero');\n  var heroVideo = document.getElementById('heroVideo');\n  function revealHero(){ if(hero) hero.classList.add('is-in'); }\n  requestAnimationFrame(function(){ requestAnimationFrame(revealHero); });\n  window.addEventListener('load', revealHero);\n\n  /* ---- Fade the cosmos video in over the CSS fallback once it can play ---- */\n  if(heroVideo){\n    var showVideo = function(){ heroVideo.classList.add('ready'); };\n    if(heroVideo.readyState >= 3) showVideo();\n    heroVideo.addEventListener('canplay', showVideo, {once:true});\n    heroVideo.addEventListener('loadeddata', showVideo, {once:true});\n    // if the asset is missing, leave the animated fallback in place\n    heroVideo.addEventListener('error', function(){ heroVideo.classList.remove('ready'); });\n    var src = heroVideo.querySelector('source');\n    if(src) src.addEventListener('error', function(){ heroVideo.classList.remove('ready'); });\n    var play = heroVideo.play && heroVideo.play();\n    if(play && play.catch) play.catch(function(){});\n  }\n\n  /* ---- Catalog grid 3D tilt toward cursor ---- */\n  var bookgrid = document.getElementById('bookgrid');\n  var books = bookgrid ? bookgrid.querySelectorAll('.book') : [];\n  if(bookgrid && !isTouch && !reduce){\n    var gmx=0,gmy=0;\n    bookgrid.addEventListener('mousemove', function(e){\n      var r = bookgrid.getBoundingClientRect();\n      gmx = ((e.clientX - r.left)/r.width - .5);\n      gmy = ((e.clientY - r.top)/r.height - .5);\n      books.forEach(function(b){ b.style.setProperty('--mx', gmx); b.style.setProperty('--my', gmy); });\n    });\n    bookgrid.addEventListener('mouseleave', function(){\n      books.forEach(function(b){ b.style.setProperty('--mx', 0); b.style.setProperty('--my', 0); });\n    });\n  }\n\n  /* ---- Filter pills ---- */\n  document.querySelectorAll('.pill').forEach(function(p){\n    p.addEventListener('click', function(){\n      document.querySelectorAll('.pill').forEach(function(x){ x.classList.remove('active'); });\n      p.classList.add('active');\n    });\n  });\n\n  /* ---- Count-up ---- */\n  var joinNum = document.getElementById('joinNum');\n  function countUp(el){\n    var target = +el.getAttribute('data-target'), start=null, dur=1600;\n    function step(ts){\n      if(!start) start=ts;\n      var p = Math.min(1,(ts-start)/dur);\n      var v = Math.floor((1-Math.pow(1-p,3))*target);\n      el.textContent = v.toLocaleString('en-US');\n      if(p<1) requestAnimationFrame(step);\n    }\n    requestAnimationFrame(step);\n  }\n\n  /* ---- IntersectionObserver entrances ---- */\n  var io = new IntersectionObserver(function(entries){\n    entries.forEach(function(en){\n      if(!en.isIntersecting) return;\n      var t = en.target;\n      if(t.id==='catHead'||t.id==='evHead') t.classList.add('is-in');\n      else if(t.classList.contains('book')) t.classList.add('rise');\n      else if(t.classList.contains('ev')) t.classList.add('rise');\n      else if(t.id==='joinNum'){ if(!reduce) countUp(t); else t.textContent='84,000'; }\n      else t.classList.add('rise');\n      io.unobserve(t);\n    });\n  }, {threshold:0.12, rootMargin:'0px 0px -8% 0px'});\n  ['catHead','evHead','newsBlock','footCols','joinNum'].forEach(function(id){ var e=document.getElementById(id); if(e) io.observe(e); });\n  books.forEach(function(b,i){ b.style.transitionDelay=(i*0.08)+'s'; io.observe(b); });\n  document.querySelectorAll('.ev').forEach(function(e,i){ e.style.transitionDelay=(i*0.1)+'s'; io.observe(e); });\n  if(reduce && joinNum) joinNum.textContent='84,000';\n\n  /* ---- Classroom sticky-stack scale + lock ---- */\n  var outer = document.getElementById('classroomOuter');\n  var panels = outer ? Array.prototype.slice.call(outer.querySelectorAll('.panel')) : [];\n  var mobileStack = window.matchMedia('(max-width:768px)').matches;\n  if(mobileStack){\n    panels.forEach(function(p){ p.classList.add('locked'); });\n  }\n\n  /* ---- One rAF scroll loop ---- */\n  var sy = window.scrollY, ticking=false;\n  var spine = document.getElementById('spine');\n  var thread = document.getElementById('thread');\n  var fshapes = document.querySelectorAll('.fshape');\n  var footer = document.querySelector('footer');\n  var catalog = document.getElementById('catalog');\n  var heroInner = document.querySelector('.hero-inner');\n\n  function update(){\n    var vh = window.innerHeight;\n\n    // hero scroll choreography — the cosmos video slow-zooms as the title\n    // parts and fades, handing focus to the catalog below\n    var hp = Math.min(1, Math.max(0, sy/(vh*0.9))); // 0..1 across the first screen\n    if(!reduce){\n      if(heroVideo) heroVideo.style.transform = 'translateY('+(hp*-40)+'px) scale('+(1 + hp*0.12)+')';\n      if(heroInner){ heroInner.style.transform = 'translateY('+(hp*-46)+'px)'; heroInner.style.opacity = (1 - hp*1.05); }\n    }\n\n    // catalog z-separation on scroll\n    if(catalog && !reduce && !mobileStack){\n      var cr = catalog.getBoundingClientRect();\n      var cp = Math.min(1, Math.max(0, 1 - (cr.top / vh)));\n      books.forEach(function(b,i){ b.style.setProperty('--zsep', (cp*(i%3)*22)+'px'); });\n    }\n\n    // classroom sticky-stack\n    if(outer && !mobileStack){\n      var orect = outer.getBoundingClientRect();\n      var total = outer.offsetHeight - vh;\n      var p = Math.min(1, Math.max(0, (-orect.top)/total)); // 0..1 over whole section\n      var seg = 1/panels.length;\n      panels.forEach(function(panel,i){\n        // each panel \"active\" window\n        var pStart = i*seg;\n        var local = (p - pStart)/seg; // progress while this panel is on top\n        if(local > 0.05 && local < 1.05){\n          panel.classList.add('locked');\n        }\n        // scale previous panels down as next covers them\n        if(i < panels.length-1){\n          var nextProg = Math.min(1, Math.max(0, (p - (i+1)*seg + seg)/seg));\n          var sc = 1 - nextProg*0.04;\n          panel.style.transform = 'scale('+sc+')';\n        }\n      });\n      // ensure first panel locks immediately when in view\n      if(p < 0.05) panels[0].classList.add('locked');\n    }\n\n    // events spine draw\n    if(thread && spine && !reduce){\n      var tr = thread.getBoundingClientRect();\n      var tp = Math.min(1, Math.max(0, (vh*0.85 - tr.top)/(tr.height*0.85)));\n      spine.style.transform = 'scaleY('+tp+')';\n      // portrait parallax\n      document.querySelectorAll('.who2').forEach(function(w){\n        var wr = w.getBoundingClientRect();\n        var off = (wr.top - vh/2)*-0.04;\n        w.style.transform = 'translateY('+off+'px)';\n      });\n    }\n\n    // footer shape parallax\n    if(footer && !reduce){\n      var fr = footer.getBoundingClientRect();\n      fshapes.forEach(function(s){\n        var d = +s.getAttribute('data-depth')||0;\n        s.style.transform = 'translateY('+((vh-fr.top)/vh*d)+'px)';\n      });\n    }\n\n    ticking=false;\n  }\n  function onScroll(){ sy = window.scrollY; if(!ticking){ requestAnimationFrame(update); ticking=true; } }\n  window.addEventListener('scroll', onScroll, {passive:true});\n  window.addEventListener('resize', function(){ mobileStack = window.matchMedia('(max-width:768px)').matches; onScroll(); }, {passive:true});\n  update();\n})();\n</script>\n\n\n",
      "overrides": {
        "htmlAttrs": "lang=\"en\"",
        "bodyAttrs": "class=\"paper-tex\"",
        "head": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Little Orrery — children's astronomy books</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">"
      },
