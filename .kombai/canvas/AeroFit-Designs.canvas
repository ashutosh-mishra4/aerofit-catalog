    "node_e8d2a236ebfb": {
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.outline-text{color:transparent;-webkit-text-stroke:var(--sw,2px) var(--sc,#2A0B14);}\n.text-reveal{overflow:hidden;}\n.marquee-track{animation:marquee 32s linear infinite;}\n.ticker-track{animation:marquee 26s linear infinite;}\n@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.scroll-line{transform-origin:top center;animation:scrollDrop 1.6s ease-in-out infinite;}\n@keyframes scrollDrop{0%{transform:scaleY(0);opacity:0;transform-origin:top center}40%{transform:scaleY(1);opacity:1;transform-origin:top center}60%{transform:scaleY(1);opacity:1;transform-origin:bottom center}100%{transform:scaleY(0);opacity:0;transform-origin:bottom center}}\n.hero-dot{transition:opacity .3s ease,transform .3s ease;}\n.hero-dot.active{opacity:1;transform:scale(1.6);}\n.strip{transition:transform .55s cubic-bezier(.22,.61,.36,1);}\n.strip:hover{transform:translateX(2.5vw);}\n.strip .strip-img{transition:transform .7s cubic-bezier(.22,.61,.36,1);}\n.strip:hover .strip-img{transform:scale(1.06) rotate(-2deg);}\n.bar-fill{transform:scaleY(.08);transform-origin:bottom;transition:transform .6s cubic-bezier(.22,.8,.36,1);}\n.stage-active .bar-fill{transform:scaleY(var(--h));}\n.stage-active .bar-fill:nth-child(1){transition-delay:.1s}\n.gauge-fg{stroke-dasharray:264;stroke-dashoffset:264;transition:stroke-dashoffset 1.2s cubic-bezier(.22,.8,.36,1);}\n.stage-active .gauge-fg{stroke-dashoffset:115;}\n.prog-dot{opacity:.4;transition:opacity .35s ease,transform .35s ease;}\n.prog-dot.active{opacity:1;transform:translateX(-6px);}\n.prog-dot::after{content:\"\";display:inline-block;vertical-align:middle;margin-left:.6rem;width:1.5rem;height:1.5px;background:currentColor;transform:scaleX(.3);transform-origin:right center;transition:transform .35s ease;}\n.prog-dot.active::after{transform:scaleX(1);}\n.sticker{animation:wobble 4s ease-in-out infinite;}\n@keyframes wobble{0%,100%{transform:translate(-50%,-50%) rotate(-6deg)}50%{transform:translate(-50%,-50%) rotate(-3deg)}}\n.spin-slow{animation:spin 30s linear infinite;}\n@keyframes spin{to{transform:rotate(360deg)}}\n.perforation{background-image:repeating-linear-gradient(to right,#2A0B14 0 14px,transparent 14px 24px);}\n\n.starshape{clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);}\n.sparkle{clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%);}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip pb-4\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- ═════════ HERO — colour-block slides ═════════ -->\n<section class=\"relative mx-4 mt-4 h-[860px] rounded-[28px] overflow-hidden bg-[#F8F38A]\" data-kid=\"1-1\" data-name=\"hero use-case slideshow\" id=\"hero\">\n<!-- floating pill nav -->\n<div class=\"absolute z-[60] top-5 left-5 right-5 h-[68px] rounded-full bg-white/92 backdrop-blur-md shadow-[0_8px_28px_rgba(42,11,20,0.10)] border border-white/60 pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"floating product navigation bar\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-1-1-1\" data-name=\"brand and nav links group\">\n<span class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-1-1-1-1\" data-name=\"site logo with wordmark\">\n<img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1-1\" data-name=\"Aero Fit logo mark icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>Aero Fit\n        </span>\n<div class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-1-2\" data-name=\"primary navigation pills\">\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-1-2-1\" data-name=\"Overview navigation pill\" href=\"#\">Overview</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-1-2-2\" data-name=\"How it works navigation pill\" href=\"#\">How it works</a>\n<a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-1-2-3\" data-name=\"Shop bands navigation pill (active)\" href=\"#\">Shop bands</a>\n</div>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"header actions group\">\n<button class=\"h-[52px] pl-5 pr-2 rounded-full border border-[#EFEAE6] bg-white text-[14px] font-medium flex items-center gap-2 hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-1-2-1\" data-name=\"cart button with badge\">\n<span class=\"text-[18px] flex\" data-kid=\"1-1-1-2-1-1\" data-name=\"shopping bag icon wrapper\"><i class=\"ti ti-shopping-bag\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"shopping bag icon\"></i></span>Cart\n          <span class=\"min-w-9 h-9 px-2 rounded-full bg-[#F3EFEC] text-[13px] flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-2\" data-name=\"cart item count badge\" data-reason=\"count text and background replaced by script on add-to-cart\" id=\"cartCount\">0</span>\n</button>\n<button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-1-2-2\" data-name=\"join free call-to-action button\">Join Aero Fit free</button>\n</div>\n</div>\n<!-- progress dots -->\n<div class=\"absolute z-[55] right-8 top-1/2 -translate-y-1/2 flex flex-col gap-4 text-[#2A0B14]\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"hero slide progress dots\" data-reason=\"dot color recolored by slide script\" id=\"heroDots\" style=\"color: rgb(250, 248, 246);\">\n<button aria-label=\"Slide 1\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-i=\"0\" data-kid=\"1-1-2-1\" data-name=\"slide 1 dot\"></button>\n<button aria-label=\"Slide 2\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-i=\"1\" data-kid=\"1-1-2-2\" data-name=\"slide 2 dot\"></button>\n<button aria-label=\"Slide 3\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-i=\"2\" data-kid=\"1-1-2-3\" data-name=\"slide 3 dot\"></button>\n<button aria-label=\"Slide 4\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30 active\" data-i=\"3\" data-kid=\"1-1-2-4\" data-name=\"slide 4 dot\"></button>\n<button aria-label=\"Slide 5\" class=\"hero-dot w-1.5 h-1.5 rounded-full bg-current opacity-30\" data-i=\"4\" data-kid=\"1-1-2-5\" data-name=\"slide 5 dot\"></button>\n</div>\n<!-- 01 Endurance -->\n<div class=\"hero-slide absolute inset-0 z-[1] bg-[#F8F38A] text-[#2A0B14]\" data-kid=\"1-1-3\" data-name=\"endurance slide\" style=\"translate: none; rotate: none; scale: none; transform: translate(0px, 0px); z-index: 1;\">\n<div class=\"slide-image absolute inset-0\" data-kid=\"1-1-3-1\" data-name=\"slide image wrapper\" style=\"translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 0px);\">\n<img alt=\"Trail runner checking his Aero Fit Ultra\" class=\"w-full h-full object-cover object-[70%_center]\" data-kid=\"1-1-3-1-1\" data-name=\"endurance portrait photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/e8e9b52b3aa4462b8d6ad53cd59b2ef3.jpg\"/>\n<div class=\"absolute inset-0 bg-[linear-gradient(90deg,#F8F38A_0%,rgba(248,243,138,0.85)_30%,rgba(248,243,138,0)_56%)]\" data-kid=\"1-1-3-1-2\" data-name=\"slide colour fade overlay\"></div>\n</div>\n<div class=\"slide-text absolute left-0 top-0 bottom-0 w-[52%] flex flex-col justify-center pl-[72px] pt-20\" data-kid=\"1-1-3-2\" data-name=\"slide copy column\">\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-1\"><span class=\"slide-eyebrow block pb-5 text-[12px] font-semibold tracking-[0.32em] uppercase opacity-60\" data-kid=\"1-1-3-2-1-1\" data-name=\"slide eyebrow\">Shop for endurance — 2026</span></div>\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-2\"><h1 class=\"slide-brand serif text-[164px] leading-[0.86] font-medium tracking-[-0.045em] pb-6\" data-kid=\"1-1-3-2-2-1\" data-name=\"giant brand headline\">Aero Fit</h1></div>\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-3\"><p class=\"slide-tagline serif italic text-[36px] leading-[1.1] pb-3\" data-kid=\"1-1-3-2-3-1\" data-name=\"slide tagline\">Built for the long way round.</p></div>\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-4\"><p class=\"slide-sub text-[16px] leading-[1.55] opacity-80 max-w-[430px] pb-9\" data-kid=\"1-1-3-2-4-1\" data-name=\"slide supporting text\">14 days on a charge with dual-band GPS. Ultra and Pro suit this best.</p></div>\n<div class=\"text-reveal\" data-kid=\"1-1-3-2-5\"><div class=\"slide-ctas flex items-center gap-6 pb-1\" data-kid=\"1-1-3-2-5-1\" data-name=\"slide call-to-action row\">\n<a class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[14px] font-medium flex items-center gap-2\" data-kid=\"1-1-3-2-5-1-1\" data-name=\"view Ultra primary button\" href=\"#lineup\">View Ultra <i class=\"ti ti-arrow-right\" data-kid=\"1-1-3-2-5-1-1-1\"></i></a>\n<a class=\"text-[14px] font-medium underline underline-offset-4\" data-kid=\"1-1-3-2-5-1-2\" data-name=\"see all bands link\" href=\"#lineup\">See all five bands</a>\n</div></div>\n</div>\n<div class=\"slide-card absolute right-6 bottom-6 w-[370px] bg-white/92 backdrop-blur-md rounded-[22px] p-3 pr-5 shadow-[0_14px_40px_rgba(42,11,20,0.16)] flex items-center gap-4 text-[#2A0B14]\" data-kid=\"1-1-3-3\" data-name=\"floating product card\" style=\"translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 0px);\">\n<div class=\"w-[96px] h-[96px] rounded-[16px] bg-[radial-gradient(circle,#F8F38A_0%,#FBF4B8_45%,#F4F1EE_80%)] flex items-center justify-center shrink-0\" data-kid=\"1-1-3-3-1\" data-name=\"product photo tile\"><img alt=\"Aero Fit Ultra\" class=\"w-[84px] h-[84px] object-contain mix-blend-multiply brightness-110\" data-kid=\"1-1-3-3-1-1\" data-name=\"Ultra product image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/></div>\n<div data-kid=\"1-1-3-3-2\" data-name=\"product card text\"><p class=\"serif text-[22px] font-medium leading-tight\" data-kid=\"1-1-3-3-2-1\" data-name=\"product name\">Aero Fit Ultra</p><p class=\"mt-1 text-[14px] text-[#4A2A33]\" data-kid=\"1-1-3-3-2-2\" data-name=\"product price line\">$399, or included with Life</p><p class=\"mt-0.5 text-[13px] text-[#6B4F57]\" data-kid=\"1-1-3-3-2-3\" data-name=\"shipping note\">Ships from November 4</p></div>\n</div>\n<span class=\"slide-num absolute left-[72px] bottom-9 text-[11px] font-semibold tracking-[0.3em] opacity-50\" data-kid=\"1-1-3-4\" data-name=\"slide counter\">01 — 05</span>\n</div>\n<!-- 02 Training -->\n<div class=\"hero-slide absolute inset-0 z-[2] bg-[#6B7B4E] text-[#FAF8F6]\" data-kid=\"1-1-4\" data-name=\"training slide\" style=\"translate: none; rotate: none; scale: none; transform: translate(0px, 0px); z-index: 1;\">\n<div class=\"slide-image absolute inset-0\" data-kid=\"1-1-4-1\" data-name=\"slide image wrapper\">\n<img alt=\"Athlete starting a workout on her Aero Fit Pro\" class=\"w-full h-full object-cover object-[70%_center]\" data-kid=\"1-1-4-1-1\" data-name=\"training portrait photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/b676a18a466145849599dd16012925dc.jpg\"/>\n<div class=\"absolute inset-0 bg-[linear-gradient(90deg,#6B7B4E_0%,rgba(107,123,7