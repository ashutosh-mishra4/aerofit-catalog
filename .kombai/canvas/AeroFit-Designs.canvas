      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip py-5\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Product bar -->\n    <div class=\"mx-4 h-[68px] rounded-full bg-white shadow-[0_4px_18px_rgba(42,11,20,0.06)] border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1\" data-name=\"top product bar\">\n        <div class=\"flex items-center gap-6\" data-kid=\"1-1-1\" data-name=\"brand and nav left group\">\n            <span class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-1-1-1\" data-name=\"brand wordmark link\">\n                <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1\" data-name=\"Aero Fit logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n                Aero Fit\n            </span>\n            <div class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"primary page navigation links\">\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link Overview\" href=\"#\">\n                    Overview\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link How it works\" href=\"#\">\n                    How it works\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link Shop bands active highlight\" href=\"#\">\n                    Shop devices\n                </a>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"account and cart action group\">\n            <button class=\"h-[52px] pl-5 pr-2 rounded-full border border-[#EFEAE6] bg-white text-[14px] font-medium flex items-center gap-2 hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-2-1\" data-name=\"cart summary button\">\n                <span class=\"text-[18px] flex\" data-kid=\"1-1-2-1-1\" data-name=\"shopping bag icon wrapper\">\n                    <i class=\"ti ti-shopping-bag\" data-kid=\"1-1-2-1-1-1\" data-name=\"shopping bag icon\">\n                    </i>\n                </span>\n                Cart\n                <span class=\"min-w-9 h-9 px-2 rounded-full bg-[#F3EFEC] text-[13px] flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"cart item count badge\" data-reason=\"count text and highlight class rewritten by cart click handler\" id=\"cartCount\">\n                    0\n                </span>\n            </button>\n            <button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-2-2\" data-name=\"join now primary button\">\n                Join Aero Fit free\n            </button>\n        </div>\n    </div>\n    <!-- Ultra launch hero -->\n    <section class=\"mx-4 mt-5 h-[480px] rounded-[28px] bg-[#F3EDE9] overflow-hidden grid grid-cols-[1fr_540px]\" data-kid=\"1-2\" data-name=\"Ultra launch hero section\">\n        <div class=\"pl-[96px] pr-10 flex flex-col justify-center\" data-kid=\"1-2-1\" data-name=\"hero copy column\">\n            <h1 class=\"serif text-[58px] leading-[1.04] font-medium tracking-[-0.015em]\" data-kid=\"1-2-1-1\" data-name=\"hero headline\">\n                Aero Fit Ultra.\n                <br data-kid=\"1-2-1-1-1\" data-name=\"line break\"/>\n                Fourteen days on\n                <br data-kid=\"1-2-1-1-2\" data-name=\"line break\"/>\n                one charge.\n            </h1>\n            <p class=\"mt-5 text-[16px] leading-[1.55] text-[#4A2A33] max-w-[470px]\" data-kid=\"1-2-1-2\" data-name=\"hero supporting paragraph\">\n                A titanium case, dual-band GPS and ECG, built for long training blocks and multi-day races. Ships from November 4.\n            </p>\n            <div class=\"mt-7 flex items-center gap-2\" data-kid=\"1-2-1-3\" data-name=\"hero call-to-action button row\">\n                <button class=\"h-11 px-5 rounded-full bg-[#2A0B14] text-white text-[14px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-2-1-3-1\" data-name=\"view Ultra primary button\">\n                    View Ultra\n                </button>\n                <button class=\"h-11 px-5 rounded-full border border-[#D9D0CB] bg-white text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-act=\"use\" data-kid=\"1-2-1-3-2\" data-name=\"compare Ultra and Pro button\" data-use=\"endurance\">\n                    Compare Ultra and Pro\n                </button>\n            </div>\n            <dl class=\"mt-9 flex gap-10\" data-kid=\"1-2-1-4\" data-name=\"hero spec stats list\">\n                <div data-kid=\"1-2-1-4-1\" data-name=\"battery spec stat\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-4-1-1\" data-name=\"stat label Battery\">\n                        Battery\n                    </dt>\n                    <dd class=\"mt-0.5 text-[20px] font-semibold\" data-kid=\"1-2-1-4-1-2\" data-name=\"stat value 14 days\">\n                        14 days\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-1-4-2\" data-name=\"water resistance spec stat\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-4-2-1\" data-name=\"stat label Water resistance\">\n                        Water resistance\n                    </dt>\n                    <dd class=\"mt-0.5 text-[20px] font-semibold\" data-kid=\"1-2-1-4-2-2\" data-name=\"stat value 100 m\">\n                        100 m\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-1-4-3\" data-name=\"weight spec stat\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-4-3-1\" data-name=\"stat label Weight with band\">\n                        Weight with band\n                    </dt>\n                    <dd class=\"mt-0.5 text-[20px] font-semibold\" data-kid=\"1-2-1-4-3-2\" data-name=\"stat value 32 g\">\n                        32 g\n                    </dd>\n                </div>\n                <div data-kid=\"1-2-1-4-4\" data-name=\"price spec stat\">\n                    <dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-2-1-4-4-1\" data-name=\"stat label Price\">\n                        Price\n                    </dt>\n                    <dd class=\"mt-0.5 text-[20px] font-semibold\" data-kid=\"1-2-1-4-4-2\" data-name=\"stat price value $399\">\n                        $399\n                        <span class=\"text-[13px] font-normal text-[#6B4F57]\" data-kid=\"1-2-1-4-4-2-1\" data-name=\"price membership note span\">\n                            or with Life\n                        </span>\n                    </dd>\n                </div>\n            </dl>\n        </div>\n        <div class=\"relative flex items-center justify-center\" data-kid=\"1-2-2\" data-name=\"hero product imagery area\">\n            <div class=\"absolute w-[560px] h-[560px] rounded-full bg-[radial-gradient(circle,#F8F38A_0%,#FBF4B8_38%,transparent_68%)]\" data-kid=\"1-2-2-1\" data-name=\"decorative radial glow behind product\">\n            </div>\n            <img alt=\"Aero Fit Ultra titanium adventure watch\" class=\"relative w-[430px] h-[430px] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" data-kid=\"1-2-2-2\" data-name=\"hero Ultra watch product image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/>\n        </div>\n    </section>\n    <!-- Decision rail -->\n    <section class=\"mx-4 mt-4 rounded-[22px] bg-[#F8F38A] px-7 py-5 grid grid-cols-[auto_1fr_auto] gap-10 items-center\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"use-case decision rail\" data-reason=\"children and text repopulated by use-case render script\">\n        <div data-kid=\"1-3-1\" data-name=\"use-question and chips container\">\n            <p class=\"text-[16px] font-medium\" data-kid=\"1-3-1-1\" data-name=\"use-question heading text\">\n                What matters most to you?\n            </p>\n            <div class=\"mt-3 flex gap-2\" data-dynamic=\"true\" data-kid=\"1-3-1-2\" data-name=\"use-case filter chips row\" data-reason=\"chip buttons injected by use-case render script\" id=\"useChips\">\n                <button class=\"h-10 px-4 rounded-full text-[14px] font-medium flex items-center gap-1.5 transition bg-[#2A0B14] text-white\" data-act=\"use\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1\" data-name=\"sleep use-case filter chip button\" data-reason=\"chip buttons re-rendered by use-case render script\" data-use=\"sleep\">\n                    <span class=\"text-[16px] flex\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1\" data-name=\"sleep chip icon wrapper\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        <i class=\"ti ti-moon-stars\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"moon stars icon\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        </i>\n                    </span>\n                    Sleep\n                </button>\n                <button class=\"h-10 px-4 rounded-full text-[14px] font-medium flex items-center gap-1.5 transition bg-white hover:bg-[#FFFDF0]\" data-act=\"use\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2\" data-name=\"training use-case filter chip button\" data-reason=\"chip buttons re-rendered by use-case render script\" data-use=\"training\">\n                    <span class=\"text-[16px] flex\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-1\" data-name=\"training chip icon wrapper\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        <i class=\"ti ti-barbell\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"barbell icon\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        </i>\n                    </span>\n                    Training\n                </button>\n                <button class=\"h-10 px-4 rounded-full text-[14px] font-medium flex items-center gap-1.5 transition bg-white hover:bg-[#FFFDF0]\" data-act=\"use\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3\" data-name=\"music use-case filter chip button\" data-reason=\"chip buttons re-rendered by use-case render script\" data-use=\"music\">\n                    <span class=\"text-[16px] flex\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3-1\" data-name=\"music chip icon wrapper\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        <i class=\"ti ti-music\" data-dynamic=\"true\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"music note icon\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        </i>\n                    </span>\n                    Music\n                </button>\n                <button class=\"h-10 px-4 rounded-full text-[14px] font-medium flex items-center gap-1.5 transition bg-white hover:bg-[#FFFDF0]\" data-act=\"use\" data-dynamic=\"true\" data-kid=\"1-3-1-2-4\" data-name=\"endurance use-case filter chip button\" data-reason=\"chip buttons re-rendered by use-case render script\" data-use=\"endurance\">\n                    <span class=\"text-[16px] flex\" data-dynamic=\"true\" data-kid=\"1-3-1-2-4-1\" data-name=\"endurance chip icon wrapper\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        <i class=\"ti ti-route\" data-dynamic=\"true\" data-kid=\"1-3-1-2-4-1-1\" data-name=\"route icon\" data-reason=\"chip buttons re-rendered by use-case render script\">\n                        </i>\n                    </span>\n                    Endurance\n                </button>\n            </div>\n        </div>\n        <p class=\"text-[15px] leading-[1.55] text-[#4A2A33] max-w-[440px]\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"use-case rationale text\" data-reason=\"rationale text replaced when use case changes\" id=\"useWhy\">\n            Every model tracks sleep stages. Lite and Smart are the lightest to wear overnight, and Smart adds skin temperature for illness and cycle trends.\n        </p>\n        <div class=\"text-right\" data-kid=\"1-3-3\" data-name=\"use-case comparison callout column\">\n            <p class=\"text-[13px] text-[#4A2A33]\" data-kid=\"1-3-3-1\" data-name=\"comparison prompt label\">\n                Start by comparing\n            </p>\n            <p class=\"serif text-[24px] font-medium leading-tight\" data-dynamic=\"true\" data-kid=\"1-3-3-2\" data-name=\"compared models pair text\" data-reason=\"pair names replaced when use case changes\" id=\"usePair\">\n                Lite and Smart\n            </p>\n            <a class=\"mt-1 inline-block text-[13px] underline underline-offset-2\" data-kid=\"1-3-3-3\" data-name=\"find-your-band quiz link\" href=\"#\">\n                Not sure yet? Find your Aero Fit in 3 questions\n            </a>\n        </div>\n    </section>\n    <!-- Lineup -->\n    <section class=\"max-w-[1248px] mx-auto px-4 pt-24\" data-kid=\"1-4\" data-name=\"lineup section\">\n        <div class=\"flex items-end justify-between gap-10\" data-kid=\"1-4-1\" data-name=\"lineup header row\">\n            <div data-kid=\"1-4-1-1\" data-name=\"lineup heading block\">\n                <h2 class=\"serif text-[46px] leading-[1.08] font-medium tracking-[-0.01em]\" data-kid=\"1-4-1-1-1\" data-name=\"lineup section headline\">\n                    Choose your Aero Fit\n                </h2>\n                <p class=\"mt-3 text-[15px] leading-[1.6] text-[#4A2A33] max-w-[520px]\" data-kid=\"1-4-1-1-2\" data-name=\"lineup supporting description\">\n                    From a screenless band to a titanium adventure watch. All five run the same Aero Fit app, coaching and Recovery scores.\n                </p>\n            </div>\n            <div class=\"flex flex-col items-end gap-3\" data-kid=\"1-4-1-2\" data-name=\"pricing mode controls column\">\n                <div class=\"h-12 p-1 rounded-full bg-white border border-[#EFEAE6] flex text-[14px] font-medium\" data-kid=\"1-4-1-2-1\" data-name=\"purchase mode tab switcher\" role=\"tablist\">\n                    <button class=\"modeBtn h-10 px-5 rounded-full transition bg-[#2A0B14] text-white\" data-act=\"mode\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-1\" data-mode=\"out\" data-name=\"buy outright tab button\" data-reason=\"active class restyled by mode render\">\n                        Buy outright\n                    </button>\n                    <button class=\"modeBtn h-10 px-5 rounded-full transition hover:bg-[#F3EFEC]\" data-act=\"mode\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-2\" data-mode=\"mem\" data-name=\"with membership tab button\" data-reason=\"active class restyled by mode render\">\n                        With membership\n                    </button>\n                </div>\n                <div class=\"hidden items-center gap-2 text-[13px]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2\" data-name=\"membership plan selector row\" data-reason=\"plan buttons injected by mode render script\" id=\"planRow\">\n                    <span class=\"text-[#6B4F57] mr-1\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-1\" data-name=\"plan label text\" data-reason=\"plan buttons injected by mode render script\">\n                        Plan\n                    </span>\n                    <button class=\"h-9 px-3.5 rounded-full border transition border-[#E3DDDA] hover:bg-white\" data-act=\"plan\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-2\" data-name=\"One plan selection button\" data-plan=\"1\" data-reason=\"plan buttons injected by mode render script\">\n                        One · $16/mo\n                    </button>\n                    <button class=\"h-9 px-3.5 rounded-full border transition border-[#2A0B14] bg-white font-medium\" data-act=\"plan\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-3\" data-name=\"Peak plan selection button\" data-plan=\"2\" data-reason=\"plan buttons injected by mode render script\">\n                        Peak · $25/mo\n                    </button>\n                    <button class=\"h-9 px-3.5 rounded-full border transition border-[#E3DDDA] hover:bg-white\" data-act=\"plan\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2-4\" data-name=\"Life plan selection button\" data-plan=\"3\" data-reason=\"plan buttons injected by mode render script\">\n                        Life · $33/mo\n                    </button>\n                </div>\n            </div>\n        </div>\n        <p class=\"mt-6 text-[13px] text-[#6B4F57]\" data-dynamic=\"true\" data-kid=\"1-4-2\" data-name=\"pricing example note\" data-reason=\"example text rewritten per purchase mode\" id=\"example\">\n            Prices in USD, free shipping and 30-day returns. Adding a membership later is optional.\n        </p>\n        <div class=\"mt-4 grid grid-cols-5 gap-3 items-start\" data-dynamic=\"true\" data-kid=\"1-4-3\" data-name=\"band lineup card grid\" data-reason=\"product cards templated into container by render script\" id=\"lineup\">\n            <article class=\"rounded-[22px] bg-white p-3 pb-4 flex flex-col border transition borde