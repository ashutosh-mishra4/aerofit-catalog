      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.marq{animation:marq 16s linear infinite;}\n@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.noscroll::-webkit-scrollbar{display:none}\n.noscroll{scrollbar-width:none}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Announcement -->\n    <!-- Nav -->\n    <header class=\"bg-[#FAF8F6] border-b border-[#EEE8E4]\" data-kid=\"1-2\" data-name=\"site header with navigation\">\n        <div class=\"px-10 h-[64px] grid grid-cols-[1fr_auto_1fr] items-center\" data-kid=\"1-2-1\" data-name=\"header navigation container\">\n            <a class=\"flex items-center gap-2\" data-kid=\"1-2-1-1\" data-name=\"brand logo link\" href=\"#\">\n                <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-2-1-1-1\" data-name=\"Aero Fit logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n                <span class=\"serif text-[24px] font-medium tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"WHOOP brand wordmark\">\n                    Aero Fit\n                </span>\n            </a>\n            <nav class=\"flex items-center gap-8 text-[13px] font-medium\" data-kid=\"1-2-1-2\" data-name=\"primary navigation menu\">\n                <a class=\"flex items-center gap-1 hover:opacity-70 transition\" data-kid=\"1-2-1-2-1\" data-name=\"membership dropdown link\" href=\"#\">\n                    Memberships\n                    <span class=\"text-[12px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"dropdown chevron label\">\n                        <i class=\"ti ti-chevron-down\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"chevron down icon\">\n                        </i>\n                    </span>\n                </a>\n                <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-1-2-2\" data-name=\"how it works nav link\" href=\"#\">\n                    How it works\n                </a>\n                <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-1-2-3\" data-name=\"why whoop nav link\" href=\"#\">\n                    Why Aero Fit\n                </a>\n                <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-1-2-5\" data-name=\"accessories nav link\" href=\"#\">\n                    Accessories\n                </a>\n                <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-1-2-6\" data-name=\"download app nav link\" href=\"#\">\n                    Download App\n                </a>\n            </nav>\n            <div class=\"flex items-center justify-end gap-2 whitespace-nowrap\" data-kid=\"1-2-1-3\" data-name=\"header auth actions container\">\n                <button class=\"h-9 px-3 rounded-lg border border-[#E8E2DE] bg-white text-[13px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-2-1-3-1\" data-name=\"sign in button\">\n                    Sign in\n                </button>\n                <button class=\"h-9 px-3.5 rounded-lg bg-[#F8F38A] text-[13px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-2-1-3-2\" data-name=\"join free primary button\">\n                    Join Aero Fit free\n                </button>\n            </div>\n        </div>\n    </header>\n    <!-- Full-bleed hero -->\n    <section class=\"relative h-[640px] overflow-hidden\" data-kid=\"1-3\" data-name=\"full-bleed hero section\">\n        <img alt=\"Two friends laughing and high-fiving after a forest trail run, both wearing Aero Fit bands\" class=\"absolute inset-0 w-full h-full object-cover object-[center_30%]\" data-kid=\"1-3-1\" data-name=\"hero background athlete image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/65ac1bc7a57c4d3bb3773cee4236749d.png\"/>\n        <div class=\"absolute inset-0 bg-gradient-to-t from-[#2A0B14]/90 via-[#2A0B14]/35 to-transparent\" data-kid=\"1-3-2\" data-name=\"hero bottom gradient overlay\">\n        </div>\n        <div class=\"absolute inset-0 bg-gradient-to-r from-[#2A0B14]/50 to-transparent\" data-kid=\"1-3-3\" data-name=\"hero left gradient overlay\">\n        </div>\n        <!-- live label + team stack -->\n        <div class=\"absolute right-10 bottom-10 w-[260px] bg-white/12 backdrop-blur-md border border-white/20 rounded-[14px] p-3 text-white\" data-kid=\"1-3-5\" data-name=\"performance team live card\">\n            <p class=\"text-[11px] text-white/70 mb-2\" data-kid=\"1-3-5-1\" data-name=\"team card tagline\">\n                Your performance team is live\n            </p>\n            <div class=\"space-y-2\" data-kid=\"1-3-5-2\" data-name=\"team members list\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-5-2-1\" data-name=\"coach team member row\">\n                    <img alt=\"Coach Amelia Carter\" class=\"w-9 h-9 rounded-md object-cover\" data-kid=\"1-3-5-2-1-1\" data-name=\"coach avatar thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/477df3f011ae43f3abe4c0cf588a828b.jpg\"/>\n                    <span class=\"text-[12px] font-medium flex-1\" data-kid=\"1-3-5-2-1-2\" data-name=\"coach name label\">\n                        Coach Amelia Carter\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-5-2-2\" data-name=\"doctor team member row\">\n                    <img alt=\"Dr. Daniel Morgan\" class=\"w-9 h-9 rounded-md object-cover\" data-kid=\"1-3-5-2-2-1\" data-name=\"doctor avatar thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/b55145485cc54ff08d9f99147f426b26.jpg\"/>\n                    <span class=\"text-[12px] font-medium flex-1\" data-kid=\"1-3-5-2-2-2\" data-name=\"doctor name and specialty label\">\n                        Dr. Daniel Morgan · Sleep\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-5-2-3\" data-name=\"recovery specialist team member row\">\n                    <img alt=\"Sophia Bennett\" class=\"w-9 h-9 rounded-md object-cover\" data-kid=\"1-3-5-2-3-1\" data-name=\"specialist avatar thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/082d9c34332646e7b8af0a283c122907.jpg\"/>\n                    <span class=\"text-[12px] font-medium flex-1\" data-kid=\"1-3-5-2-3-2\" data-name=\"specialist name and specialty label\">\n                        Sophia Bennett · Recovery\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute left-14 bottom-14 max-w-[760px] text-[#FAF8F6]\" data-kid=\"1-3-6\" data-name=\"hero headline text block\">\n            <div class=\"w-[230px] overflow-hidden text-[12px] text-white/80 [mask-image:linear-gradient(90deg,#000_80%,transparent)]\" data-kid=\"1-3-6-1\" data-name=\"marquee feature label container\">\n                <div class=\"marq flex whitespace-nowrap w-max\" data-kid=\"1-3-6-1-1\" data-name=\"marquee track\">\n                    <span data-kid=\"1-3-6-1-1-2\" data-name=\"marquee feature label duplicate\">\n                        Sleep • Strain • Recovery • Healthspan • Heart Health •\n                    </span>\n                </div>\n            </div>\n            <h1 class=\"serif mt-4 text-[76px] leading-[1.02] font-medium tracking-[-0.015em]\" data-kid=\"1-3-6-2\" data-name=\"hero headline\">\n                Know What Your Body Needs, Every Single Day\n            </h1>\n            <p class=\"mt-5 text-[16px] leading-[1.6] text-white/85 max-w-[520px]\" data-kid=\"1-3-6-3\" data-name=\"hero supporting copy\">\n                Aero Fit turns 24/7 health insights into personalized coaching to help you sleep, train, and feel better wherever life takes you.\n            </p>\n            <div class=\"mt-7 flex gap-2\" data-kid=\"1-3-6-4\" data-name=\"hero call to action buttons\">\n                <button class=\"h-11 px-5 rounded-lg bg-[#F8F38A] text-[#2A0B14] text-[14px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-3-6-4-1\" data-name=\"primary free trial cta button\">\n                    Try Aero Fit for free\n                </button>\n                <button class=\"h-11 px-4 rounded-lg border border-white/40 text-white text-[14px] font-medium hover:bg-white/10 transition\" data-kid=\"1-3-6-4-2\" data-name=\"secondary join cta button\">\n                    Join Now\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Promo card (About) -->\n    <section class=\"px-10 pt-14\" data-kid=\"1-4\" data-name=\"about promo section\">\n        <div class=\"max-w-[1000px] mx-auto bg-[#F3EEEA] rounded-[18px] p-5 flex items-center gap-8\" data-kid=\"1-4-1\" data-name=\"about promo card\">\n            <img alt=\"Two athletes stretching on a track at sunrise\" class=\"w-[220px] h-[150px] rounded-[12px] object-cover shrink-0\" data-kid=\"1-4-1-1\" data-name=\"about promo image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/1f026a8f11f74e0cbbfa802834c37de1.jpg\"/>\n            <div class=\"flex-1\" data-kid=\"1-4-1-2\" data-name=\"about promo text content\">\n                <p class=\"text-[12px] font-medium text-[#7A5B64]\" data-kid=\"1-4-1-2-1\" data-name=\"about promo eyebrow label\">\n                    Why Aero Fit\n                </p>\n                <h2 class=\"serif mt-1 text-[30px] leading-[1.15] font-medium\" data-kid=\"1-4-1-2-2\" data-name=\"about promo heading\">\n                    Unlocking Human Performance & Healthspan\n                </h2>\n                <p class=\"mt-2 text-[13px] leading-[1.6] text-[#4A2A33] max-w-[460px]\" data-kid=\"1-4-1-2-3\" data-name=\"about promo description\">\n                    We make 24/7 health monitoring simple, accurate, and personal. With independently validated sensors and personalized coaching, we help you understand your sleep, strain, and stress, so you can act on it every day.\n                </p>\n            </div>\n            <button class=\"shrink-0 h-10 px-4 rounded-lg border border-[#2A0B14] text-[13px] font-medium hover:bg-[#2A0B14] hover:text-white transition\" data-kid=\"1-4-1-3\" data-name=\"about learn more button\">\n                Learn More\n            </button>\n        </div>\n    </section>\n    <!-- Logos -->\n    <section class=\"pt-14\" data-kid=\"1-5\" data-name=\"social proof logos section\">\n        <p class=\"text-center text-[14px] text-[#4A2A33]\" data-kid=\"1-5-1\" data-name=\"social proof stat sentence\">\n            Logged over\n            <span class=\"inline-block bg-[#2A0B14] text-white rounded-full px-2 py-0.5 text-[13px] font-medium\" data-kid=\"1-5-1-1\" data-name=\"workouts stat badge\">\n                12M\n            </span>\n            workouts last week\n        </p>\n    </section>\n    <!-- Carousel -->\n    <section class=\"pt-20 pb-20\" data-kid=\"1-6\" data-name=\"feature carousel section\">\n        <div class=\"max-w-[1000px] mx-auto px-0 flex items-end justify-between mb-6\" data-kid=\"1-6-1\" data-name=\"feature carousel heading area\">\n            <h2 class=\"serif text-[36px] leading-[1.12] font-medium\" data-kid=\"1-6-1-1\" data-name=\"feature carousel heading\">\n                Everything Your Body Needs,\n                <br data-kid=\"1-6-1-1-1\" data-name=\"line break\"/>\n                One Simple Wearable\n            </h2>\n            <p class=\"text-[13px] leading-[1.6] text-[#4A2A33] max-w-[270px]\" data-kid=\"1-6-1-2\" data-name=\"feature carousel supporting copy\">\n                Experience 24/7 monitoring across sleep, strain, stress and heart health with personalized daily coaching\n            </p>\n        </div>\n        <div class=\"relative\" data-kid=\"1-6-2\" data-name=\"feature carousel wrapper\">\n            <div class=\"noscroll flex gap-4 overflow-x-auto snap-x snap-mandatory pl-[140px] pr-10 scroll-pl-[140px] scroll-smooth\" data-kid=\"1-6-2-1\" data-name=\"feature cards horizontal track\" id=\"track\">\n                <article class=\"snap-start shrink-0 relative w-[260px] h-[340px] rounded-[16px] overflow-hidden group\" data-kid=\"1-6-2-1-1\" data-name=\"sleep feature card\">\n                    <img alt=\"Sleep scientist reviewing sleep data\" class=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700\" data-kid=\"1-6-2-1-1-1\" data-name=\"sleep feature card image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/b55145485cc54ff08d9f99147f426b26.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#2A0B14]/70 via-transparent to-transparent\" data-kid=\"1-6-2-1-1-2\" data-name=\"sleep feature card gradient overlay\">\n                    </div>\n                    <h3 class=\"serif absolute left-5 top-5 right-5 text-white text-[21px] leading-[1.2] font-medium\" data-kid=\"1-6-2-1-1-3\" data-name=\"sleep feature card title\">\n                        Optimize your sleep, wake up ready\n                    </h3>\n                    <button aria-label=\"Learn about sleep\" class=\"absolute right-4 bottom-4 w-7 h-7 rounded-full bg-white text-[#2A0B14] flex items-center justify-center text-[14px] hover:bg-[#F8F38A] transition\" data-kid=\"1-6-2-1-1-4\" data-name=\"sleep feature learn more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-6-2-1-1-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n                <article class=\"snap-start shrink-0 relative w-[260px] h-[340px] rounded-[16px] overflow-hidden group\" data-kid=\"1-6-2-1-2\" data-name=\"coaching feature card\">\n                    <img alt=\"Aero Fit coach explaining\" class=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700\" data-kid=\"1-6-2-1-2-1\" data-name=\"coaching feature card image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/1ea11b9725244f2587b3227b5fe5edc0.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#2A0B14]/70 via-transparent to-transparent\" data-kid=\"1-6-2-1-2-2\" data-name=\"coaching feature card gradient overlay\">\n                    </div>\n                    <h3 class=\"serif absolute left-5 top-5 right-5 text-white text-[21px] leading-[1.2] font-medium\" data-kid=\"1-6-2-1-2-3\" data-name=\"coaching feature card title\">\n                        Know when to push and when to recover\n                    </h3>\n                    <button aria-label=\"Learn about coaching\" class=\"absolute right-4 bottom-4 w-7 h-7 rounded-full bg-white text-[#2A0B14] flex items-center justify-center text-[14px] hover:bg-[#F8F38A] transition\" data-kid=\"1-6-2-1-2-4\" data-name=\"coaching feature learn more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-6-2-1-2-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n                <article class=\"snap-start shrink-0 relative w-[260px] h-[340px] rounded-[16px] overflow-hidden group\" data-kid=\"1-6-2-1-3\" data-name=\"heart health feature card\">\n                    <img alt=\"Recovery specialist with a tablet\" class=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700\" data-kid=\"1-6-2-1-3-1\" data-name=\"heart health feature card image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/082d9c34332646e7b8af0a283c122907.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#2A0B14]/70 via-transparent to-transparent\" data-kid=\"1-6-2-1-3-2\" data-name=\"heart health feature card gradient overlay\">\n                    </div>\n                    <h3 class=\"serif absolute left-5 top-5 right-5 text-white text-[21px] leading-[1.2] font-medium\" data-kid=\"1-6-2-1-3-3\" data-name=\"heart health feature card title\">\n                        Keep a closer eye on your heart health\n                    </h3>\n                    <button aria-label=\"Learn about heart health\" class=\"absolute right-4 bottom-4 w-7 h-7 rounded-full bg-white text-[#2A0B14] flex items-center justify-center text-[14px] hover:bg-[#F8F38A] transition\" data-kid=\"1-6-2-1-3-4\" data-name=\"heart health feature learn more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-6-2-1-3-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n                <article class=\"snap-start shrink-0 relative w-[260px] h-[340px] rounded-[16px] overflow-hidden group\" data-kid=\"1-6-2-1-4\" data-name=\"healthspan feature card\">\n                    <img alt=\"Athletes stretching at sunrise\" class=\"absolute inset-0 w-full h-full object-cover object-[60%_center] group-hover:scale-105 transition duration-700\" data-kid=\"1-6-2-1-4-1\" data-name=\"healthspan feature card image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/1f026a8f11f74e0cbbfa802834c37de1.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#2A0B14]/70 via-transparent to-transparent\" data-kid=\"1-6-2-1-4-2\" data-name=\"healthspan feature card gradient overlay\">\n                    </div>\n                    <h3 class=\"serif absolute left-5 top-5 right-5 text-white text-[21px] leading-[1.2] font-medium\" data-kid=\"1-6-2-1-4-3\" data-name=\"healthspan feature card title\">\n                        Build habits for a longer, healthier life\n                    </h3>\n                    <button aria-label=\"Learn about healthspan\" class=\"absolute right-4 bottom-4 w-7 h-7 rounded-full bg-white text-[#2A0B14] flex items-center justify-center text-[14px] hover:bg-[#F8F38A] transition\" data-kid=\"1-6-2-1-4-4\" data-name=\"healthspan feature learn more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-6-2-1-4-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n                <article class=\"snap-start shrink-0 relative w-[260px] h-[340px] rounded-[16px] overflow-hidden group\" data-kid=\"1-6-2-1-5\" data-name=\"advanced labs feature card\">\n                    <img alt=\"Performance coach on a call\" class=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700\" data-kid=\"1-6-2-1-5-1\" data-name=\"advanced labs feature card image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/477df3f011ae43f3abe4c0cf588a828b.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#2A0B14]/70 via-transparent to-transparent\" data-kid=\"1-6-2-1-5-2\" data-name=\"advanced labs feature card gradient overlay\">\n                    </div>\n                    <h3 class=\"serif absolute left-5 top-5 right-5 text-white text-[21px] leading-[1.2] font-medium\" data-kid=\"1-6-2-1-5-3\" data-name=\"advanced labs feature card title\">\n                        See what your bloodwork means for you\n                    </h3>\n                    <button aria-label=\"Learn about Advanced Labs\" class=\"absolute right-4 bottom-4 w-7 h-7 rounded-full bg-white text-[#2A0B14] flex items-center justify-center text-[14px] hover:bg-[#F8F38A] transition\" data-kid=\"1-6-2-1-5-4\" data-name=\"advanced labs feature learn more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-6-2-1-5-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n            </div>\n            <button aria-label=\"Next slide\" class=\"absolute right-[132px] top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white shadow-[0_6px_20px_rgba(42,11,20,0.15)] flex items-center justify-center text-[18px] hover:bg-[#F8F38A] transition\" data-kid=\"1-6-2-2\" data-name=\"carousel next slide button\" id=\"next\" title=\"Next\">\n                <i class=\"ti ti-chevron-right\" data-kid=\"1-6-2-2-1\" data-name=\"chevron right icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"mt-5 flex justify-center gap-1.5\" data-kid=\"1-6-3\" data-name=\"carousel pagination dots\">\n            <span class=\"w-1.5 h-1.5 rounded-full bg-[#2A0B14]\" data-kid=\"1-6-3-1\" data-name=\"active pagination dot\">\n            </span>\n            <span class=\"w-1.5 h-1.5 rounded-full bg-[#C9BFC2]\" data-kid=\"1-6-3-2\" data-name=\"inactive pagination dot\">\n            </span>\n            <span class=\"w-1.5 h-1.5 rounded-full bg-[#C9BFC2]\" data-kid=\"1-6-3-3\" data-name=\"inactive pagination dot\">\n            </span>\n        </div>\n    </section>\n    <!-- Dark bento section -->\n    <section class=\"bg-[#2A0B14] rounded-[32px] mx-0 pt-20 pb-20 text-[#FAF8F6]\" data-kid=\"1-7\" data-name=\"dark bento features section\">\n        <div class=\"text-center\" data-kid=\"1-7-1\" data-name=\"dark bento intro header\">\n            <h2 class=\"serif text-[46px] leading-[1.1] font-medium\" data-kid=\"1-7-1-1\" data-name=\"dark bento section heading\">\n                The Wearable for Better Health\n            </h2>\n            <p class=\"mt-3 text-[14px] text-white/70 max-w-[440px] mx-auto leading-[1.6]\" data-kid=\"1-7-1-2\" data-name=\"dark bento section subheading\">\n                Get a recommended bedtime, AI coaching, and medical-grade heart screening, all from one band.\n            </p>\n            <button class=\"mt-6 h-10 px-4 rounded-lg bg-[#F8F38A] text-[#2A0B14] text-[13px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-7-1-3\" data-name=\"dark bento get started button\">\n                Get Started\n            </button>\n        </div>\n        <div class=\"max-w-[1000px] mx-auto mt-12 space-y-3\" data-kid=\"1-7-2\" data-name=\"dark bento card stack\">\n            <!-- Wide: Sleep | phone | Coach -->\n            <div class=\"relative h-[400px] bg-[#FAF8F6] text-[#2A0B14] rounded-[20px] overflow-hidden grid grid-cols-[1fr_230px_1fr] items-center\" data-kid=\"1-7-2-1\" data-name=\"sleep phone coach bento row\">\n                <div class=\"px-10\" data-kid=\"1-7-2-1-1\" data-name=\"sleep feature content pane\">\n                    <span class=\"text-[18px]\" data-kid=\"1-7-2-1-1-1\" data-name=\"sleep icon badge\">\n                        <i class=\"ti ti-moon-stars\" data-kid=\"1-7-2-1-1-1-1\" data-name=\"moon stars icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"serif mt-3 text-[26px] font-medium leading-[1.15]\" data-kid=\"1-7-2-1-1-2\" data-name=\"sleep feature title\">\n                        Optimize Your Sleep\n                    </h3>\n                    <p class=\"mt-2 text-[12px] leading-[1.6] text-[#5A3B44]\" data-kid=\"1-7-2-1-1-3\" data-name=\"sleep feature description\">\n                        Get a personalized bedtime 