      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19229/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/AeroFit-Designs.canvas\", nodeId: \"node_paste_d6f577d51d13\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n</style>\n<main class=\"sans relative min-h-[1032px] w-full overflow-hidden bg-[#FAF8F6] px-10 py-24 text-[#2A0B14] antialiased\" data-kid=\"1\" data-name=\"checkout landing page\">\n    <div class=\"pointer-events-none absolute -left-40 top-10 h-[520px] w-[620px] rounded-full bg-[radial-gradient(circle,#F8F38A_0%,#FBF4B8_40%,transparent_70%)] opacity-60 blur-[30px]\" data-kid=\"1-1\" data-name=\"decorative warm glow blur\">\n    </div>\n    <div class=\"pointer-events-none absolute -right-32 bottom-0 h-[460px] w-[560px] rounded-full bg-[radial-gradient(circle,#D2F6E6_0%,transparent_70%)] opacity-70 blur-[30px]\" data-kid=\"1-2\" data-name=\"decorative mint glow blur\">\n    </div>\n    <section class=\"relative mx-auto grid h-[840px] w-full max-w-[1280px] grid-cols-[59%_41%] overflow-hidden rounded-[32px] border border-[#EFEAE6] bg-[#F6F1EE] p-3 shadow-[0_24px_60px_rgba(42,11,20,0.08)]\" data-kid=\"1-3\" data-name=\"checkout panel container\">\n        <!-- Left panel -->\n        <div class=\"relative flex min-w-0 flex-col overflow-hidden rounded-[22px] bg-white shadow-[0_6px_24px_rgba(42,11,20,0.07)]\" data-kid=\"1-3-1\" data-name=\"left checkout panel\">\n            <header class=\"flex h-[82px] shrink-0 items-center justify-between border-b border-[#F3EFEC] px-7\" data-kid=\"1-3-1-1\" data-name=\"left panel header bar\">\n                <div class=\"flex items-center gap-4\" data-kid=\"1-3-1-1-1\" data-name=\"header left brand group\">\n                    <button aria-label=\"Close checkout\" class=\"grid size-9 place-items-center rounded-full border border-[#EFEAE6] bg-white text-[#6B4F57] transition hover:bg-[#F3EFEC]\" data-kid=\"1-3-1-1-1-1\" data-name=\"close checkout button\">\n                        <span class=\"text-[16px]\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"close button icon wrapper\">\n                            <i class=\"ti ti-x\" data-kid=\"1-3-1-1-1-1-1-1\" data-name=\"x close icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-1-1-1-2\" data-name=\"brand logo and name group\">\n                        <span class=\"grid size-9 place-items-center rounded-full bg-[#2A0B14] text-[18px] text-[#F8F38A]\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"brand logo badge\">\n                            <i class=\"ti ti-trending-up\" data-kid=\"1-3-1-1-1-2-1-1\" data-name=\"trending arrow brand icon\">\n                            </i>\n                        </span>\n                        <span class=\"serif text-[24px] font-medium tracking-tight\" data-kid=\"1-3-1-1-1-2-2\" data-name=\"brand name text\">\n                            Convertly\n                        </span>\n                    </div>\n                </div>\n                <nav aria-label=\"Checkout progress\" class=\"flex items-center gap-2 text-[12px]\" data-kid=\"1-3-1-1-2\" data-name=\"checkout progress stepper\">\n                    <div class=\"flex items-center gap-2 font-medium text-[#4A2A33]\" data-kid=\"1-3-1-1-2-1\" data-name=\"brand logo badge\">\n                        <span class=\"grid size-7 place-items-center rounded-full bg-[#D2F6E6] text-[14px] text-[#1E7A52]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"trending arrow brand icon\">\n                            <i class=\"ti ti-check\" data-kid=\"1-3-1-1-2-1-1-1\" data-name=\"checkmark icon in step badge\">\n                            </i>\n                        </span>\n                        Store Setup\n                    </div>\n                    <span class=\"h-px w-5 bg-[#D9D0CB]\" data-kid=\"1-3-1-1-2-2\" data-name=\"brand name text\">\n                    </span>\n                    <div class=\"flex items-center gap-2 font-medium text-[#2A0B14]\" data-kid=\"1-3-1-1-2-3\" data-name=\"step 2 active indicator\">\n                        <span class=\"grid size-7 place-items-center rounded-full bg-[#2A0B14] text-[12px] text-white\" data-kid=\"1-3-1-1-2-3-1\" data-name=\"step 2 number badge\">\n                            2\n                        </span>\n                        Plan\n                    </div>\n                    <span class=\"h-px w-5 bg-[#EFEAE6]\" data-kid=\"1-3-1-1-2-4\" data-name=\"stepper separator line\">\n                    </span>\n                    <div class=\"flex items-center gap-2 text-[#9A8E91]\" data-kid=\"1-3-1-1-2-5\" data-name=\"step 3 upcoming indicator\">\n                        <span class=\"grid size-7 place-items-center rounded-full bg-[#F3EFEC] text-[12px]\" data-kid=\"1-3-1-1-2-5-1\" data-name=\"step 3 number badge\">\n                            3\n                        </span>\n                        Payment\n                    </div>\n                </nav>\n            </header>\n            <div class=\"flex-1 overflow-y-auto px-[56px] pb-24 pt-6\" data-kid=\"1-3-1-2\" data-name=\"left panel scrollable content body\">\n                <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-3-1-2-1\" data-name=\"plan selection heading and billing toggle row\">\n                    <div data-kid=\"1-3-1-2-1-1\" data-name=\"heading and subtitle group\">\n                        <h1 class=\"serif text-[30px] font-medium leading-[1.2] tracking-[-0.015em]\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"plan selection headline\">\n                            Choose your growth plan\n                        </h1>\n                        <p class=\"mt-2 max-w-[470px] text-[13px] leading-[1.55] text-[#4A2A33]\" data-kid=\"1-3-1-2-1-1-2\" data-name=\"plan selection subtitle text\">\n                            Select your store platform, then choose how far you want to optimize. You can switch plans or platforms at any time.\n                        </p>\n                    </div>\n                    <label class=\"mt-2 flex shrink-0 items-center gap-2 text-[12px] text-[#6B4F57]\" data-kid=\"1-3-1-2-1-2\" data-name=\"monthly vs annual billing toggle\">\n                        <span data-kid=\"1-3-1-2-1-2-1\" data-name=\"monthly billing label\">\n                            Monthly\n                        </span>\n                        <button aria-checked=\"true\" aria-label=\"Toggle annual billing\" class=\"relative h-6 w-11 rounded-full bg-[#2A0B14]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"billing toggle switch\" data-reason=\"aria-checked and background class rewritten by billing toggle script on every render\" id=\"billingToggle\" role=\"switch\" type=\"button\">\n                            <span class=\"absolute right-1 top-1 size-4 rounded-full bg-[#F8F38A]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-2-2-1\" data-name=\"billing toggle knob\" data-reason=\"knob position and color classes rewritten by billing toggle script on every render\" id=\"billingKnob\">\n                            </span>\n                        </button>\n                        <span class=\"font-medium text-[#2A0B14]\" data-kid=\"1-3-1-2-1-2-3\" data-name=\"annual billing label\">\n                            Annual\n                        </span>\n                        <span class=\"rounded-full bg-[#F8F38A] px-2 py-0.5 text-[11px] font-medium text-[#2A0B14]\" data-kid=\"1-3-1-2-1-2-4\" data-name=\"annual discount badge\">\n                            20% off\n                        </span>\n                    </label>\n                </div>\n                <section aria-labelledby=\"platformLabel\" class=\"mt-6\" data-kid=\"1-3-1-2-2\" data-name=\"platform selection section\">\n                    <div class=\"mb-3 text-[13px] font-medium text-[#4A2A33]\" data-kid=\"1-3-1-2-2-1\" data-name=\"platform section step label\" id=\"platformLabel\">\n                        1. Select your store platform\n                    </div>\n                    <div aria-label=\"Store platform\" class=\"grid grid-cols-3 gap-1.5 rounded-full bg-[#F3EFEC] p-1.5\" data-kid=\"1-3-1-2-2-2\" data-name=\"platform selection tab bar\" role=\"tablist\">\n                        <button aria-selected=\"true\" class=\"platform-tab flex h-11 items-center justify-center gap-2 rounded-full bg-[#F8F38A] text-[13px] font-medium text-[#2A0B14] shadow-[0_2px_8px_rgba(42,11,20,0.08)]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"shopify platform tab\" data-platform=\"shopify\" data-reason=\"aria-selected and class rewritten by platform selection script on every render\" role=\"tab\">\n                            <span class=\"text-[16px]\" data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"tab icon wrapper\">\n                                <i class=\"ti ti-shopping-bag\" data-kid=\"1-3-1-2-2-2-1-1-1\" data-name=\"shopping bag icon\">\n                                </i>\n                            </span>\n                            Shopify\n             