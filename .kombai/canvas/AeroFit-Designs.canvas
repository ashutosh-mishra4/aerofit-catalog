    "inspiration_node_e70eb3854143": {
      "type": "variant",
      "id": "inspiration_node_e70eb3854143",
      "label": "POPH",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:18920/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/AeroFit-Designs.canvas\", nodeId: \"inspiration_node_e70eb3854143\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap\" rel=\"stylesheet\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n<style>\n    *,\n    *::before,\n    *::after {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    :root {\n      --orange: #FF6B1A;\n      --pink: #FF2D78;\n      --lime: #BFFF00;\n      --blue: #0057FF;\n      --off-white: #F5F0E8;\n      --black: #0D0D0D;\n    }\n\n    html {\n      scroll-behavior: auto;\n    }\n\n    body {\n      font-family: 'Space Grotesk', sans-serif;\n      background: var(--black);\n      overflow-x: hidden;\n    }\n\n    /* ── NAV ──────────────────────────────────── */\n    .main-nav {\n      position: fixed;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 200;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 1.75rem 3.5rem;\n      pointer-events: none;\n      background: transparent;\n      backdrop-filter: blur(0px);\n      -webkit-backdrop-filter: blur(0px);\n      border-bottom: 1px solid transparent;\n      transition: background 0.4s ease, backdrop-filter 0.4s ease,\n        -webkit-backdrop-filter 0.4s ease,\n        border-color 0.4s ease, padding 0.4s ease;\n    }\n\n    .main-nav.scrolled {\n      background: rgba(13, 13, 13, 0.45);\n      backdrop-filter: blur(20px) saturate(160%);\n      -webkit-backdrop-filter: blur(20px) saturate(160%);\n      border-bottom: 1px solid rgba(245, 240, 232, 0.08);\n      padding: 1rem 3.5rem;\n    }\n\n    .main-nav.scrolled .nav-logo,\n    .main-nav.scrolled .nav-links a {\n      color: var(--off-white) !important;\n    }\n\n    .nav-logo,\n    .nav-links a {\n      pointer-events: all;\n    }\n\n    .nav-logo {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 1.75rem;\n      letter-spacing: 0.1em;\n      text-decoration: none;\n      color: var(--off-white);\n      transition: color 0.35s ease;\n    }\n\n    .nav-links {\n      list-style: none;\n      display: flex;\n      gap: 2.5rem;\n    }\n\n    .nav-links a {\n      font-size: 0.72rem;\n      font-weight: 600;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      text-decoration: none;\n      color: var(--off-white);\n      transition: color 0.35s ease;\n    }\n\n    /* ── HERO ─────────────────────────────────── */\n    #hero {\n      position: relative;\n      width: 100%;\n      height: 100vh;\n      overflow: hidden;\n    }\n\n    .hero-slide {\n      position: absolute;\n      inset: 0;\n      will-change: transform;\n    }\n\n    .hero-slide:nth-child(1) {\n      background: var(--orange);\n      color: var(--black);\n      z-index: 1;\n    }\n\n    .hero-slide:nth-child(2) {\n      background: var(--pink);\n      color: var(--off-white);\n      z-index: 2;\n    }\n\n    .hero-slide:nth-child(3) {\n      background: var(--lime);\n      color: var(--black);\n      z-index: 3;\n    }\n\n    .hero-slide:nth-child(4) {\n      background: var(--blue);\n      color: var(--off-white);\n      z-index: 4;\n    }\n\n    .slide-image {\n      position: absolute;\n      inset: 0;\n      z-index: 1;\n    }\n\n    .slide-image img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      object-position: center top;\n      display: block;\n      will-change: transform;\n    }\n\n    .slide-text {\n      position: absolute;\n      left: 0;\n      top: 0;\n      bottom: 0;\n      width: 48%;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      padding: 7rem 3rem 4rem 5vw;\n      z-index: 2;\n    }\n\n    .text-reveal {\n      overflow: hidden;\n    }\n\n    .text-reveal+.text-reveal {\n      margin-top: 0.1em;\n    }\n\n    .slide-eyebrow {\n      display: block;\n      font-size: 0.68rem;\n      font-weight: 600;\n      letter-spacing: 0.38em;\n      text-transform: uppercase;\n      opacity: 0.55;\n      padding-bottom: 1.25rem;\n    }\n\n    .slide-brand {\n      display: block;\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(8rem, 19vw, 19rem);\n      line-height: 0.86;\n      letter-spacing: -0.01em;\n      padding-bottom: 1.75rem;\n    }\n\n    .slide-tagline {\n      display: block;\n      font-size: clamp(0.95rem, 1.5vw, 1.3rem);\n      font-weight: 500;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      line-height: 1.35;\n      padding-bottom: 3rem;\n    }\n\n    .slide-ctas {\n      display: flex;\n      align-items: center;\n      gap: 2.5rem;\n    }\n\n    .btn-primary {\n      display: inline-block;\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 0.75rem;\n      font-weight: 700;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      text-decoration: none;\n      color: inherit;\n      padding: 1.1rem 2.6rem;\n      border: 2px solid currentColor;\n      background: transparent;\n      transition: background 0.22s ease, color 0.22s ease;\n    }\n\n    .hero-slide:nth-child(1) .btn-primary:hover,\n    .hero-slide:nth-child(3) .btn-primary:hover {\n      background: var(--black);\n      color: var(--off-white);\n      border-color: var(--black);\n    }\n\n    .hero-slide:nth-child(2) .btn-primary:hover,\n    .hero-slide:nth-child(4) .btn-primary:hover {\n      background: var(--off-white);\n      color: var(--black);\n      border-color: var(--off-white);\n    }\n\n    .btn-secondary {\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 0.75rem;\n      font-weight: 700;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      text-decoration: none;\n      color: inherit;\n      border-bottom: 1.5px solid currentColor;\n      padding-bottom: 3px;\n      opacity: 0.7;\n      transition: opacity 0.2s ease;\n    }\n\n    .btn-secondary:hover {\n      opacity: 1;\n    }\n\n    .slide-num {\n      position: absolute;\n      bottom: 2.75rem;\n      left: 5vw;\n      z-index: 3;\n      font-size: 0.68rem;\n      font-weight: 600;\n      letter-spacing: 0.3em;\n      text-transform: uppercase;\n      opacity: 0.45;\n      color: inherit;\n    }\n\n    .scroll-hint {\n      position: absolute;\n      bottom: 2.5rem;\n      right: 5vw;\n      z-index: 3;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 0.75rem;\n      opacity: 0.4;\n      color: inherit;\n    }\n\n    .scroll-hint span {\n      font-size: 0.6rem;\n      font-weight: 600;\n      letter-spacing: 0.3em;\n      text-transform: uppercase;\n      writing-mode: vertical-rl;\n    }\n\n    .scroll-hint-line {\n      width: 1px;\n      height: 3.5rem;\n      background: currentColor;\n      transform-origin: top center;\n      animation: scrollDrop 1.6s ease-in-out infinite;\n    }\n\n    @keyframes scrollDrop {\n      0% {\n        transform: scaleY(0);\n        opacity: 0;\n        transform-origin: top center;\n      }\n\n      40% {\n        transform: scaleY(1);\n        opacity: 1;\n        transform-origin: top center;\n      }\n\n      60% {\n        transform: scaleY(1);\n        opacity: 1;\n        transform-origin: bottom center;\n      }\n\n      100% {\n        transform: scaleY(0);\n        opacity: 0;\n        transform-origin: bottom center;\n      }\n    }\n\n    .hero-dots {\n      position: fixed;\n      right: 2.5rem;\n      top: 50%;\n      transform: translateY(-50%);\n      z-index: 150;\n      display: flex;\n      flex-direction: column;\n      gap: 1rem;\n      transition: opacity 0.4s ease, visibility 0.4s ease;\n    }\n\n    .hero-dots.hidden {\n      opacity: 0;\n      visibility: hidden;\n      pointer-events: none;\n    }\n\n    .hero-dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: currentColor;\n      color: var(--off-white);\n      opacity: 0.25;\n      cursor: pointer;\n      transition: opacity 0.3s ease, transform 0.3s ease, color 0.35s ease;\n    }\n\n    .hero-dot.active {\n      opacity: 1;\n      transform: scale(1.5);\n    }\n\n    /* ── MARQUEE STRIP ────────────────────────── */\n    .marquee-strip {\n      background: var(--black);\n      overflow: hidden;\n      padding: 1.75rem 0;\n      border-top: 1px solid rgba(245, 240, 232, 0.07);\n    }\n\n    .marquee-track {\n      display: flex;\n      align-items: center;\n      gap: 3rem;\n      width: max-content;\n      animation: marqueeScroll 24s linear infinite;\n      will-change: transform;\n    }\n\n    .marquee-track span {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 2.2rem;\n      letter-spacing: 0.1em;\n      color: var(--off-white);\n      white-space: nowrap;\n    }\n\n    .m-sep {\n      font-size: 0.9rem !important;\n    }\n\n    .m-sep.orange {\n      color: var(--orange) !important;\n    }\n\n    .m-sep.pink {\n      color: var(--pink) !important;\n    }\n\n    .m-sep.lime {\n      color: var(--lime) !important;\n    }\n\n    .m-sep.blue {\n      color: var(--blue) !important;\n    }\n\n    @keyframes marqueeScroll {\n      from {\n        transform: translateX(0);\n      }\n\n      to {\n        transform: translateX(-50%);\n      }\n    }\n\n    /* ════════════════════════════════════════════════════════════════\n       COLLECTIONS — \"DROP SHEET\"\n       ════════════════════════════════════════════════════════════════ */\n    #collections {\n      background: var(--black);\n      padding: 8rem 0 0;\n      position: relative;\n    }\n\n    .collections-header {\n      padding: 0 5vw 5rem;\n      display: grid;\n      grid-template-columns: 1fr 1.5fr 1fr;\n      gap: 2rem;\n      align-items: end;\n    }\n\n    .collections-eyebrow {\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 0.7rem;\n      font-weight: 700;\n      letter-spacing: 0.35em;\n      text-transform: uppercase;\n      color: var(--lime);\n    }\n\n    .collections-eyebrow::before {\n      content: \"✦  \";\n      color: var(--pink);\n    }\n\n    .collections-title {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(4.5rem, 10vw, 12rem);\n      color: var(--off-white);\n      line-height: 0.86;\n      letter-spacing: -0.005em;\n    }\n\n    .collections-meta {\n      text-align: right;\n      display: flex;\n      align-items: baseline;\n      justify-content: flex-end;\n      gap: 1.25rem;\n    }\n\n    .collections-meta-num {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(3.5rem, 7vw, 8rem);\n      color: var(--orange);\n      line-height: 0.9;\n      letter-spacing: -0.02em;\n    }\n\n    .collections-meta-sub {\n      font-size: 0.65rem;\n      font-weight: 600;\n      letter-spacing: 0.28em;\n      text-transform: uppercase;\n      color: var(--off-white);\n      opacity: 0.55;\n      line-height: 1.5;\n      max-width: 6.5rem;\n    }\n\n    /* Strips */\n    .strips {\n      padding: 0 0 7rem;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .strip {\n      position: relative;\n      display: grid;\n      grid-template-columns: 60px 1fr 360px;\n      height: 340px;\n      overflow: hidden;\n      text-decoration: none;\n      background: var(--black);\n      border-top: 1px solid rgba(245, 240, 232, 0.08);\n      transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);\n    }\n\n    .strip:last-child {\n      border-bottom: 1px solid rgba(245, 240, 232, 0.08);\n    }\n\n    .strip:nth-child(even) {\n      margin-left: 4vw;\n    }\n\n    .strip:hover {\n      transform: translateX(4vw);\n    }\n\n    .strip:nth-child(even):hover {\n      transform: translateX(8vw);\n    }\n\n    .strip-bar {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      height: 6px;\n      background: var(--strip-color);\n      z-index: 5;\n      transform-origin: left center;\n      transform: scaleX(1);\n      transition: height 0.4s ease;\n    }\n\n    .strip:hover .strip-bar {\n      height: 12px;\n    }\n\n    .strip-rail {\n      grid-column: 1;\n      align-self: center;\n      justify-self: center;\n      writing-mode: vertical-rl;\n      transform: rotate(180deg);\n      font-size: 0.6rem;\n      font-weight: 600;\n      letter-spacing: 0.4em;\n      text-transform: uppercase;\n      color: var(--off-white);\n      opacity: 0.4;\n      white-space: nowrap;\n    }\n\n    .strip-num {\n      position: absolute;\n      top: 50%;\n      left: 5%;\n      transform: translateY(-50%);\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(18rem, 28vw, 28rem);\n      line-height: 0.78;\n      letter-spacing: -0.04em;\n      color: transparent;\n      -webkit-text-stroke: 2px var(--strip-color);\n      pointer-events: none;\n      z-index: 1;\n      white-space: nowrap;\n      user-select: none;\n      opacity: 0.9;\n    }\n\n    .strip-image {\n      grid-column: 2;\n      position: relative;\n      z-index: 2;\n      overflow: hidden;\n      margin-left: auto;\n      width: 92%;\n      max-width: 580px;\n      background: var(--strip-color);\n    }\n\n    .strip-image img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      object-position: center top;\n      transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);\n    }\n\n    .strip:hover .strip-image img {\n      transform: scale(1.05);\n    }\n\n    .strip-info {\n      grid-column: 3;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      padding: 2.5rem 2.5rem 2.25rem;\n      background: var(--strip-color);\n      color: var(--black);\n      position: relative;\n      z-index: 3;\n    }\n\n    .strip--pink .strip-info,\n    .strip--blue .strip-info {\n      color: var(--off-white);\n    }\n\n    .strip-info-top {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      gap: 1rem;\n    }\n\n    .strip-name {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(2.4rem, 3.5vw, 3.6rem);\n      letter-spacing: 0.02em;\n      line-height: 0.88;\n    }\n\n    .strip-tag {\n      font-size: 0.55rem;\n      font-weight: 700;\n      letter-spacing: 0.3em;\n      text-transform: uppercase;\n      border: 1.5px solid currentColor;\n      padding: 0.35rem 0.7rem;\n      align-self: flex-start;\n      margin-top: 0.4rem;\n    }\n\n    .strip-spec {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 0.45rem;\n      margin-top: 1.25rem;\n    }\n\n    .strip-spec li {\n      font-size: 0.62rem;\n      font-weight: 600;\n      letter-spacing: 0.26em;\n      text-transform: uppercase;\n      position: relative;\n      padding-left: 1.4rem;\n    }\n\n    .strip-spec li::before {\n      content: \"—\";\n      position: absolute;\n      left: 0;\n      opacity: 0.6;\n    }\n\n    .strip-foot {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n    }\n\n    .strip-price {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 2.4rem;\n      line-height: 0.9;\n      letter-spacing: 0.02em;\n    }\n\n    .strip-cta {\n      font-size: 0.65rem;\n      font-weight: 700;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      border-bottom: 1.5px solid currentColor;\n      padding-bottom: 2px;\n      transform: translateX(-6px);\n      opacity: 0.7;\n      transition: opacity 0.35s ease, transform 0.35s ease;\n    }\n\n    .strip:hover .strip-cta {\n      opacity: 1;\n      transform: translateX(0);\n    }\n\n    .collections-footer {\n      padding: 3.5rem 5vw;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-top: 1px solid rgba(245, 240, 232, 0.07);\n    }\n\n    .collections-footer-label {\n      font-size: 0.7rem;\n      font-weight: 600;\n      letter-spacing: 0.28em;\n      text-transform: uppercase;\n      color: var(--off-white);\n      opacity: 0.45;\n    }\n\n    .collections-footer-link {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 1.6rem;\n      letter-spacing: 0.1em;\n      color: var(--off-white);\n      text-decoration: none;\n      display: flex;\n      align-items: center;\n      gap: 1rem;\n      transition: gap 0.3s ease, color 0.3s ease;\n    }\n\n    .collections-footer-link:hover {\n      gap: 1.8rem;\n      color: var(--lime);\n    }\n\n    /* ════════════════════════════════════════════════════════════════\n       THE CRAFT — \"SCROLL-HIJACK SPEC SHEET\" (3 stages, pinned)\n       ════════════════════════════════════════════════════════════════ */\n    #craft {\n      position: relative;\n      background: var(--black);\n    }\n\n    .craft-frame {\n      position: relative;\n      height: 100vh;\n      overflow: hidden;\n      background: var(--black);\n    }\n\n    /* Persistent overlay (eyebrow + tiny headline) */\n    .craft-overlay-top {\n      position: absolute;\n      top: 4.5rem;\n      left: 5vw;\n      right: 5vw;\n      z-index: 10;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      pointer-events: none;\n      mix-blend-mode: difference;\n      color: var(--off-white);\n    }\n\n    .craft-eyebrow {\n      font-size: 0.66rem;\n      font-weight: 700;\n      letter-spacing: 0.36em;\n      text-transform: uppercase;\n    }\n\n    .craft-eyebrow::before {\n      content: \"✦  \";\n    }\n\n    .craft-overlay-title {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 1.4rem;\n      letter-spacing: 0.12em;\n    }\n\n    /* Progress dots (01 / 02 / 03 stacked) */\n    .craft-progress {\n      position: absolute;\n      top: 50%;\n      right: 3vw;\n      transform: translateY(-50%);\n      z-index: 10;\n      display: flex;\n      flex-direction: column;\n      gap: 1.1rem;\n      pointer-events: none;\n      mix-blend-mode: difference;\n      color: var(--off-white);\n    }\n\n    .craft-progress-dot {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 1.2rem;\n      letter-spacing: 0.16em;\n      opacity: 0.35;\n      transition: opacity 0.35s ease, transform 0.35s ease;\n      position: relative;\n      padding-right: 2.2rem;\n    }\n\n    .craft-progress-dot::after {\n      content: \"\";\n      position: absolute;\n      right: 0;\n      top: 50%;\n      width: 1.5rem;\n      height: 1.5px;\n      background: currentColor;\n      transform: translateY(-50%) scaleX(0.3);\n      transform-origin: right center;\n      transition: transform 0.35s ease;\n    }\n\n    .craft-progress-dot.active {\n      opacity: 1;\n      transform: translateX(-6px);\n    }\n\n    .craft-progress-dot.active::after {\n      transform: translateY(-50%) scaleX(1);\n    }\n\n    /* Stages container */\n    .craft-stages {\n      position: absolute;\n      inset: 0;\n      z-index: 1;\n    }\n\n    .craft-stage {\n      position: absolute;\n      inset: 0;\n      padding: 9rem 5vw 6rem;\n      will-change: transform;\n      overflow: hidden;\n    }\n\n    .stage-01 {\n      background: var(--lime);\n      color: var(--black);\n    }\n\n    .stage-02 {\n      background: var(--orange);\n      color: var(--black);\n    }\n\n    .stage-03 {\n      background: var(--blue);\n      color: var(--off-white);\n    }\n\n    /* MASSIVE numeral (top-left of each stage) */\n    .stage-no {\n      position: absolute;\n      top: 8vh;\n      left: 4vw;\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(10rem, 26vw, 30rem);\n      line-height: 0.8;\n      letter-spacing: -0.04em;\n      z-index: 2;\n      pointer-events: none;\n    }\n\n    .stage-no .of {\n      font-size: 0.18em;\n      vertical-align: top;\n      margin-left: 0.25em;\n      opacity: 0.55;\n      letter-spacing: 0.05em;\n    }\n\n    .stage-03 .stage-no {\n      color: transparent;\n      -webkit-text-stroke: 2.5px var(--off-white);\n    }\n\n    /* Body (spec name + desc + tag) — right half */\n    .stage-body {\n      position: absolute;\n      right: 8vw;\n      top: 50%;\n      transform: translateY(-50%);\n      max-width: 38ch;\n      z-index: 3;\n    }\n\n    .stage-name {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(3rem, 6.5vw, 7rem);\n      line-height: 0.86;\n      letter-spacing: 0.01em;\n      margin-bottom: 1.5rem;\n    }\n\n    .stage-desc {\n      font-size: clamp(1rem, 1.15vw, 1.2rem);\n      line-height: 1.55;\n      margin-bottom: 2rem;\n      max-width: 32ch;\n    }\n\n    .stage-tag {\n      display: inline-block;\n      font-size: 0.65rem;\n      font-weight: 700;\n      letter-spacing: 0.3em;\n      text-transform: uppercase;\n      border: 1.5px solid currentColor;\n      padding: 0.6rem 1.1rem;\n    }\n\n    /* STAGE 01 — wavelength bars */\n    .graphic-wavelength {\n      position: absolute;\n      bottom: 8rem;\n      left: 4vw;\n      width: 40vw;\n      max-width: 540px;\n      display: flex;\n      align-items: flex-end;\n      gap: 14px;\n      height: 110px;\n      z-index: 2;\n    }\n\n    .graphic-wavelength span {\n      flex: 1;\n      background: var(--black);\n      transform-origin: bottom;\n      transform: scaleY(0.12);\n      transition: transform 0.5s cubic-bezier(0.22, 0.8, 0.36, 1);\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(1) {\n      transform: scaleY(0.42);\n      transition-delay: 0.10s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(2) {\n      transform: scaleY(0.68);\n      transition-delay: 0.18s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(3) {\n      transform: scaleY(0.52);\n      transition-delay: 0.26s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(4) {\n      transform: scaleY(0.94);\n      transition-delay: 0.34s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(5) {\n      transform: scaleY(0.58);\n      transition-delay: 0.42s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(6) {\n      transform: scaleY(0.78);\n      transition-delay: 0.50s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(7) {\n      transform: scaleY(0.48);\n      transition-delay: 0.58s;\n    }\n\n    .craft-stage.stage-active .graphic-wavelength span:nth-child(8) {\n      transform: scaleY(0.85);\n      transition-delay: 0.66s;\n    }\n\n    /* STAGE 02 — radial 400nm gauge (SVG arc) */\n    .graphic-gauge {\n      position: absolute;\n      left: 4vw;\n      bottom: 7rem;\n      width: 240px;\n      height: 240px;\n      z-index: 2;\n    }\n\n    .gauge-arc-bg,\n    .gauge-arc-fg {\n      fill: none;\n      stroke-width: 12;\n    }\n\n    .gauge-arc-bg {\n      stroke: rgba(13, 13, 13, 0.18);\n    }\n\n    .gauge-arc-fg {\n      stroke: var(--black);\n      stroke-dasharray: 264;\n      stroke-dashoffset: 264;\n      transition: stroke-dashoffset 1.2s cubic-bezier(0.22, 0.8, 0.36, 1);\n    }\n\n    .craft-stage.stage-active .gauge-arc-fg {\n      stroke-dashoffset: 26;\n    }\n\n    .gauge-label {\n      font-family: 'Bebas Neue', sans-serif;\n      fill: var(--black);\n    }\n\n    .gauge-label-num {\n      font-size: 24px;\n      letter-spacing: 0.02em;\n    }\n\n    .gauge-label-unit {\n      font-size: 12px;\n      opacity: 0.6;\n      letter-spacing: 0.18em;\n    }\n\n    /* STAGE 03 — weight comparison list */\n    .graphic-list {\n      position: absolute;\n      left: 4vw;\n      bottom: 7rem;\n      width: 340px;\n      max-width: 38vw;\n      z-index: 2;\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 0.7rem;\n    }\n\n    .graphic-list li {\n      font-size: 0.78rem;\n      font-weight: 500;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      padding-bottom: 0.65rem;\n      border-bottom: 1px solid rgba(245, 240, 232, 0.22);\n      opacity: 0;\n      transform: translateX(24px);\n      transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 0.8, 0.36, 1);\n    }\n\n    .graphic-list li strong {\n      font-family: 'Bebas Neue', sans-serif;\n      font-weight: 400;\n      font-size: 1.5rem;\n      letter-spacing: 0.04em;\n    }\n\n    .craft-stage.stage-active .graphic-list li {\n      opacity: 1;\n      transform: translateX(0);\n    }\n\n    .craft-stage.stage-active .graphic-list li:nth-child(1) {\n      transition-delay: 0.18s;\n    }\n\n    .craft-stage.stage-active .graphic-list li:nth-child(2) {\n      transition-delay: 0.30s;\n    }\n\n    .craft-stage.stage-active .graphic-list li:nth-child(3) {\n      transition-delay: 0.42s;\n    }\n\n    .craft-stage.stage-active .graphic-list li:nth-child(4) {\n      transition-delay: 0.54s;\n    }\n\n    /* Persistent pink ticker at bottom of frame */\n    .craft-ticker {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      background: var(--pink);\n      color: var(--off-white);\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      height: 56px;\n      z-index: 5;\n    }\n\n    .craft-ticker-track {\n      display: flex;\n      gap: 2.5rem;\n      width: max-content;\n      animation: marqueeScroll 22s linear infinite;\n      white-space: nowrap;\n    }\n\n    .craft-ticker-track span {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 1.5rem;\n      letter-spacing: 0.12em;\n    }\n\n    .craft-ticker-track .dot {\n      font-size: 0.7rem;\n      align-self: center;\n      opacity: 0.7;\n    }\n\n    /* ════════════════════════════════════════════════════════════════\n       CTA — \"TYPE COLLISION\"\n       ════════════════════════════════════════════════════════════════ */\n    #cta {\n      position: relative;\n      background: var(--black);\n      min-height: 100vh;\n      overflow: hidden;\n      padding: 6rem 5vw;\n    }\n\n    .cta-word {\n      position: absolute;\n      font-family: 'Bebas Neue', sans-serif;\n      line-height: 0.86;\n      letter-spacing: -0.01em;\n      white-space: nowrap;\n      pointer-events: none;\n      will-change: transform, opacity;\n    }\n\n    .cta-word--1 {\n      top: 10vh;\n      left: 6vw;\n      font-size: clamp(3.5rem, 9vw, 10rem);\n      color: var(--off-white);\n      transform: rotate(-4deg);\n    }\n\n    .cta-word--2 {\n      top: 20vh;\n      right: 6vw;\n      font-size: clamp(4.5rem, 11vw, 12.5rem);\n      color: var(--pink);\n      transform: rotate(3deg);\n    }\n\n    .cta-word--3 {\n      top: 46vh;\n      left: 4vw;\n      font-size: clamp(6rem, 16vw, 18rem);\n      color: transparent;\n      -webkit-text-stroke: 2.5px var(--lime);\n      transform: rotate(-2deg);\n    }\n\n    .cta-word--4 {\n      bottom: 4vh;\n      left: 50%;\n      font-size: clamp(7rem, 20vw, 24rem);\n      color: var(--orange);\n      transform: translateX(-50%) rotate(1deg);\n    }\n\n    .cta-star {\n      position: absolute;\n      bottom: -16vw;\n      right: -8vw;\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: 36vw;\n      line-height: 1;\n      color: transparent;\n      -webkit-text-stroke: 1.5px rgba(245, 240, 232, 0.12);\n      pointer-events: none;\n      user-select: none;\n      animation: starSpin 30s linear infinite;\n    }\n\n    @keyframes starSpin {\n      from {\n        transform: rotate(0deg);\n      }\n\n      to {\n        transform: rotate(360deg);\n      }\n    }\n\n    .cta-eyebrow {\n      position: absolute;\n      top: 3rem;\n      left: 50%;\n      transform: translateX(-50%);\n      font-size: 0.65rem;\n      font-weight: 700;\n      letter-spacing: 0.4em;\n      text-transform: uppercase;\n      color: var(--off-white);\n      opacity: 0.5;\n    }\n\n    .cta-eyebrow::before {\n      content: \"✦  \";\n      color: var(--lime);\n    }\n\n    .cta-eyebrow::after {\n      content: \"  ✦\";\n      color: var(--pink);\n    }\n\n    .cta-sticker {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      display: inline-block;\n      padding: 1.4rem 3.2rem;\n      background: var(--lime);\n      color: var(--black);\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 0.9rem;\n      font-weight: 700;\n      letter-spacing: 0.24em;\n      text-transform: uppercase;\n      text-decoration: none;\n      z-index: 20;\n      animation: stickerWobble 4s ease-in-out infinite;\n      box-shadow: 0 8px 0 var(--black);\n      clip-path: polygon(2% 12%, 8% 0%, 18% 10%, 28% 0%, 40% 8%, 52% 0%, 64% 10%, 76% 0%, 88% 8%, 100% 6%,\n          96% 22%, 100% 40%, 94% 58%, 100% 72%, 96% 90%, 90% 100%, 76% 92%, 62% 100%, 48% 90%, 34% 100%, 20% 92%, 8% 100%, 0% 86%,\n          4% 68%, 0% 50%, 6% 32%, 0% 18%);\n    }\n\n    @keyframes stickerWobble {\n      0% {\n        transform: translate(-50%, -50%) rotate(-6deg);\n      }\n\n      50% {\n        transform: translate(-50%, -50%) rotate(-3deg);\n      }\n\n      100% {\n        transform: translate(-50%, -50%) rotate(-6deg);\n      }\n    }\n\n    .cta-sticker .arrow {\n      display: inline-block;\n      margin-left: 0.7rem;\n      transform: translateY(-1px);\n    }\n\n    .cta-foot {\n      position: absolute;\n      bottom: 1.75rem;\n      left: 5vw;\n      right: 5vw;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      font-size: 0.6rem;\n      font-weight: 600;\n      letter-spacing: 0.3em;\n      text-transform: uppercase;\n      color: var(--off-white);\n      opacity: 0.4;\n      z-index: 5;\n    }\n\n    /* ════════════════════════════════════════════════════════════════\n       FOOTER — \"BACK COVER\"\n       ════════════════════════════════════════════════════════════════ */\n    #footer {\n      background: var(--black);\n      position: relative;\n      overflow: hidden;\n    }\n\n    .footer-colophon {\n      padding: 1.4rem 5vw;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-top: 1px solid rgba(245, 240, 232, 0.1);\n      border-bottom: 1px solid rgba(245, 240, 232, 0.1);\n      font-size: 0.6rem;\n      font-weight: 700;\n      letter-spacing: 0.34em;\n      text-transform: uppercase;\n      color: var(--off-white);\n      opacity: 0.55;\n    }\n\n    .footer-colophon .dot {\n      color: var(--lime);\n      margin: 0 0.6em;\n    }\n\n    .footer-colophon .dot.pink {\n      color: var(--pink);\n    }\n\n    .footer-colophon .dot.orange {\n      color: var(--orange);\n    }\n\n    .footer-coupon-wrap {\n      padding: 5rem 5vw 4rem;\n    }\n\n    .footer-coupon {\n      position: relative;\n      background: var(--off-white);\n      color: var(--black);\n      padding: 3rem 3.5rem 2.5rem;\n      transform: rotate(-0.7deg);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 3rem;\n      box-shadow: 0 12px 0 rgba(13, 13, 13, 0.85);\n    }\n\n    .footer-coupon::before {\n      content: \"\";\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      height: 2px;\n      background-image: repeating-linear-gradient(to right,\n          var(--black) 0 14px,\n          transparent 14px 24px);\n    }\n\n    .footer-coupon::after {\n      content: \"✂\";\n      position: absolute;\n      top: -14px;\n      left: 36px;\n      width: 28px;\n      height: 28px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: var(--off-white);\n      color: var(--black);\n      font-size: 1rem;\n      transform: rotate(-12deg);\n    }\n\n    .footer-coupon-label {\n      font-family: 'Bebas Neue', sans-serif;\n      font-size: clamp(2.2rem, 4.5vw, 4.5rem);\n      line-height: 0.9;\n      letter-spacing: 0.005em;\n    }\n\n    .footer-coupon-label em {\n      font-style: normal;\n      color: var(--pink);\n    }\n\n    .footer-coupon-sub {\n      display: block;\n      margin-top: 0.85rem;\n      font-size: 0.7rem;\n      font-weight: 600;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      color: var(--black);\n      opacity: 0.55;\n    }\n\n    .footer-coupon-form {\n      display: flex;\n      flex: 0 0 46%;\n      max-width: 480px;\n    }\n\n    .footer-coupon-input {\n      flex: 1;\n      background: transparent;\n      border: 1.5px solid var(--black);\n      border-right: none;\n      padding: 1rem 1.5rem;\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 0.82rem;\n      color: var(--black);\n      outline: none;\n      transition: background 0.2s ease;\n    }\n\n    .footer-coupon-input::placeholder {\n      color: rgba(13, 13, 13, 0.4);\n    }\n\n    .footer-coupon-input:focus {\n      background: rgba(13, 13, 13, 0.05);\n    }\n\n    .footer-coupon-btn {\n      background: var(--black);\n      color: var(--off-white);\n      border: 1.5px solid var(--black);\n      padding: 1rem 1.75rem;\n      font-family: 'Space Grotesk', sans-serif;\n      font-size: 0.7rem;\n      font-weight: 700;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      cursor: pointer;\n      white-space: nowrap;\n      transition: background 0.2s ease, color 0.2s ease;\n    }\n\n    .footer-coupon-btn:hover {\n     