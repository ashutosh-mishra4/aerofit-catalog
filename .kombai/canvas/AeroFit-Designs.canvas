    },
    "var_2916d6536bd8": {
      "type": "variant",
      "label": "Aero Fit Catalog — Editorial Field Guide",
      "parentId": "var_73acb2a35486",
      "themeId": null,
      "rect": {
        "x": 578,
        "y": 7933,
        "w": 1564,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n\n.starshape{clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);}\n.sparkle{clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%);}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip py-5\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Product bar -->\n<div class=\"mx-4 h-[68px] rounded-full bg-white shadow-[0_4px_18px_rgba(42,11,20,0.06)] border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-1\" data-name=\"product top navigation bar\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-1-1\" data-name=\"brand and nav links group\">\n<span class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-1-1-1\" data-name=\"site logo with wordmark\">\n<img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-1-1-1\" data-name=\"Aero Fit logo mark icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n                Aero Fit\n            </span>\n<div class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-1-1-2\" data-name=\"primary navigation pills\">\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-2-1\" data-name=\"Overview navigation pill\" href=\"#\">\n                    Overview\n                </a>\n<a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-1-1-2-2\" data-name=\"How it works navigation pill\" href=\"#\">\n                    How it works\n                </a>\n<a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-1-1-2-3\" data-name=\"Shop bands navigation pill (active)\" href=\"#\">\n                    Shop bands\n                </a>\n</div>\n</div>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"header actions group\">\n<button class=\"h-[52px] pl-5 pr-2 rounded-full border border-[#EFEAE6] bg-white text-[14px] font-medium flex items-center gap-2 hover:bg-[#F3EFEC] transition\" data-kid=\"1-1-2-1\" data-name=\"cart button with badge\">\n<span class=\"text-[18px] flex\" data-kid=\"1-1-2-1-1\" data-name=\"shopping bag icon wrapper\">\n<i class=\"ti ti-shopping-bag\" data-kid=\"1-1-2-1-1-1\" data-name=\"shopping bag icon\">\n</i>\n</span>\n                Cart\n                <span class=\"min-w-9 h-9 px-2 rounded-full bg-[#F3EFEC] text-[13px] flex items-center justify-center\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"cart item count badge\" data-reason=\"count text and background color replaced by script on add-to-cart\" id=\"cartCount\">\n                    0\n                </span>\n</button>\n<button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-1-2-2\" data-name=\"join free call-to-action button\">\n                Join Aero Fit free\n            </button>\n</div>\n</div>\n<!-- Hero scene -->\n<section class=\"mx-4 mt-5 h-[680px] overflow-hidden relative\" data-kid=\"1-2\" data-name=\"hero zoom slider section\" id=\"zoomHero\">\n<h1 class=\"absolute z-20 left-0 right-0 top-[40px] text-center serif text-[64px] leading-[1.05] font-medium tracking-[-0.022em]\" data-kid=\"1-2-1\" data-name=\"hero headline\">Built for the long way round.</h1>\n<div class=\"absolute z-20 pointer-events-none\" data-dynamic=\"true\" data-kid=\"1-2-3\" data-name=\"active band label\" data-reason=\"text and position replaced by slider script\" id=\"zhLabel\">\n<p class=\"text-[15px] font-semibold tracking-[0.08em] uppercase\" data-kid=\"1-2-3-2\" id=\"zhName\">Aero Fit Pro</p>\n<p class=\"mt-0.5 text-[13px] text-[#4A2A33]\" data-kid=\"1-2-3-3\" id=\"zhLine\">Built-in GPS and ECG · $279</p>\n</div>\n<div class=\"absolute inset-0\" data-dynamic=\"true\" data-kid=\"1-2-4\" data-name=\"zoom slider track\" data-reason=\"tiles rendered and positioned by slider script\" id=\"zhTrack\"></div>\n</section>\n<!-- Shop for -->\n<section class=\"max-w-[1248px] mx-auto px-4 pt-24\" data-kid=\"1-3\" data-name=\"shop-for section\">\n<div class=\"flex items-end justify-between gap-10\" data-kid=\"1-3-1\" data-name=\"shop-for section header\">\n<h2 class=\"serif text-[46px] leading-[1.08] font-medium tracking-[-0.01em] max-w-[560px]\" data-kid=\"1-3-1-1\" data-name=\"shop-for section heading\">\n                Which band belongs in your day?\n            </h2>\n<p class=\"text-[15px] leading-[1.6] text-[#4A2A33] max-w-[400px]\" data-kid=\"1-3-1-2\" data-name=\"shop-for section intro text\">\n                Pick what you do most. We'll point out the bands that suit it in the lineup and comparison below.\n            </p>\n</div>\n<div class=\"mt-10 grid grid-cols-4 gap-4\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"shop for use-case card grid\" data-reason=\"children rendered by script from USE data (innerHTML assigned on load and on click)\" id=\"shopFor\"><button class=\"text-left group\" data-act=\"use\" data-kid=\"1-3-2-1\" data-use=\"sleep\">\n<div class=\"h-[330px] rounded-[20px] overflow-hidden\" data-kid=\"1-3-2-1-1\"><img alt=\"Hand reaching for the bedside in morning light, photo by cottonbro studio on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6963181/pexels-photo-6963181.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600&amp;q=80\"/></div>\n<div class=\"mt-4 flex items-center justify-between\" data-kid=\"1-3-2-1-2\"><p class=\"serif text-[24px] font-medium\" data-kid=\"1-3-2-1-2-1\">Shop for sleep</p><span class=\"w-9 h-9 rounded-full flex items-center justify-center text-[16px] transition bg-[#F3EFEC] group-hover:bg-[#ECE6E2]\" data-kid=\"1-3-2-1-2-2\"><i class=\"ti ti-arrow-down\" data-kid=\"1-3-2-1-2-2-1\"></i></span></div>\n<p class=\"mt-1 text-[14px] text-[#4A2A33]\" data-kid=\"1-3-2-1-3\">Lite and Smart suit this best</p></button><button class=\"text-left group\" data-act=\"use\" data-kid=\"1-3-2-2\" data-use=\"training\">\n<div class=\"h-[330px] rounded-[20px] overflow-hidden\" data-kid=\"1-3-2-2-1\"><img alt=\"Man training on a forest path, photo by Alex Gagareen on Unsplash\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1630254608294-d844a0242357?auto=format&amp;w=600&amp;q=80&amp;fit=crop\"/></div>\n<div class=\"mt-4 flex items-center justify-between\" data-kid=\"1-3-2-2-2\"><p class=\"serif text-[24px] font-medium\" data-kid=\"1-3-2-2-2-1\">Shop for training</p><span class=\"w-9 h-9 rounded-full flex items-center justify-center text-[16px] transition bg-[#F3EFEC] group-hover:bg-[#ECE6E2]\" data-kid=\"1-3-2-2-2-2\"><i class=\"ti ti-arrow-down\" data-kid=\"1-3-2-2-2-2-1\"></i></span></div>\n<p class=\"mt-1 text-[14px] text-[#4A2A33]\" data-kid=\"1-3-2-2-3\">Pro and Ultra suit this best</p></button><button class=\"text-left group\" data-act=\"use\" data-kid=\"1-3-2-3\" data-use=\"music\">\n<div class=\"h-[330px] rounded-[20px] overflow-hidden\" data-kid=\"1-3-2-3-1\"><img alt=\"Woman walking with headphones, photo by Fatih Güney on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-3-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18823179/pexels-photo-18823179.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600&amp;q=80\"/></div>\n<div class=\"mt-4 flex items-center justify-between\" data-kid=\"1-3-2-3-2\"><p class=\"serif text-[24px] font-medium\" data-kid=\"1-3-2-3-2-1\">Shop for music</p><span class=\"w-9 h-9 rounded-full flex items-center justify-center text-[16px] transition bg-[#F3EFEC] group-hover:bg-[#ECE6E2]\" data-kid=\"1-3-2-3-2-2\"><i class=\"ti ti-arrow-down\" data-kid=\"1-3-2-3-2-2-1\"></i></span></div>\n<p class=\"mt-1 text-[14px] text-[#4A2A33]\" data-kid=\"1-3-2-3-3\">Music and Pro suit this best</p></button><button class=\"text-left group\" data-act=\"use\" data-kid=\"1-3-2-4\" data-use=\"endurance\">\n<div class=\"h-[330px] rounded-[20px] overflow-hidden ring-2 ring-offset-4 ring-offset-[#FAF8F6] ring-[#2A0B14]\" data-kid=\"1-3-2-4-1\"><img alt=\"Hiker resting on a mountain ridge, photo by Haroon Khalid on Unsplash\" class=\"w-full h-full object-cover\" data-kid=\"1-3-2-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1745692607831-66df9207b8bc?auto=format&amp;w=600&amp;q=80&amp;fit=crop\"/></div>\n<div class=\"mt-4 flex items-center justify-between\" data-kid=\"1-3-2-4-2\"><p class=\"serif text-[24px] font-medium\" data-kid=\"1-3-2-4-2-1\">Shop for endurance</p><span class=\"w-9 h-9 rounded-full flex items-center justify-center text-[16px] transition bg-[#2A0B14] text-white\" data-kid=\"1-3-2-4-2-2\"><i class=\"ti ti-arrow-down\" data-kid=\"1-3-2-4-2-2-1\"></i></span></div>\n<p class=\"mt-1 text-[14px] text-[#4A2A33]\" data-kid=\"1-3-2-4-3\">Ultra and Pro suit this best</p></button></div>\n</section>\n<!-- Lineup -->\n<section class=\"max-w-[1248px] mx-auto px-4 pt-28\" data-kid=\"1-4\" data-name=\"lineup section\" id=\"lineup\">\n<div class=\"flex items-end justify-between gap-10\" data-kid=\"1-4-1\" data-name=\"lineup section header\">\n<div data-kid=\"1-4-1-1\" data-name=\"lineup heading group\">\n<h2 class=\"serif text-[46px] leading-[1.08] font-medium tracking-[-0.01em]\" data-kid=\"1-4-1-1-1\" data-name=\"lineup section heading\">\n                    Five bands, one app\n                </h2>\n<p class=\"mt-3 text-[15px] leading-[1.6] text-[#4A2A33] max-w-[540px]\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2\" data-name=\"lineup mode note text\" data-reason=\"text replaced by render() based on purchase mode\" id=\"lineNote\">Every band runs the same Aero Fit app, coaching and Recovery scores. Buy one outright and add a membership any time.</p>\n</div>\n<div class=\"flex flex-col items-end gap-3\" data-kid=\"1-4-1-2\" data-name=\"lineup controls column\">\n<div class=\"h-12 p-1 rounded-full bg-white border border-[#EFEAE6] flex text-[14px] font-medium\" data-kid=\"1-4-1-2-1\" data-name=\"buy mode toggle group\">\n<button class=\"modeBtn h-10 px-5 rounded-full transition bg-[#2A0B14] text-white\" data-act=\"mode\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-1\" data-mode=\"out\" data-name=\"buy outright toggle button\" data-reason=\"active class styling set by script based on mode state\">\n                        Buy outright\n                    </button>\n<button class=\"modeBtn h-10 px-5 rounded-full transition hover:bg-[#F3EFEC]\" data-act=\"mode\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1-2\" data-mode=\"mem\" data-name=\"with membership toggle button\" data-reason=\"active class styling set by script based on mode state\">\n                        With membership\n                    </button>\n</div>\n<div class=\"hidden items-center gap-2 text-[13px]\" data-dynamic=\"true\" data-kid=\"1-4-1-2-2\" data-name=\"plan selector row\" data-reason=\"children and visibility rendered by script based on selected plan and mode\" id=\"planRow\"><span class=\"text-[#6B4F57] mr-1\" data-kid=\"1-4-1-2-2-1\">Plan</span><button class=\"h-9 px-3.5 rounded-full border transition border-[#E3DDDA] hover:bg-white\" data-act=\"plan\" data-kid=\"1-4-1-2-2-2\" data-plan=\"1\">One · $199/yr</button><button class=\"h-9 px-3.5 rounded-full border transition border-[#2A0B14] bg-white font-medium\" data-act=\"plan\" data-kid=\"1-4-1-2-2-3\" data-plan=\"2\">Peak · $299/yr</button><button class=\"h-9 px-3.5 rounded-full border transition border-[#E3DDDA] hover:bg-white\" data-act=\"plan\" data-kid=\"1-4-1-2-2-4\" data-plan=\"3\">Life · $399/yr</button></div>\n</div>\n</div>\n<div class=\"mt-10 grid grid-cols-3 gap-4 items-start\" data-dynamic=\"true\" data-kid=\"1-4-2\" data-name=\"band product card grid\" data-reason=\"children rendered by script from product data (innerHTML assigned on load and on click)\" id=\"grid\"><article class=\"col-span-2 rounded-[28px] bg-[#F3EDE9] p-5 grid grid-cols-[1fr_340px] gap-7\" data-kid=\"1-4-2-1\">\n<div class=\"relative rounded-[20px] bg-[radial-gradient(circle_at_50%_55%,#F8F38A_0%,#FBF4B8_40%,#F4F1EE_78%)] flex items-center justify-center min-h-[460px]\" data-kid=\"1-4-2-1-1\"><img alt=\"Aero Fit Ultra in Titanium\" class=\"w-[360px] h-[360px] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" data-kid=\"1-4-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg\"/><span class=\"absolute left-3 top-3 text-[12px] font-medium bg-white rounded-full px-2.5 py-1\" data-kid=\"1-4-2-1-1-2\">Ships Nov 4</span><span class=\"absolute left-3 bottom-3 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-2.5 py-1\" data-kid=\"1-4-2-1-1-3\">Good for endurance</span></div>\n<div class=\"py-3 pr-2 flex flex-col\" data-kid=\"1-4-2-1-2\">\n<h3 class=\"serif text-[38px] leading-[1.05] font-medium\" data-kid=\"1-4-2-1-2-1\">Aero Fit Ultra</h3>\n<p class=\"mt-3 text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"1-4-2-1-2-2\">Titanium case, dual-band GPS and 14 days of battery for multi-day races and long training blocks.</p>\n<dl class=\"mt-6 grid grid-cols-3 gap-3\" data-kid=\"1-4-2-1-2-3\"><div data-kid=\"1-4-2-1-2-3-1\"><dd class=\"text-[18px] font-semibold\" data-kid=\"1-4-2-1-2-3-1-1\">14 days</dd><dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-4-2-1-2-3-1-2\">Battery</dt></div><div data-kid=\"1-4-2-1-2-3-2\"><dd class=\"text-[18px] font-semibold\" data-kid=\"1-4-2-1-2-3-2-1\">100 m</dd><dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-4-2-1-2-3-2-2\">Water</dt></div><div data-kid=\"1-4-2-1-2-3-3\"><dd class=\"text-[18px] font-semibold\" data-kid=\"1-4-2-1-2-3-3-1\">Dual-band</dd><dt class=\"text-[13px] text-[#6B4F57]\" data-kid=\"1-4-2-1-2-3-3-2\">GPS</dt></div></dl>\n<div class=\"mt-auto\" data-kid=\"1-4-2-1-2-4\"><div class=\"mt-5 rounded-[18px] bg-[#FAF8F6] border border-[#F0EBE8] p-4\" data-kid=\"1-4-2-1-2-4-1\">\n<div class=\"flex items-start justify-between gap-3\" data-kid=\"1-4-2-1-2-4-1-1\"><div data-kid=\"1-4-2-1-2-4-1-1-1\"><p class=\"text-[28px] font-semibold leading-none\" data-kid=\"1-4-2-1-2-4-1-1-1-1\">$399</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\" data-kid=\"1-4-2-1-2-4-1-1-1-2\">One-time · free returns</p></div>\n<div class=\"text-right\" data-kid=\"1-4-2-1-2-4-1-1-2\"><div class=\"flex gap-1 justify-end\" data-kid=\"1-4-2-1-2-4-1-1-2-1\"><button aria-label=\"Titanium\" class=\"w-7 h-7 rounded-full p-[3px] border-2 border-[#2A0B14]\" data-act=\"color\" data-i=\"0\" data-id=\"ultra\" data-kid=\"1-4-2-1-2-4-1-1-2-1-1\"><span class=\"block w-full h-full rounded-full\" data-kid=\"1-4-2-1-2-4-1-1-2-1-1-1\" style=\"background:#8B8A87\"></span></button><button aria-label=\"Black\" class=\"w-7 h-7 rounded-full p-[3px] border-2 border-transparent\" data-act=\"color\" data-i=\"1\" data-id=\"ultra\" data-kid=\"1-4-2-1-2-4-1-1-2-1-2\"><span class=\"block w-full h-full rounded-full\" data-kid=\"1-4-2-1-2-4-1-1-2-1-2-1\" style=\"background:#1F1F1F\"></span></button><button aria-label=\"Trail\" class=\"w-7 h-7 rounded-full p-[3px] border-2 border-transparent\" data-act=\"color\" data-i=\"2\" data-id=\"ultra\" data-kid=\"1-4-2-1-2-4-1-1-2-1-3\"><span class=\"block w-full h-full rounded-full\" data-kid=\"1-4-2-1-2-4-1-1-2-1-3-1\" style=\"background:#6B7B4E\"></span></button></div><p class=\"mt-1 text-[13px] text-[#6B4F57]\" data-kid=\"1-4-2-1-2