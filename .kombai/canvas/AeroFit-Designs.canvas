d-full bg-[#2A0B14] text-[18px] text-[#F8F38A]\" data-kid=\"1-2-1-1\" data-name=\"brand logo icon circle\">\n                <i class=\"ti ti-trending-up\" data-kid=\"1-2-1-1-1\" data-name=\"trending arrow brand icon\">\n                </i>\n            </span>\n            <span class=\"serif text-[24px] font-medium tracking-tight\" data-kid=\"1-2-1-2\" data-name=\"brand name text\">\n                Convertly\n            </span>\n        </div>\n        <nav aria-label=\"Setup progress\" class=\"flex items-center gap-3 text-[13px] font-medium\" data-kid=\"1-2-2\" data-name=\"setup progress step indicator bar\">\n            <span class=\"flex h-10 items-center gap-2 rounded-full bg-[#F3EFEC] pl-1.5 pr-4 text-[#4A2A33]\" data-kid=\"1-2-2-1\" data-name=\"completed Store Setup step pill\">\n                <span class=\"grid size-7 place-items-center rounded-full bg-[#D2F6E6] text-[14px] text-[#1E7A52]\" data-kid=\"1-2-2-1-1\" data-name=\"completed step check circle\">\n                    <i class=\"ti ti-check\" data-kid=\"1-2-2-1-1-1\" data-name=\"checkmark icon\">\n                    </i>\n                </span>\n                Store Setup\n            </span>\n            <span class=\"h-px w-8 bg-[#D9D0CB]\" data-kid=\"1-2-2-2\" data-name=\"step connector divider\">\n            </span>\n            <span aria-current=\"step\" class=\"flex h-10 items-center gap-2 rounded-full bg-[#F8F38A] pl-1.5 pr-4\" data-kid=\"1-2-2-3\" data-name=\"active Plan step pill\">\n                <span class=\"grid size-7 place-items-center rounded-full bg-[#2A0B14] text-[12px] text-white\" data-kid=\"1-2-2-3-1\" data-name=\"active step number badge\">\n                    2\n                </span>\n                Plan\n            </span>\n            <span class=\"h-px w-8 bg-[#EFEAE6]\" data-kid=\"1-2-2-4\" data-name=\"step connector divider\">\n            </span>\n            <span class=\"flex h-10 items-center gap-2 rounded-full pl-1.5 pr-4 text-[#9A8E91]\" data-kid=\"1-2-2-5\" data-name=\"inactive Payment step pill\">\n                <span class=\"grid size-7 place-items-center rounded-full border border-[#EFEAE6] text-[12px]\" data-kid=\"1-2-2-5-1\" data-name=\"inactive step number badge\">\n                    3\n                </span>\n                Payment\n            </span>\n        </nav>\n        <div class=\"justify-self-end text-[12px] text-[#6B4F57]\" data-kid=\"1-2-3\" data-name=\"step counter text\">\n            Step 2 of 3\n        </div>\n    </header>\n    <main class=\"relative mx-auto w-[1200px] pt-12\" data-kid=\"1-3\" data-name=\"main content area\">\n        <section class=\"flex items-end justify-between gap-8\" data-kid=\"1-3-1\" data-name=\"hero header section\">\n            <div data-kid=\"1-3-1-1\" data-name=\"hero heading block\">\n                <h1 class=\"serif text-[52px] font-medium leading-[1.08] tracking-[-0.015em]\" data-kid=\"1-3-1-1-1\" data-name=\"hero heading text\">\n                    Choose how far you want to grow.\n                </h1>\n                <p class=\"mt-3 text-[15px] leading-[1.55] text-[#4A2A33]\" data-kid=\"1-3-1-1-2\" data-name=\"hero supporting subtitle text\">\n                    Start with clear store intelligence, or let Convertly continuously optimize performance for you.\n                </p>\n            </div>\n            <div aria-label=\"Billing frequency\" class=\"flex items-center gap-1 rounded-full border border-[#EFEAE6] bg-white p-1 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"1-3-1-2\" data-name=\"billing frequency toggle group\">\n                <button class=\"bill-btn h-9 rounded-full bg-[#2A0B14] px-4 text-[12px] font-medium text-white\" data-billing=\"monthly\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1\" data-name=\"Monthly billing toggle button\" data-reason=\"className rewritten by render script to reflect active billing state\">\n                    Monthly\n                </button>\n                <button class=\"bill-btn h-9 rounded-full px-4 text-[12px] font-medium text-[#6B4F57] hover:bg-[#F3EFEC]\" data-billing=\"annual\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2\" data-name=\"Annual billing toggle button\" data-reason=\"className rewritten by render script to reflect active billing state\">\n                    Annually\n                </button>\n                <span class=\"mr-1 rounded-full bg-[#F8F38A] px-2.5 py-1 text-[11px] font-medium\" data-kid=\"1-3-1-2-3\" data-name=\"save 20% discount badge\">\n                    Save 20%\n                </span>\n            </div>\n        </section>\n        <div class=\"mt-9 grid grid-cols-[minmax(0,1fr)_340px] items-stretch gap-7\" data-kid=\"1-3-2\" data-name=\"form main two-column layout\">\n            <section data-kid=\"1-3-2-1\" data-name=\"storefront and plan selection section\">\n                <h2 class=\"mb-3 text-[14px] font-medium\" data-kid=\"1-3-2-1-1\" data-name=\"storefront selection heading\">\n                    Which storefronts should we optimize?\n                </h2>\n                <div aria-label=\"Storefront selection\" class=\"grid grid-cols-[1fr_1fr_1.16fr] gap-2.5\" data-kid=\"1-3-2-1-2\" data-name=\"storefront radio group\" role=\"radiogroup\">\n                    <button aria-checked=\"true\" class=\"platform flex min-h-[68px] items-center gap-3 rounded-[18px] border border-transparent bg-[#F8F38A] py-3.5 pl-3.5 pr-4 text-left shadow-[0_6px_18px_rgba(42,11,20,0.08)]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-1\" data-name=\"Shopify storefront selection radio button\" data-platform=\"shopify\" data-reason=\"className and aria-checked rewritten by render script to reflect selected platform state\" role=\"radio\">\n                        <span class=\"p-icon grid size-9 shrink-0 place-items-center rounded-full bg-white/80 text-[17px] text-[#2A0B14]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"Shopify circular platform icon wrapper\" data-reason=\"className swapped by render script based on selected state\">\n                            <i class=\"ti ti-shopping-bag\" data-kid=\"1-3-2-1-2-1-1-1\" data-name=\"shopping bag icon\">\n                            </i>\n                        </span>\n                        <span class=\"flex flex-col gap-0.5 text-left\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"Shopify label and price block\">\n                            <span class=\"text-[13px] font-medium\" data-kid=\"1-3-2-1-2-1-2-1\" data-name=\"Shopify platform label\">\n                                Shopify\n                            </span>\n                            <span class=\"p-price text-[11px] text-[#4A2A33]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-1-2-2\" data-name=\"Shopify storefront starting price\" data-reason=\"className swapped by render script based on selected state\">\n                                From $1,000 / month\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-checked=\"false\" class=\"platform flex min-h-[68px] items-center gap-3 rounded-[18px] border border-[#EFEAE6] bg-white py-3.5 pl-3.5 pr-4 text-left transition hover:border-[#D9D0CB]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2\" data-name=\"WooCommerce storefront selection radio button\" data-platform=\"woocommerce\" data-reason=\"className and aria-checked rewritten by render script to reflect selected platform state\" role=\"radio\">\n                        <span class=\"p-icon grid size-9 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[17px] text-[#4A2A33]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"WooCommerce circular platform icon wrapper\" data-reason=\"className swapped by render script based on selected state\">\n                            <i class=\"ti ti-building-store\" data-kid=\"1-3-2-1-2-2-1-1\" data-name=\"storefront building icon\">\n                            </i>\n                        </span>\n                        <span class=\"flex flex-col gap-0.5 text-left\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"WooCommerce label and price block\">\n                            <span class=\"text-[13px] font-medium\" data-kid=\"1-3-2-1-2-2-2-1\" data-name=\"WooCommerce platform label\">\n                                WooCommerce\n                            </span>\n                            <span class=\"p-price text-[11px] text-[#9A8E91]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2-2-2\" data-name=\"WooCommerce storefront starting price\" data-reason=\"className swapped by render script based on selected state\">\n                                From $1,000 / month\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-checked=\"false\" class=\"platform flex min-h-[68px] items-center gap-3 rounded-[18px] border border-[#EFEAE6] bg-white py-3.5 pl-3.5 pr-4 text-left transition hover:border-[#D9D0CB]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3\" data-name=\"Both (bundled) storefront selection radio button\" data-platform=\"both\" data-reason=\"className and aria-checked rewritten by render script to reflect selected platform state\" role=\"radio\">\n                        <span class=\"p-icon grid size-9 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[17px] text-[#4A2A33]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3-1\" data-name=\"Bundled storefronts circular platform icon wrapper\" data-reason=\"className swapped by render script based on selected state\">\n                            <i class=\"ti ti-layout-columns\" data-kid=\"1-3-2-1-2-3-1-1\" data-name=\"columns layout icon\">\n                            </i>\n                        </span>\n                        <span class=\"flex flex-col gap-0.5 text-left\" data-kid=\"1-3-2-1-2-3-2\" data-name=\"Bundled label and price block\">\n                            <span class=\"flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-3-2-1-2-3-2-1\" data-name=\"Both platform label with badge\">\n                                Both\n                                <span class=\"rounded-full bg-[#2A0B14] px-1.5 py-0.5 text-[9px] font-medium text-white\" data-kid=\"1-3-2-1-2-3-2-1-1\" data-name=\"save 10% discount badge\">\n                                    Save 10%\n                                </span>\n                            </span>\n                            <span class=\"p-price text-[11px] text-[#9A8E91]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-3-2-2\" data-name=\"Bundled storefronts starting price\" data-reason=\"className swapped by render script based on selected state\">\n                                From $1,800 / month\n                            </span>\n                        </span>\n                    </button>\n                </div>\n                <div aria-label=\"Plan selection\" class=\"mt-6 grid grid-cols-2 gap-5\" data-kid=\"1-3-2-1-3\" data-name=\"plan selection radio group\" role=\"radiogroup\">\n                    <button aria-checked=\"false\" class=\"plan-card relative flex min-h-[430px] flex-col rounded-[26px] border-[1.5px] border-[#EFEAE6] bg-white p-6 text-left transition hover:border-[#D9D0CB]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-1\" data-name=\"Analytics pricing plan card\" data-plan=\"analytics\" data-reason=\"className and radio innerHTML rewritten by render script for selected plan state\" role=\"radio\">\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-3-2-1-3-1-1\" data-name=\"Analytics plan header row\">\n                            <span class=\"plan-icon grid size-10 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[19px] text-[#4A2A33]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-1-1-1\" data-name=\"Analytics plan circular icon wrapper\" data-reason=\"className swapped by render script based on selected plan state\">\n                                <i class=\"ti ti-chart-bar\" data-kid=\"1-3-2-1-3-1-1-1-1\" data-name=\"bar chart icon\">\n                                </i>\n                            </span>\n                            <span class=\"serif text-[28px] font-medium leading-none tracking-[-0.01em]\" data-kid=\"1-3-2-1-3-1-1-2\" data-name=\"Analytics plan title\">\n                                Analytics\n                            </span>\n                            <span class=\"radio ml-auto size-5 rounded-full border-[1.5px] border-[#D9D0CB] bg-white\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-1-1-3\" data-name=\"Analytics plan radio selection indicator\" data-reason=\"className and innerHTML rewritten by render script for selected plan state\">\n                            </span>\n                        </span>\n                        <span class=\"mt-4 block min-h-[44px] text-[13px] leading-[1.6] text-[#6B4F57]\" data-kid=\"1-3-2-1-3-1-2\" data-name=\"Analytics plan description text\">\n                            Find revenue leaks and know exactly where your storefront can improve.\n                        </span>\n                        <span class=\"mt-4 flex items-baseline gap-1.5\" data-kid=\"1-3-2-1-3-1-3\" data-name=\"Analytics plan price row\">\n                            <strong class=\"text-[42px] font-semibold leading-none tracking-[-0.025em]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-1-3-1\" data-name=\"Analytics plan monthly price\" data-reason=\"text replaced by render script with computed platform/billing price\" id=\"analyticsPrice\">\n                                $1,000\n                            </strong>\n                            <span class=\"text-[12px] text-[#6B4F57]\" data-kid=\"1-3-2-1-3-1-3-2\" data-name=\"per-month price suffix\">\n                                / month\n                            </span>\n                        </span>\n                        <span class=\"mt-1.5 block text-[11px] text-[#6B4F57]\" data-dynamic=\"true\" data-kid=\"