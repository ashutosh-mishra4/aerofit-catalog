      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.fadeimg{-webkit-mask-image:linear-gradient(180deg,#000 55%,transparent);mask-image:linear-gradient(180deg,#000 55%,transparent);}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-hidden\" data-kid=\"1\" style=\"padding-left: 0px; padding-right: 0px; margin: 20px 0px;\">\n    <!-- Global nav -->\n    <!-- Product bar -->\n    <div class=\"mx-4 h-[68px] rounded-full bg-white shadow-[0_4px_18px_rgba(42,11,20,0.06)] border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-kid=\"1-2\" style=\"padding-top: 0px;\">\n        <div class=\"flex items-center gap-6\" data-kid=\"1-2-1\">\n            <span class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-2-1-1\">\n                <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-2-1-1-1\" data-name=\"Aero Fit logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\">\n                Aero Fit\n            </span>\n            <div class=\"flex gap-2 text-[14px] font-medium\" data-kid=\"1-2-1-2\">\n                <a class=\"h-10 px-4 rounded-full bg-[#F8F38A] flex items-center\" data-kid=\"1-2-1-2-1\" href=\"#\">\n                    Overview\n                </a>\n                <a class=\"h-10 px-4 rounded-full bg-[#F3EFEC] flex items-center hover:bg-[#ECE6E2] transition\" data-kid=\"1-2-1-2-2\" href=\"#\">\n                    How it works\n                </a>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-5\" data-kid=\"1-2-2\">\n            <div class=\"text-right leading-tight\" data-kid=\"1-2-2-1\">\n                <p class=\"text-[14px] font-medium\" data-kid=\"1-2-2-1-1\">\n                    Know What Your Body Needs?\n                </p>\n                <p class=\"text-[12px] text-[#6B4F57]\" data-kid=\"1-2-2-1-2\">\n                    Start your\n                    <span class=\"underline underline-offset-2\" data-kid=\"1-2-2-1-2-1\">\n                        1-Month Aero Fit Free Trial\n                    </span>\n                    today\n                </p>\n            </div>\n            <button class=\"h-[52px] px-6 rounded-full bg-[#2A0B14] text-white text-[15px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-2-2-2\">\n                Join Aero Fit free\n            </button>\n        </div>\n    </div>\n    <!-- Hero split card -->\n    <section class=\"mx-4 mt-5 h-[600px] rounded-[28px] bg-[#F3EDE9] overflow-hidden grid grid-cols-[560px_1fr]\" data-kid=\"1-3\">\n        <div class=\"pl-[96px] pr-10 flex flex-col justify-center\" data-kid=\"1-3-1\">\n            <p class=\"text-[15px] font-medium\" data-kid=\"1-3-1-1\">\n                Sleep • Strain • Recovery • Healthspan\n            </p>\n            <h1 class=\"serif mt-4 text-[56px] leading-[1.06] font-medium tracking-[-0.015em]\" data-kid=\"1-3-1-2\">\n                Know What Your Body Needs, Every Single Day\n            </h1>\n            <p class=\"mt-5 text-[16px] leading-[1.55] text-[#4A2A33] max-w-[420px]\" data-kid=\"1-3-1-3\">\n                Aero Fit turns 24/7 health insights into personalized coaching to help you sleep, train, and feel better wherever life takes you.\n            </p>\n            <p class=\"mt-6 text-[15px] text-[#4A2A33]\" data-kid=\"1-3-1-4\">\n                Logged over\n                <span class=\"inline-block bg-[#2A0B14] text-white rounded-full px-2 py-0.5 text-[13px] font-medium\" data-kid=\"1-3-1-4-1\">\n                    12M\n                </span>\n                workouts last week\n            </p>\n            <div class=\"mt-6 flex gap-2\" data-kid=\"1-3-1-5\">\n                <button class=\"h-11 px-5 rounded-full bg-[#F8F38A] text-[14px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-3-1-5-1\">\n                    Try Aero Fit for free\n                </button>\n                <button class=\"h-11 px-5 rounded-full border border-[#D9D0CB] bg-white text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-3-1-5-2\">\n                    Join Now\n                </button>\n            </div>\n        </div>\n        <div class=\"relative\" data-kid=\"1-3-2\">\n            <img alt=\"Two friends laughing and high-fiving after a forest trail run, both wearing Aero Fit bands\" class=\"w-full h-full object-cover object-[85%_center]\" data-kid=\"1-3-2-1\" data-name=\"hero athlete photo\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/65ac1bc7a57c4d3bb3773cee4236749d.png\">\n            <div class=\"absolute left-6 bottom-6 w-[275px] bg-white/90 backdrop-blur-md rounded-[18px] p-3 shadow-[0_14px_40px_rgba(42,11,20,0.16)]\" data-kid=\"1-3-2-3\">\n                <p class=\"text-[11px] text-[#6B4F57] px-1 mb-2\" data-kid=\"1-3-2-3-1\">\n                    Your performance team\n                </p>\n                <div class=\"space-y-1.5\" data-kid=\"1-3-2-3-2\">\n                    <div class=\"flex items-center gap-2.5 bg-[#FAF8F6] rounded-[10px] p-1.5\" data-kid=\"1-3-2-3-2-1\">\n                        <img alt=\"Coach Amelia Carter\" class=\"w-8 h-8 rounded-lg object-cover\" data-kid=\"1-3-2-3-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/477df3f011ae43f3abe4c0cf588a828b.jpg\">\n                        <span class=\"text-[12px] font-medium flex-1\" data-kid=\"1-3-2-3-2-1-2\">\n                            Coach Amelia Carter\n                        </span>\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#2BB673] mr-1.5\" data-kid=\"1-3-2-3-2-1-3\">\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2.5 bg-[#FAF8F6] rounded-[10px] p-1.5\" data-kid=\"1-3-2-3-2-2\">\n                        <img alt=\"Dr. Daniel Morgan\" class=\"w-8 h-8 rounded-lg object-cover\" data-kid=\"1-3-2-3-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/b55145485cc54ff08d9f99147f426b26.jpg\">\n                        <span class=\"text-[12px] font-medium flex-1\" data-kid=\"1-3-2-3-2-2-2\">\n                            Dr. Daniel Morgan · Sleep\n                        </span>\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#2BB673] mr-1.5\" data-kid=\"1-3-2-3-2-2-3\">\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2.5 bg-[#FAF8F6] rounded-[10px] p-1.5\" data-kid=\"1-3-2-3-2-3\">\n                        <img alt=\"Sophia Bennett\" class=\"w-8 h-8 rounded-lg object-cover\" data-kid=\"1-3-2-3-2-3-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/082d9c34332646e7b8af0a283c122907.jpg\">\n                        <span class=\"text-[12px] font-medium flex-1\" data-kid=\"1-3-2-3-2-3-2\">\n                            Sophia Bennett · Recovery\n                        </span>\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#D6CFCC] mr-1.5\" data-kid=\"1-3-2-3-2-3-3\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Promo strip -->\n    <div class=\"mx-4 mt-4 rounded-[22px] bg-[#F8F38A] px-7 py-4 flex items-center gap-5\" data-kid=\"1-4\">\n        <div class=\"flex -space-x-2.5\" data-kid=\"1-4-1\">\n            <img alt=\"Member avatar\" class=\"w-9 h-9 rounded-full border-2 border-[#F8F38A] object-cover\" data-kid=\"1-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=whoop-ashlynn\">\n            <img alt=\"Member avatar\" class=\"w-9 h-9 rounded-full border-2 border-[#F8F38A] object-cover\" data-kid=\"1-4-1-2\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=whoop-samatha\">\n            <img alt=\"Member avatar\" class=\"w-9 h-9 rounded-full border-2 border-[#F8F38A] object-cover\" data-kid=\"1-4-1-3\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=whoop-ellie\">\n            <span class=\"w-9 h-9 rounded-full border-2 border-[#F8F38A] bg-[#2A0B14] text-white text-[10px] font-medium flex items-center justify-center\" data-kid=\"1-4-1-4\">\n                5M+\n            </span>\n        </div>\n        <div class=\"leading-tight\" data-kid=\"1-4-2\">\n            <p class=\"text-[16px] font-medium flex items-center gap-2\" data-kid=\"1-4-2-1\">\n                4.8\n                <span class=\"text-[#E8920F] tracking-[2px] text-[15px]\" data-kid=\"1-4-2-1-1\">\n                    ★★★★\n                    <span class=\"bg-[linear-gradient(90deg,#E8920F_60%,#C9C27A_60%)] bg-clip-text text-transparent\" data-kid=\"1-4-2-1-1-1\">\n                        ★\n                    </span>\n                </span>\n                Member Satisfaction\n            </p>\n            <p class=\"text-[13px] text-[#4A2A33] mt-0.5\" data-kid=\"1-4-2-2\">\n                Join over 5M members logging 12M+ workouts every week.\n            </p>\n        </div>\n    </div>\n    <!-- Collage -->\n    <section class=\"pt-28 pb-24\" data-kid=\"1-5\">\n        <div class=\"text-center\" data-kid=\"1-5-1\">\n            <h2 class=\"serif text-[52px] leading-[1.1] font-medium tracking-[-0.015em]\" data-kid=\"1-5-1-1\">\n                Everything Your Body Needs,\n                <br data