    "node_48045682db46": {
      "html": "<script data-asset-crawler=\"\">\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19229/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/AeroFit-Designs.canvas\", nodeId: \"node_48045682db46\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><script src=\"https://unpkg.com/@tailwindcss/browser@4.3.3/dist/index.global.js\" integrity=\"sha384-2ql948lIdLcGEE0/qxNiudyTjgauA3RDJERu5xW75kFCvSl5a9odyQYCb6tEjnmB\" crossorigin=\"anonymous\"></script>\n<script src=\"https://unpkg.com/lenis@1.1.13/dist/lenis.min.js\"></script>\n<style type=\"text/tailwindcss\">\n    @theme {\n      --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n      --font-serif: \"Source Serif 4\", ui-serif, Georgia, serif;\n\n      --text-display: 64px;\n      --text-display--line-height: 1.02;\n      --text-display--letter-spacing: -0.02em;\n      --text-heading: 46px;\n      --text-heading--line-height: 1.08;\n      --text-heading--letter-spacing: -0.01em;\n      --text-heading-sm: 44px;\n      --text-heading-sm--line-height: 1.08;\n      --text-heading-sm--letter-spacing: -0.01em;\n\n      --color-canvas: #faf8f6;\n      --color-ink: #2a0b14;\n      --color-ink-hover: #45172a;\n      --color-ink-soft: #4a2a33;\n      --color-muted: #6b4f57;\n      --color-subtle: #7a5b64;\n      --color-placeholder: #9a8e91;\n      --color-disabled: #c9c0c2;\n      --color-line: #efeae6;\n      --color-line-soft: #f3efec;\n      --color-line-strong: #e3ddda;\n      --color-panel-line: #f0ebe8;\n      --color-chip: #f3efec;\n      --color-chip-hover: #ece6e2;\n      --color-sand: #f3ede9;\n      --color-tile: #f4f1ee;\n      --color-accent: #f8f38a;\n      --color-accent-hover: #f2eb6a;\n      --color-accent-pale: #fbf4b8;\n      --color-highlight: #fbf7c8;\n\n      --radius-thumb: 16px;\n      --radius-panel: 18px;\n      --radius-tile: 20px;\n      --radius-float: 22px;\n      --radius-card: 24px;\n      --radius-section: 28px;\n\n      --shadow-nav: 0 4px 18px rgb(42 11 20 / 0.06);\n      --shadow-soft: 0 4px 18px rgb(42 11 20 / 0.05);\n      --shadow-float: 0 14px 40px rgb(42 11 20 / 0.16);\n\n      --container-page: 1248px;\n\n      --ease-out-soft: cubic-bezier(0.2, 0.7, 0.2, 1);\n      --animate-hero-zoom: hero-zoom 1.8s var(--ease-out-soft) both;\n\n      @keyframes hero-zoom {\n        from { transform: scale(1.08); }\n        to { transform: scale(1); }\n      }\n    }\n\n    @utility bg-hero-fade {\n      background-image: linear-gradient(90deg, rgb(250 248 246 / 0.96) 0%, rgb(250 248 246 / 0.82) 30%, rgb(250 248 246 / 0) 58%);\n    }\n    @utility bg-glow-thumb {\n      background-image: radial-gradient(circle, var(--color-accent) 0%, var(--color-accent-pale) 45%, var(--color-tile) 80%);\n    }\n    @utility bg-glow-feature {\n      background-image: radial-gradient(circle at 50% 55%, var(--color-accent) 0%, var(--color-accent-pale) 40%, var(--color-tile) 78%);\n    }\n\n    @layer base {\n      body { @apply bg-canvas font-sans text-ink antialiased; }\n      button { cursor: pointer; }\n      h1, h2, h3 { text-wrap: balance; }\n    }\n\n    @layer components {\n      .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s var(--ease-out-soft), transform .7s var(--ease-out-soft); transition-delay: var(--reveal-delay, 0ms); }\n      .reveal[data-visible='true'] { opacity: 1; transform: none; }\n    }\n  </style>\n<style>\n    /* Lenis smooth scroll (replaces html { scroll-behavior: smooth } on this page). */\n    html.lenis, html.lenis body { height: auto; }\n    .lenis.lenis-smooth { scroll-behavior: auto !important; }\n    .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }\n\n    .no-scrollbar { scrollbar-width: none; }\n    .starshape { clip-path: polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%); }\n    .sparkle { clip-path: polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%); }\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    [data-scrub] { will-change: transform, opacity; }\n\n    /* Section-level design notes, toggled from the bottom-left button. */\n    .note { display: none; }\n    body.show-notes .note { display: flex; }\n\n    /* Reduced motion: no pinning, everything shown in its end state. */\n    html.rm .pin-wrap { height: auto !important; }\n    html.rm .pin-stage { position: relative !important; }\n    html.rm .stack-block { position: relative !important; top: auto !important; transform: none !important; }\n    html.rm .reveal { opacity: 1; transform: none; transition: none; }\n  </style>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&amp;family=Inter:wght@400;500;600&amp;display=swap\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"1\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"2\">\n\n<div class=\"overflow-x-clip py-5\" data-kid=\"3\">\n\n  <!-- NAV — same markup as Navbar.tsx; only change is sticky + frosted. -->\n  <header id=\"nav\" class=\"sticky top-3 z-50 mx-4 flex h-[68px] items-center justify-between rounded-full border border-line bg-white/85 pr-2 pl-7 shadow-nav backdrop-blur-md transition-[background-color]\" data-kid=\"3-1\">\n    <div class=\"flex items-center gap-6\" data-kid=\"3-1-1\">\n      <a href=\"#\" class=\"flex items-center gap-2 whitespace-nowrap\" aria-label=\"Aero Fit home\" data-kid=\"3-1-1-1\">\n        <img loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\" decoding=\"async\" alt=\"\" class=\"size-8\" data-kid=\"3-1-1-1-1\">\n        <span class=\"font-serif text-[22px] font-medium tracking-tight\" data-kid=\"3-1-1-1-2\">Aero Fit</span>\n      </a>\n      <nav aria-label=\"Primary\" class=\"hidden gap-2 text-[14px] font-medium md:flex\" data-kid=\"3-1-1-2\">\n        <a href=\"#\" aria-current=\"page\" class=\"flex h-10 items-center rounded-full bg-accent px-4\" data-kid=\"3-1-1-2-1\">Overview</a>\n        <a href=\"#\" class=\"flex h-10 items-center rounded-full bg-chip px-4 transition hover:bg-chip-hover\" data-kid=\"3-1-1-2-2\">How it works</a>\n        <a href=\"#\" class=\"flex h-10 items-center rounded-full bg-chip px-4 transition hover:bg-chip-hover\" data-kid=\"3-1-1-2-3\">Shop bands</a>\n      </nav>\n    </div>\n    <div class=\"flex items-center gap-2\" data-kid=\"3-1-2\">\n      <button type=\"button\" class=\"flex h-[52px] items-center gap-2 rounded-full border border-line bg-white pr-2 pl-5 text-[14px] font-medium transition hover:bg-chip\" data-kid=\"3-1-2-1\">\n        <i class=\"ti ti-shopping-bag text-[18px]\" aria-hidden=\"true\" data-kid=\"3-1-2-1-1\"></i> Cart\n        <span class=\"flex h-9 min-w-9 items-center justify-center rounded-full bg-chip px-2 text-[13px]\" data-kid=\"3-1-2-1-2\">0</span>\n      </button>\n      <a href=\"#\" class=\"hidden h-[52px] items-center justify-center rounded-full bg-ink px-6 text-[15px] font-medium whitespace-nowrap text-white transition hover:bg-ink-hover sm:inline-flex\" data-kid=\"3-1-2-2\">Join Aero Fit free</a>\n    </div>\n  </header>\n\n  <main data-kid=\"3-2\">\n\n    <!-- ============ 1. HERO ============ -->\n    <section id=\"hero\" class=\"relative mx-4 mt-5 h-[calc(100svh-108px)] min-h-[600px] max-h-[860px] overflow-hidden rounded-section\" data-kid=\"3-2-1\" style=\"clip-path: inset(0px round 28px);\">\n      \n      <div class=\"absolute inset-0 animate-hero-zoom\" data-kid=\"3-2-1-2\">\n        <img decoding=\"async\" loading=\"lazy\" id=\"heroImg\" data-scrub=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/ff20317377ff42e99355401aec31e474.jpg\" alt=\"Woman stretching on a coastal road at sunrise wearing an Aero Fit band\" class=\"size-full object-cover object-[70%_center]\" fetchpriority=\"high\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-1-2-1\" style=\"transform: translate3d(0px, 0%, 0px) scale(1);\">\n      </div>\n      <div aria-hidden=\"true\" class=\"absolute inset-0 bg-hero-fade\" data-kid=\"3-2-1-3\"></div>\n\n      <div id=\"heroCopy\" data-scrub=\"\" class=\"relative flex h-full max-w-[720px] flex-col justify-end pb-14 pl-8 pr-6 lg:pb-[88px] lg:pl-[96px]\" data-kid=\"3-2-1-4\" style=\"transform: translate3d(0px, 0px, 0px); opacity: 1;\">\n        \n        <h1 class=\"reveal mt-6 font-serif text-[44px] leading-[1.02] font-medium tracking-[-0.02em] lg:text-display\" style=\"--reveal-delay:100ms\" data-kid=\"3-2-1-4-2\" data-visible=\"true\">Know what your body<br data-kid=\"3-2-1-4-2-1\">is ready for today.</h1>\n        <p class=\"reveal mt-5 max-w-[460px] text-[17px] leading-[1.55] text-ink-soft\" style=\"--reveal-delay:200ms\" data-kid=\"3-2-1-4-3\" data-visible=\"true\">Aero Fit bands read your sleep, heart and effort around the clock. Each morning the app gives you one call: push, hold steady or recover.</p>\n        <div class=\"reveal mt-7 flex flex-wrap items-center gap-5\" style=\"--reveal-delay:300ms\" data-kid=\"3-2-1-4-4\" data-visible=\"true\">\n          <a href=\"#\" class=\"inline-flex h-11 items-center rounded-full bg-ink px-5 text-[14px] font-medium text-white transition hover:bg-ink-hover\" data-kid=\"3-2-1-4-4-1\">See how membership works</a>\n          <a href=\"#bands\" class=\"text-[14px] font-medium underline underline-offset-4 transition hover:opacity-70\" data-kid=\"3-2-1-4-4-2\">Shop the five bands</a>\n        </div>\n      </div>\n\n      <div id=\"heroCard\" data-scrub=\"\" class=\"absolute right-6 bottom-6 hidden md:block\" data-kid=\"3-2-1-5\" style=\"transform: translate3d(0px, 0px, 0px);\">\n        <div class=\"reveal w-[340px] rounded-float bg-white/92 p-5 shadow-float backdrop-blur-md\" style=\"--reveal-delay:450ms\" role=\"img\" aria-label=\"Example morning readout: Recovery 82%\" data-kid=\"3-2-1-5-1\" data-visible=\"true\">\n          <div class=\"flex items-end justify-between\" data-kid=\"3-2-1-5-1-1\">\n            <div data-kid=\"3-2-1-5-1-1-1\"><p class=\"text-[13px] text-muted\" data-kid=\"3-2-1-5-1-1-1-1\">This morning</p><p class=\"font-serif text-[22px] leading-tight font-medium\" data-kid=\"3-2-1-5-1-1-1-2\">Recovery</p></div>\n            <p class=\"text-[40px] leading-none font-semibold\" data-kid=\"3-2-1-5-1-1-2\">82%</p>\n          </div>\n          <dl class=\"mt-5 space-y-3\" data-kid=\"3-2-1-5-1-2\">\n            <div class=\"grid grid-cols-[84px_1fr_auto] items-center gap-3 text-[13px]\" data-kid=\"3-2-1-5-1-2-1\"><dt class=\"text-muted\" data-kid=\"3-2-1-5-1-2-1-1\">Sleep</dt><div class=\"h-1.5 overflow-hidden rounded-full bg-chip\" data-kid=\"3-2-1-5-1-2-1-2\"><div class=\"h-full w-[86%] rounded-full bg-ink\" data-kid=\"3-2-1-5-1-2-1-2-1\"></div></div><dd class=\"font-medium\" data-kid=\"3-2-1-5-1-2-1-3\">7h 42m</dd></div>\n            <div class=\"grid grid-cols-[84px_1fr_auto] items-center gap-3 text-[13px]\" data-kid=\"3-2-1-5-1-2-2\"><dt class=\"text-muted\" data-kid=\"3-2-1-5-1-2-2-1\">HRV</dt><div class=\"h-1.5 overflow-hidden rounded-full bg-chip\" data-kid=\"3-2-1-5-1-2-2-2\"><div class=\"h-full w-[72%] rounded-full bg-ink\" data-kid=\"3-2-1-5-1-2-2-2-1\"></div></div><dd class=\"font-medium\" data-kid=\"3-2-1-5-1-2-2-3\">64 ms</dd></div>\n            <div class=\"grid grid-cols-[84px_1fr_auto] items-center gap-3 text-[13px]\" data-kid=\"3-2-1-5-1-2-3\"><dt class=\"text-muted\" data-kid=\"3-2-1-5-1-2-3-1\">Resting HR</dt><div class=\"h-1.5 overflow-hidden rounded-full bg-chip\" data-kid=\"3-2-1-5-1-2-3-2\"><div class=\"h-full w-[64%] rounded-full bg-ink\" data-kid=\"3-2-1-5-1-2-3-2-1\"></div></div><dd class=\"font-medium\" data-kid=\"3-2-1-5-1-2-3-3\">52 bpm</dd></div>\n          </dl>\n          <p class=\"mt-5 inline-flex rounded-full bg-accent px-3 py-1 text-[13px] font-medium\" data-kid=\"3-2-1-5-1-3\">Green light for intervals</p>\n        </div>\n      </div>\n    </section>\n\n\n    <!-- ============ 2. SIGNAL COLLAGE (pinned) ============ -->\n    <div id=\"collage\" class=\"pin-wrap relative h-[220vh]\" data-kid=\"3-2-2\">\n      <div class=\"pin-stage sticky top-0 flex h-svh items-center justify-center overflow-hidden\" data-kid=\"3-2-2-1\">\n        <span class=\"note absolute top-24 left-5 z-20 max-w-[300px] flex-col gap-1 rounded-panel bg-ink p-4 text-[12px] leading-[1.5] text-white\" data-kid=\"3-2-2-1-1\"><b data-kid=\"3-2-2-1-1-1\">2 · Signal collage</b>From Ultrahuman's \"Every reading, built on evidence\". Photo cards fan out from behind the headline as you scroll, each at its own speed. Replaces nothing — it's the new bridge from hero to the scores.</span>\n\n        <div id=\"collageCards\" aria-hidden=\"true\" data-kid=\"3-2-2-1-2\">\n          <!-- data-x / data-y = final offset from centre in % of stage width / height. data-s = drift speed. -->\n          <figure data-card=\"\" data-x=\"-34\" data-y=\"-24\" data-s=\"1.2\" data-w=\"210\" data-h=\"150\" class=\"absolute top-1/2 left-1/2 overflow-hidden rounded-tile shadow-soft\" style=\"opacity: 0; width: 210px; height: 150px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 12;\" data-kid=\"3-2-2-1-2-1\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/e8e9b52b3aa4462b8d6ad53cd59b2ef3.jpg\" alt=\"Runner checking his Aero Fit Ultra\" class=\"size-full object-cover\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-2-1-2-1-1\">\n          </figure>\n          <figure data-card=\"\" data-x=\"-27\" data-y=\"20\" data-s=\"0.8\" data-w=\"250\" data-h=\"170\" class=\"absolute top-1/2 left-1/2 overflow-hidden rounded-tile shadow-soft\" style=\"opacity: 0; width: 250px; height: 170px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 8;\" data-kid=\"3-2-2-1-2-2\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/07bb0b4b98b3472387094f62ed418e87.jpg\" alt=\"Runner in headphones wearing Aero Fit Music\" class=\"size-full object-cover\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-2-1-2-2-1\">\n          </figure>\n          <figure data-card=\"\" data-x=\"-6\" data-y=\"-36\" data-s=\"1.4\" data-w=\"150\" data-h=\"112\" class=\"absolute top-1/2 left-1/2 overflow-hidden rounded-tile shadow-soft\" style=\"opacity: 0; width: 150px; height: 112px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 14;\" data-kid=\"3-2-2-1-2-3\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/3543f8cd7d9d41538a82a53b258a38b1.jpg\" alt=\"Aero Fit Lite on morning linen\" class=\"size-full object-cover\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-2-1-2-3-1\">\n          </figure>\n          <figure data-card=\"\" data-x=\"30\" data-y=\"-25\" data-s=\"1\" data-w=\"180\" data-h=\"180\" class=\"absolute top-1/2 left-1/2 flex items-center justify-center overflow-hidden rounded-tile bg-glow-thumb shadow-soft\" style=\"opacity: 0; width: 180px; height: 180px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 10;\" data-kid=\"3-2-2-1-2-4\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg\" alt=\"\" class=\"size-[78%] object-contain mix-blend-multiply brightness-110\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-2-1-2-4-1\">\n          </figure>\n          <figure data-card=\"\" data-x=\"34\" data-y=\"18\" data-s=\"0.7\" data-w=\"240\" data-h=\"160\" class=\"absolute top-1/2 left-1/2 overflow-hidden rounded-tile shadow-soft\" style=\"opacity: 0; width: 240px; height: 160px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 7;\" data-kid=\"3-2-2-1-2-5\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/7a47796ecb4f4ff7a78dc7db5db4e0e9.jpg\" alt=\"Aero Fit Smart on a stone block\" class=\"size-full object-cover\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-2-1-2-5-1\">\n          </figure>\n          <figure data-card=\"\" data-x=\"9\" data-y=\"36\" data-s=\"1.1\" data-w=\"190\" data-h=\"130\" class=\"absolute top-1/2 left-1/2 overflow-hidden rounded-tile shadow-soft\" style=\"opacity: 0; width: 190px; height: 130px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 11;\" data-kid=\"3-2-2-1-2-6\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/1554a09252854047951ad166e87cafc5.jpg\" alt=\"Aero Fit Ultra on a mossy summit rock\" class=\"size-full object-cover\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-2-1-2-6-1\">\n          </figure>\n          <!-- Two small readout chips, same treatment as the hero ReadoutCard -->\n          <div data-card=\"\" data-x=\"-16\" data-y=\"33\" data-s=\"1.6\" data-w=\"150\" data-h=\"64\" class=\"absolute top-1/2 left-1/2 flex flex-col justify-center rounded-thumb bg-white px-4 shadow-float\" style=\"opacity: 0; width: 150px; height: 64px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 16;\" data-kid=\"3-2-2-1-2-7\">\n            <span class=\"text-[12px] text-muted\" data-kid=\"3-2-2-1-2-7-1\">HRV</span><span class=\"text-[20px] leading-tight font-semibold\" data-kid=\"3-2-2-1-2-7-2\">64 ms</span>\n          </div>\n          <div data-card=\"\" data-x=\"19\" data-y=\"-38\" data-s=\"1.3\" data-w=\"160\" data-h=\"64\" class=\"absolute top-1/2 left-1/2 flex flex-col justify-center rounded-thumb bg-white px-4 shadow-float\" style=\"opacity: 0; width: 160px; height: 64px; transform: translate(-50%, -50%) translate3d(0px, 0px, 0px) scale(0.5); z-index: 13;\" data-kid=\"3-2-2-1-2-8\">\n            <span class=\"text-[12px] text-muted\" data-kid=\"3-2-2-1-2-8-1\">Resting HR</span><span class=\"text-[20px] leading-tight font-semibold\" data-kid=\"3-2-2-1-2-8-2\">52 bpm</span>\n          </div>\n        </div>\n\n        <div id=\"collageText\" data-scrub=\"\" class=\"relative z-10 max-w-[560px] px-6 text-center\" data-kid=\"3-2-2-1-3\" style=\"opacity: 0; transform: translate3d(0px, 30px, 0px);\">\n          <h2 class=\"font-serif text-[36px] leading-[1.08] font-medium tracking-[-0.01em] lg:text-heading\" data-kid=\"3-2-2-1-3-1\">Built on what your body already tells you.</h2>\n          <p class=\"mx-auto mt-4 max-w-[400px] text-[15px] leading-[1.6] text-ink-soft\" data-kid=\"3-2-2-1-3-2\">Heart rate, HRV, skin temperature and movement, read every few seconds, day and night.</p>\n          <a href=\"#scores\" class=\"mt-7 inline-flex h-11 items-center rounded-full bg-ink px-5 text-[14px] font-medium text-white transition hover:bg-ink-hover\" data-kid=\"3-2-2-1-3-3\">See the four scores</a>\n        </div>\n      </div>\n    </div>\n\n\n    <!-- ============ 3. ONE NUMBER (pinned counter) ============ -->\n    <div id=\"score\" class=\"pin-wrap relative h-[260vh]\" data-kid=\"3-2-3\">\n      <div class=\"pin-stage sticky top-0 h-svh overflow-hidden px-4\" data-kid=\"3-2-3-1\">\n        <span class=\"note absolute top-24 right-5 z-20 max-w-[300px] flex-col gap-1 rounded-panel bg-ink p-4 text-[12px] leading-[1.5] text-white\" data-kid=\"3-2-3-1-1\"><b data-kid=\"3-2-3-1-1-1\">3 · One number</b>Ultrahuman's \"15 DAYS\" battery moment. Headline fades out, the score counts up, the arc fills and the band rises into frame. Then the three inputs pop in.</span>\n\n        <!-- Title layer: fades out first -->\n        <div id=\"scoreTitle\" data-scrub=\"\" class=\"absolute inset-x-0 top-[17%] z-10 px-6 text-center\" data-kid=\"3-2-3-1-2\" style=\"opacity: 1; transform: translate3d(0px, 0px, 0px);\">\n          <p class=\"text-[13px] font-semibold tracking-[0.12em] text-muted uppercase\" data-kid=\"3-2-3-1-2-1\">Every morning</p>\n          <h2 class=\"mx-auto mt-4 max-w-[640px] font-serif text-[36px] leading-[1.08] font-medium tracking-[-0.01em] lg:text-heading\" data-kid=\"3-2-3-1-2-2\">One call before your feet hit the floor.</h2>\n        </div>\n\n        <!-- Stat row: fades in as title leaves -->\n        <div id=\"scoreStat\" data-scrub=\"\" class=\"absolute inset-x-0 top-[13%] z-10 grid grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 opacity-0 sm:gap-10\" data-kid=\"3-2-3-1-3\" style=\"opacity: 0; transform: translate3d(0px, 24px, 0px);\">\n          <p class=\"text-right text-[12px] font-semibold tracking-[0.12em] text-muted uppercase sm:text-[14px]\" data-kid=\"3-2-3-1-3-1\">This morning</p>\n          <p class=\"font-serif text-[96px] leading-none font-medium tracking-[-0.03em] tabular-nums sm:text-[150px] lg:text-[190px]\" data-kid=\"3-2-3-1-3-2\"><span id=\"scoreNum\" data-kid=\"3-2-3-1-3-2-1\">0</span><span class=\"text-[0.4em] text-muted\" data-kid=\"3-2-3-1-3-2-2\">%</span></p>\n          <p class=\"text-[12px] font-semibold tracking-[0.12em] text-muted uppercase sm:text-[14px]\" data-kid=\"3-2-3-1-3-3\">Recovery</p>\n        </div>\n\n        <!-- Arc + rising \"sun\" disk with the band -->\n        <div class=\"absolute inset-x-0 bottom-0 mx-auto h-[54%] max-w-[1000px]\" data-kid=\"3-2-3-1-4\">\n          <svg viewBox=\"0 0 1000 500\" class=\"absolute bottom-0 left-1/2 h-full w-auto max-w-none -translate-x-1/2\" aria-hidden=\"true\" data-kid=\"3-2-3-1-4-1\">\n            <path d=\"M 40 500 A 460 460 0 0 1 960 500\" fill=\"none\" stroke=\"var(--color-line-strong)\" stroke-width=\"14\" stroke-linecap=\"round\" data-kid=\"k8g4bpv\"></path>\n            <path id=\"scoreArc\" d=\"M 40 500 A 460 460 0 0 1 960 500\" fill=\"none\" stroke=\"var(--color-ink)\" stroke-width=\"14\" stroke-linecap=\"round\" pathLength=\"100\" stroke-dasharray=\"100\" stroke-dashoffset=\"100\" style=\"stroke-dashoffset: 100;\" data-kid=\"klt7wpt\"></path>\n          </svg>\n          <div id=\"scoreBand\" data-scrub=\"\" class=\"absolute bottom-0 left-1/2 aspect-square h-[150%] overflow-hidden rounded-full bg-glow-feature\" style=\"transform: translate3d(-50%, 100%, 0px);\" data-kid=\"3-2-3-1-4-2\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg\" alt=\"Aero Fit Smart showing the morning Recovery score\" class=\"absolute top-[7%] left-1/2 w-[32%] -translate-x-1/2 mix-blend-multiply brightness-110\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-3-1-4-2-1\">\n          </div>\n\n          <!-- Inputs: pop in at the end -->\n          <div data-chip=\"\" class=\"absolute bottom-[40%] left-[2%] z-10 rounded-float bg-white p-4 shadow-float opacity-0 sm:left-0 sm:w-[200px]\" data-kid=\"3-2-3-1-4-3\" style=\"opacity: 0; transform: translate3d(0px, 24px, 0px) scale(0.94);\">\n            <p class=\"flex items-center gap-2 text-[13px] text-muted\" data-kid=\"3-2-3-1-4-3-1\"><i class=\"ti ti-moon-stars\" aria-hidden=\"true\" data-kid=\"3-2-3-1-4-3-1-1\"></i>Sleep</p><p class=\"mt-1 text-[24px] leading-tight font-semibold\" data-kid=\"3-2-3-1-4-3-2\">7h 42m</p>\n          </div>\n          <div data-chip=\"\" class=\"absolute bottom-[12%] left-[4%] z-10 hidden rounded-float bg-white p-4 shadow-float opacity-0 sm:block sm:w-[200px]\" data-kid=\"3-2-3-1-4-4\" style=\"opacity: 0; transform: translate3d(0px, 24px, 0px) scale(0.94);\">\n            <p class=\"flex items-center gap-2 text-[13px] text-muted\" data-kid=\"3-2-3-1-4-4-1\"><i class=\"ti ti-wave-sine\" aria-hidden=\"true\" data-kid=\"3-2-3-1-4-4-1-1\"></i>HRV</p><p class=\"mt-1 text-[24px] leading-tight font-semibold\" data-kid=\"3-2-3-1-4-4-2\">64 ms</p>\n          </div>\n          <div data-chip=\"\" class=\"absolute right-[2%] bottom-[40%] z-10 rounded-float bg-white p-4 shadow-float opacity-0 sm:right-0 sm:w-[200px]\" data-kid=\"3-2-3-1-4-5\" style=\"opacity: 0; transform: translate3d(0px, 24px, 0px) scale(0.94);\">\n            <p class=\"flex items-center gap-2 text-[13px] text-muted\" data-kid=\"3-2-3-1-4-5-1\"><i class=\"ti ti-heartbeat\" aria-hidden=\"true\" data-kid=\"3-2-3-1-4-5-1-1\"></i>Resting HR</p><p class=\"mt-1 text-[24px] leading-tight font-semibold\" data-kid=\"3-2-3-1-4-5-2\">52 bpm</p>\n          </div>\n          <p data-chip=\"\" class=\"absolute right-[4%] bottom-[16%] z-10 hidden rounded-full bg-accent px-4 py-2 text-[14px] font-medium opacity-0 shadow-soft sm:block\" data-kid=\"3-2-3-1-4-6\" style=\"opacity: 0; transform: translate3d(0px, 24px, 0px) scale(0.94);\">Green light for intervals</p>\n        </div>\n      </div>\n    </div>\n\n\n    <!-- ============ 4. FOUR SCORES (dark, tabs + carousel) ============ -->\n    <div id=\"scoresPin\" class=\"pin-wrap relative lg:h-[380vh]\" data-name=\"scores scroll pin\" data-kid=\"3-2-10\">\n    <div class=\"pin-stage flex flex-col justify-center lg:sticky lg:top-0 lg:h-svh\" data-name=\"scores sticky stage\" data-kid=\"3-2-10-1\">\n    <section id=\"scores\" class=\"relative mx-4 overflow-hidden rounded-section bg-ink py-16 text-white lg:py-14\" data-kid=\"3-2-4\">\n      <span class=\"note absolute top-5 right-5 z-20 max-w-[300px] flex-col gap-1 rounded-panel bg-white p-4 text-[12px] leading-[1.5] text-ink\" data-kid=\"3-2-4-1\"><b data-kid=\"3-2-4-1-1\">4 · Four scores</b>Ultrahuman's dark \"PRO beyond measure\" block: tab pills drive a centred card carousel with a readout floating on each photo. Replaces today's MetricsSection list (same data).</span>\n\n      <div class=\"mx-auto max-w-page px-4 text-center\" data-kid=\"3-2-4-2\">\n        <h2 class=\"reveal font-serif text-[36px] leading-[1.08] font-medium tracking-[-0.01em] lg:text-heading\" data-kid=\"3-2-4-2-1\" data-visible=\"true\">A band that understands your body</h2>\n        \n\n        \n      </div>\n\n      <div id=\"track\" data-lenis-prevent=\"\" class=\"mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-[calc((100%-min(760px,84vw))/2)] no-scrollbar will-change-transform [backface-visibility:hidden] lg:snap-none lg:overflow-visible lg:scroll-auto\" data-kid=\"3-2-4-3\" data-name=\"score card track\" data-dynamic=\"true\" data-reason=\"translateX set by scroll position script\" style=\"transform: translate3d(0px, 0px, 0px);\">\n        <!-- Card: Sleep -->\n        <article data-slide=\"\" class=\"w-[min(760px,84vw)] shrink-0 snap-center will-change-[transform,opacity]\" data-kid=\"3-2-4-3-1\" style=\"opacity: 1; transform: scale(1);\">\n          <div class=\"relative h-[300px] overflow-hidden rounded-card sm:h-[420px]\" data-kid=\"3-2-4-3-1-1\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/a01a86b9ff904c068d38a21a52bd3be1.jpg\" alt=\"Woman resting with her Aero Fit Lite\" class=\"size-full object-cover object-[75%_center]\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-4-3-1-1-1\">\n            <div class=\"absolute bottom-4 left-4 w-[230px] rounded-float bg-white/92 p-4 text-ink shadow-float backdrop-blur-md\" data-kid=\"3-2-4-3-1-1-2\">\n              <p class=\"text-[12px] text-muted\" data-kid=\"3-2-4-3-1-1-2-1\">Sleep Performance</p>\n              <p class=\"mt-0.5 text-[32px] leading-none font-semibold\" data-kid=\"3-2-4-3-1-1-2-2\">86%</p>\n              <div class=\"mt-3 flex h-8 items-end gap-[3px]\" aria-hidden=\"true\" data-kid=\"3-2-4-3-1-1-2-3\">\n                <span class=\"h-[40%] flex-1 rounded-sm bg-chip\" data-kid=\"3-2-4-3-1-1-2-3-1\"></span><span class=\"h-[70%] flex-1 rounded-sm bg-ink\" data-kid=\"3-2-4-3-1-1-2-3-2\"></span><span class=\"h-[90%] flex-1 rounded-sm bg-ink\" data-kid=\"3-2-4-3-1-1-2-3-3\"></span><span class=\"h-[55%] flex-1 rounded-sm bg-chip\" data-kid=\"3-2-4-3-1-1-2-3-4\"></span><span class=\"h-[80%] flex-1 rounded-sm bg-ink\" data-kid=\"3-2-4-3-1-1-2-3-5\"></span><span class=\"h-[35%] flex-1 rounded-sm bg-chip\" data-kid=\"3-2-4-3-1-1-2-3-6\"></span><span class=\"h-[65%] flex-1 rounded-sm bg-ink\" data-kid=\"3-2-4-3-1-1-2-3-7\"></span><span class=\"h-[95%] flex-1 rounded-sm bg-accent\" data-kid=\"3-2-4-3-1-1-2-3-8\"></span><span class=\"h-[50%] flex-1 rounded-sm bg-chip\" data-kid=\"3-2-4-3-1-1-2-3-9\"></span><span class=\"h-[75%] flex-1 rounded-sm bg-ink\" data-kid=\"3-2-4-3-1-1-2-3-10\"></span>\n              </div>\n            </div>\n          </div>\n          <div class=\"mt-6 grid gap-4 sm:grid-cols-[1fr_1.2fr] sm:gap-10\" data-kid=\"3-2-4-3-1-2\">\n            <h3 class=\"flex items-center gap-3 font-serif text-[26px] leading-tight font-medium\" data-kid=\"3-2-4-3-1-2-1\"><span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-accent text-ink\" data-kid=\"3-2-4-3-1-2-1-1\"><i class=\"ti ti-moon-stars text-[17px]\" aria-hidden=\"true\" data-kid=\"3-2-4-3-1-2-1-1-1\"></i></span>Sleep Performance</h3>\n            <div data-kid=\"3-2-4-3-1-2-2\">\n              <p class=\"text-[15px] leading-[1.6] text-white/70\" data-kid=\"3-2-4-3-1-2-2-1\">How much of the sleep your body needed you actually got, split into light, deep and REM stages.</p>\n              <ul class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"3-2-4-3-1-2-2-2\"><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-1-2-2-2-1\">Sleep stages</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-1-2-2-2-2\">Skin temperature</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-1-2-2-2-3\">Breathing rate</li></ul>\n            </div>\n          </div>\n        </article>\n\n        <!-- Card: Recovery -->\n        <article data-slide=\"\" class=\"w-[min(760px,84vw)] shrink-0 snap-center will-change-[transform,opacity]\" data-kid=\"3-2-4-3-2\" style=\"opacity: 0.45; transform: scale(0.96);\">\n          <div class=\"relative h-[300px] overflow-hidden rounded-card sm:h-[420px]\" data-kid=\"3-2-4-3-2-1\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/87d408f175064ec88d083cb4a3861585.jpg\" alt=\"Woman with morning coffee wearing her Aero Fit Smart\" class=\"size-full object-cover object-[75%_center]\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-4-3-2-1-1\">\n            <div class=\"absolute bottom-4 left-4 w-[230px] rounded-float bg-white/92 p-4 text-ink shadow-float backdrop-blur-md\" data-kid=\"3-2-4-3-2-1-2\">\n              <p class=\"text-[12px] text-muted\" data-kid=\"3-2-4-3-2-1-2-1\">Recovery</p>\n              <p class=\"mt-0.5 text-[32px] leading-none font-semibold\" data-kid=\"3-2-4-3-2-1-2-2\">82%</p>\n              <div class=\"mt-3 h-1.5 overflow-hidden rounded-full bg-chip\" data-kid=\"3-2-4-3-2-1-2-3\"><div class=\"h-full w-[82%] rounded-full bg-ink\" data-kid=\"3-2-4-3-2-1-2-3-1\"></div></div>\n              <p class=\"mt-3 inline-flex rounded-full bg-accent px-2.5 py-0.5 text-[12px] font-medium\" data-kid=\"3-2-4-3-2-1-2-4\">Ready to push</p>\n            </div>\n          </div>\n          <div class=\"mt-6 grid gap-4 sm:grid-cols-[1fr_1.2fr] sm:gap-10\" data-kid=\"3-2-4-3-2-2\">\n            <h3 class=\"flex items-center gap-3 font-serif text-[26px] leading-tight font-medium\" data-kid=\"3-2-4-3-2-2-1\"><span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-accent text-ink\" data-kid=\"3-2-4-3-2-2-1-1\"><i class=\"ti ti-bolt text-[17px]\" aria-hidden=\"true\" data-kid=\"3-2-4-3-2-2-1-1-1\"></i></span>Recovery</h3>\n            <div data-kid=\"3-2-4-3-2-2-2\">\n              <p class=\"text-[15px] leading-[1.6] text-white/70\" data-kid=\"3-2-4-3-2-2-2-1\">A morning read on how ready you are to take on load, so you know whether to push or back off.</p>\n              <ul class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"3-2-4-3-2-2-2-2\"><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-2-2-2-2-1\">Heart rate variability</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-2-2-2-2-2\">Resting heart rate</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-2-2-2-2-3\">Sleep</li></ul>\n            </div>\n          </div>\n        </article>\n\n        <!-- Card: Strain -->\n        <article data-slide=\"\" class=\"w-[min(760px,84vw)] shrink-0 snap-center will-change-[transform,opacity]\" data-kid=\"3-2-4-3-3\" style=\"opacity: 0.45; transform: scale(0.96);\">\n          <div class=\"relative h-[300px] overflow-hidden rounded-card sm:h-[420px]\" data-kid=\"3-2-4-3-3-1\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/356b3e3c8d704bf4887b81203fda5357.jpg\" alt=\"Runner wearing Aero Fit Pro in the blocks on a track\" class=\"size-full object-cover object-[center_40%]\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-4-3-3-1-1\">\n            <div class=\"absolute bottom-4 left-4 w-[230px] rounded-float bg-white/92 p-4 text-ink shadow-float backdrop-blur-md\" data-kid=\"3-2-4-3-3-1-2\">\n              <p class=\"text-[12px] text-muted\" data-kid=\"3-2-4-3-3-1-2-1\">Strain · 0–21</p>\n              <p class=\"mt-0.5 text-[32px] leading-none font-semibold\" data-kid=\"3-2-4-3-3-1-2-2\">14.2</p>\n              <div class=\"mt-3 flex gap-1\" aria-hidden=\"true\" data-kid=\"3-2-4-3-3-1-2-3\"><span class=\"h-1.5 flex-1 rounded-full bg-ink\" data-kid=\"3-2-4-3-3-1-2-3-1\"></span><span class=\"h-1.5 flex-1 rounded-full bg-ink\" data-kid=\"3-2-4-3-3-1-2-3-2\"></span><span class=\"h-1.5 flex-1 rounded-full bg-ink\" data-kid=\"3-2-4-3-3-1-2-3-3\"></span><span class=\"h-1.5 flex-1 rounded-full bg-accent\" data-kid=\"3-2-4-3-3-1-2-3-4\"></span><span class=\"h-1.5 flex-1 rounded-full bg-chip\" data-kid=\"3-2-4-3-3-1-2-3-5\"></span></div>\n              <p class=\"mt-3 text-[12px] text-muted\" data-kid=\"3-2-4-3-3-1-2-4\">Target today: 13–15</p>\n            </div>\n          </div>\n          <div class=\"mt-6 grid gap-4 sm:grid-cols-[1fr_1.2fr] sm:gap-10\" data-kid=\"3-2-4-3-3-2\">\n            <h3 class=\"flex items-center gap-3 font-serif text-[26px] leading-tight font-medium\" data-kid=\"3-2-4-3-3-2-1\"><span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-accent text-ink\" data-kid=\"3-2-4-3-3-2-1-1\"><i class=\"ti ti-flame text-[17px]\" aria-hidden=\"true\" data-kid=\"3-2-4-3-3-2-1-1-1\"></i></span>Strain</h3>\n            <div data-kid=\"3-2-4-3-3-2-2\">\n              <p class=\"text-[15px] leading-[1.6] text-white/70\" data-kid=\"3-2-4-3-3-2-2-1\">Every workout, commute and flight of stairs adds up to one daily effort score on a 0–21 scale.</p>\n              <ul class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"3-2-4-3-3-2-2-2\"><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-3-2-2-2-1\">Heart rate zones</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-3-2-2-2-2\">Workout types</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-3-2-2-2-3\">Steps</li></ul>\n            </div>\n          </div>\n        </article>\n\n        <!-- Card: Heart -->\n        <article data-slide=\"\" class=\"w-[min(760px,84vw)] shrink-0 snap-center will-change-[transform,opacity]\" data-kid=\"3-2-4-3-4\" style=\"opacity: 0.45; transform: scale(0.96);\">\n          <div class=\"relative h-[300px] overflow-hidden rounded-card sm:h-[420px]\" data-kid=\"3-2-4-3-4-1\">\n            <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/b676a18a466145849599dd16012925dc.jpg\" alt=\"Athlete checking her pulse on her Aero Fit Pro\" class=\"size-full object-cover object-[70%_center]\" onerror=\"__crawlAsset&amp;&amp;__crawlAsset(this)\" data-kid=\"3-2-4-3-4-1-1\">\n            <div class=\"absolute bottom-4 left-4 w-[230px] rounded-float bg-white/92 p-4 text-ink shadow-float backdrop-blur-md\" data-kid=\"3-2-4-3-4-1-2\">\n              <p class=\"text-[12px] text-muted\" data-kid=\"3-2-4-3-4-1-2-1\">Resting heart rate</p>\n              <p class=\"mt-0.5 text-[32px] leading-none font-semibold\" data-kid=\"3-2-4-3-4-1-2-2\">52 <span class=\"text-[16px] font-medium text-muted\" data-kid=\"3-2-4-3-4-1-2-2-1\">bpm</span></p>\n              <svg viewBox=\"0 0 200 40\" class=\"mt-3 h-8 w-full\" aria-hidden=\"true\" data-kid=\"3-2-4-3-4-1-2-3\"><polyline fill=\"none\" stroke=\"var(--color-ink)\" stroke-width=\"2\" stroke-linejoin=\"round\" points=\"0,28 20,26 40,30 60,22 80,24 100,18 120,20 140,14 160,16 180,12 200,13\" data-kid=\"kacgbp5\"></polyline></svg>\n            </div>\n          </div>\n          <div class=\"mt-6 grid gap-4 sm:grid-cols-[1fr_1.2fr] sm:gap-10\" data-kid=\"3-2-4-3-4-2\">\n            <h3 class=\"flex items-center gap-3 font-serif text-[26px] leading-tight font-medium\" data-kid=\"3-2-4-3-4-2-1\"><span class=\"flex size-9 shrink-0 items-center justify-center rounded-full bg-accent text-ink\" data-kid=\"3-2-4-3-4-2-1-1\"><i class=\"ti ti-heartbeat text-[17px]\" aria-hidden=\"true\" data-kid=\"3-2-4-3-4-2-1-1-1\"></i></span>Heart health</h3>\n            <div data-kid=\"3-2-4-3-4-2-2\">\n              <p class=\"text-[15px] leading-[1.6] text-white/70\" data-kid=\"3-2-4-3-4-2-2-1\">Resting heart rate trends, plus ECG and Blood Pressure Insights on Pro and Ultra.</p>\n              <ul class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"3-2-4-3-4-2-2-2\"><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-4-2-2-2-1\">Resting HR</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-4-2-2-2-2\">ECG</li><li class=\"rounded-full bg-white/10 px-3 py-1 text-[12px] font-medium\" data-kid=\"3-2-4-3-4-2-2-2-3\">Blood pressure</li></ul>\n            </div>\n          </div>\n        </article>\n      </div>\n\n      <!-- Pager: long pill = active (Ultrahuman pattern) + arrows -->\n      <div class=\"mx-auto mt-10 flex max-w-[min(760px,84vw)] items-center justify-between\" data-kid=\"3-2-4-4\">\n        \n        <div class=\"flex gap-2\" data-kid=\"3-2-4-4-2\">\n          \n          \n        </div>\n      </div>\n    </section>\n    </div>\n    </div>\n\n\n    <!-- ============ 5. A DAY ON THE BAND (pinned, scrubbed timeline) ============ -->\n    <div id=\"day\" class=\"pin-wrap relative mt-4 lg:h-[320vh]\" data-kid=\"3-2-5\">\n      <div class=\"pin-stage flex items-center lg:sticky lg:top-0 lg:h-svh\" data-kid=\"3-2-5-1\">\n        <section class=\"relative mx-4 w-full rounded-section bg-sand px-6 py-16 lg:px-[80px] lg:py-20\" data-kid=\"3-2-5-1-1\">\n          <span class=\"note absolute top-5 right-5 z-20 max-w-[300px] flex-col gap-1 rounded-panel bg-ink p-4 text-[12px] leading-[1.5] text-white\" data-kid=\"3-2-5-1-1-1\"><b data-kid=\"3-2-5-1-1-1-1\">5 · A day on the band</b>Same section as today, now pinned. Scrolling draws the line across the day and lights up each moment in turn, the way Ultrahuman ties copy to scroll position.</span>\n          <div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"3-2-5-1-1-2\">\n            <h2 class=\"max-w-[520px] font-serif text-[36px] leading-[1.08] font-medium tracking-[-0.01em] lg:text-heading-sm\" data-kid=\"3-2-5-1-1-2-1\" style=\"height: 142.545px; width: 519.994px;\">Wear and forget it. Aero Fit only speaks up when there is something to act on</h2>\n            \n          </div>\n\n          <ol class=\"relative mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8\" data-kid=\"3-2-5-1-1-3\">\n            <span aria-hidden=\"true\" class=\"absolute top-[7px] right-0 left-0 hidden h-px bg-line-strong lg:block\" data-kid=\"3-2-5-1-1-3-1\"></span>\n            <span id=\"dayFill\" aria-hidden=\"true\" class=\"absolute top-[6px] right-0 left-0 hidden h-[3px] origin-left rounded-full bg-ink lg:block\" style=\"transform: scaleX(0);\" data-kid=\"3-2-5-1-1-3-2\"></span>\n\n            <li data-moment=\"\" class=\"relative transition-opacity duration-500\" data-kid=\"3-2-5-1-1-3-3\" style=\"opacity: 1;\">\n              <span aria-hidden=\"true\" class=\"relative block size-[15px] rounded-full border-[3px] border-sand bg-ink\" data-kid=\"3-2-5-1-1-3-3-1\"></span>\n              \n              \n              <div data-el=\"Container\" data-name=\"Container\" style=\"font-size: 12px;\" data-kid=\"3-2-5-1-1-3-3-2\"><h3 class=\"mt-4 font-serif text-[24px] leading-tight font-medium\" data-kid=\"3-2-5-1-1-3-3-4\">Wake to a plan</h3><p class=\"mt-2 text-[14px] leading-[1.6] text-ink-soft\" data-kid=\"3-2-5-1-1-3-3-5\">Your Recovery score is waiting, with a strain target sized to how well you slept.</p></div>\n              <figure data-shot=\"\" class=\"relative mt-5 h-[190px] overflow-hidden rounded-[20px] bg-tile\" data-name=\"moment photo\" data-dynamic=\"true\" data-reason=\"clip-path revealed by scroll position script\" style=\"clip-path: inset(0 0 0% 0 round 20px)\" data-kid=\"3-2-5-1-1-3-3-3\"><img src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/2dabe16266d04995a3144d175002d70b.jpg\" alt=\"Woman checking her morning Recovery score in bed\" class=\"size-full object-cover\" decoding=\"async\" loading=\"lazy\" data-name=\"moment photo image\" data-kid=\"3-2-5-1-1-3-3-3-1\" style=\"transform: scale(1);\"></figure>\n            </li>\n            <li data-moment=\"\" class=\"relative transition-opacity duration-500\" data-kid=\"3-2-5-1-1-3-4\" style=\"opacity: 0.35;\">\n              <span aria-hidden=\"true\" class=\"relative block size-[15px] rounded-full border-[3px] border-sand bg-ink\" data-kid=\"3-2-5-1-1-3-4-1\"></span>\n              \n              \n              <h3 class=\"mt-4 font-serif text-[24px] leading-tight font-medium\" data-kid=\"3-2-5-1-1-3-4-4\">Steady through the day</h3>\n              <p class=\"mt-2 text-[14px] leading-[1.6] text-ink-soft\" data-kid=\"3-2-5-1-1-3-4-5\">Strain builds quietly in the background. A nudge arrives if you have been still too long.</p>\n              <figure data-shot=\"\" class=\"relative mt-5 h-[190px] overflow-hidden rounded-[20px] bg-tile\" data-name=\"moment photo\" data-dynamic=\"true\" data-reason=\"clip-path revealed by scroll position script\" style=\"clip-path: inset(0 0 100% 0 round 20px)\" data-kid=\"3-2-5-1-1-3-4-2\"><img src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/86a131a0d4bc45ed8390ea519e3dfb4e.jpg\" alt=\"Man stretching away from his desk at midday\" class=\"size-full object-cover\" decoding=\"async\" loading=\"lazy\" data-name=\"moment photo image\" data-kid=\"3-2-5-1-1-3-4-2-1\" style=\"transform: scale(1.12);\"></figure>\n            </li>\n            <li data-moment=\"\" class=\"relative transition-opacity duration-500\" data-kid=\"3-2-5-1-1-3-5\" style=\"opacity: 0.35;\">\n              <span aria-hidden=\"true\" class=\"relative block size-[15px] rounded-full border-[3px] border-sand bg-ink\" data-kid=\"3-2-5-1-1-3-5-1\"></span>\n              \n              \n              <h3 class=\"mt-4 font-serif text-[24px] leading-tight font-medium\" data-kid=\"3-2-5-1-1-3-5-4\">Train with feedback</h3>\n              <p class=\"mt-2 text-[14px] leading-[1.6] text-ink-soft\" data-kid=\"3-2-5-1-1-3-5-5\">Live heart rate zones and GPS on your wrist, then a breakdown of what the session cost you.</p>\n              <figure data-shot=\"\" class=\"relative mt-5 h-[190px] overflow-hidden rounded-[20px] bg-tile\" data-name=\"moment photo\" data-dynamic=\"true\" data-reason=\"clip-path revealed by scroll position script\" style=\"clip-path: inset(0 0 100% 0 round 20px)\" data-kid=\"3-2-5-1-1-3-5-2\"><img src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/6c37160e3d2e460fbd5f3cd60e3cf18e.jpg\" alt=\"Runner checking her watch on an evening coastal run\" class=\"size-full object-cover\" decoding=\"async\" loading=\"lazy\" data-name=\"moment photo image\" data-kid=\"3-2-5-1-1-3-5-2-1\" style=\"transform: scale(1.12);\"></figure>\n            </li>\n            <li data-moment=\"\" class=\"relative transition-opacity duration-500\" data-kid=\"3-2-5-1-1-3-6\" style=\"opacity: 0.35;\">\n              <span aria-hidden=\"true\" class=\"relative block size-[15px] rounded-full border-[3px] border-sand bg-ink\" data-kid=\"3-2-5-1-1-3-6-1\"></span>\n              \n              \n              <h3 class=\"mt-4 font-serif text-[24px] leading-tight font-medium\" data-kid=\"3-2-5-1-1-3-6-4\">Wind down on time</h3>\n              <p class=\"mt-2 text-[14px] leading-[1.6] text-ink-soft\" data-kid=\"3-2-5-1-1-3-6-5\">A bedtime suggestion based on tomorrow’s plan, so your sleep matches the day ahead.</p>\n              <figure data-shot=\"\" class=\"relative mt-5 h-[190px] overflow-hidden rounded-[20px] bg-tile\" data-name=\"moment photo\" data-dynamic=\"true\" data-reason=\"clip-path revealed by scroll position script\" style=\"clip-path: inset(0 0 100% 0 round 20px)\" data-kid=\"3-2-5-1-1-3-6-2\"><img src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/3c387915ade44e58919ec9a131736683.jpg\" alt=\"Man reading in bed under a warm lamp before sleep\" class=\"size-full object-cover\" decoding=\"async\" loading=\"lazy\" data-name=\"moment photo image\" data-kid=\"3-2-5-1-1-3-6-2-1\" style=\"transform: scale(1.12);\"></figure>\n            </li>\n          </ol>\n        </section>\n      </div>\n    </div>\n\n\n    <!-- ============ 6. BANDS — stacked sticky blocks ============ -->\n    <section id=\"bands\" class=\"relative mx-auto mt-28 max-w-page px-4\" data-kid=\"3-2-6\">\n      <span class=\"note absolute -top-14 right-4 z-20 max-w-[300px] flex-col gap-1 rounded-panel bg-ink p-4 text-[12px] leading-[1.5] text-white\" data-kid=\"3-2-6-1\"><b data-kid=\"3-2-6-1-1\">6 · Bands</b>Ultrahuman's Ring PRO / Ring AIR blocks. Product stays pinned on the left while detail tiles scroll on the right. Each block then holds still and the next one slides over it. Replaces BandsStripSection.</span>\n      <div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10\" data-kid=\"3-2-6-2\">\n        <div data-kid=\"3-2-6-2-1\">\n          <h2 class=\"reveal font-serif text-[36px] leading-[1.08] font-medium tracking-[-0.01em] lg:text-heading\" data-kid=\"3-2-6-2-1-1\">Pick the hardware.<br data-kid=\"3-2-6-2-1-1-1\">The coaching is the same.</h2>\n          <p class=\"reveal mt-3 max-w-[520px] text-[15px] leading-[1.6] text-ink-soft\" style=\"--reveal-delay:100ms\" data-kid=\"3-2-6-2-1-2\">Five bands, one membership. Here are three to start with, from an 18 g sleep tracker to a titanium GPS watch.</p>\n        </div>\n        <a href=\"#\" class=\"reveal text-[14px] font-medium underline underline-offset-4 transition hover:opacity-70\" style=\"--reveal-delay:150ms\" data-kid=\"3-2-6-2-2\">Compare all five side by side</a>\n      </div>\n    </section>\n\n    <div id=\"stack\" class=\"relative mt-10\" data-kid=\"3-2-7\">\n\n      <!-- Block: Lite (sand) -->\n      <article data-block=\"\" class=\"stack-block relative z-[1] mx-4 rounded-section bg-[#5E6E7D] text-white lg:sticky\" data-kid=\"3-2-7-1\" style=\"top: -1269px; transform: scale(1);\">\n        <div data-shade=\"\" aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 z-10 rounded-section bg-ink opacity-0\" data-kid=\"3-2-7-1-1\" style=\"opacity: 0;\"></div>\n        <div class=\"grid gap-4 p-4 lg:grid-cols-2 lg:p-6\" data-kid=\"3-2-7-1-2\">\n          <div class=\"lg:sticky lg:top-[100px] lg:self-start\" data-kid=\"3-2-7-1-2-1\">\n            <div class=\"h-[340px] overflow-hidden rounded-card bg-tile lg:h-[520px]\" data-kid=\"3-2-7-1-2-1-1\" data-name=\"product photo\">\n              <img decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/3543f8cd7d9d41538a82a53b258a38b1.jpg\" alt=\"Aero Fit Lite on morning linen sheets\" class=\"size-full object-cover\" data-name=\"product photo image\" data-kid=\"3-2-7-1-2-1-1-1\">\n            </div>\n            <div class=\"mt-5 flex flex-wrap items-center justify-between gap-4 px-2\" data-kid=\"3-2-7-1-2-1-2\">\n              <div data-kid=\"3-2-7-1-2-1-2-1\">\n                <p class=\"font-serif text-[32px] leading-tight font-medium\" data-kid=\"3-2-7-1-2-1-2-1-1\">Aero Fit Lite</p>\n                <p class=\"mt-1 text-[13px] text-white/70\" data-kid=\"3-2-7-1-2-1-2-1-2\">$149 or <span class=\"font-medium text-white\" data-kid=\"3-2-7-1-2-1-2-1-2-1\">$0 on One</span></p>\n              </div>\n              <div class=\"flex gap-2\" data-kid=\"3-2-7-1-2-1-2-2\">\n