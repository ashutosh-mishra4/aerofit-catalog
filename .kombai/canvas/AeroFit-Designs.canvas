      "contentHeight": 6300,
      "order": 2
    },
    "var_oura_video_quick": {
      "type": "variant",
      "label": "AeroFit Landing — Layout 3",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": -3516.6620866494295,
        "y": 19063.93708978476,
        "w": 1291,
        "h": 0
      },
      "html": "<style>\n    html, body { margin: 0; padding: 0; } #root { display: contents; }\n</style>\n<div data-kid=\"2\" data-name=\"page root container\" id=\"root\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.marq{animation:marq 16s linear infinite;}\n@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n.noscroll::-webkit-scrollbar{display:none}\n.noscroll{scrollbar-width:none}\n.hero-in{animation:heroIn 1.1s cubic-bezier(.2,.7,.2,1) both .2s}\n@keyframes heroIn{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}\n    </style>\n    <div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n        <!-- Announcement -->\n        <!-- Full-bleed video hero (Amazfit-inspired) -->\n        <section class=\"relative h-[760px] rounded-b-[32px] overflow-hidden bg-[#2A0B14] text-white\" data-kid=\"1-1\" data-name=\"video hero section\">\n            <video autoplay=\"\" class=\"absolute inset-0 w-full h-full object-cover object-[60%_center]\" data-kid=\"1-1-1\" data-name=\"full-bleed autoplay hero video\" id=\"heroVideo\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/65ac1bc7a57c4d3bb3773cee4236749d.png\" preload=\"metadata\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/45939b9edb2d4f9f924094fb56ff4f57.mp4\">\n            </video>\n            <div class=\"absolute inset-x-0 top-0 h-[180px] bg-gradient-to-b from-[#1A060C]/60 to-transparent\" data-kid=\"1-1-2\" data-name=\"hero top gradient overlay\">\n            </div>\n            <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(26,6,12,0.72)_0%,rgba(26,6,12,0.35)_42%,transparent_70%)]\" data-kid=\"1-1-3\" data-name=\"hero side scrim gradient overlay\">\n            </div>\n            <div class=\"absolute inset-x-0 bottom-0 h-[320px] bg-gradient-to-t from-[#1A060C]/70 to-transparent\" data-kid=\"1-1-4\" data-name=\"hero bottom gradient overlay\">\n            </div>\n            <!-- Overlay nav -->\n            <header class=\"relative z-20 px-16 h-[84px] grid grid-cols-[1fr_auto_1fr] items-center\" data-kid=\"1-1-5\" data-name=\"site header bar\">\n                <a class=\"flex items-center gap-2\" data-kid=\"1-1-5-1\" data-name=\"brand logo link\" href=\"#\">\n                    <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-1-5-1-1\" data-name=\"brand SVG logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n                    <span class=\"serif text-[24px] font-medium tracking-tight text-white\" data-kid=\"1-1-5-1-2\" data-name=\"brand wordmark text\">\n                        Aero Fit\n                    </span>\n                </a>\n                <nav class=\"flex items-center gap-7 text-[14px] whitespace-nowrap text-white/90\" data-kid=\"1-1-5-2\" data-name=\"main navigation links\">\n                    <a class=\"flex items-center gap-1.5 hover:text-white transition\" data-kid=\"1-1-5-2-1\" data-name=\"memberships nav dropdown link\" href=\"#\">\n                        Memberships\n                        <span class=\"text-[13px]\" data-kid=\"1-1-5-2-1-1\" data-name=\"dropdown chevron wrapper\">\n                            <i class=\"ti ti-chevron-down\" data-kid=\"1-1-5-2-1-1-1\" data-name=\"chevron-down icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-1.5 hover:text-white transition\" data-kid=\"1-1-5-2-2\" data-name=\"how-it-works nav dropdown link\" href=\"#\">\n                        How it works\n                        <span class=\"text-[13px]\" data-kid=\"1-1-5-2-2-1\" data-name=\"dropdown chevron wrapper\">\n                            <i class=\"ti ti-chevron-down\" data-kid=\"1-1-5-2-2-1-1\" data-name=\"chevron-down icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-1.5 hover:text-white transition\" data-kid=\"1-1-5-2-3\" data-name=\"why-aero-fit nav dropdown link\" href=\"#\">\n                        Why Aero Fit\n                        <span class=\"text-[13px]\" data-kid=\"1-1-5-2-3-1\" data-name=\"dropdown chevron wrapper\">\n                            <i class=\"ti ti-chevron-down\" data-kid=\"1-1-5-2-3-1-1\" data-name=\"chevron-down icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"hover:text-white transition\" data-kid=\"1-1-5-2-4\" data-name=\"accessories nav link\" href=\"#\">\n                        Accessories\n                    </a>\n                </nav>\n                <div class=\"flex items-center justify-end gap-2 whitespace-nowrap\" data-kid=\"1-1-5-3\" data-name=\"header actions container\">\n                    <a class=\"text-[14px] px-2 text-white/90 hover:text-white transition\" data-kid=\"1-1-5-3-1\" data-name=\"sign-in link\" href=\"#\">\n                        Sign in\n                    </a>\n                    <button class=\"h-10 px-5 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[14px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-1-5-3-2\" data-name=\"primary join CTA button\">\n                        Join Aero Fit free\n                    </button>\n                </div>\n            </header>\n            <!-- Hero copy -->\n            <div class=\"absolute z-10 left-16 bottom-16 w-[560px] hero-in\" data-kid=\"1-1-6\" data-name=\"hero copy container\">\n                <h1 class=\"serif mt-6 text-[72px] leading-[0.98] font-normal tracking-[-0.03em] text-white\" data-kid=\"1-1-6-1\" data-name=\"hero headline text\">\n                    Know What Your Body Needs, Every Single Day\n                </h1>\n                <p class=\"mt-6 text-[18px] leading-[1.5] text-white/80 max-w-[480px]\" data-kid=\"1-1-6-2\" data-name=\"hero subheading text\">\n                    Aero Fit turns 24/7 health insights into personalized coaching to help you sleep, train, and feel better wherever life takes you.\n                </p>\n                <div class=\"mt-8 flex gap-2.5\" data-kid=\"1-1-6-3\" data-name=\"hero action buttons container\">\n                    <button class=\"h-12 px-7 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[15px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-1-6-3-1\" data-name=\"primary try-free CTA button\">\n                        Try Aero Fit for free\n                    </button>\n                    <button class=\"h-12 px-6 rounded-full bg-white/12 backdrop-blur-md border border-white/30 text-white text-[15px] font-medium hover:bg-white/20 transition\" data-kid=\"1-1-6-3-2\" data-name=\"secondary join-now button\">\n                        Join Now\n                    </button>\n                </div>\n            </div>\n            <!-- Bottom-right: team pill + video control -->\n            <div class=\"absolute z-10 right-16 bottom-16 flex items-center gap-3\" data-kid=\"1-1-7\" data-name=\"hero bottom-right cluster container\">\n                <div class=\"flex items-center gap-3 h-14 pl-2 pr-5 rounded-full bg-white/12 backdrop-blur-md border border-white/20\" data-kid=\"1-1-7-1\" data-name=\"performance team pill\">\n                    <div class=\"flex -space-x-2.5\" data-kid=\"1-1-7-1-1\" data-name=\"team avatar stack\">\n                        <img alt=\"Coach Amelia Carter\" class=\"w-10 h-10 rounded-full object-cover border-2 border-white/60\" data-kid=\"1-1-7-1-1-1\" data-name=\"coach Amelia Carter avatar thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/477df3f011ae43f3abe4c0cf588a828b.jpg\"/>\n                        <img alt=\"Dr. Daniel Morgan\" class=\"w-10 h-10 rounded-full object-cover border-2 border-white/60\" data-kid=\"1-1-7-1-1-2\" data-name=\"Dr Daniel Morgan avatar thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/b55145485cc54ff08d9f99147f426b26.jpg\"/>\n                        <img alt=\"Sophia Bennett\" class=\"w-10 h-10 rounded-full object-cover border-2 border-white/60\" data-kid=\"1-1-7-1-1-3\" data-name=\"Sophia Bennett avatar thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/082d9c34332646e7b8af0a283c122907.jpg\"/>\n                    </div>\n                    <div class=\"leading-tight\" data-kid=\"1-1-7-1-2\" data-name=\"team pill text block\">\n                        <p class=\"text-[13px] font-medium\" data-kid=\"1-1-7-1-2-1\" data-name=\"team pill status label\">\n                            Your performance team is live\n                        </p>\n                        <p class=\"text-[11px] text-white/70\" data-kid=\"1-1-7-1-2-2\" data-name=\"team pill categories subtitle\">\n                            Coaching · Sleep · Recovery\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <script>\n            (function(){const v=document.getElementById('heroVideo'),b=document.getElementById('heroToggle');\n    b.addEventListener('click',()=>{if(v.paused){v.play();b.innerHTML='<i class=\"ti ti-player-pause-filled\"></i>';b.setAttribute('aria-label','Pause video')}else{v.pause();b.innerHTML='<i class=\"ti ti-player-play-filled\"></i>';b.setAttribute('aria-label','Play video')}});})();\n        </script>\n        <!-- Centered statement -->\n        <section class=\"pt-32 text-center\" data-kid=\"1-4\" data-name=\"statement section\">\n            <h2 class=\"serif text-[60px] leading-[1.04] font-normal tracking-[-0.025em] max-w-[960px] mx-auto\" data-kid=\"1-4-1\" data-name=\"statement section headline\">\n                Everything Your Body Needs, One Simple Wearable\n            </h2>\n            <p class=\"mt-6 text-[19px] leading-[1.5] text-[#4A2A33] max-w-[640px] mx-auto\" data-kid=\"1-4-2\" data-name=\"statement section description\">\n                Experience 24/7 monitoring across sleep, strain, stress and heart health with personalized daily coaching.\n            </p>\n            <div class=\"mt-9 flex justify-center gap-2.5\" data-kid=\"1-4-3\" data-name=\"statement section CTA button row\">\n                <button class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[15px] hover:bg-[#45172A] transition\" data-kid=\"1-4-3-1\" data-name=\"why-aero-fit CTA button\">\n                    Why Aero Fit\n                </button>\n                <button class=\"h-12 px-6 rounded-full bg-[#2A0B14] text-white text-[15px] hover:bg-[#45172A] transition\" data-kid=\"1-4-3-2\" data-name=\"how-it-works CTA button\">\n                    How it works\n                </button>\n            </div>\n        </section>\n        <!-- Carousel -->\n        <section class=\"pt-20\" data-kid=\"1-5\" data-name=\"feature carousel\">\n            <div class=\"noscroll flex gap-6 overflow-x-auto snap-x snap-mandatory px-16 scroll-pl-16 scroll-smooth\" data-kid=\"1-5-1\" data-name=\"feature carousel track\" id=\"track\">\n                <article class=\"snap-start shrink-0 relative w-[392px] h-[500px] rounded-[18px] overflow-hidden group\" data-kid=\"1-5-1-1\" data-name=\"sleep feature carousel card\">\n                    <img alt=\"Sleep scientist reviewing sleep data\" class=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700\" data-kid=\"1-5-1-1-1\" data-name=\"sleep card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/b55145485cc54ff08d9f99147f426b26.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#2A0B14]/80 via-[#2A0B14]/10 to-[#2A0B14]/20\" data-kid=\"1-5-1-1-2\" data-name=\"sleep card gradient overlay\">\n                    </div>\n                    <span class=\"absolute left-5 top-5 h-11 px-4 rounded-full bg-[#2A0B14]/45 backdrop-blur-md text-white text-[13px] flex items-center gap-2\" data-kid=\"1-5-1-1-3\" data-name=\"sleep category pill\">\n                        <span class=\"text-[17px]\" data-kid=\"1-5-1-1-3-1\" data-name=\"sleep pill icon wrapper\">\n                            <i class=\"ti ti-moon\" data-kid=\"1-5-1-1-3-1-1\" data-name=\"moon icon\">\n                            </i>\n                        </span>\n                        Sleep\n                    </span>\n                    <button aria-label=\"Learn about sleep\" class=\"absolute right-5 top-5 w-11 h-11 rounded-full bg-[#FAF8F6] text-[#2A0B14] flex items-center justify-center text-[18px] hover:bg-[#F8F38A] transition\" data-kid=\"1-5-1-1-4\" data-name=\"sleep card learn-more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-5-1-1-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                    <h3 class=\"serif absolute left-6 right-6 bottom-6 text-white text-[32px] leading-[1.1] font-light\" data-kid=\"1-5-1-1-5\" data-name=\"sleep card headline\">\n                        Optimize your sleep, wake up ready\n                    </h3>\n                </article>\n                <article class=\"snap-start shrink-0 relative w-[392px] h-[500px] rounded-[18px] overflow-hidden group\" data-kid=\"1-5-1-2\" data-name=\"coaching feature carousel card\">\n                    <img alt=\"Aero Fit coach explaining\" class=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700\" data-kid=\"1-5-1-2-1\" data-name=\"coaching card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/1ea11b9725244f2587b3227b5fe5edc0.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#2A0B14]/80 via-[#2A0B14]/10 to-[#2A0B14]/20\" data-kid=\"1-5-1-2-2\" data-name=\"coaching card gradient overlay\">\n                    </div>\n                    <span class=\"absolute left-5 top-5 h-11 px-4 rounded-full bg-[#2A0B14]/45 backdrop-blur-md text-white text-[13px] flex items-center gap-2\" data-kid=\"1-5-1-2-3\" data-name=\"coaching category pill\">\n                        <span class=\"text-[17px]\" data-kid=\"1-5-1-2-3-1\" data-name=\"coaching pill icon wrapper\">\n                            <i class=\"ti ti-message-chatbot\" data-kid=\"1-5-1-2-3-1-1\" data-name=\"message-chatbot icon\">\n                            </i>\n                        </span>\n                        Coaching\n                    </span>\n                    <button aria-label=\"Learn about coaching\" class=\"absolute right-5 top-5 w-11 h-11 rounded-full bg-[#FAF8F6] text-[#2A0B14] flex items-center justify-center text-[18px] hover:bg-[#F8F38A] transition\" data-kid=\"1-5-1-2-4\" data-name=\"coaching card learn-more button\">\n                        <i class=\"ti ti-plus\" data-kid=\"1-5-1-2-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                    <h3 class=\"serif absolute left-6 right-6 bottom-6 text-white text-[32px] leading-[1.1] font-light\" data-kid=\"1-5-1-2-5\" data-name=\"coaching card headline\">\n                        Know when to push and when to recover\n                    </h