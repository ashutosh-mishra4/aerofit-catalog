"kbiz5yb\">50 m</div><div class=\"py-4 px-2 text-center\" data-kid=\"kqjq71o\">100 m</div></div></div>\n      <div class=\"border-t border-[#F3EFEC] px-6 py-4 flex items-center justify-between\" data-name=\"table footer\" data-kid=\"1-5-2-3\">\n        <p class=\"text-[13px] text-[#6B4F57] flex items-center gap-4\" data-kid=\"1-5-2-3-1\"><span class=\"flex items-center gap-1.5\" data-kid=\"1-5-2-3-1-1\"><i class=\"ti ti-check text-[16px]\" data-kid=\"1-5-2-3-1-1-1\"></i>Available</span><span class=\"flex items-center gap-1.5\" data-kid=\"1-5-2-3-1-2\"><i class=\"ti ti-minus text-[16px] text-[#C9C0C2]\" data-kid=\"1-5-2-3-1-2-1\"></i>Not available</span><span class=\"flex items-center gap-1.5\" data-kid=\"1-5-2-3-1-3\"><span class=\"w-3 h-3 rounded-sm bg-[#FBF7C8] border border-[#EFE7A8]\" data-kid=\"1-5-2-3-1-3-1\"></span>Relevant to your activity</span></p>\n        <button id=\"moreBtn\" data-act=\"more\" class=\"h-11 px-5 rounded-full border border-[#2A0B14]/30 text-[14px] font-medium hover:bg-[#F3EFEC]\" data-name=\"show all specs\" data-dynamic=\"true\" data-reason=\"label toggled by script\" data-kid=\"1-5-2-3-2\">Show all 16 specs</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- ═════ FOOTER ═════ -->\n  <footer class=\"relative mx-4 mt-[120px] rounded-[28px] bg-[#F3EDE9] overflow-hidden px-[88px] pt-20 pb-9\" data-name=\"site footer\" data-kid=\"1-6\">\n    <span class=\"fshape absolute -left-16 top-24 w-[180px] h-[180px] rounded-full border border-[#E3D9CF]\" data-depth=\"-20\" aria-hidden=\"true\" data-kid=\"1-6-1\" style=\"transform: translateY(-1.90201px);\"></span>\n    <span class=\"fshape absolute -right-10 bottom-24 w-[120px] h-[120px] rounded-full border border-[#E3D9CF]\" data-depth=\"-35\" aria-hidden=\"true\" data-kid=\"1-6-2\" style=\"transform: translateY(-3.32852px);\"><span class=\"absolute -top-1.5 left-1/2 w-3 h-3 rounded-full bg-[#F2E04F]\" data-kid=\"1-6-2-1\"></span></span>\n    <div class=\"relative grid grid-cols-[1.15fr_1fr] gap-16 items-end\" data-name=\"newsletter row\" data-kid=\"1-6-3\">\n      <div data-kid=\"1-6-3-1\">\n        <h3 class=\"serif text-[48px] leading-[1.05] font-medium tracking-[-0.02em]\" data-name=\"newsletter headline\" data-kid=\"1-6-3-1-1\">Get health tips in your inbox</h3>\n        <p class=\"mt-4 text-[16px] leading-[1.6] text-[#4A2A33] max-w-[460px]\" data-name=\"newsletter text\" data-kid=\"1-6-3-1-2\">Sleep, recovery and training insights from the Aero Fit performance team, every week.</p>\n        <form class=\"mt-7 max-w-[520px]\" onsubmit=\"return false\" data-name=\"newsletter form\" data-kid=\"1-6-3-1-3\">\n          <label for=\"em1\" class=\"text-[14px] font-medium\" data-kid=\"1-6-3-1-3-1\">Email address</label>\n          <div class=\"mt-2 h-[56px] rounded-full bg-white pl-5 pr-1.5 flex items-center gap-2\" data-kid=\"1-6-3-1-3-2\"><input id=\"em1\" type=\"email\" placeholder=\"name@example.com\" class=\"flex-1 bg-transparent outline-hidden text-[15px] placeholder:text-[#9A8E91]\" data-kid=\"1-6-3-1-3-2-1\"><button type=\"button\" class=\"h-11 px-6 rounded-full bg-[#F8F38A] text-[14px] font-semibold\" data-kid=\"1-6-3-1-3-2-2\">Subscribe</button></div>\n        </form>\n      </div>\n      <div class=\"flex items-end gap-5 justify-end\" data-name=\"five bands signature\" data-kid=\"1-6-3-2\">\n        <span id=\"countFive\" class=\"serif text-[200px] leading-[0.75] font-medium tracking-[-0.05em] tnum\" data-dynamic=\"true\" data-reason=\"count-up animation rewrites the number\" data-kid=\"1-6-3-2-1\">5</span>\n        <span class=\"serif text-[30px] leading-[1.1] pb-2 max-w-[8ch]\" data-kid=\"1-6-3-2-2\">Five bands, one app</span>\n      </div>\n    </div>\n    <div class=\"relative mt-16 pt-12 border-t border-[#2A0B14]/10 grid grid-cols-[1.4fr_1fr_1fr_1fr_1fr] gap-8 text-[15px]\" data-name=\"footer links\" data-kid=\"1-6-4\">\n      <div data-kid=\"1-6-4-1\"><span class=\"serif text-[26px] font-medium flex items-center gap-2\" data-kid=\"1-6-4-1-1\"><img alt=\"Aero Fit logo\" class=\"w-9 h-9\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\" data-kid=\"1-6-4-1-1-1\">Aero Fit</span></div>\n      <div data-kid=\"1-6-4-2\"><p class=\"text-[14px] font-medium text-[#7A5B64] mb-4\" data-kid=\"1-6-4-2-1\">Shop</p><ul class=\"space-y-2.5\" data-kid=\"1-6-4-2-2\"><li data-kid=\"1-6-4-2-2-1\"><a href=\"#lineup\" data-kid=\"1-6-4-2-2-1-1\">Aero Fit Lite</a></li><li data-kid=\"1-6-4-2-2-2\"><a href=\"#lineup\" data-kid=\"1-6-4-2-2-2-1\">Aero Fit Smart</a></li><li data-kid=\"1-6-4-2-2-3\"><a href=\"#lineup\" data-kid=\"1-6-4-2-2-3-1\">Aero Fit Pro</a></li><li data-kid=\"1-6-4-2-2-4\"><a href=\"#lineup\" data-kid=\"1-6-4-2-2-4-1\">Aero Fit Music</a></li><li data-kid=\"1-6-4-2-2-5\"><a href=\"#lineup\" data-kid=\"1-6-4-2-2-5-1\">Aero Fit Ultra</a></li></ul></div>\n      <div data-kid=\"1-6-4-3\"><p class=\"text-[14px] font-medium text-[#7A5B64] mb-4\" data-kid=\"1-6-4-3-1\">Memberships</p><ul class=\"space-y-2.5\" data-kid=\"1-6-4-3-2\"><li data-kid=\"1-6-4-3-2-1\"><a href=\"#plans\" data-kid=\"1-6-4-3-2-1-1\">Aero Fit One</a></li><li data-kid=\"1-6-4-3-2-2\"><a href=\"#plans\" data-kid=\"1-6-4-3-2-2-1\">Aero Fit Peak</a></li><li data-kid=\"1-6-4-3-2-3\"><a href=\"#plans\" data-kid=\"1-6-4-3-2-3-1\">Aero Fit Life</a></li><li data-kid=\"1-6-4-3-2-4\"><a href=\"#compare\" data-kid=\"1-6-4-3-2-4-1\">Compare plans</a></li></ul></div>\n      <div data-kid=\"1-6-4-4\"><p class=\"text-[14px] font-medium text-[#7A5B64] mb-4\" data-kid=\"1-6-4-4-1\">Support</p><ul class=\"space-y-2.5\" data-kid=\"1-6-4-4-2\"><li data-kid=\"1-6-4-4-2-1\"><a href=\"#\" data-kid=\"1-6-4-4-2-1-1\">Help Center</a></li><li data-kid=\"1-6-4-4-2-2\"><a href=\"#\" data-kid=\"1-6-4-4-2-2-1\">Sizing guide</a></li><li data-kid=\"1-6-4-4-2-3\"><a href=\"#\" data-kid=\"1-6-4-4-2-3-1\">Accessories</a></li><li data-kid=\"1-6-4-4-2-4\"><a href=\"#\" data-kid=\"1-6-4-4-2-4-1\">Download App</a></li></ul></div>\n      <div data-kid=\"1-6-4-5\"><p class=\"text-[14px] font-medium text-[#7A5B64] mb-4\" data-kid=\"1-6-4-5-1\">Connect</p><ul class=\"space-y-2.5\" data-kid=\"1-6-4-5-2\"><li data-kid=\"1-6-4-5-2-1\"><a href=\"#\" data-kid=\"1-6-4-5-2-1-1\">Instagram</a></li><li data-kid=\"1-6-4-5-2-2\"><a href=\"#\" data-kid=\"1-6-4-5-2-2-1\">YouTube</a></li><li data-kid=\"1-6-4-5-2-3\"><a href=\"#\" data-kid=\"1-6-4-5-2-3-1\">Podcast</a></li><li data-kid=\"1-6-4-5-2-4\"><a href=\"#\" data-kid=\"1-6-4-5-2-4-1\">Contact</a></li></ul></div>\n    </div>\n    <div class=\"relative mt-12 h-14 rounded-full bg-white px-6 flex items-center justify-between text-[13px] text-[#4A2A33]\" data-name=\"legal bar\" data-kid=\"1-6-5\">\n      <div class=\"flex gap-6\" data-kid=\"1-6-5-1\"><a href=\"#\" data-kid=\"1-6-5-1-1\">Terms &amp; Conditions</a><a href=\"#\" data-kid=\"1-6-5-1-2\">Privacy Policy</a><a href=\"#\" data-kid=\"1-6-5-1-3\">Accessibility</a></div><span data-kid=\"1-6-5-2\">© 2026 Aero Fit. All rights reserved.</span>\n    </div>\n    <p class=\"relative mt-5 px-2 text-[13px] leading-[1.65] text-[#4A2A33] max-w-[900px]\" data-name=\"disclaimer\" data-kid=\"1-6-6\">Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. Membership plans are billed annually with a 12-month minimum term.</p>\n  </footer>\n</div>\n\n<script>\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',line:'Titanium case, dual-band GPS and 14 days of battery for multi-day races and long training blocks.',peek:[['Battery','14 days'],['GPS','Dual-band'],['Water','100 m'],['Case','Titanium, 32 g']],price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',bg:'radial-gradient(circle at 50% 55%,#F8F38A 0%,#FBF4B8 38%,#F4F1EE 76%)',ship:'Ships Nov 4'},\n{id:'pro',n:'Pro',line:'Built-in GPS and ECG for structured training without your phone.',peek:[['Battery','10 days'],['GPS','Built-in'],['ECG','Heart Screener'],['Workouts','120 types']],price:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',bg:'#F4F1EE'},\n{id:'lite',n:'Lite',line:'Featherweight tracking for sleep, steps and daily recovery.',peek:[['Weight','18 g'],['Battery','5 days'],['GPS','Via phone'],['Display','Mono OLED']],price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',bg:'#F4F1EE'},\n{id:'smart',n:'Smart',line:'Everyday sleep, strain and recovery on an always-on display.',peek:[['Weight','24 g'],['Battery','7 days'],['Skin temp','Yes'],['Display','AMOLED']],price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',bg:'#F4F1EE'},\n{id:'music',n:'Music',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',peek:[['Storage','4 GB · ~500 songs'],['Audio','Bluetooth headphones'],['Battery','6 days'],['GPS','Built-in']],price:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',bg:'#F4F1EE'}];\nconst ORDER=['lite','smart','pro','music','ultra'];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={sleep:{n:'sleep',img:'https://images.pexels.com/photos/6963181/pexels-photo-6963181.jpeg?auto=compress&cs=tinysrgb&w=300&q=80',alt:'Hand reaching for the bedside in morning light, photo by cottonbro studio on Pexels',fit:['lite','smart'],rows:['sleep','temp','weight','battery']},\n training:{n:'training',img:'https://images.unsplash.com/photo-1630254608294-d844a0242357?auto=format&w=300&q=80&fit=crop',alt:'Man training on a forest path, photo by Alex Gagareen on Unsplash',fit:['pro','ultra'],rows:['gps','modes','ecg','recovery']},\n music:{n:'music',img:'https://images.pexels.com/photos/18823179/pexels-photo-18823179.jpeg?auto=compress&cs=tinysrgb&w=300&q=80',alt:'Woman walking with headphones, photo by Fatih Güney on Pexels',fit:['music','pro'],rows:['storage','bt','gps']},\n endurance:{n:'endurance',img:'https://images.unsplash.com/photo-1745692607831-66df9207b8bc?auto=format&w=300&q=80&fit=crop',alt:'Hiker resting on a mountain ridge, photo by Haroon Khalid on Unsplash',fit:['ultra','pro'],rows:['battery','gps','water','case']}};\nconst ROWS=[['battery','Battery life',['5 days','7 days','10 days','6 days','14 days'],1],['gps','GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],['ecg','ECG with Heart Screener',[0,0,1,0,1],1],['storage','Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],['case','Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],['weight','Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],['outright','Buy outright',['$149','$199','$279','$299','$399'],1],['incl','Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only'],1],['display','Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],['water','Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],['sleep','Sleep stages & Sleep Performance',[1,1,1,1,1],0],['recovery','Recovery & Strain scores',[1,1,1,1,1],0],['temp','Skin temperature',[0,1,1,1,1],0],['bp','Blood Pressure Insights',[0,0,1,0,1],0],['modes','Workout types',['20','40','120','80','150'],0],['bt','Bluetooth headphones',[0,0,0,1,0],0]];\nconst SIZE={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet mode='out',plan=2,use='endurance',cart=0,more=false,lastAdd='',q={use:'training',night:'light',pay:'mem'};\nconst $=id=>document.getElementById(id);const byId=i=>P.find(p=>p.id===i);const cap=s=>s[0].toUpperCase()+s.slice(1);\n\nfunction priceBlock(p){\n if(mode==='out')return `<p class=\"serif text-[30px] font-medium leading-none tnum\">$${p.price}</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">One-time · free returns</p>`;\n if(plan>=p.min){const[n,mo,yr]=PL[plan];return `<p class=\"serif text-[30px] font-medium leading-none tnum\">$0 <span class=\"sans text-[14px] font-medium text-[#6B4F57]\">band</span></p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">With ${n} · $${yr}/year ($${mo}/mo)</p>`}\n return `<p class=\"serif text-[22px] font-medium leading-tight\">Included with ${PL[p.min][0]}</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">Not part of ${PL[plan][0]} · $${PL[p.min][2]}/year</p>`;\n}\nfunction renderLineup(){\n $('lineNote').innerHTML=mode==='out'?'Every band runs the same Aero Fit app, coaching and Recovery scores. Buy one outright and add a membership any time.':`On a membership the band is included. Example: <b class=\"font-medium text-[#2A0B14]\">Pro on Peak is $0 for the band, $299 billed today</b>, 12-month minimum.`;\n $('actPills').innerHTML=Object.keys(USE).map(k=>`<button data-act=\"use\" data-use=\"${k}\" class=\"h-11 px-5 rounded-full text-[14px] font-medium border transition ${k===use?'bg-[#F8F38A] border-[#E9DF5A]':'border-[#E3DDDA] hover:bg-[#FAF8F6]'}\">${cap(k)}</button>`).join('');\n $('modePills').innerHTML=[['out','Buy outright'],['mem','With membership']].map(([k,l])=>`<button data-act=\"mode\" data-mode=\"${k}\" class=\"h-10 px-5 rounded-full transition ${mode===k?'bg-white shadow-[0_1px_4px_rgba(42,11,20,0.1)]':'text-[#6B4F57]'}\">${l}</button>`).join('');\n $('planRow').innerHTML=mode==='mem'?[1,2,3].map(t=>`<button data-act=\"plan\" data-plan=\"${t}\" class=\"h-9 px-3.5 rounded-full border transition ${t===plan?'border-[#2A0B14] bg-[#FBF7C8] font-medium':'border-[#E3DDDA] hover:bg-[#FAF8F6]'}\">${PL[t][0]} · $${PL[t][2]}/year</button>`).join(''):'<span class=\"h-9\"></span>';\n $('useRail').innerHTML=Object.entries(USE).map(([k,u])=>`<button data-act=\"use\" data-use=\"${k}\" class=\"text-left rounded-[18px] p-2.5 pr-4 flex items-center gap-3.5 transition ${k===use?'bg-[#FBF7C8]':'bg-[#FAF8F6] hover:bg-[#F3EFEC]'}\"><img src=\"${u.img}\" alt=\"${u.alt}\" class=\"w-[64px] h-[64px] rounded-[12px] object-cover shrink-0\" decoding=\"async\" loading=\"lazy\"><span><span class=\"serif text-[19px] font-medium block leading-tight\">Shop for ${u.n}</span><span class=\"text-[13px] text-[#4A2A33]\">${u.fit.map(i=>byId(i).n).join(' and ')} suit this best</span></span></button>`).join('');\n $('grid').innerHTML=P.map(p=>{const fit=USE[use].fit.includes(p.id);const blocked=mode==='mem'&&plan<p.min;return `<article class=\"card relative\" data-card=\"${p.id}\" data-name=\"${p.n} product\">\n  <div class=\"tiltwrap relative\"><div class=\"tilt relative aspect-[4/3] rounded-[22px] overflow-hidden flex items-center justify-center\" style=\"background:${p.bg}\">\n   <img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} product photo\" class=\"w-[68%] h-[86%] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\">\n   ${p.ship?`<span class=\"absolute left-3.5 top-3.5 text-[13px] font-medium bg-white rounded-full px-3 py-1\">${p.ship}</span>`:''}\n   ${fit?`<span class=\"absolute left-3.5 bottom-3.5 text-[13px] font-medium bg-[#F8F38A] rounded-full px-3 py-1\">Good for ${use}</span>`:''}\n  </div>\n  <div class=\"peek absolute inset-3 rounded-[16px] bg-[#FAF8F6] p-5 flex flex-col justify-between\"><p class=\"serif text-[20px] font-medium\">Aero Fit ${p.n} at a glance</p><dl class=\"grid grid-cols-2 gap-x-4 gap-y-3\">${p.peek.map(([k,v])=>`<div><dt class=\"text-[13px] text-[#6B4F57]\">${k}</dt><dd class=\"text-[15px] font-medium\">${v}</dd></div>`).join('')}</dl></div></div>\n  <div class=\"mt-5 flex items-start justify-between gap-4\"><h3 class=\"serif text-[28px] leading-none font-medium\">Aero Fit ${p.n}</h3><button data-act=\"specs\" data-id=\"${p.id}\" class=\"text-[13px] font-medium underline underline-offset-4 shrink-0 mt-1.5\">View specs</button></div>\n  <p class=\"mt-2.5 text-[15px] leading-[1.5] text-[#4A2A33] min-h-[45px]\">${p.line}</p>\n  <div class=\"mt-5 flex items-end justify-between gap-3\"><div>${priceBlock(p)}</div>\n   <div class=\"text-right\"><div class=\"flex gap-1 justify-end\">${p.c.map((c,j)=>`<button data-act=\"color\" data-id=\"${p.id}\" data-i=\"${j}\" aria-label=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${j===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div><p class=\"mt-1 text-[13px] text-[#6B4F57]\">${p.c[p.ci][0]}</p></div></div>\n  <div class=\"mt-4 flex items-center gap-2\"><div class=\"h-11 p-1 rounded-full bg-[#F3EFEC] flex\" aria-label=\"Size\">${['S','M','L'].map(s=>`<button data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" class=\"w-9 rounded-full text-[13px] font-medium ${s===p.s?'bg-white shadow-[0_1px_4px_rgba(42,11,20,0.12)]':'text-[#6B4F57]'}\">${s}</button>`).join('')}</div>\n   ${blocked?`<button data-act=\"plan\" data-plan=\"${p.min}\" class=\"flex-1 h-11 rounded-full border border-[#2A0B14]/30 text-[14px] font-medium\">Switch to ${PL[p.min][0]} · $${PL[p.min][2]}/year</button>`:`<button data-act=\"add\" data-id=\"${p.id}\" class=\"flex-1 h-11 rounded-full border border-[#2A0B14]/30 text-[14px] font-medium hover:bg-[#F8F38A] hover:border-[#E9DF5A] transition flex items-center justify-center gap-1.5\"><i class=\"ti ti-shopping-bag\"></i>Add ${p.n} to cart</button>`}</div>\n  <p class=\"mt-2 text-[13px] text-[#6B4F57]\">Size ${p.s} fits wrists ${SIZE[p.s]}${lastAdd===p.id?` · <b class=\"font-medium text-[#2A0B14]\">Added ${p.n}, ${p.c[p.ci][0]}, size ${p.s}${mode==='mem'?' on '+PL[plan][0]:''}</b>`:''}</p>\n </article>`}).join('')+`<a href=\"#compare\" class=\"rounded-[22px] border-2 border-dashed border-[#E3D9CF] flex flex-col items-center justify-center text-center aspect-[4/3] hover:bg-[#FAF8F6] transition\" data-name=\"compare all tile\"><span class=\"serif text-[28px] font-medium\">Compare all five bands</span><span class=\"mt-1.5 text-[15px] text-[#4A2A33] flex items-center gap-1.5\">16 specs side by side <i class=\"ti ti-arrow-right\"></i></span></a>`;\n bindTilt();\n}\nconst Q=[['use','What will you use it for most?',[['sleep','Sleep'],['training','Training'],['music','Music on runs'],['endurance','Long days outdoors']]],['night','How do you feel about wearing it overnight?',[['light','I want the lightest band'],['any',\"Weight doesn't matter\"]]],['pay','How would you like to pay?',[['out','Buy the band outright'],['mem','Include it in a membership']]]];\nconst PAIRS={sleep:{light:['lite','smart'],any:['smart','pro']},training:{light:['pro','smart'],any:['pro','ultra']},music:{light:['music','smart'],any:['music','pro']},endurance:{light:['pro','smart'],any:['ultra','pro']}};\nconst WHY={lite:'18 g, the lightest band',smart:'24 g with skin temperature',pro:'built-in GPS and ECG, no onboard music',ultra:'14-day battery, dual-band GPS',music:'4 GB of onboard music'};\nfunction renderQuiz(){\n $('quiz').innerHTML=Q.map(([k,t,o],i)=>`<div class=\"p-6\"><p class=\"text-[13px] text-[#6B4F57]\">Question ${i+1} of 3</p><p class=\"mt-1 serif text-[22px] font-medium\">${t}</p><div class=\"mt-3.5 flex flex-wrap gap-2\">${o.map(([v,l])=>`<button data-act=\"q\" data-k=\"${k}\" data-v=\"${v}\" class=\"h-11 px-5 rounded-full text-[14px] font-medium border transition ${q[k]===v?'bg-[#F8F38A] border-[#E9DF5A]':'border-[#E3DDDA] hover:bg-[#FAF8F6]'}\">${l}</button>`).join('')}</div></div>`).join('');\n const pair=PAIRS[q.use][q.night].map(byId);\n const payNote=q.pay==='out'?`$${pair[0].price} and $${pair[1].price} outright`:pair.map(p=>`${p.n} from $0 on ${PL[p.min][0]} ($${PL[p.min][2]}/year)`).join(', ');\n $('quizResult').innerHTML=`<div class=\"flex items-center justify-between gap-6\"><div><p class=\"text-[14px] text-[#4A2A33]\">Start by comparing</p><p class=\"serif text-[34px] font-medium leading-tight\">${pair[0].n} and ${pair[1].n}</p></div><div class=\"flex gap-2\">${pair.map(p=>`<span class=\"w-[68px] h-[68px] rounded-full bg-white flex items-center justify-center\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n}\" class=\"w-12 h-12 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"></span>`).join('')}</div></div>\n <ul class=\"mt-4 text-[15px] space-y-1.5\">${pair.map(p=>`<li><b class=\"font-medium\">${p.n}:</b> ${WHY[p.id]}</li>`).join('')}</ul>\n <div class=\"mt-5 pt-4 border-t border-[#2A0B14]/10 flex items-center justify-between gap-4\"><p class=\"text-[14px] text-[#4A2A33]\">${payNote}.</p><button data-act=\"use\" data-use=\"${q.use}\" data-go=\"compare\" class=\"shrink-0 h-11 px-5 rounded-full bg-white text-[14px] font-semibold flex items-center gap-2\">Compare ${pair[0].n} and ${pair[1].n} <i class=\"ti ti-arrow-right\"></i></button></div>`;\n}\nfunction renderPlans(){\n $('planList').innerHTML=[1,2,3].map(t=>{const bands=ORDER.filter(i=>byId(i).min<=t);const on=mode==='mem'&&plan===t;return `<div class=\"relative\" data-name=\"${PL[t][0]} plan\">\n  <span class=\"absolute -left-[64px] top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-[#F8F38A] border-4 border-[#FAF8F6] ring-1 ring-[#E9DF5A]\"></span>\n  <div class=\"bg-white rounded-[22px] border border-[#EFEAE6] grid grid-cols-[240px_1fr_auto] items-center overflow-hidden\">\n   <div class=\"p-7 h-full ${on?'bg-[#F8F38A]':'bg-[#FAF8F6]'} transition\"><p class=\"serif text-[30px] font-medium leading-none\">Aero Fit ${PL[t][0]}</p><p class=\"mt-3 serif text-[40px] font-medium leading-none tnum\">$${PL[t][2]}<span class=\"sans text-[15px] font-medium text-[#4A2A33]\">/year</span></p><p class=\"mt-1.5 text-[13px] text-[#4A2A33]\">$${PL[t][1]}/mo · band included at $0</p></div>\n   <div class=\"px-8 py-6\"><p class=\"text-[14px] text-[#6B4F57]\">Includes ${bands.length===5?'all five bands':bands.map(i=>byId(i).n).join(', ')}</p><div class=\"mt-3 flex gap-2.5\">${bands.map(i=>`<span class=\"flex flex-col items-center gap-1\"><span class=\"w-[60px] h-[60px] rounded-[14px] bg-[#F4F1EE] flex items-center justify-center\"><img src=\"${IMG[i]}\" alt=\"Aero Fit ${byId(i).n}\" class=\"w-11 h-11 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"></span><span class=\"text-[13px]\">${byId(i).n}</span></span>`).join('')}</div></div>\n   <div class=\"pr-7 flex flex-col items-end gap-2.5\">${on?'<span class=\"h-11 px-5 rounded-full bg-[#FBF7C8] text-[14px] font-semibold flex items-center gap-1.5\"><i class=\"ti ti-check\"></i>Selected</span>':`<button data-act=\"plan\" data-plan=\"${t}\" class=\"h-11 px-5 rounded-full border border-[#2A0B14]/30 text-[14px] font-medium hover:bg-[#FAF8F6]\">Use ${PL[t][0]} pricing</button>`}<a href=\"#lineup\" class=\"text-[13px] font-medium underline underline-offset-4\">View bands on ${PL[t][0]}</a></div>\n  </div></div>`}).join('');\n}\nfunction renderTable(){\n const U=USE[use];\n $('useChips').innerHTML=Object.keys(USE).map(k=>`<button data-act=\"use\" data-use=\"${k}\" class=\"h-10 px-4 rounded-full text-[14px] font-medium border transition ${k===use?'bg-[#F8F38A] border-[#E9DF5A]':'bg-white border-[#EFEAE6] hover:bg-[#F3EFEC]'}\">${cap(k)}</button>`).join('');\n $('tableNote').innerHTML=`The rows that decide most purchases come first. Rows for ${U.n} are highlighted.`;\n $('tHead').innerHTML='<div class=\"p-6 flex items-end text-[14px] text-[#6B4F57]\">'+(mode==='out'?'Buy outright':'With '+PL[plan][0]+' · $'+PL[plan][2]+'/year')+'</div>'+ORDER.map(i=>{const p=byId(i);const hp=mode==='out'?'$'+p.price:(plan>=p.min?'$0 band':'Needs '+PL[p.min][0]);return `<div class=\"p-5 flex flex-col items-center text-center\"><img src=\"${IMG[i]}\" alt=\"Aero Fit ${p.n}\" class=\"w-16 h-16 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"><p class=\"mt-2 serif text-[21px] font-medium\">${p.n}</p><p class=\"text-[14px] text-[#4A2A33] tnum\">${hp}</p>${U.fit.includes(i)?`<p class=\"mt-1.5 text-[13px] font-medium bg-[#F8F38A] rounded-full px-2.5 py-0.5\">Good for ${U.n}</p>`:''}</div>`}).join('');\n const cell=v=>v===1?'<span class=\"text-[18px] flex justify-center\" title=\"Available\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[16px] flex justify-center text-[#C9C0C2]\" title=\"Not available\"><i class=\"ti ti-minus\"></i></span>':v;\n $('tBody').innerHTML=ROWS.filter(r=>r[3]||more||U.rows.includes(r[0])).map(([k,l,v],ri)=>{const hi=U.rows.includes(k);return `<div class=\"grid grid-cols-[280px_repeat(5,1fr)] text-[15px] tnum ${ri?'border-t border-[#F3EFEC]':''} ${hi?'bg-[#FBF7C8]':''}\"><p class=\"px-6 py-4 ${hi?'font-medium':'text-[#4A2A33]'}\">${l}</p>${v.map(x=>`<div class=\"py-4 px-2 text-center\">${cell(x)}</div>`).join('')}</div>`}).join('');\n $('moreBtn').textContent=more?'Show fewer specs':'Show all 16 specs';\n}\nfunction render(){renderLineup();renderQuiz();renderPlans();renderTable();}\nfunction bindTilt(){document.querySelectorAll('.card').forEach(c=>{const t=c.querySelector('.tilt');const w=c.querySelector('.tiltwrap');w.onmousemove=e=>{const r=w.getBoundingClientRect();t.style.setProperty('--mx',(e.clientX-r.left)/r.width-.5);t.style.setProperty('--my',(e.clientY-r.top)/r.height-.5)};w.onmouseleave=()=>{t.style.setProperty('--mx',0);t.style.setProperty('--my',0)}});}\ndocument.addEventListener('click',e=>{const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=byId(t.dataset.id);\n if(a==='specs'){t.closest('.card').classList.toggle('show-specs');return;}\n if(a==='use'){use=t.dataset.use;if(t.dataset.go)$('compare').scrollIntoView({behavior:'smooth'});}\n else if(a==='mode')mode=t.dataset.mode;else if(a==='plan'){plan=+t.dataset.plan;mode='mem'}\n else if(a==='color')p.ci=+t.dataset.i;else if(a==='size')p.s=t.dataset.s;else if(a==='more')more=!more;else if(a==='q')q[t.dataset.k]=t.dataset.v;\n else if(a==='add'){cart++;lastAdd=p.id;$('cartCount').textContent=cart;$('cartCount').className='min-w-8 h-8 px-2 rounded-full bg-[#F8F38A] text-[13px] font-semibold flex items-center justify-center';}\n render();});\nrender();\n/* stack scale + footer drift + count-up */\nconst panels=[...document.querySelectorAll('.panel')];\nfunction update(){const vh=innerHeight;panels.forEach((p,i)=>{if(i<panels.length-1){const nr=panels[i+1].getBoundingClientRect();const pr=Math.min(1,Math.max(0,1-(nr.top-16)/vh));p.style.transform=`scale(${1-pr*0.015})`;}});\n const fr=document.querySelector('footer').getBoundingClientRect();document.querySelectorAll('.fshape').forEach(s=>s.style.transform=`translateY(${Math.max(-1,Math.min(1,(vh-fr.top)/vh))*(+s.dataset.depth)}px)`);}\nlet tk=false;addEventListener('scroll',()=>{if(!tk){requestAnimationFrame(()=>{update();tk=false});tk=true}},{passive:true});update();\nconst cf=$('countFive');new IntersectionObserver((es,o)=>es.forEach(en=>{if(!en.isIntersecting)return;let n=0;cf.textContent='0';const iv=setInterval(()=>{n++;cf.textContent=n;if(n>=5)clearInterval(iv)},140);o.disconnect();}),{threshold:.4}).observe(cf);\n</script>\n",
