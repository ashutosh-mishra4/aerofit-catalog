    "node_14476bf4b90d": {
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.ease{transition-timing-function:cubic-bezier(.16,.84,.44,1);}\n.starshape{clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);}\n.sparkle{clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%);}\n/* hero */\n.hero .ring{position:absolute;top:50%;left:50%;border-radius:50%;transform:translate(-50%,-50%);border:1px solid rgba(42,11,20,.12);}\n.hero .r1{width:1180px;height:1180px;animation:spin 64s linear infinite}\n.hero .r2{width:800px;height:800px;border-color:rgba(200,85,61,.22);animation:spin 44s linear infinite reverse}\n.hero .r3{width:470px;height:470px;border-color:rgba(107,123,78,.25);animation:spin 30s linear infinite}\n.hero .planet{position:absolute;top:-8px;left:50%;width:16px;height:16px;border-radius:50%;transform:translateX(-50%)}\n@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}\n.hero-bg{animation:kenburns 22s ease-in-out infinite alternate;}\n@keyframes kenburns{from{transform:scale(1.02)}to{transform:scale(1.1) translateY(-10px)}}\n.hero .ln{display:block;overflow:hidden;padding-bottom:.06em}\n.hero .ln>span{display:block;transform:translateY(116%);transition:transform 1s cubic-bezier(.16,.84,.44,1)}\n.hero .ln:nth-child(2)>span{transition-delay:.12s}\n.hero.is-in .ln>span{transform:none}\n.hero .stg{opacity:0;transform:translateY(16px);transition:opacity .8s cubic-bezier(.16,.84,.44,1),transform .8s cubic-bezier(.16,.84,.44,1)}\n.hero.is-in .stg{opacity:1;transform:none}\n.hero.is-in .stg.d1{transition-delay:.05s}.hero.is-in .stg.d2{transition-delay:.5s}.hero.is-in .stg.d3{transition-delay:.62s}.hero.is-in .stg.d4{transition-delay:.74s}\n.bob{animation:bob 2.4s cubic-bezier(.16,.84,.44,1) infinite}\n@keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,7px)}}\n/* catalog */\n.clip-i{display:inline-block;clip-path:inset(0 100% 0 0);transition:clip-path 1s cubic-bezier(.16,.84,.44,1)}\n.is-in .clip-i{clip-path:inset(0 0 0 0)}\n.grid-scene{perspective:1500px}\n.band{transform-style:preserve-3d;transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(var(--zsep,0px));transition:transform .3s cubic-bezier(.16,.84,.44,1)}\n.band.rise{opacity:1}\n.band:hover{transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(calc(var(--zsep,0px) + 50px)) scale(1.02)}\n.band .peek{opacity:0;transition:opacity .4s ease}\n.band:hover .peek{opacity:1}\n/* stack panels */\n.panel-inner{transition:filter .7s cubic-bezier(.16,.84,.44,1),opacity .7s cubic-bezier(.16,.84,.44,1)}\n.panel.locked .panel-inner{filter:none;opacity:1}\n/* events-style timeline */\n.spine{background:repeating-linear-gradient(180deg,#6B7B4E 0 10px,transparent 10px 18px);transform:scaleY(0);transform-origin:top center}\n.ev{transition:opacity .8s ease,transform .8s cubic-bezier(.16,.84,.44,1)}\n.ev.rise{opacity:1;transform:none}\n.ev-h2{transform:translateY(34px) skewY(5deg);opacity:0;transition:transform 1s cubic-bezier(.16,.84,.44,1),opacity 1s ease}\n.is-in .ev-h2{transform:none;opacity:1}\n.reveal{transition:opacity .9s ease,transform .9s cubic-bezier(.16,.84,.44,1)}\n.reveal.rise{opacity:1;transform:none}\n.lift{transition:transform .35s cubic-bezier(.16,.84,.44,1),background .35s ease}\n.lift:hover{transform:translateY(-3px)}\n/* hero band playlist */\n.hv{opacity:0;transition:opacity .55s ease}\n.hv.on{opacity:1;z-index:2}\n.hv.was{opacity:1;z-index:1;transition:none}\n.hl{opacity:0;transform:translateY(-10px);transition:opacity .18s ease,transform .25s ease}\n.hl.on{opacity:1;transform:none;transition:opacity .45s ease .22s,transform .7s cubic-bezier(.16,.84,.44,1) .22s}\n.hl:not(.on){transform:translateY(-10px)}\n.hl.on~.hl:not(.on),.hl:not(.on){pointer-events:none}\n.hc{opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .18s ease,transform .25s ease,background-color .3s ease}\n.hc.on{opacity:1;transform:none;pointer-events:auto;transition:opacity .4s ease .2s,transform .6s cubic-bezier(.16,.84,.44,1) .2s,background-color .3s ease}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip pb-4\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- ═════════ HERO ═════════ -->\n<section class=\"hero relative mx-4 mt-4 h-[880px] rounded-[28px] overflow-hidden flex flex-col justify-center isolate bg-[#F3EDE9] is-in\" data-kid=\"1-1\" data-name=\"hero section\" id=\"hero\">\n<div class=\"absolute inset-0 overflow-hidden\" data-kid=\"1-1-1\" data-name=\"hero background\" style=\"transform: translateY(0px) scale(1);\">\n<video aria-label=\"Woman checking her Aero Fit Pro mid-workout in a gym\" autoplay=\"\" class=\"hv absolute inset-0 w-full h-full object-cover object-left on\" data-band=\"pro\" data-kid=\"1-1-1-1\" data-name=\"Pro gym video\" id=\"heroBg\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/e876560358da44b0adf65507683a795a.mp4\"></video>\n<video aria-label=\"Woman waking up wearing her Aero Fit Lite\" class=\"hv absolute inset-0 w-full h-full object-cover object-left\" data-band=\"lite\" data-kid=\"1-1-1-2\" data-name=\"Lite morning video\" muted=\"\" playsinline=\"\" preload=\"auto\" src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/5f2c10d65df84821ae27987022fb2fd6.mp4\"></video>\n<video aria-label=\"Trekker checking his Aero Fit Ultra in heavy rain\" class=\"hv absolute inset-0 w-full h-full object-cover object-left\" data-band=\"u