    "node_29b3fba6548a": {
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.tnum{font-variant-numeric:tabular-nums lining-nums;}\n.ring{position:absolute;left:50%;top:50%;border-radius:50%;border:1px solid #E6DCD3;transform:translate(-50%,-50%);}\n.spin-a{animation:spin 90s linear infinite}.spin-b{animation:spin 64s linear infinite reverse}.spin-c{animation:spin 48s linear infinite}\n@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}\n.mark{position:absolute;top:-5px;left:50%;width:10px;height:10px;border-radius:50%;transform:translateX(-50%);}\n.tiltwrap{perspective:1100px}\n.tilt{transform:rotateX(calc(var(--my,0) * -3deg)) rotateY(calc(var(--mx,0) * 3deg));transition:transform .35s cubic-bezier(.16,.84,.44,1);}\n.peek{opacity:0;transform:translateY(8px);transition:opacity .3s ease,transform .3s ease;pointer-events:none}\n.card:hover .peek,.card.show-specs .peek{opacity:1;transform:none;pointer-events:auto}\n.panel{transform-origin:center top;}\n</style>\n\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-x-clip pb-6\" data-name=\"page layout container\" data-kid=\"1\">\n\n  <!-- ═════ HERO ═════ -->\n  <section id=\"hero\" class=\"relative mx-4 mt-4 h-[800px] rounded-[28px] overflow-hidden bg-[#FAF8F6] border border-[#EFEAE6]\" data-name=\"hero with landscape\" data-kid=\"1-1\">\n    <div class=\"absolute inset-0 pointer-events-none\" aria-hidden=\"true\" data-name=\"orbit rings\" data-kid=\"1-1-1\">\n      <span class=\"ring spin-a w-[1240px] h-[1240px] top-[46%]\" data-kid=\"1-1-1-1\"><span class=\"mark bg-[#F2E04F]\" data-kid=\"1-1-1-1-1\"></span></span>\n      <span class=\"ring spin-b w-[880px] h-[880px] top-[46%]\" data-kid=\"1-1-1-2\"><span class=\"mark bg-[#C8553D] !w-2 !h-2\" data-kid=\"1-1-1-2-1\"></span></span>\n      <span class=\"ring spin-c w-[560px] h-[560px] top-[46%]\" data-kid=\"1-1-1-3\"><span class=\"mark bg-[#6B7B4E] !w-2 !h-2\" data-kid=\"1-1-1-3-1\"></span></span>\n    </div>\n    <div class=\"absolute left-0 right-0 bottom-0 h-[350px] [mask-image:linear-gradient(to_bottom,transparent_0%,black_38%)]\" data-name=\"landscape band\" data-kid=\"1-1-2\">\n      <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/6e534848bbfc4491a89e450a0aa3dae5.jpg\" alt=\"Trail runner crossing a grassy ridge at sunrise\" class=\"w-full h-full object-cover object-[50%_88%]\" decoding=\"async\" loading=\"lazy\" data-name=\"sunrise ridge photograph\" data-kid=\"1-1-2-1\">\n    </div>\n\n    <header class=\"relative z-20 mx-5 mt-5 h-[64px] rounded-full bg-white border border-[#EFEAE6] pl-7 pr-2 flex items-center justify-between\" data-name=\"top navigation bar\" data-kid=\"1-1-3\">\n      <div class=\"flex items-center gap-7\" data-name=\"brand and nav\" data-kid=\"1-1-3-1\">\n        <span class=\"serif text-[22px] font-medium tracking-tight flex items-center gap-2\" data-name=\"logo\" data-kid=\"1-1-3-1-1\"><img alt=\"Aero Fit logo\" class=\"w-8 h-8\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\" data-kid=\"1-1-3-1-1-1\">Aero Fit</span>\n        <nav class=\"flex gap-1.5 text-[14px] font-medium\" data-name=\"primary nav\" data-kid=\"1-1-3-1-2\">\n          <a href=\"#lineup\" class=\"h-10 px-4 rounded-full flex items-center bg-[#F8F38A]\" data-kid=\"1-1-3-1-2-1\">Shop bands</a>\n          <a href=\"#finder\" class=\"h-10 px-4 rounded-full flex items-center hover:bg-[#F3EFEC]\" data-kid=\"1-1-3-1-2-2\">Band finder</a>\n          <a href=\"#plans\" class=\"h-10 px-4 rounded-full flex items-center hover:bg-[#F3EFEC]\" data-kid=\"1-1-3-1-2-3\">Memberships</a>\n          <a href=\"#compare\" class=\"h-10 px-4 rounded-full flex items-center hover:bg-[#F3EFEC]\" data-kid=\"1-1-3-1-2-4\">Compare</a>\n        </nav>\n      </div>\n      <div class=\"flex items-center gap-2\" data-name=\"header actions\" data-kid=\"1-1-3-2\">\n        <button class=\"h-12 pl-5 pr-2 rounded-full border border-[#EFEAE6] text-[14px] font-medium flex items-center gap-2 hover:bg-[#F3EFEC]\" data-name=\"cart button\" data-kid=\"1-1-3-2-1\"><i class=\"ti ti-shopping-bag text-[18px]\" data-kid=\"1-1-3-2-1-1\"></i>Cart<span id=\"cartCount\" class=\"min-w-8 h-8 px-2 rounded-full bg-[#F3EFEC] text-[13px] flex items-center justify-center\" data-dynamic=\"true\" data-reason=\"count replaced by add-to-cart script\" data-kid=\"1-1-3-2-1-2\">0</span></button>\n        <button class=\"h-12 px-6 rounded-full border border-[#2A0B14]/25 text-[15px] font-medium hover:bg-[#F3EFEC]\" data-name=\"join free button\" data-kid=\"1-1-3-2-2\">Join Aero Fit free</button>\n      </div>\n    </header>\n\n    <div class=\"relative z-10 pt-[86px] text-center\" data-name=\"hero copy\" data-kid=\"1-1-4\">\n      <h1 class=\"serif text-[82px] leading-[1.02] font-medium tracking-[-0.025em]\" data-name=\"hero headline\" data-kid=\"1-1-4-1\">Built for the<br data-kid=\"1-1-4-1-1\">long way round.</h1>\n      <p class=\"mt-6 mx-auto max-w-[520px] text-[18px] leading-[1.6] text-[#4A2A33] text-left\" data-name=\"hero paragraph\" data-kid=\"1-1-4-2\">Aero Fit Ultra runs 14 days on a charge with dual-band GPS, so a week of trail miles fits between charges.</p>\n      <div class=\"mt-8 flex justify-center items-center gap-7\" data-name=\"hero actions\" data-kid=\"1-1-4-3\">\n        <a href=\"#lineup\" class=\"h-[52px] px-7 rounded-full bg-[#F8F38A] text-[15px] font-semibold flex items-center gap-2 hover:bg-[#F2EB6A] transition\" data-name=\"view Ultra button\" data-kid=\"1-1-4-3-1\">View Ultra <i class=\"ti ti-arrow-right\" data-kid=\"1-1-4-3-1-1\"></i></a>\n        <a href=\"#lineup\" class=\"text-[15px] font-medium underline underline-offset-[5px] decoration-[1.5px]\" data-name=\"see all bands link\" data-kid=\"1-1-4-3-2\">See all five bands</a>\n      </div>\n    </div>\n\n    <div class=\"absolute z-10 left-1/2 -translate-x-1/2 bottom-7 h-[58px] px-7 rounded-full bg-[#FAF8F6] flex items-center gap-6 text-[14px] text-[#4A2A33] whitespace-nowrap tnum\" data-name=\"proof row\" data-kid=\"1-1-5\">\n      <span data-kid=\"1-1-5-1\"><b class=\"serif text-[18px] font-semibold text-[#2A0B14]\" data-kid=\"1-1-5-1-1\">14 days</b> battery</span><span class=\"w-px h-5 bg-[#E3DDDA]\" data-kid=\"1-1-5-2\"></span>\n      <span data-kid=\"1-1-5-3\"><b class=\"serif text-[18px] font-semibold text-[#2A0B14]\" data-kid=\"1-1-5-3-1\">Dual-band</b> GPS</span><span class=\"w-px h-5 bg-[#E3DDDA]\" data-kid=\"1-1-5-4\"></span>\n      <span data-kid=\"1-1-5-5\"><b class=\"serif text-[18px] font-semibold text-[#2A0B14]\" data-kid=\"1-1-5-5-1\">100 m</b> water resistance</span><span class=\"w-px h-5 bg-[#E3DDDA]\" data-kid=\"1-1-5-6\"></span>\n      <span data-kid=\"1-1-5-7\"><b class=\"serif text-[18px] font-semibold text-[#2A0B14]\" data-kid=\"1-1-5-7-1\">$399</b> or included with Life</span><span class=\"w-px h-5 bg-[#E3DDDA]\" data-kid=\"1-1-5-8\"></span>\n      <span data-kid=\"1-1-5-9\">Ships from November 4</span>\n    </div>\n  </section>\n\n  <!-- ═════ LINEUP ═════ -->\n  <section id=\"lineup\" class=\"mx-4 mt-4 rounded-[28px] bg-white px-[88px] pt-20 pb-16\" data-name=\"lineup section\" data-kid=\"1-2\">\n    <h2 class=\"serif text-[56px] leading-[1.04] font-medium tracking-[-0.02em]\" data-name=\"lineup headline\" data-kid=\"1-2-1\">Five bands, one app</h2>\n    <p id=\"lineNote\" class=\"mt-3 text-[16px] leading-[1.6] text-[#4A2A33] max-w-[620px]\" data-name=\"lineup note\" data-dynamic=\"true\" data-reason=\"text replaced by render() from purchase mode\" data-kid=\"1-2-2\">Every band runs the same Aero Fit app, coaching and Recovery scores. Buy one outright and add a membership a