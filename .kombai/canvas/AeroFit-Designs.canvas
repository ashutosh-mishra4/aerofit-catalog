-center rounded-full bg-white text-[17px] text-[#1E7A52]\" data-kid=\"1-3-7-1-1\" data-name=\"check icon badge\">\n                    <i class=\"ti ti-check\" data-kid=\"1-3-7-1-1-1\" data-name=\"checkmark icon\">\n                    </i>\n                </span>\n                <div data-kid=\"1-3-7-1-2\" data-name=\"trust point copy container\">\n                    <strong class=\"block text-[14px] font-medium\" data-kid=\"1-3-7-1-2-1\" data-name=\"trust point title: clear monthly pricing\">\n                        Clear monthly pricing\n                    </strong>\n                    <span class=\"block text-[12.5px] text-[#6B4F57]\" data-kid=\"1-3-7-1-2-2\" data-name=\"trust point subtext: clear monthly pricing\">\n                        No usage-based math on this page\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-start gap-3 rounded-[20px] bg-[#F3EDE9] p-5\" data-kid=\"1-3-7-2\" data-name=\"trust point: annual discount\">\n                <span class=\"grid size-9 shrink-0 place-items-center rounded-full bg-white text-[17px] text-[#1E7A52]\" data-kid=\"1-3-7-2-1\" data-name=\"percentage icon badge\">\n                    <i class=\"ti ti-percentage\" data-kid=\"1-3-7-2-1-1\" data-name=\"percentage icon\">\n                    </i>\n                </span>\n                <div data-kid=\"1-3-7-2-2\" data-name=\"trust point copy container\">\n                    <strong class=\"block text-[14px] font-medium\" data-kid=\"1-3-7-2-2-1\" data-name=\"trust point title: 20% annual discount\">\n                        20% annual discount\n                    </strong>\n                    <span class=\"block text-[12.5px] text-[#6B4F57]\" data-kid=\"1-3-7-2-2-2\" data-name=\"trust point subtext: 20% annual discount\">\n                        Applied when annual billing is selected\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-start gap-3 rounded-[20px] bg-[#F3EDE9] p-5\" data-kid=\"1-3-7-3\" data-name=\"trust point: review before payment\">\n                <span class=\"grid size-9 shrink-0 place-items-center rounded-full bg-white text-[17px] text-[#1E7A52]\" data-kid=\"1-3-7-3-1\" data-name=\"arrow icon badge\">\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-3-7-3-1-1\" data-name=\"arrow right icon\">\n                    </i>\n                </span>\n                <div data-kid=\"1-3-7-3-2\" data-name=\"trust point copy container\">\n                    <strong class=\"block text-[14px] font-medium\" data-kid=\"1-3-7-3-2-1\" data-name=\"trust point title: review before payment\">\n                        Review before payment\n                    </strong>\n                    <span class=\"block text-[12.5px] text-[#6B4F57]\" data-kid=\"1-3-7-3-2-2\" data-name=\"trust point subtext: review before payment\">\n                        Your selection carries into the next step\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"mb-12\" data-kid=\"1-3-8\" data-name=\"FAQ section\">\n            <h2 class=\"serif mb-6 text-center text-[40px] font-medium tracking-[-0.01em]\" data-kid=\"1-3-8-1\" data-name=\"FAQ section title\">\n                Frequently asked questions\n            </h2>\n            <div class=\"grid grid-cols-2 items-start gap-3\" data-kid=\"1-3-8-2\" data-name=\"FAQ items grid\">\n                <div class=\"faq-item cursor-pointer rounded-[18px] border border-[#EFEAE6] bg-white\" data-kid=\"1-3-8-2-1\" data-name=\"FAQ item: which store platforms can I select\" onclick=\"toggleFaq(this)\">\n                    <div class=\"flex items-center justify-between gap-4 px-5 py-4 text-[14px] font-medium\" data-kid=\"1-3-8-2-1-1\" data-name=\"FAQ question row\">\n                        <span data-kid=\"1-3-8-2-1-1-1\" data-name=\"FAQ question text\">\n                            Which store platforms can I select?\n                        </span>\n                        <span class=\"faq-plus grid size-7 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[14px]\" data-dynamic=\"true\" data-kid=\"1-3-8-2-1-1-2\" data-name=\"FAQ toggle icon wrapper\" data-reason=\"icon replaced by toggleFaq on click\">\n                            <i class=\"ti ti-plus\" data-dynamic=\"true\" data-kid=\"1-3-8-2-1-1-2-1\" data-name=\"FAQ toggle icon\" data-reason=\"icon replaced by toggleFaq on click\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"faq-answer hidden px-5 pb-4 text-[13px] text-[#4A2A33]\" data-kid=\"1-3-8-2-1-2\" data-name=\"FAQ answer: which store platforms can I select\">\n                        Choose Shopify, WooCommerce, or Both. The plan price updates automatically for your platform selection.\n                    </div>\n                </div>\n                <div class=\"faq-item cursor-pointer rounded-[18px] border border-[#EFEAE6] bg-white\" data-kid=\"1-3-8-2-2\" data-name=\"FAQ item: how does annual billing work\" onclick=\"toggleFaq(this)\">\n                    <div class=\"flex items-center justify-between gap-4 px-5 py-4 text-[14px] font-medium\" data-kid=\"1-3-8-2-2-1\" data-name=\"FAQ question row\">\n                        <span data-kid=\"1-3-8-2-2-1-1\" data-name=\"FAQ question text\">\n                            How does annual billing work?\n                        </span>\n                        <span class=\"faq-plus grid size-7 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[14px]\" data-dynamic=\"true\" data-kid=\"1-3-8-2-2-1-2\" data-name=\"FAQ toggle icon wrapper\" data-reason=\"icon replaced by toggleFaq on click\">\n                            <i class=\"ti ti-plus\" data-dynamic=\"true\" data-kid=\"1-3-8-2-2-1-2-1\" data-name=\"FAQ toggle icon\" data-reason=\"icon replaced by toggleFaq on click\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"faq-answer hidden px-5 pb-4 text-[13px] text-[#4A2A33]\" data-kid=\"1-3-8-2-2-2\" data-name=\"FAQ answer: how does annual billing work\">\n                        Annual billing gives 20% off the monthly equivalent. Enable Annual to see the discounted price and yearly savings.\n                    </div>\n                </div>\n                <div class=\"faq-item cursor-pointer rounded-[18px] border border-[#EFEAE6] bg-white\" data-kid=\"1-3-8-2-3\" data-name=\"FAQ item: what is the difference between the plans\" onclick=\"toggleFaq(this)\">\n                    <div class=\"flex items-center justify-between gap-4 px-5 py-4 text-[14px] font-medium\" data-kid=\"1-3-8-2-3-1\" data-name=\"FAQ question row\">\n                        <span data-kid=\"1-3-8-2-3-1-1\" data-name=\"FAQ question text\">\n                            What is the difference between the plans?\n                        </span>\n                        <span class=\"faq-plus grid size-7 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[14px]\" data-dynamic=\"true\" data-kid=\"1-3-8-2-3-1-2\" data-name=\"FAQ toggle icon wrapper\" data-reason=\"icon replaced by toggleFaq on click\">\n                            <i class=\"ti ti-plus\" data-dynamic=\"true\" data-kid=\"1-3-8-2-3-1-2-1\" data-name=\"FAQ toggle icon\" data-reason=\"icon replaced by toggleFaq on click\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"faq-answer hidden px-5 pb-4 text-[13px] text-[#4A2A33]\" data-kid=\"1-3-8-2-3-2\" data-name=\"FAQ answer: what is the difference between the plans\">\n                        Analytics identifies opportunities. Optimization includes Analytics and automatically tests and applies improvements.\n                    </div>\n                </div>\n                <div class=\"faq-item cursor-pointer rounded-[18px] border border-[#EFEAE6] bg-white\" data-kid=\"1-3-8-2-4\" data-name=\"FAQ item: what happens next\" onclick=\"toggleFaq(this)\">\n                    <div class=\"flex items-center justify-between gap-4 px-5 py-4 text-[14px] font-medium\" data-kid=\"1-3-8-2-4-1\" data-name=\"FAQ question row\">\n                        <span data-kid=\"1-3-8-2-4-1-1\" data-name=\"FAQ question text\">\n                            What happens next?\n                        </span>\n                        <span class=\"faq-plus grid size-7 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[14px]\" data-dynamic=\"true\" data-kid=\"1-3-8-2-4-1-2\" data-name=\"FAQ toggle icon wrapper\" data-reason=\"icon replaced by toggleFaq on click\">\n                            <i class=\"ti ti-plus\" data-dynamic=\"true\" data-kid=\"1-3-8-2-4-1-2-1\" data-name=\"FAQ toggle icon\" data-reason=\"icon replaced by toggleFaq on click\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"faq-answer hidden px-5 pb-4 text-[13px] text-[#4A2A33]\" data-kid=\"1-3-8-2-4-2\" data-name=\"FAQ answer: what happens next\">\n                        Continue to Payment with your platform, plan, and billing frequency already selected for review.\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative flex items-center justify-between gap-6 overflow-hidden rounded-[28px] bg-[#45172A] py-5 pl-8 pr-5 text-white shadow-[0_24px_60px_rgba(42,11,20,0.18)]\" data-kid=\"1-3-9\" data-name=\"summary checkout bar\">\n            <div class=\"relative\" data-kid=\"1-3-9-2\" data-name=\"selection summary block\">\n                <div class=\"text-[12px] text-[#C9B5BB]\" data-kid=\"1-3-9-2-1\" data-name=\"summary label\">\n                    Your selection\n                </div>\n                <div class=\"serif mt-1 text-[24px] font-medium\" data-kid=\"1-3-9-2-2\" data-name=\"summary plan and platform text\">\n                    <span data-dynamic=\"true\" data-kid=\"1-3-9-2-2-1\" data-name=\"selected plan name\" data-reason=\"selection rewritten by render\" id=\"summaryPlan\">\n                        Optimization\n                    </span>\n                    <span class=\"text-[#C9B5BB]\" data-kid=\"1-3-9-2-2-2\" data-name=\"separator dot\">\n                        ·\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-3-9-2-2-3\" data-name=\"selected platform name\" data-reason=\"selection rewritten by render\" id=\"summaryPlatform\">\n                        Shopify\n                    </span>\n                </div>\n                <div class=\"text-[12px] text-[#C9B5BB]\" data-dynamic=\"true\" data-kid=\"1-3-9-2-3\" data-name=\"summary billing line\" data-reason=\"selection rewritten by render\" id=\"summaryBilling\">\n                    Monthly billing · Payment is next\n                </div>\n            </div>\n            <div class=\"relative flex items-center gap-6\" data-kid=\"1-3-9-3\" data-name=\"price and CTA block\">\n                <div class=\"text-right\" data-kid=\"1-3-9-3-1\" data-name=\"summary price block\">\n                    <strong class=\"block text-[28px] font-semibold tracking-[-0.02em]\" data-dynamic=\"true\" data-kid=\"1-3-9-3-1-1\" data-name=\"summary price\" data-reason=\"price recalculated by render per selection\" id=\"summaryPrice\">\n                        $2,000/mo\n                    </strong>\n                    <span class=\"block text-[12px] text-[#F8F38A]\" data-dynamic=\"true\" data-kid=\"1-3-9-3-1-2\" data-name=\"summary savings note\" data-reason=\"note text rewritten by render\" id=\"summarySaving\">\n                        Switch to annual billing for 20% off\n                    </span>\n                </div>\n                <button class=\"flex h-[54px] items-center gap-2 rounded-full bg-[#F8F38A] px-7 text-[14px] font-medium text-[#2A0B14] transition hover:bg-[#F2EB6A]\" data-kid=\"1-3-9-3-2\" data-name=\"proceed to payment button\" onclick=\"openCheckout()\">\n                    Proceed to Payment\n                    <span class=\"text-[16px]\" data-kid=\"1-3-9-3-2-1\" data-name=\"arrow icon wrapper\">\n                        <i class=\"ti ti-arrow-right\" data-kid=\"1-3-9-3-2-1-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n        </section>\n    </main>\n</div>\n<div class=\"modal-backdrop fixed inset-0 z-50 hidden items-center justify-center bg-[#2A0B14]/40 p-6 backdrop-blur-xs\" data-kid=\"2\" data-name=\"checkout review modal backdrop\" id=\"checkoutModal\">\n    <div class=\"w-[520px] rounded-[26px] bg-white p-7 text-[#2A0B14] shadow-[0_30px_80px_rgba(42,11,20,0.25)]\" data-kid=\"2-1\" data-name=\"checkout review dialog\">\n        <div class=\"mb-3 flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"dialog header\">\n            <h3 class=\"serif text-[26px] font-medium\" data-kid=\"2-1-1-1\" data-name=\"dialog title: review your selection\">\n                Review your selection\n            </h3>\n            <button aria-label=\"Close\" class=\"grid size-9 place-items-center rounded-full bg-[#F3EFEC] text-[16px]\" data-kid=\"2-1-1-2\" data-name=\"dialog close button\" onclick=\"closeModal('checkoutModal')\">\n                <i class=\"ti ti-x\" data-kid=\"2-1-1-2-1\" data-name=\"x icon\">\n                </i>\n            </button>\n        </div>\n        <p class=\"text-[14px] text-[#4A2A33]\" data-kid=\"2-1-2\" data-name=\"dialog description\">\n            Everything looks ready. Confirm these details before continuing to the Payment step.\n        </p>\n        <div class=\"my-5 rounded-[18px] bg-[#FAF8F6] px-4 py-2 text-[13px]\" data-kid=\"2-1-3\" data-name=\"review summary card\">\n            <div class=\"flex justify-between py-2\" data-kid=\"2-1-3-1\" data-name=\"review row: platform\">\n                <span class=\"text-[#6B4F57]\" data-kid=\"2-1-3-1-1\" data-name=\"platform label\">\n                    Platform\n                </span>\n                <strong class=\"font-medium\" data-dynamic=\"true\" data-kid=\"2-1-3-1-2\" data-name=\"platform value\" data-reason=\"value set by openCheckout on confirm\" id=\"reviewPlatform\">\n                    Shopify\n                </strong>\n            </div>\n            <div class=\"flex justify-between border-t border-[#EFEAE6] py-2\" data-kid=\"2-1-3-2\" data-name=\"review row: plan\">\n                <span class=\"text-[#6B4F57]\" data-kid=\"2-1-3-2-1\" data-name=\"plan label\">\n                    Plan\n                </span>\n                <strong class=\"font-medium\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2\" data-name=\"plan value\" data-reason=\"value set by openCheckout on confirm\" id=\"reviewPlan\">\n                    Optimization\n                </strong>\n            </div>\n            <div class=\"flex justify-between border-t border-[#EFEAE6] py-2\" data-kid=\"2-1-3-3\" data-name=\"review row: billing\">\n                <span class=\"text-[#6B4F57]\" data-kid=\"2-1-3-3-1\" data-name=\"billing label\">\n                    Billing\n                </span>\n                <strong class=\"font-medium\" data-dynamic=\"true\" data-kid=\"2-1-3-3-2\" data-name=\"billing value\" data-reason=\"value set by openCheckout on confirm\" id=\"reviewBilling\">\n                    Monthly\n                </strong>\n            </div>\n            <div class=\"flex justify-between border-t border-[#EFEAE6] py-2\" data-kid=\"2-1-3-4\" data-name=\"review row: price\">\n                <span class=\"text-[#6B4F57]\" data-kid=\"2-1-3-4-1\" data-name=\"price label\">\n                    Plan price\n                </span>\n                <strong class=\"font-medium\" data-dynamic=\"true\" data-kid=\"2-1-3-4-2\" data-name=\"price value\" data-reason=\"value set by openCheckout on confirm\" id=\"reviewPrice\">\n                    $2,000/month\n                </strong>\n            </div>\n        </div>\n        <div class=\"flex gap-2.5\" data-kid=\"2-1-4\" data-name=\"dialog action buttons\">\n            <button class=\"h-12 flex-1 rounded-full border border-[#D9D0CB] text-[13px] font-medium\" data-kid=\"2-1-4-1\" data-name=\"modify selection button\" onclick=\"closeModal('checkoutModal')\">\n                Modify selection\n            </button>\n            <button class=\"h-12 flex-1 rounded-full bg-[#2A0B14] text-[13px] font-medium text-white\" data-kid=\"2-1-4-2\" data-name=\"confirm and continue button\" onclick=\"finishPayment()\">\n                Confirm & continue →\n            </button>\n        </div>\n    </div>\n</div>\n<div class=\"modal-backdrop fixed inset-0 z-50 hidden items-center justify-center bg-[#2A0B14]/40 p-6 backdrop-blur-xs\" data-kid=\"3\" data-name=\"help modal backdrop\" id=\"helpModal\">\n    <div class=\"w-[520px] rounded-[26px] bg-white p-7 text-[14px] text-[#4A2A33] shadow-[0_30px_80px_rgba(42,11,20,0.25)]\" data-kid=\"3-1\" data-name=\"help dialog\">\n        <div class=\"mb-3 flex items-center justify-between\" data-kid=\"3-1-1\" data-name=\"dialog header\">\n            <h3 class=\"serif text-[26px] font-medium text-[#2A0B14]\" data-kid=\"3-1-1-1\" data-name=\"dialog title: choosing the right plan\">\n                Choosing the right plan\n            </h3>\n            <button aria-label=\"Close\" class=\"grid size-9 place-items-center rounded-full bg-[#F3EFEC] text-[16px]\" data-kid=\"3-1-1-2\" data-name=\"dialog close button\" onclick=\"closeModal('helpModal')\">\n                <i class=\"ti ti-x\" data-kid=\"3-1-1-2-1\" data-name=\"x icon\">\n                </i>\n            </button>\n        </div>\n        <p data-kid=\"3-1-2\" data-name=\"help copy paragraph: choose analytics\">\n            <strong class=\"font-medium text-[#2A0B14]\" data-kid=\"3-1-2-1\" data-name=\"analytics plan emphasis\">\n                Choose Analytics\n            </strong>\n            when your team wants clear store insights and will implement changes themselves.\n        </p>\n        <p class=\"mt-3\" data-kid=\"3-1-3\" data-name=\"help copy paragraph: choose optimization\">\n            <strong class=\"font-medium text-[#2A0B14]\" data-kid=\"3-1-3-1\" data-name=\"optimization plan emphasis\">\n                Choose Optimization\n            </strong>\n            when you want Convertly to continuously test and automate improvements for you.\n        </p>\n        <button class=\"mt-5 h-11 rounded-full bg-[#2A0B14] px-6 text-[13px] font-medium text-white\" data-kid=\"3-1-4\" data-name=\"got it dismiss button\" onclick=\"closeModal('helpModal')\">\n            Got it\n        </button>\n    </div>\n</div>\n<div class=\"pointer-events-none fixed bottom-6 right-6 z-[60] translate-y-2 rounded-full bg-[#2A0B14] px-5 py-3 text-[13px] font-medium text-white opacity-0 shadow-[0_14px_40px_rgba(42,11,20,0.25)] transition\" data-dynamic=\"true\" data-kid=\"4\" data-name=\"toast notification\" data-reason=\"text and visibility reinitialized by showToast on each action\" id=\"toast\">\n    Selection updated\n</div>\n<script>\n    var state={provider:'shopify',tier:'optimization',annual:false};\nvar PRICING={shopify:{name:'Shopify',analytics:1000,optimization:2000},woocommerce:{name:'WooCommerce',analytics:1000,optimization:2000},both:{name:'Both platforms',analytics:1800,optimization:3600}};\nvar segOn='segment flex h-10 items-center gap-2 rounded-full bg-[#F8F38A] px-5 text-[13px] font-medium text-[#2A0B14] shadow-[0_2px_8px_rgba(42,11,20,0.08)]';\nvar segOff='segment flex h-10 items-center gap-2 rounded-full px-5 text-[13px] font-medium text-[#6B4F57] hover:bg-white/70';\nvar billOn='billing-choice h-10 rounded-full bg-[#2A0B14] px-5 text-[13px] font-medium text-white';\nvar billOff='billing-choice h-10 rounded-full px-5 text-[13px] font-medium text-[#6B4F57] hover:bg-white/70';\nfunction paint(){\n  ['shopify','woocommerce','both'].forEach(function(k){var t=document.getElementById('tab-'+k);t.className=k===state.provider?segOn:segOff;t.setAttribute('aria-selected',k===state.provider);});\n  document.getElementById('billing-monthly').className=state.annual?billOff:billOn;document.getElementById('billing-annual').className=state.annual?billOn:billOff;\n  ['analytics','optimization'].forEach(function(k){var on=k===state.tier,c=document.getElementById('card-'+k);\n    c.className=on?'plan-card relative flex cursor-pointer flex-col rounded-[28px] border-[1.5px] border-[#2A0B14] bg-[radial-gradient(ellipse_at_100%_0%,#FBF4B8_0%,#FFFDF2_38%,#FFFFFF_72%)] p-8 shadow-[0_20px_50px_rgba(42,11,20,0.10)]':'plan-card relative flex cursor-pointer flex-col rounded-[28px] border-[1.5px] border-[#EFEAE6] bg-white p-8 shadow-[0_4px_18px_rgba(42,11,20,0.05)] transition hover:border-[#D9D0CB]';\n    c.querySelector('.plan-icon').className=on?'plan-icon mb-5 grid size-12 place-items-center rounded-full bg-[#F8F38A] text-[22px]':'plan-icon mb-5 grid size-12 place-items-center rounded-full bg-[#F3EFEC] text-[22px] text-[#4A2A33]';\n    c.querySelector('.price-box').className=on?'price-box my-6 rounded-[20px] bg-white/80 px-5 py-4 shadow-[0_4px_14px_rgba(42,11,20,0.05)]':'price-box my-6 rounded-[20px] bg-[#FAF8F6] px-5 py-4';\n    c.querySelector('.sel-ind').className=on?'sel-ind mb-5 flex items-center gap-2.5 rounded-full bg-[#2A0B14] px-4 py-2.5 text-[13px] font-medium text-white':'sel-ind mb-5 flex items-center gap-2.5 rounded-full bg-[#F3EFEC] px-4 py-2.5 text-[13px] font-medium text-[#4A2A33]';\n    var r=c.querySelector('.radio');r.className=on?'radio grid size-[18px] place-items-center rounded-full bg-[#F8F38A]':'radio size-[18px] rounded-full border-[1.5px] border-[#9A8E91] bg-white';r.innerHTML=on?'<span class=\"size-2 rounded-full bg-[#2A0B14]\"></span>':'';\n    document.getElementById('button-'+k).className=on?'plan-button h-12 rounded-full bg-[#2A0B14] text-[14px] font-medium text-white transition hover:bg-[#45172A]':'plan-button h-12 rounded-full border border-[#D9D0CB] bg-white text-[14px] font-medium transition hover:bg-[#F3EFEC]';});\n}\nfunction selectProvider(p){state.provider=p;var both=p==='both';\n  document.getElementById('bundleTitle').textContent=both?'Both platforms selected':'Run Shopify and WooCommerce together';\n  document.getElementById('bundleText').textContent=both?'One plan now covers both storefronts in a unified dashboard.':'Bundle both storefronts under one dashboard with lower combined pricing.';\n  document.getElementById('bundleButton').style.display=both?'none':'block';\n  document.getElementById('comparisonPlatform').textContent='For '+PRICING[p].name;render();showToast(PRICING[p].name+' selected');}\nfunction setBilling(a){state.annual=a;render();showToast(a?'20% annual discount applied':'Monthly billing selected');}\nfunction selectTier(t){state.tier=t;var a=t==='analytics';\n  document.getElementById('label-analytics').textContent=a?'Selected: Analytics':'Select Analytics';\n  document.getElementById('label-optimization').textContent=a?'Select Optimization':'Selected: Optimization';\n  document.getElementById('button-analytics').textContent=a?'Continue with Analytics →':'Choose Analytics';\n  document.getElementById('button-optimization').textContent=a?'Choose Optimization':'Continue with Optimization →';\n  render();showToast((a?'Analytics':'Optimization')+' selected');}\nfunction render(){var p=PRICING[state.provider];\n  var ap=state.annual?Math.round(p.analytics*.8):p.analytics,op=state.annual?Math.round(p.optimization*.8):p.optimization;\n  updatePrice('analytics',p.analytics,ap);updatePrice('optimization',p.optimization,op);\n  var b=p[state.tier],act=state.annual?Math.round(b*.8):b;\n  document.getElementById('summaryPlan').textContent=state.tier==='analytics'?'Analytics':'Optimization';\n  document.getElementById('summaryPlatform').textContent=p.name;\n  document.getElementById('summaryPrice').textContent='$'+act.toLocaleString()+'/mo';\n  document.getElementById('summaryBilling').textContent=(state.annual?'Annual billing':'Monthly billing')+' · Payment is next';\n  document.getElementById('summarySaving').textContent=state.annual?'Save $'+((b-act)*12).toLocaleString()+'/year':'Switch to annual billing for 20% off';paint();}\nfunction updatePrice(t,b,a){document.getElementById('price-'+t).textContent=a.toLocaleString();var o=document.getElementById('old-'+t),n=document.getElementById('note-'+t);\n  if(state.annual){o.style.display='inline';o.textContent='$'+b.toLocaleString();n.textContent='Annual billing · save $'+((b-a)*12).toLocaleString()+'/year';}else{o.style.display='none';n.textContent='Billed monthly';}}\nfunction toggleFaq(i){var a=i.querySelector('.faq-answer');a.classList.toggle('hidden');i.querySelector('.faq-plus').innerHTML=a.classList.contains('hidden')?'<i class=\"ti ti-plus\"></i>':'<i class=\"ti ti-minus\"></i>';}\nfunction openModal(id){var m=document.getElementById(id);m.classList.remove('hidden');m.classList.add('flex');}\nfunction closeModal(id){var m=document.getElementById(id);m.classList.add('hidden');m.classList.remove('flex');}\nfunction openCheckout(){var p=PRICING[state.provider],b=p[state.tier],a=state.annual?Math.round(b*.8):b;\n  document.getElementById('reviewPlatform').textContent=p.name;document.getElementById('reviewPlan').textContent=state.tier==='analytics'?'Analytics':'Optimization';\n  document.getElementById('reviewBilling').textContent=state.annual?'Annual · 20% off':'Monthly';document.getElementById('reviewPrice').textContent='$'+a.toLocaleString()+'/month';openModal('checkoutModal');}\nfunction finishPayment(){closeModal('checkoutModal');showToast('Continuing to Payment…');}\nfunction showToast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.remove('opacity-0','translate-y-2');clearTimeout(window.tt);window.tt=setTimeout(function(){t.classList.add('opacity-0','translate-y-2');},2200);}\nwindow.addEventListener('click',function(e){if(e.target.classList&&e.target.classList.contains('modal-backdrop')){e.target.classList.add('hidden');e.target.classList.remove('flex');}});\n</script>\n",
