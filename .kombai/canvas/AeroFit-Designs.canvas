data-kid=\"1-10-2-2-3-1\" data-name=\"Support column heading\">\n                        Support\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-10-2-2-3-2\" data-name=\"Support link list\">\n                        <li data-kid=\"1-10-2-2-3-2-1\" data-name=\"Help Center link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-3-2-1-1\" href=\"#\">\n                                Help Center\n                            </a>\n                        </li>\n                        <li data-kid=\"1-10-2-2-3-2-2\" data-name=\"Sizing link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-3-2-2-1\" href=\"#\">\n                                Sizing\n                            </a>\n                        </li>\n                        <li data-kid=\"1-10-2-2-3-2-3\" data-name=\"Accessories link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-3-2-3-1\" href=\"#\">\n                                Accessories\n                            </a>\n                        </li>\n                        <li data-kid=\"1-10-2-2-3-2-4\" data-name=\"Download App link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-3-2-4-1\" href=\"#\">\n                                Download App\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-10-2-2-4\" data-name=\"footer Connect link column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-10-2-2-4-1\" data-name=\"Connect column heading\">\n                        Connect\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-10-2-2-4-2\" data-name=\"Connect link list\">\n                        <li data-kid=\"1-10-2-2-4-2-1\" data-name=\"Instagram link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-4-2-1-1\" href=\"#\">\n                                Instagram\n                            </a>\n                        </li>\n                        <li data-kid=\"1-10-2-2-4-2-2\" data-name=\"YouTube link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-4-2-2-1\" href=\"#\">\n                                YouTube\n                            </a>\n                        </li>\n                        <li data-kid=\"1-10-2-2-4-2-3\" data-name=\"Podcast link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-4-2-3-1\" href=\"#\">\n                                Podcast\n                            </a>\n                        </li>\n                        <li data-kid=\"1-10-2-2-4-2-4\" data-name=\"Contact link\">\n                            <a class=\"hover:opacity-70 transition\" data-kid=\"1-10-2-2-4-2-4-1\" href=\"#\">\n                                Contact\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-12 h-14 rounded-full bg-white px-6 flex items-center justify-between text-[12px] text-[#6B4F57]\" data-kid=\"1-10-3\" data-name=\"legal and social footer bar\">\n            <div class=\"flex gap-5\" data-kid=\"1-10-3-1\" data-name=\"legal links row\">\n                <a class=\"hover:text-[#2A0B14] transition\" data-kid=\"1-10-3-1-1\" data-name=\"Terms and Conditions link\" href=\"#\">\n                    Terms &amp; Conditions\n                </a>\n                <a class=\"hover:text-[#2A0B14] transition\" data-kid=\"1-10-3-1-2\" data-name=\"Privacy Policy link\" href=\"#\">\n                    Privacy Policy\n                </a>\n                <a class=\"hover:text-[#2A0B14] transition\" data-kid=\"1-10-3-1-3\" data-name=\"Accessibility link\" href=\"#\">\n                    Accessibility\n                </a>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-10-3-2\" data-name=\"social icons and copyright group\">\n                <div class=\"flex gap-1.5 text-[15px] text-[#2A0B14]\" data-kid=\"1-10-3-2-1\" data-name=\"social media icon links\">\n                    \n                    \n                    \n                </div>\n                <span data-kid=\"1-10-3-2-2\" data-name=\"footer copyright notice text\">\n                    © 2026 Aero Fit. All rights reserved.\n                </span>\n            </div>\n        </div>\n        <p class=\"mt-6 px-2 text-[11px] leading-[1.7] text-[#7A5B64] max-w-[900px]\" data-kid=\"1-10-4\" data-name=\"footer medical disclaimer text\">\n            Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. If you have health concerns, consult your doctor or another qualified healthcare professional.\n        </p>\n    </footer>\n</div>\n<script>\n    function cal(el,title,startDow,days,prevTail,cfg){\n  const d=['S','M','T','W','T','F','S'];\n  let h=`<div class=\"flex items-center justify-between mb-3\"><span class=\"w-5 h-5 rounded-full border border-[#E3DDDA] flex items-center justify-center text-[10px]\">+</span><span class=\"font-semibold text-[12px]\">${title}</span><span class=\"text-[12px] text-[#9A8E91]\"><i class=\"ti ti-moon-stars\"></i></span></div><div class=\"grid grid-cols-7 gap-y-1.5 text-center\">`;\n  d.forEach(x=>h+=`<span class=\"text-[#9A8E91] h-6 leading-6\">${x}</span>`);\n  for(let i=0;i<startDow;i++)h+=`<span class=\"h-6 leading-6 text-[#D6CFCC]\">${prevTail-startDow+i+1}</span>`;\n  for(let n=1;n<=days;n++){\n    let c='h-6 leading-6 rounded relative';\n    if(cfg.band.includes(n))c+=' bg-[#FBF7C8] rounded-none';\n    if(cfg.fill.includes(n))c+=' bg-[#F8F38A] !rounded';\n    if(cfg.ring.includes(n))c+=' ring-1 ring-[#EF6A84] text-[#D1435E] !rounded bg-white';\n    const dot=cfg.dot.includes(n)?'<span class=\"absolute left-1/2 -translate-x-1/2 bottom-[1px] w-[3px] h-[3px] rounded-full bg-[#2A0B14]\"></span>':'';\n    h+=`<span class=\"${c}\">${n}${dot}</span>`;\n  }\n  el.innerHTML=h+'</div><div class=\"mt-3 flex items-center gap-2 bg-[#FAF8F6] rounded-lg p-2\"><span class=\"w-7 h-7 rounded-full bg-[#F8F38A] flex items-center justify-center text-[12px]\"><i class=\"ti ti-moon\"></i></span><div><p class=\"text-[11px] font-semibold\">Sleep Performance</p><p class=\"text-[9px] text-[#9A8E91]\">92% · 7h 48m</p></div></div>';\n}\ncal(document.getElementById('cal1'),'April 2026',3,30,31,{band:[19,20,21,23,25,26,27,28,29,30],fill:[24],ring:[22],dot:[9,14,18,30]});\n\nfunction rows(el,items){\n  el.innerHTML=items.map(([ic,t,s])=>`<div class=\"flex items-center gap-2 bg-[#FAF8F6] rounded-lg px-2.5 py-2\"><span class=\"w-6 h-6 rounded-full bg-white flex items-center justify-center text-[12px]\"><i class=\"ti ${ic}\"></i></span><div class=\"flex-1\"><p class=\"text-[11px] font-semibold\">${t}</p><p class=\"text-[9px] text-[#9A8E91]\">${s}</p></div><span class=\"text-[10px] text-[#C9C0C2]\"><i class=\"ti ti-chevron-right\"></i></span></div>`).join('');\n}\nrows(document.getElementById('mon2'),[['ti-heartbeat','Resting Heart Rate','52 bpm'],['ti-wave-sine','HRV','68 ms · Above baseline'],['ti-lungs','Blood Oxygen','98% SpO₂']]);\n\nconst pat='10111011101011101110101110111011100110110111';\nlet hh='';for(let i=0;i<44;i++){const on=pat[i]==='1';hh+=`<span class=\"h-[13px] rounded-[2px] ${on?(i%3?'bg-[#F6EE7A]':'bg-[#F9F3A8]'):'bg-[#F3EFEC]'}\"></span>`}\ndocument.getElementById('heat').innerHTML=hh;\nlet hm='';for(let i=0;i<28;i++){const on=pat[i]==='1';hm+=`<span class=\"h-[12px] rounded-[2px] ${on?'bg-[#F6EE7A]':'bg-[#EDE6EF]'}\"></span>`}\ndocument.getElementById('heatmini').innerHTML=hm;\n</script>\n",
      "comments": [],
      "created": "2026-10-13T07:35:38.389720+00:00",
      "modified": "2026-10-13T08:48:45.814553+00:00",
