border-[#F0EBE8] rounded-[6px] p-2\" data-kid=\"1-5-5-1-2-3\" data-name=\"biomarker panel\">\n                        <p class=\"text-[7px] font-medium flex items-center gap-1\" data-kid=\"1-5-5-1-2-3-1\" data-name=\"biomarker panel header\">\n                            <i class=\"ti ti-droplet\" data-kid=\"1-5-5-1-2-3-1-1\" data-name=\"droplet icon\">\n                            </i>\n                            Biomarker progress\n                        </p>\n                        <div class=\"mt-3 flex gap-1 h-2\" data-kid=\"1-5-5-1-2-3-2\" data-name=\"biomarker mini bar progress\">\n                            <span class=\"flex-1 rounded-sm bg-[#F3EE85]\" data-kid=\"1-5-5-1-2-3-2-1\" data-name=\"bio segment one\">\n                            </span>\n                            <span class=\"flex-1 rounded-sm bg-[#BDEBC6]\" data-kid=\"1-5-5-1-2-3-2-2\" data-name=\"bio segment two\">\n                            </span>\n                            <span class=\"flex-1 rounded-sm bg-[#F8CDB8]\" data-kid=\"1-5-5-1-2-3-2-3\" data-name=\"bio segment three\">\n                            </span>\n                        </div>\n                        <div class=\"mt-2 text-[6px] divide-y divide-[#F0EBE8]\" data-kid=\"1-5-5-1-2-3-3\" data-name=\"bio rows list\">\n                            <div class=\"flex justify-between py-1\" data-kid=\"1-5-5-1-2-3-3-1\" data-name=\"ApoB row\">\n                                <span class=\"text-[#9A8E91]\" data-kid=\"1-5-5-1-2-3-3-1-1\" data-name=\"ApoB label\">\n                                    ApoB\n                                </span>\n                                <span class=\"font-semibold\" data-kid=\"1-5-5-1-2-3-3-1-2\" data-name=\"ApoB value\">\n                                    78\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between py-1\" data-kid=\"1-5-5-1-2-3-3-2\" data-name=\"HbA1c row\">\n                                <span class=\"text-[#9A8E91]\" data-kid=\"1-5-5-1-2-3-3-2-1\" data-name=\"HbA1c label\">\n                                    HbA1c\n                                </span>\n                                <span class=\"font-semibold\" data-kid=\"1-5-5-1-2-3-3-2-2\" data-name=\"HbA1c value\">\n                                    5.2\n                                </span>\n                            </div>\n                            <div class=\"flex justify-between py-1\" data-kid=\"1-5-5-1-2-3-3-3\" data-name=\"Vitamin D row\">\n                                <span class=\"text-[#9A8E91]\" data-kid=\"1-5-5-1-2-3-3-3-1\" data-name=\"Vitamin D label\">\n                                    Vitamin D\n                                </span>\n                                <span class=\"font-semibold\" data-kid=\"1-5-5-1-2-3-3-3-2\" data-name=\"Vitamin D value\">\n                                    42\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"p-3 flex flex-col\" data-kid=\"1-5-5-2\" data-name=\"healthspan feature content column\">\n                <span class=\"text-[18px]\" data-kid=\"1-5-5-2-1\" data-name=\"feature topic icon holder\">\n                    <i class=\"ti ti-heart-plus\" data-kid=\"1-5-5-2-1-1\" data-name=\"heart with plus icon\">\n                    </i>\n                </span>\n                <h3 class=\"serif mt-5 text-[22px] font-medium\" data-kid=\"1-5-5-2-2\" data-name=\"feature card title\">\n                    Extend Your Prime\n                </h3>\n                <p class=\"mt-2 text-[12px] leading-[1.55] text-[#5A3B44] max-w-[320px]\" data-kid=\"1-5-5-2-3\" data-name=\"feature card description\">\n                    Build habits for a longer, healthier life and see what your bloodwork means for you.\n                </p>\n                <ul class=\"mt-10 space-y-3.5 text-[12px]\" data-kid=\"1-5-5-2-4\" data-name=\"feature checklist\">\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"1-5-5-2-4-1\" data-name=\"checklist item with Peace of Aging\">\n                        <i class=\"ti ti-check\" data-kid=\"1-5-5-2-4-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                        Track Healthspan and Pace of Aging\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"1-5-5-2-4-2\" data-name=\"checklist item with 122+ biomarkers\">\n                        <i class=\"ti ti-check\" data-kid=\"1-5-5-2-4-2-1\" data-name=\"checkmark icon\">\n                        </i>\n                        Go deeper with 122+ biomarkers\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"1-5-5-2-4-3\" data-name=\"checklist item with personalized plan\">\n                        <i class=\"ti ti-check\" data-kid=\"1-5-5-2-4-3-1\" data-name=\"checkmark icon\">\n                        </i>\n                        Follow a personalized Action Plan\n                    </li>\n                </ul>\n                <button class=\"mt-12 self-start h-10 px-3.5 rounded-md bg-[#2A0B14] text-white text-[12px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-5-5-2-5\" data-name=\"Get Started button\">\n                    Get Started\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"max-w-[1160px] mx-auto px-6 pb-10\" data-kid=\"1-6\" data-name=\"site footer\">\n        <div class=\"bg-[#F6F1EE] rounded-[18px] px-10 pt-12 pb-8\" data-kid=\"1-6-1\" data-name=\"footer content container\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-6-1-1\" data-name=\"footer brand and tagline row\">\n                <a class=\"flex items-center gap-3\" data-kid=\"1-6-1-1-1\" data-name=\"footer brand logo link\" href=\"#\">\n                    <img alt=\"Aero Fit logo\" class=\"w-11 h-11\" data-kid=\"1-6-1-1-1-1\" data-name=\"footer Aero Fit logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\">\n                    <span class=\"serif text-[40px] font-medium tracking-tight\" data-kid=\"1-6-1-1-1-2\" data-name=\"footer brand wordmark text\">\n                        Aero Fit\n                    </span>\n                </a>\n                \n            </div>\n            <div class=\"mt-10 grid grid-cols-[400px_1fr] gap-16\" data-kid=\"1-6-1-2\" data-name=\"footer link and CTA grid\">\n                <div class=\"bg-gradient-to-b from-white to-[#FBF7C8] rounded-[14px] p-7 shadow-[0_10px_40px_rgba(42,11,20,0.06)]\" data-kid=\"1-6-1-2-1\" data-name=\"footer try Aero Fit free card\">\n                    <h2 class=\"serif text-[32px] leading-[1.12] font-medium\" data-kid=\"1-6-1-2-1-1\" data-name=\"footer try Aero Fit free headline\">\n                        Try Aero Fit for Free\n                    </h2>\n                    <p class=\"mt-3 text-[13px] leading-[1.6] text-[#4A2A33]\" data-kid=\"1-6-1-2-1-2\" data-name=\"footer try Aero Fit free description text\">\n                        Experience 24/7 monitoring across sleep, strain, stress and heart health with personalized daily coaching.\n                    </p>\n                    <div class=\"mt-6 flex gap-2\" data-kid=\"1-6-1-2-1-3\" data-name=\"footer CTA button group\">\n                        <button class=\"h-10 px-3.5 rounded-lg bg-[#F8F38A] text-[13px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-6-1-2-1-3-1\" data-name=\"footer primary try Aero Fit free button\">\n                            Try Aero Fit for free\n                        </button>\n                        <button class=\"h-10 px-3.5 rounded-lg border border-[#E8E2DE] bg-white text-[13px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-6-1-2-1-3-2\" data-name=\"footer secondary Join Now button\">\n                            Join Now\n                        </button>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-4 gap-8 text-[13px] pt-2\" data-kid=\"1-6-1-2-2\" data-name=\"footer link columns grid\">\n                    <div data-kid=\"1-6-1-2-2-1\" data-name=\"footer memberships link column\">\n                        <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-1-2-2-1-1\" data-name=\"footer memberships column heading\">\n                            Memberships\n                        </p>\n                        <ul class=\"space-y-3\" data-kid=\"1-6-1-2-2-1-2\" data-name=\"footer memberships link list\">\n                            <li data-kid=\"1-6-1-2-2-1-2-1\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-1-2-1-1\" href=\"#\">\n                                    Aero Fit One\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-1-2-2\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-1-2-2-1\" href=\"#\">\n                                    Aero Fit Peak\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-1-2-3\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-1-2-3-1\" href=\"#\">\n                                    Aero Fit Life\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-1-2-4\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-1-2-4-1\" href=\"#\">\n                                    Compare plans\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-6-1-2-2-2\" data-name=\"footer why Aero Fit link column\">\n                        <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-1-2-2-2-1\" data-name=\"footer why Aero Fit column heading\">\n                            Why Aero Fit\n                        </p>\n                        <ul class=\"space-y-3\" data-kid=\"1-6-1-2-2-2-2\" data-name=\"footer why Aero Fit link list\">\n                            <li data-kid=\"1-6-1-2-2-2-2-1\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-2-2-1-1\" href=\"#\">\n                                    How it works\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-2-2-2\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-2-2-2-1\" href=\"#\">\n                                    Advanced Labs\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-2-2-3\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-2-2-3-1\" href=\"#\">\n                                    Healthspan\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-2-2-4\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-2-2-4-1\" href=\"#\">\n                                    Heart Health\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-6-1-2-2-3\" data-name=\"footer support link column\">\n                        <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-1-2-2-3-1\" data-name=\"footer support column heading\">\n                            Support\n                        </p>\n                        <ul class=\"space-y-3\" data-kid=\"1-6-1-2-2-3-2\" data-name=\"footer support link list\">\n                            <li data-kid=\"1-6-1-2-2-3-2-1\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-3-2-1-1\" href=\"#\">\n                                    Help Center\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-3-2-2\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-3-2-2-1\" href=\"#\">\n                                    Sizing\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-3-2-3\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-3-2-3-1\" href=\"#\">\n                                    Accessories\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-3-2-4\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-3-2-4-1\" href=\"#\">\n                                    Download App\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-6-1-2-2-4\" data-name=\"footer connect link column\">\n                        <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-1-2-2-4-1\" data-name=\"footer connect column heading\">\n                            Connect\n                        </p>\n                        <ul class=\"space-y-3\" data-kid=\"1-6-1-2-2-4-2\" data-name=\"footer connect link list\">\n                            <li data-kid=\"1-6-1-2-2-4-2-1\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-4-2-1-1\" href=\"#\">\n                                    Instagram\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-4-2-2\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-4-2-2-1\" href=\"#\">\n                                    YouTube\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-4-2-3\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-4-2-3-1\" href=\"#\">\n                                    Podcast\n                                </a>\n                            </li>\n                            <li data-kid=\"1-6-1-2-2-4-2-4\">\n                                <a class=\"hover:opacity-70 transition\" data-kid=\"1-6-1-2-2-4-2-4-1\" href=\"#\">\n                                    Contact\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <p class=\"mt-12 text-[11px] leading-[1.7] text-[#7A5B64] max-w-[820px]\" data-kid=\"1-6-1-3\" data-name=\"footer legal disclaimer text\">\n                Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. If you have health concerns, consult your doctor or another qualified healthcare professional.\n            </p>\n            <div class=\"mt-6 pt-6 border-t border-[#E8E2DE] flex items-center justify-between text-[12px] text-[#7A5B64]\" data-kid=\"1-6-1-4\" data-name=\"footer legal links and copyright bar\">\n                <div class=\"flex gap-5\" data-kid=\"1-6-1-4-1\" data-name=\"footer legal links group\">\n                    <a class=\"hover:text-[#2A0B14] transition\" data-kid=\"1-6-1-4-1-1\" data-name=\"terms and conditions link\" href=\"#\">\n                        Terms &amp; Conditions\n                    </a>\n                    <a class=\"hover:text-[#2A0B14] transition\" data-kid=\"1-6-1-4-1-2\" data-name=\"privacy policy link\" href=\"#\">\n                        Privacy Policy\n                    </a>\n                    <a class=\"hover:text-[#2A0B14] transition\" data-kid=\"1-6-1-4-1-3\" data-name=\"accessibility link\" href=\"#\">\n                        Accessibility\n                    </a>\n                </div>\n                <span data-kid=\"1-6-1-4-2\" data-name=\"footer copyright notice text\">\n                    © 2026 Aero Fit. All rights reserved.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    function cal(el,title,startDow,days,prevTail,cfg,plusSide){\n  const d=['S','M','T','W','T','F','S'];\n  let h=`<div class=\"flex items-center justify-between mb-3\">${plusSide==='l'?'<span class=\"w-3.5 h-3.5 rounded-full border border-[#E3DDDA] flex items-center justify-center text-[8px]\">+</span>':'<span></span>'}<span class=\"font-semibold text-[9px]\">${title}</span>${plusSide==='r'?'<span class=\"w-3.5 h-3.5 rounded-full border border-[#E3DDDA] flex items-center justify-center text-[8px]\">+</span>':'<span></span>'}</div><div class=\"grid grid-cols-7 gap-y-1 text-center\">`;\n  d.forEach(x=>h+=`<span class=\"text-[#9A8E91] h-5 leading-5\">${x}</span>`);\n  for(let i=0;i<startDow;i++)h+=`<span class=\"h-5 leading-5 text-[#D6CFCC]\">${prevTail?prevTail-startDow+i+1:''}</span>`;\n  for(let n=1;n<=days;n++){\n    let c='h-5 leading-5 rounded relative';\n    if(cfg.band&&cfg.band.includes(n))c+=' bg-[#FBF7C8] rounded-none';\n    if(cfg.fill&&cfg.fill.includes(n))c+=' bg-[#F8F38A] !rounded';\n    if(cfg.ring&&cfg.ring.includes(n))c+=' ring-1 ring-[#EF6A84] text-[#D1435E] !rounded bg-white';\n    if(cfg.red&&cfg.red.includes(n))c+=' text-[#EF3B4A]';\n    const dot=cfg.dot&&cfg.dot.includes(n)?'<span class=\"absolute left-1/2 -translate-x-1/2 bottom-[1px] w-[2px] h-[2px] rounded-full bg-[#2A0B14]\"></span>':'';\n    h+=`<span class=\"${c}\">${n}${dot}</span>`;\n  }\n  el.innerHTML=h+'</div>';\n}\ncal(document.getElementById('cal1'),'April 2026',3,30,31,{band:[19,20,21,23,25,26,27,28,29,30],fill:[24],ring:[22],dot:[9,14,18,30]},'l');\ncal(document.getElementById('cal2'),'May 2026',5,31,0,{band:[1,2,3,4,5,6,7,8,9],fill:[12],ring:[20],red:[10,11],dot:[7,14,28]},'r');\n\nfunction rows(el,items){\n  el.innerHTML=items.map(([ic,t,s])=>`<div class=\"flex items-center gap-2 bg-[#FAF8F6] rounded-md px-2 py-1.5\"><span class=\"w-5 h-5 rounded-full bg-white flex items-center justify-center text-[10px]\"><i class=\"ti ${ic}\"></i></span><div class=\"flex-1\"><p class=\"text-[8px] font-semibold\">${t}</p><p class=\"text-[6.5px] text-[#9A8E91]\">${s}</p></div><span class=\"text-[8px] text-[#C9C0C2]\"><i class=\"ti ti-chevron-down\"></i></span></div>`).join('');\n}\nrows(document.getElementById('mon1'),[['ti-moon','Sleep Performance','92% · 7h 48m'],['ti-battery-charging','Recovery','78% · Green'],['ti-flame','Day Strain','14.2 · Optimal']]);\nrows(document.getElementById('mon2'),[['ti-heartbeat','Resting Heart Rate','52 bpm'],['ti-wave-sine','HRV','68 ms · Above baseline'],['ti-lungs','Blood Oxygen','98% SpO₂']]);\n\nconst heat=document.getElementById('heat');const pat='10111011101011101110101110111011100110110111';\nlet hh='';for(let i=0;i<44;i++){const on=pat[i]==='1';hh+=`<span class=\"h-[11px] rounded-[2px] ${on?(i%3?'bg-[#F6EE7A]':'bg-[#F9F3A8]'):'bg-transparent'}\"></span>`}heat.innerHTML=hh;\n</script>\n",
