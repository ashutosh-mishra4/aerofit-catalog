      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.serif{font-family:'Source Serif 4',serif;}\n.sans{font-family:'Inter',sans-serif;}\n.marq{animation:marq 14s linear infinite;}\n@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n</style>\n<div class=\"sans bg-[#FAF8F6] text-[#2A0B14] antialiased overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Announcement -->\n    <!-- Nav -->\n    <header class=\"max-w-[1160px] mx-auto px-6 h-[68px] flex items-center justify-between\" data-kid=\"1-2\" data-name=\"site header\">\n        <a class=\"flex items-center gap-2\" data-kid=\"1-2-1\" data-name=\"brand logo link\" href=\"#\">\n            <img alt=\"Aero Fit logo\" class=\"w-8 h-8\" data-kid=\"1-2-1-1\" data-name=\"Aero Fit logo mark\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\">\n            <span class=\"serif text-[26px] font-medium tracking-tight\" data-kid=\"1-2-1-2\" data-name=\"brand wordmark text\">\n                Aero Fit\n            </span>\n        </a>\n        <nav class=\"flex items-center gap-8 text-[14px] font-medium\" data-kid=\"1-2-2\" data-name=\"main navigation menu\">\n            <a class=\"flex items-center gap-1 hover:opacity-70 transition\" data-kid=\"1-2-2-1\" data-name=\"Memberships nav link with dropdown\" href=\"#\">\n                Memberships\n                <span class=\"text-[12px]\" data-kid=\"1-2-2-1-1\" data-name=\"dropdown chevron indicator\">\n                    <i class=\"ti ti-chevron-down\" data-kid=\"1-2-2-1-1-1\" data-name=\"chevron down icon\">\n                    </i>\n                </span>\n            </a>\n            <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-2-2\" data-name=\"How it works nav link\" href=\"#\">\n                How it works\n            </a>\n            <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-2-3\" data-name=\"Why WHOOP nav link\" href=\"#\">\n                Why Aero Fit\n            </a>\n            <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-2-5\" data-name=\"Accessories nav link\" href=\"#\">\n                Accessories\n            </a>\n            <a class=\"hover:opacity-70 transition\" data-kid=\"1-2-2-6\" data-name=\"Download App nav link\" href=\"#\">\n                Download App\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-2 whitespace-nowrap\" data-kid=\"1-2-3\" data-name=\"auth action buttons group\">\n            <button class=\"h-9 px-3 rounded-lg border border-[#E8E2DE] bg-white text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-2-3-1\" data-name=\"Sign in button\">\n                Sign in\n            </button>\n            <button class=\"h-9 px-3.5 rounded-lg bg-[#F8F38A] text-[14px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-2-3-2\" data-name=\"Join WHOOP free call-to-action button\">\n                Join Aero Fit free\n            </button>\n        </div>\n    </header>\n    <!-- Hero -->\n    <section class=\"relative pt-14 pb-10\" data-kid=\"1-3\" data-name=\"hero section\">\n        <div class=\"absolute -left-[150px] top-[110px] w-[290px] h-[290px] rounded-full border border-[#E6E1DD]\" data-kid=\"1-3-1\" data-name=\"left decorative circle outline\">\n        </div>\n        <div class=\"absolute -right-[150px] top-[110px] w-[290px] h-[290px] rounded-full border border-[#E6E1DD]\" data-kid=\"1-3-2\" data-name=\"right decorative circle outline\">\n        </div>\n        <div class=\"absolute left-1/2 -translate-x-1/2 top-0 w-[820px] h-[560px] bg-gradient-to-b from-[#F5EFEC] to-transparent rounded-t-[40px] opacity-70\" data-kid=\"1-3-3\" data-name=\"centered gradient backdrop\">\n        </div>\n        <div class=\"relative text-center\" data-kid=\"1-3-4\" data-name=\"hero content block\">\n            <div class=\"mx-auto w-[170px] overflow-hidden text-[12px] text-[#4A2A33] [mask-image:linear-gradient(90deg,transparent,#000_15%,#000_85%,transparent)]\" data-kid=\"1-3-4-1\" data-name=\"scrolling marquee label area\">\n                <div class=\"marq flex whitespace-nowrap w-max gap-1.5\" data-dynamic=\"true\" data-kid=\"1-3-4-1-1\" data-name=\"marquee track\" data-reason=\"track translated by infinite marquee keyframe animation\">\n                </div>\n            </div>\n            <h1 class=\"serif mt-6 text-[68px] leading-[1.08] font-medium tracking-[-0.01em]\" data-kid=\"1-3-4-2\" data-name=\"hero headline text\">\n                Know What Your Body\n                <br data-kid=\"1-3-4-2-1\" data-name=\"headline line break\">\n                Needs, Every Single Day\n            </h1>\n            <p class=\"mt-6 text-[15px] leading-[1.6] text-[#4A2A33] max-w-[480px] mx-auto\" data-kid=\"1-3-4-3\" data-name=\"hero subheadline paragraph\">\n                Aero Fit turns 24/7 health insights into personalized coaching to help you sleep, train, and feel better wherever life takes you.\n            </p>\n            <div class=\"mt-7 flex justify-center gap-2\" data-kid=\"1-3-4-4\" data-name=\"hero CTA button group\">\n                <button class=\"h-11 px-4 rounded-lg bg-[#F8F38A] text-[14px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-3-4-4-1\" data-name=\"primary Try WHOOP free button\">\n                    Try Aero Fit for free\n                </button>\n                <button class=\"h-11 px-3.5 rounded-lg border border-[#E8E2DE] bg-white text-[14px] font-medium hover:bg-[#F3EFEC] transition\" data-kid=\"1-3-4-4-2\" data-name=\"secondary Join Now button\">\n                    Join Now\n                </button>\n            </div>\n        </div>\n        <!-- Hero visual -->\n        <div class=\"relative mt-9 mx-auto w-[830px] rounded-[18px] bg-gradient-to-b from-[#FAF8F6] via-[#FAF8F6] to-[#F8F38A] p-9 pt-0 pb-9\" data-kid=\"1-3-5\" data-name=\"hero product visual panel\">\n            <div class=\"bg-white rounded-[14px] p-4 shadow-[0_10px_40px_rgba(42,11,20,0.06)]\" data-kid=\"1-3-5-1\" data-name=\"video call card\">\n                <div class=\"flex gap-3\" data-kid=\"1-3-5-1-1\" data-name=\"video call media grid\">\n                    <div class=\"relative w-[548px] h-[336px] rounded-[10px] overflow-hidden\" data-kid=\"1-3-5-1-1-1\" data-name=\"large video call frame\">\n                        <img alt=\"Two friends laughing and high-fiving after a forest trail run, both wearing Aero Fit bands\" class=\"w-full h-full object-cover object-[60%_30%]\" data-kid=\"1-3-5-1-1-1-1\" data-name=\"hero image of two friends after a trail run\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/65ac1bc7a57c4d3bb3773cee4236749d.png\">\n                    </div>\n                    <div class=\"flex flex-col gap-3 flex-1\" data-kid=\"1-3-5-1-1-2\" data-name=\"pip thumbnail column\">\n                        <div class=\"relative h-[104px] rounded-[10px] overflow-hidden\" data-kid=\"1-3-5-1-1-2-1\" data-name=\"coach video thumbnail frame\">\n                            <img alt=\"Performance coach on a video call\" class=\"w-full h-full object-cover\" data-kid=\"1-3-5-1-1-2-1-1\" data-name=\"coach thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/477df3f011ae43f3abe4c0cf588a828b.jpg\">\n                            <div class=\"absolute left-2 bottom-2 flex items-center gap-1 bg-black/45 text-white text-[8px] px-1.5 py-0.5 rounded\" data-kid=\"1-3-5-1-1-2-1-2\" data-name=\"coach name label overlay\">\n                                <span class=\"text-[#F8F38A]\" data-kid=\"1-3-5-1-1-2-1-2-1\" data-name=\"coach icon badge\">\n                                    <i class=\"ti ti-chart-bar\" data-kid=\"1-3-5-1-1-2-1-2-1-1\" data-name=\"bar chart icon\">\n                                    </i>\n                                </span>\n                                Coach Amelia Carter\n                            </div>\n                        </div>\n                        <div class=\"relative h-[104px] rounded-[10px] overflow-hidden\" data-kid=\"1-3-5-1-1-2-2\" data-name=\"sleep scientist video thumbnail frame\">\n                            <img alt=\"Sleep scientist reviewing data\" class=\"w-full h-full object-cover\" data-kid=\"1-3-5-1-1-2-2-1\" data-name=\"sleep scientist thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/b55145485cc54ff08d9f99147f426b26.jpg\">\n                            <div class=\"absolute left-2 bottom-2 flex items-center gap-1 bg-black/45 text-white text-[8px] px-1.5 py-0.5 rounded\" data-kid=\"1-3-5-1-1-2-2-2\" data-name=\"participant name label overlay\">\n                                <span class=\"text-[#F8F38A]\" data-kid=\"1-3-5-1-1-2-2-2-1\" data-name=\"participant icon badge\">\n                                    <i class=\"ti ti-chart-bar\" data-kid=\"1-3-5-1-1-2-2-2-1-1\" data-name=\"bar chart icon\">\n                                    </i>\n                                </span>\n                                Dr. Daniel Morgan · Sleep\n                            </div>\n                        </div>\n                        <div class=\"relative h-[104px] rounded-[10px] overflow-hidden\" data-kid=\"1-3-5-1-1-2-3\" data-name=\"recovery specialist video thumbnail frame\">\n                            <img alt=\"Recovery specialist holding a tablet\" class=\"w-full h-full object-cover\" data-kid=\"1-3-5-1-1-2-3-1\" data-name=\"recovery specialist thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/082d9c34332646e7b8af0a283c122907.jpg\">\n                            <div class=\"absolute left-2 bottom-2 flex items-center gap-1 bg-black/45 text-white text-[8px] px-1.5 py-0.5 rounded\" data-kid=\"1-3-5-1-1-2-3-2\" data-name=\"participant name label overlay\">\n                                <span class=\"text-[#F8F38A]\" data-kid=\"1-3-5-1-1-2-3-2-1\" data-name=\"participant icon badge\">\n                                    <i class=\"ti ti-chart-bar\" data-kid=\"1-3-5-1-1-2-3-2-1-1\" data-name=\"bar chart icon\">\n                                    </i>\n                                </span>\n                                Sophia Bennett · Recovery\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Stats + logos -->\n        <p class=\"mt-10 text-center text-[14px] text-[#4A2A33]\" data-kid=\"1-3-6\" data-name=\"workouts logged stat text\">\n            Logged over\n            <span class=\"inline-block bg-[#2A0B14] text-white rounded-full px-2 py-0.5 text-[13px] font-medium\" data-kid=\"1-3-6-1\" data-name=\"stat count badge\">\n                12M\n            </span>\n            workouts last week\n        </p>\n    </section>\n    <!-- About -->\n    <section class=\"max-w-[1160px] mx-auto px-6 pt-20 pb-16\" data-kid=\"1-4\" data-name=\"about section\">\n        <div class=\"grid grid-cols-[230px_1fr] gap-8\" data-kid=\"1-4-1\" data-name=\"section heading grid\">\n            <p class=\"text-[14px] font-medium pt-2\" data-kid=\"1-4-1-1\" data-name=\"section eyebrow label\">\n                Why Aero Fit\n            </p>\n            <h2 class=\"serif text-[46px] leading-[1.12] font-medium tracking-[-0.01em]\" data-kid=\"1-4-1-2\" data-name=\"section headline\">\n                Unlocking Human\n                <br data-kid=\"1-4-1-2-1\" data-name=\"headline line break\">\n                Performance &amp; Healthspan\n            </h2>\n        </div>\n        <div class=\"mt-8 grid grid-cols-[230px_480px_1fr] gap-8\" data-kid=\"1-4-2\" data-name=\"about content grid\">\n            <div class=\"flex flex-col justify-end pb-2\" data-kid=\"1-4-2-1\" data-name=\"rating and avatars block\">\n                <p class=\"serif text-[44px] leading-none font-medium\" data-kid=\"1-4-2-1-1\" data-name=\"star rating number\">\n                    4.8\n                </p>\n                <div aria-label=\"4.8 out of 5 stars\" class=\"mt-3 flex gap-1 text-[22px] leading-none\" data-kid=\"1-4-2-1-2\" data-name=\"star rating row\">\n                    <span class=\"text-[#F5A524]\" data-kid=\"1-4-2-1-2-1\" data-name=\"filled star\">\n                        ★\n                    </span>\n                    <span class=\"text-[#F5A524]\" data-kid=\"1-4-2-1-2-2\" data-name=\"filled star\">\n                        ★\n                    </span>\n                    <span class=\"text-[#F5A524]\" data-kid=\"1-4-2-1-2-3\" data-name=\"filled star\">\n                        ★\n                    </span>\n                    <span class=\"text-[#F5A524]\" data-kid=\"1-4-2-1-2-4\" data-name=\"filled star\">\n                        ★\n                    </span>\n                    <span class=\"bg-[linear-gradient(90deg,#F5A524_60%,#E3DDDA_60%)] bg-clip-text text-transparent\" data-kid=\"1-4-2-1-2-5\" data-name=\"partially filled star\">\n                        ★\n                    </span>\n                </div>\n                <p class=\"mt-2 text-[16px] font-medium\" data-kid=\"1-4-2-1-3\" data-name=\"rating caption text\">\n                    Member Satisfaction\n                </p>\n                <div class=\"mt-4 flex -space-x-2.5\" data-kid=\"1-4-2-1-4\" data-name=\"member avatar stack\">\n                    <img alt=\"Member avatar\" class=\"w-10 h-10 rounded-full border-2 border-[#FAF8F6] object-cover\" data-kid=\"1-4-2-1-4-1\" data-name=\"member avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=whoop-ashlynn\">\n                    <img alt=\"Member avatar\" class=\"w-10 h-10 rounded-full border-2 border-[#FAF8F6] object-cover\" data-kid=\"1-4-2-1-4-2\" data-name=\"member avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=whoop-samatha\">\n                    <img alt=\"Member avatar\" class=\"w-10 h-10 rounded-full border-2 border-[#FAF8F6] object-cover\" data-kid=\"1-4-2-1-4-3\" data-name=\"member avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?u=whoop-ellie\">\n                    <span class=\"w-10 h-10 rounded-full border-2 border-[#FAF8F6] bg-[#2A0B14] text-white text-[11px] font-medium flex items-center justify-center\" data-kid=\"1-4-2-1-4-4\" data-name=\"member count badge\">\n                        5M+\n                    </span>\n                </div>\n            </div>\n            <div class=\"h-[236px] rounded-[10px] overflow-hidden\" data-kid=\"1-4-2-2\" data-name=\"about image frame\">\n                <img alt=\"Two athletes stretching on a track at sunrise\" class=\"w-full h-full object-cover hover:scale-[1.03] transition duration-700\" data-kid=\"1-4-2-2-1\" data-name=\"athletes stretching image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/1f026a8f11f74e0cbbfa802834c37de1.jpg\">\n            </div>\n            <div class=\"flex flex-col justify-between pl-4\" data-kid=\"1-4-2-3\" data-name=\"about description and CTA\">\n                <p class=\"text-[14px] leading-[1.6] text-[#4A2A33]\" data-kid=\"1-4-2-3-1\" data-name=\"about description text\">\n                    We make 24/7 health monitoring simple, accurate, and personal. With independently validated sensors and personalized coaching, we help you understand your sleep, strain, and stress, so you can act on it every day.\n                </p>\n                <button class=\"self-start h-10 px-3.5 rounded-lg bg-[#F8F38A] text-[14px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-4-2-3-2\" data-name=\"Learn More call-to-action button\">\n                    Learn More\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Journey -->\n    <section class=\"max-w-[1160px] mx-auto px-6 pt-14 pb-24\" data-kid=\"1-5\" data-name=\"journey features section\">\n        <div class=\"flex items-end justify-between\" data-kid=\"1-5-1\" data-name=\"features section header row\">\n            <h2 class=\"serif text-[40px] leading-[1.12] font-medium tracking-[-0.01em]\" data-kid=\"1-5-1-1\" data-name=\"features section headline\">\n                Everything Your Body Needs,\n                <br data-kid=\"1-5-1-1-1\" data-name=\"headline line break\">\n                One Simple Wearable\n            </h2>\n            <p class=\"text-[12px] leading-[1.6] text-[#4A2A33] max-w-[260px] pb-2\" data-kid=\"1-5-1-2\" data-name=\"features section subheadline\">\n                Experience 24/7 monitoring across sleep, strain, stress and heart health with personalized daily coaching\n            </p>\n        </div>\n        <!-- Card 1: Sleep -->\n        <div class=\"mt-12 bg-[#F6F1EE] rounded-[18px] p-5 grid grid-cols-[1fr_600px] gap-8\" data-kid=\"1-5-2\" data-name=\"sleep feature card\">\n            <div class=\"p-3 flex flex-col\" data-kid=\"1-5-2-1\" data-name=\"sleep feature content column\">\n                <span class=\"text-[18px]\" data-kid=\"1-5-2-1-1\" data-name=\"feature topic icon holder\">\n                    <i class=\"ti ti-moon-stars\" data-kid=\"1-5-2-1-1-1\" data-name=\"moon stars icon\">\n                    </i>\n                </span>\n                <h3 class=\"serif mt-5 text-[22px] font-medium\" data-kid=\"1-5-2-1-2\" data-name=\"feature card title\">\n                    Optimize Your Sleep\n                </h3>\n                <p class=\"mt-2 text-[12px] leading-[1.55] text-[#5A3B44] max-w-[300px]\" data-kid=\"1-5-2-1-3\" data-name=\"feature card description\">\n                    Get a personalized bedtime and wake up ready for whatever’s ahead, every day.\n                </p>\n                <ul class=\"mt-10 space-y-3.5 text-[12px]\" data-kid=\"1-5-2-1-4\" data-name=\"feature checklist\">\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"1-5-2-1-4-1\" data-name=\"checklist item with recommended bedtime\">\n                        <i class=\"ti ti-check\" data-kid=\"1-5-2-1-4-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                        Get a recommended bedtime each night\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"1-5-2-1-4-2\" data-name=\"checklist item with sleep stages\">\n                        <i class=\"ti ti-check\" data-kid=\"1-5-2-1-4-2-1\" data-name=\"checkmark icon\">\n                        </i>\n                        Track sleep stages and consistency\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"1-5-2-1-4-3\" data-name=\"checklist item with Smart Alarm\">\n                        <i class=\"ti ti-check\" data-kid=\"1-5-2-1-4-3-1\" data-name=\"checkmark icon\">\n                        </i>\n                        Wake at the right time with Smart Alarm\n                    </li>\n                </ul>\n                <button class=\"mt-12 self-start h-10 px-3.5 rounded-md bg-[#2A0B14] text-white text-[12px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-5-2-1-5\" data-name=\"Get Started button\">\n                    Get Started\n                </button>\n            </div>\n            <div class=\"h-[330px] rounded-[14px] bg-[radial-gradient(ellipse_at_40%_0%,#F7BFB0_0%,#FAD9D0_35%,#FCE7D8_65%,#FAD7A8_100%)] flex items-center justify-center\" data-kid=\"1-5-2-2\" data-name=\"sleep 