a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-2-2-1-1\" data-name=\"how it works footer link\" href=\"#\">\n                                    How it works\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-2-2-2\" data-name=\"advanced labs footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-2-2-2-1\" data-name=\"advanced labs footer link\" href=\"#\">\n                                    Advanced Labs\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-2-2-3\" data-name=\"healthspan footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-2-2-3-1\" data-name=\"healthspan footer link\" href=\"#\">\n                                    Healthspan\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-2-2-4\" data-name=\"heart health footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-2-2-4-1\" data-name=\"heart health footer link\" href=\"#\">\n                                    Heart Health\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-10-1-1-2-3\" data-name=\"footer support link column\">\n                        <p class=\"text-white/50 mb-4\" data-kid=\"1-10-1-1-2-3-1\" data-name=\"support column heading\">\n                            Support\n                        </p>\n                        <ul class=\"space-y-3 text-white/90\" data-kid=\"1-10-1-1-2-3-2\" data-name=\"support link list\">\n                            <li data-kid=\"1-10-1-1-2-3-2-1\" data-name=\"help center footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-3-2-1-1\" data-name=\"help center footer link\" href=\"#\">\n                                    Help Center\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-3-2-2\" data-name=\"sizing footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-3-2-2-1\" data-name=\"sizing footer link\" href=\"#\">\n                                    Sizing\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-3-2-3\" data-name=\"accessories footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-3-2-3-1\" data-name=\"accessories footer link\" href=\"#\">\n                                    Accessories\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-3-2-4\" data-name=\"download app footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-3-2-4-1\" data-name=\"download app footer link\" href=\"#\">\n                                    Download App\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-10-1-1-2-4\" data-name=\"footer connect link column\">\n                        <p class=\"text-white/50 mb-4\" data-kid=\"1-10-1-1-2-4-1\" data-name=\"connect column heading\">\n                            Connect\n                        </p>\n                        <ul class=\"space-y-3 text-white/90\" data-kid=\"1-10-1-1-2-4-2\" data-name=\"connect link list\">\n                            <li data-kid=\"1-10-1-1-2-4-2-1\" data-name=\"instagram footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-4-2-1-1\" data-name=\"instagram footer link\" href=\"#\">\n                                    Instagram\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-4-2-2\" data-name=\"youtube footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-4-2-2-1\" data-name=\"youtube footer link\" href=\"#\">\n                                    YouTube\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-4-2-3\" data-name=\"podcast footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-4-2-3-1\" data-name=\"podcast footer link\" href=\"#\">\n                                    Podcast\n                                </a>\n                            </li>\n                            <li data-kid=\"1-10-1-1-2-4-2-4\" data-name=\"contact footer link item\">\n                                <a class=\"hover:text-[#F8F38A] transition\" data-kid=\"1-10-1-1-2-4-2-4-1\" data-name=\"contact footer link\" href=\"#\">\n                                    Contact\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <p class=\"mt-14 pt-6 border-t border-white/12 text-[11px] leading-[1.7] text-white/50 max-w-[860px]\" data-kid=\"1-10-1-2\" data-name=\"footer medical disclaimer text\">\n                Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. If you have health concerns, consult your doctor or another qualified healthcare professional.\n            </p>\n            <div class=\"mt-6 flex items-center justify-between text-[12px] text-white/50\" data-kid=\"1-10-1-3\" data-name=\"footer legal bar\">\n                <div class=\"flex gap-5\" data-kid=\"1-10-1-3-1\" data-name=\"footer legal links row\">\n                    <a class=\"hover:text-white transition\" data-kid=\"1-10-1-3-1-1\" data-name=\"terms and conditions link\" href=\"#\">\n                        Terms & Conditions\n                    </a>\n                    <a class=\"hover:text-white transition\" data-kid=\"1-10-1-3-1-2\" data-name=\"privacy policy link\" href=\"#\">\n                        Privacy Policy\n                    </a>\n                    <a class=\"hover:text-white transition\" data-kid=\"1-10-1-3-1-3\" data-name=\"accessibility link\" href=\"#\">\n                        Accessibility\n                    </a>\n                </div>\n                <span data-kid=\"1-10-1-3-2\" data-name=\"footer copyright notice text\">\n                    © 2026 Aero Fit. All rights reserved.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    function cal(el,title,startDow,days,prevTail,cfg){\n  const d=['S','M','T','W','T','F','S'];\n  let h=`<div class=\"flex items-center justify-between mb-2\"><span class=\"w-3 h-3 rounded-full border border-[#E3DDDA] flex items-center justify-center text-[7px]\">+</span><span class=\"font-semibold text-[8px]\">${title}</span><span class=\"w-3 h-3\"></span></div><div class=\"grid grid-cols-7 gap-y-0.5 text-center\">`;\n  d.forEach(x=>h+=`<span class=\"text-[#9A8E91] h-4 leading-4\">${x}</span>`);\n  for(let i=0;i<startDow;i++)h+=`<span class=\"h-4 leading-4 text-[#D6CFCC]\">${prevTail-startDow+i+1}</span>`;\n  for(let n=1;n<=days;n++){\n    let c='h-4 leading-4 rounded relative';\n    if(cfg.band.includes(n))c+=' bg-[#FBF7C8] rounded-none';\n    if(cfg.fill.includes(n))c+=' bg-[#F8F38A] !rounded';\n    if(cfg.ring.includes(n))c+=' ring-1 ring-[#EF6A84] text-[#D1435E] !rounded bg-white';\n    const dot=cfg.dot.includes(n)?'<span class=\"absolute left-1/2 -translate-x-1/2 bottom-0 w-[2px] h-[2px] rounded-full bg-[#2A0B14]\"></span>':'';\n    h+=`<span class=\"${c}\">${n}${dot}</span>`;\n  }\n  el.innerHTML=h+'</div>';\n}\ncal(document.getElementById('cal1'),'April 2026',3,30,31,{band:[19,20,21,23,25,26,27,28,29,30],fill:[24],ring:[22],dot:[9,14,18]});\n\nfunction rows(el,items){\n  el.innerHTML=items.map(([ic,t,s])=>`<div class=\"flex items-center gap-2 bg-[#FAF8F6] rounded-md px-2 py-1.5\"><span class=\"w-5 h-5 rounded-full bg-white flex items-center justify-center text-[10px]\"><i class=\"ti ${ic}\"></i></span><div class=\"flex-1\"><p class=\"text-[8px] font-semibold\">${t}</p><p class=\"text-[6.5px] text-[#9A8E91]\">${s}</p></div><span class=\"text-[8px] text-[#C9C0C2]\"><i class=\"ti ti-chevron-down\"></i></span></div>`).join('');\n}\nrows(document.getElementById('mon1'),[['ti-moon','Sleep Performance','92% · 7h 48m'],['ti-battery-charging','Recovery','78% · Green'],['ti-flame','Day Strain','14.2 · Optimal']]);\nrows(document.getElementById('mon2'),[['ti-heartbeat','Resting Heart Rate','52 bpm'],['ti-wave-sine','HRV','68 ms · Above baseline'],['ti-lungs','Blood Oxygen','98% SpO₂']]);\n\nconst heat=document.getElementById('heat');const pat='10111011101011101110101110111011100110110111';\nlet hh='';for(let i=0;i<44;i++){const on=pat[i]==='1';hh+=`<span class=\"h-[8px] rounded-[2px] ${on?(i%3?'bg-[#F6EE7A]':'bg-[#F9F3A8]'):'bg-[#F4F1EE]'}\"></span>`}heat.innerHTML=hh;\n\ndocument.getElementById('next').addEventListener('click',()=>document.getElementById('track').scrollBy({left:276,behavior:'smooth'}));\n</script>\n",
