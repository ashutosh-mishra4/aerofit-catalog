-4\">\n<div class=\"grid grid-cols-[1.6fr_1fr_1fr_1fr_1fr] gap-7 text-[15px]\" data-kid=\"1-7-4-1\" data-name=\"footer columns\" id=\"footCols\">\n<div data-kid=\"1-7-4-1-1\">\n<div class=\"flex items-center gap-2.5 mb-4\" data-kid=\"1-7-4-1-1-1\"><img alt=\"Aero Fit logo\" class=\"w-9 h-9\" data-kid=\"1-7-4-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/><span class=\"serif text-[26px] font-medium\" data-kid=\"1-7-4-1-1-1-2\">Aero Fit</span></div>\n<p class=\"text-[13px] italic opacity-60 max-w-[30ch] leading-[1.6]\" data-kid=\"1-7-4-1-1-2\" data-name=\"footer blurb\">Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease.</p>\n</div>\n<div data-kid=\"1-7-4-1-2\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-7-4-1-2-1\">Shop</p><ul class=\"space-y-2 opacity-85\" data-kid=\"1-7-4-1-2-2\"><li data-kid=\"1-7-4-1-2-2-1\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-2-2-1-1\" href=\"#\">Aero Fit Lite</a></li><li data-kid=\"1-7-4-1-2-2-2\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-2-2-2-1\" href=\"#\">Aero Fit Smart</a></li><li data-kid=\"1-7-4-1-2-2-3\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-2-2-3-1\" href=\"#\">Aero Fit Pro</a></li><li data-kid=\"1-7-4-1-2-2-4\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-2-2-4-1\" href=\"#\">Aero Fit Music</a></li><li data-kid=\"1-7-4-1-2-2-5\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-2-2-5-1\" href=\"#\">Aero Fit Ultra</a></li></ul></div>\n<div data-kid=\"1-7-4-1-3\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-7-4-1-3-1\">Memberships</p><ul class=\"space-y-2 opacity-85\" data-kid=\"1-7-4-1-3-2\"><li data-kid=\"1-7-4-1-3-2-1\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-3-2-1-1\" href=\"#\">Aero Fit One</a></li><li data-kid=\"1-7-4-1-3-2-2\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-3-2-2-1\" href=\"#\">Aero Fit Peak</a></li><li data-kid=\"1-7-4-1-3-2-3\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-3-2-3-1\" href=\"#\">Aero Fit Life</a></li><li data-kid=\"1-7-4-1-3-2-4\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-3-2-4-1\" href=\"#\">Compare plans</a></li></ul></div>\n<div data-kid=\"1-7-4-1-4\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-7-4-1-4-1\">Support</p><ul class=\"space-y-2 opacity-85\" data-kid=\"1-7-4-1-4-2\"><li data-kid=\"1-7-4-1-4-2-1\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-4-2-1-1\" href=\"#\">Help Center</a></li><li data-kid=\"1-7-4-1-4-2-2\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-4-2-2-1\" href=\"#\">Sizing guide</a></li><li data-kid=\"1-7-4-1-4-2-3\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-4-2-3-1\" href=\"#\">Accessories</a></li><li data-kid=\"1-7-4-1-4-2-4\"><a class=\"hover:text-[#F8F38A]\" data-kid=\"1-7-4-1-4-2-4-1\" href=\"#\">Download App</a></li></ul></div>\n<div data-kid=\"1-7-4-1-5\"><p class=\"text-[11px] font-semibold tracking-[0.2em] uppercase text-[#F8F38A] mb-4\" data-kid=\"1-7-4-1-5-1\">Connect</p>\n<div class=\"flex gap-3\" data-kid=\"1-7-4-1-5-2\" data-name=\"social icons\">\n<a aria-label=\"Instagram\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-7-4-1-5-2-1\" href=\"#\"><i class=\"ti ti-brand-instagram\" data-kid=\"1-7-4-1-5-2-1-1\"></i></a>\n<a aria-label=\"YouTube\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-7-4-1-5-2-2\" href=\"#\"><i class=\"ti ti-brand-youtube\" data-kid=\"1-7-4-1-5-2-2-1\"></i></a>\n<a aria-label=\"Podcast\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-7-4-1-5-2-3\" href=\"#\"><i class=\"ti ti-microphone\" data-kid=\"1-7-4-1-5-2-3-1\"></i></a>\n<a aria-label=\"Contact\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-7-4-1-5-2-4\" href=\"#\"><i class=\"ti ti-mail\" data-kid=\"1-7-4-1-5-2-4-1\"></i></a>\n</div>\n</div>\n</div>\n<div class=\"mt-12 pt-6 border-t border-white/15 flex justify-between items-center text-[13px] italic opacity-70\" data-kid=\"1-7-4-2\" data-name=\"fine print row\">\n<span data-kid=\"1-7-4-2-1\">© 2026 Aero Fit · membership plans are billed annually with a 12-month minimum term</span>\n<div class=\"flex gap-6\" data-kid=\"1-7-4-2-2\"><a data-kid=\"1-7-4-2-2-1\" href=\"#\">Terms &amp; Conditions</a><a data-kid=\"1-7-4-2-2-2\" href=\"#\">Privacy Policy</a><a data-kid=\"1-7-4-2-2-3\" href=\"#\">Accessibility</a></div>\n</div>\n</div>\n</footer>\n</div>\n<script>\n    const IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',line:'Titanium case, dual-band GPS and 14 days of battery for multi-day races and long training blocks.',price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',b:1,isNew:1,specs:[['14 days','Battery'],['100 m','Water'],['Dual-band','GPS']]},\n{id:'pro',n:'Pro',line:'Built-in GPS and ECG for structured training without your phone.',price:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',b:1},\n{id:'lite',n:'Lite',line:'Featherweight tracking for sleep, steps and daily recovery.',price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',b:1},\n{id:'smart',n:'Smart',line:'Everyday sleep, strain and recovery on an always-on display.',price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',b:1},\n{id:'music',n:'Music',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',price:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',b:1}];\nconst ORDER=['lite','smart','pro','music','ultra'];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={\n sleep:{n:'sleep',img:'https://images.pexels.com/photos/6963181/pexels-photo-6963181.jpeg?auto=compress&cs=tinysrgb&w=600&q=80',alt:'Hand reaching for the bedside in morning light, photo by cottonbro studio on Pexels',fit:['lite','smart'],rows:['sleep','temp','weight','battery']},\n training:{n:'training',img:'https://images.unsplash.com/photo-1630254608294-d844a0242357?auto=format&w=600&q=80&fit=crop',alt:'Man training on a forest path, photo by Alex Gagareen on Unsplash',fit:['pro','ultra'],rows:['gps','modes','ecg','recovery']},\n music:{n:'music',img:'https://images.pexels.com/photos/18823179/pexels-photo-18823179.jpeg?auto=compress&cs=tinysrgb&w=600&q=80',alt:'Woman walking with headphones, photo by Fatih Güney on Pexels',fit:['music','pro'],rows:['storage','bt','gps']},\n endurance:{n:'endurance',img:'https://images.unsplash.com/photo-1745692607831-66df9207b8bc?auto=format&w=600&q=80&fit=crop',alt:'Hiker resting on a mountain ridge, photo by Haroon Khalid on Unsplash',fit:['ultra','pro'],rows:['battery','gps','water','case']}};\nconst ROWS=[\n ['battery','Battery life',['5 days','7 days','10 days','6 days','14 days'],1],\n ['gps','GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],\n ['ecg','ECG with Heart Screener',[0,0,1,0,1],1],\n ['storage','Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],\n ['case','Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],\n ['weight','Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],\n ['outright','Buy outright',['$149','$199','$279','$299','$399'],1],\n ['incl','Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only'],1],\n ['display','Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],\n ['water','Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],\n ['sleep','Sleep stages & Sleep Performance',[1,1,1,1,1],0],\n ['recovery','Recovery & Strain scores',[1,1,1,1,1],0],\n ['temp','Skin temperature',[0,1,1,1,1],0],\n ['bp','Blood Pressure Insights',[0,0,1,0,1],0],\n ['modes','Workout types',['20','40','120','80','150'],0],\n ['bt','Bluetooth headphones',[0,0,0,1,0],0]];\nlet mode='out',plan=2,use='endurance',cart=0,more=false,q={use:'training',night:'light',pay:'mem'};\nconst $=id=>document.getElementById(id);const byId=i=>P.find(p=>p.id===i);\nconst SIZE={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nfunction price(p,big){\n const sz=big?'text-[28px]':'text-[22px]';\n if(mode==='out')return `<p class=\"${sz} font-semibold leading-none\">$${p.price}</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">One-time · free returns</p>`;\n if(plan>=p.min){const[n,mo,yr]=PL[plan];return `<p class=\"${sz} font-semibold leading-none\">$0 <span class=\"text-[14px] font-medium text-[#6B4F57]\">band</span></p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">With ${n} · $${yr}/yr ($${mo}/mo)</p>`}\n return `<p class=\"text-[16px] font-semibold leading-tight\">Included with ${PL[p.min][0]}</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">Not part of ${PL[plan][0]}</p>`;\n}\nfunction buy(p,big){\n const blocked=mode==='mem'&&plan<p.min;\n return `<div class=\"mt-5 rounded-[18px] bg-[#FAF8F6] border border-[#F0EBE8] p-4\">\n  <div class=\"flex items-start justify-between gap-3\"><div>${price(p,big)}</div>\n   <div class=\"text-right\"><div class=\"flex gap-1 justify-end\">${p.c.map((c,i)=>`<button data-act=\"color\" data-id=\"${p.id}\" data-i=\"${i}\" aria-label=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${i===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full\" style=\"background:${c[1]}\"></span></button>`).join('')}</div><p class=\"mt-1 text-[13px] text-[#6B4F57]\">${p.c[p.ci][0]}</p></div></div>\n  <div class=\"mt-4 flex items-center gap-2\">\n   <div class=\"h-11 p-1 rounded-full bg-white border border-[#EFEAE6] flex\" aria-label=\"Size\">${['S','M','L'].map(s=>`<button data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" title=\"${SIZE[s]}\" class=\"w-9 rounded-full text-[13px] font-medium ${s===p.s?'bg-[#2A0B14] text-white':'hover:bg-[#F3EFEC]'}\">${s}</button>`).join('')}</div>\n   ${blocked?`<button data-act=\"plan\" data-plan=\"${p.min}\" class=\"flex-1 h-11 rounded-full border border-[#2A0B14] text-[14px] font-medium hover:bg-white\">Switch to ${PL[p.min][0]}</button>`:`<button data-act=\"add\" data-id=\"${p.id}\" class=\"flex-1 h-11 rounded-full bg-[#2A0B14] text-white text-[14px] font-medium hover:bg-[#45172A] transition\">Add ${p.n} to cart</button>`}\n  </div>\n  <p class=\"mt-2 text-[12px] text-[#6B4F57]\">Size ${p.s} fits wrists ${SIZE[p.s]}</p>\n </div>`;\n}\nfunction fitTag(p){return USE[use].fit.includes(p.id)?`<span class=\"absolute left-3 bottom-3 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-2.5 py-1\">Good for ${USE[use].n}</span>`:''}\nfunction render(){\n $('shopFor').innerHTML=Object.entries(USE).map(([k,u])=>`<button data-act=\"use\" data-use=\"${k}\" class=\"text-left group\">\n  <div class=\"h-[330px] rounded-[20px] overflow-hidden ${k===use?'ring-2 ring-offset-4 ring-offset-[#FAF8F6] ring-[#2A0B14]':''}\"><img src=\"${u.img}\" alt=\"${u.alt}\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\"></div>\n  <div class=\"mt-4 flex items-center justify-between\"><p class=\"serif text-[24px] font-medium\">Shop for ${u.n}</p><span class=\"w-9 h-9 rounded-full flex items-center justify-center text-[16px] transition ${k===use?'bg-[#2A0B14] text-white':'bg-[#F3EFEC] group-hover:bg-[#ECE6E2]'}\"><i class=\"ti ti-arrow-down\"></i></span></div>\n  <p class=\"mt-1 text-[14px] text-[#4A2A33]\">${u.fit.map(i=>byId(i).n).join(' and ')} suit this best</p></button>`).join('');\n document.querySelectorAll('.modeBtn').forEach(b=>{const on=b.dataset.mode===mode;b.className='modeBtn h-10 px-5 rounded-full transition '+(on?'bg-[#2A0B14] text-white':'hover:bg-[#F3EFEC]')});\n const pr=$('planRow');pr.classList.toggle('hidden',mode==='out');pr.classList.toggle('flex',mode!=='out');\n pr.innerHTML='<span class=\"text-[#6B4F57] mr-1\">Plan</span>'+[1,2,3].map(t=>`<button data-act=\"plan\" data-plan=\"${t}\" class=\"h-9 px-3.5 rounded-full border transition ${t===plan?'border-[#2A0B14] bg-white font-medium':'border-[#E3DDDA] hover:bg-white'}\">${PL[t][0]} · $${PL[t][2]}/yr</button>`).join('');\n $('lineNote').innerHTML=mode==='out'?'Every band runs the same Aero Fit app, coaching and Recovery scores. Buy one outright and add a membership any time.':`On a membership the band is included. Example: <span class=\"font-medium text-[#2A0B14]\">Pro on Peak is $0 for the band, $299 billed today</span>, 12-month minimum.`;\n const [u,pro,...rest]=P;\n $('grid').innerHTML=`<article class=\"col-span-2 rounded-[28px] bg-[#F3EDE9] p-5 grid grid-cols-[1fr_340px] gap-7\">\n   <div class=\"relative rounded-[20px] bg-[radial-gradient(circle_at_50%_55%,#F8F38A_0%,#FBF4B8_40%,#F4F1EE_78%)] flex items-center justify-center min-h-[460px]\"><img src=\"${IMG.ultra}\" alt=\"Aero Fit Ultra in ${u.c[u.ci][0]}\" class=\"w-[360px] h-[360px] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\"><span class=\"absolute left-3 top-3 text-[12px] font-medium bg-white rounded-full px-2.5 py-1\">Ships Nov 4</span>${fitTag(u)}</div>\n   <div class=\"py-3 pr-2 flex flex-col\">\n    <h3 class=\"serif text-[38px] leading-[1.05] font-medium\">Aero Fit Ultra</h3>\n    <p class=\"mt-3 text-[15px] leading-[1.55] text-[#4A2A33]\">${u.line}</p>\n    <dl class=\"mt-6 grid grid-cols-3 gap-3\">${u.specs.map(s=>`<div><dd class=\"text-[18px] font-semibold\">${s[0]}</dd><dt class=\"text-[13px] text-[#6B4F57]\">${s[1]}</dt></div>`).join('')}</dl>\n    <div class=\"mt-auto\">${buy(u,1)}</div>\n   </div></article>`+\n  [pro,...rest].map(p=>`<article class=\"rounded-[24px] bg-white border border-[#EFEAE6] p-4 ${p.id==='pro'?'self-stretch flex flex-col':''}\">\n   <div class=\"relative ${p.id==='pro'?'h-[268px]':'h-[230px]'} rounded-[18px] bg-[#F4F1EE] flex items-center justify-center\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"w-[200px] h-[200px] object-contain mix-blend-multiply ${p.b?'brightness-110 contrast-[1.05]':''}\" decoding=\"async\" loading=\"lazy\">${fitTag(p)}</div>\n   <div class=\"px-1 mt-4 ${p.id==='pro'?'flex-1 flex flex-col':''}\"><h3 class=\"serif text-[26px] leading-none font-medium\">Aero Fit ${p.n}</h3><p class=\"mt-2 text-[14px] leading-[1.5] text-[#4A2A33]\">${p.line}</p><div class=\"${p.id==='pro'?'mt-auto':''}\">${buy(p)}</div></div></article>`).join('');\n // quiz\n const Q=[['use','What will you use it for most?',[['sleep','Sleep'],['training','Training'],['music','Music on runs'],['endurance','Long days outdoors']]],['night','How do you feel about wearing it overnight?',[['light','I want the lightest band'],['any','Weight doesn\\'t matter']]],['pay','How would you like to pay?',[['out','Buy the band outright'],['mem','Include it in a membership']]]];\n $('quiz').innerHTML=Q.map(([k,t,o],i)=>`<div class=\"rounded-[20px] bg-white p-5\"><p class=\"text-[13px] text-[#6B4F57]\">Question ${i+1} of 3</p><p class=\"mt-1 text-[17px] font-medium\">${t}</p><div class=\"mt-3 flex flex-wrap gap-2\">${o.map(([v,l])=>`<button data-act=\"q\" data-k=\"${k}\" data-v=\"${v}\" class=\"h-10 px-4 rounded-full text-[14px] border transition ${q[k]===v?'bg-[#2A0B14] border-[#2A0B14] text-white':'border-[#E3DDDA] hover:bg-[#FAF8F6]'}\">${l}</button>`).join('')}</div></div>`).join('');\n const PAIRS={sleep:{light:['lite','smart'],any:['smart','pro']},training:{light:['pro','smart'],any:['pro','ultra']},music:{light:['music','smart'],any:['music','pro']},endurance:{light:['pro','smart'],any:['ultra','pro']}};\n const WHY={lite:'18 g, the lightest band',smart:'24 g with skin temperature',pro:'built-in GPS and ECG',ultra:'14-day battery, dual-band GPS',music:'4 GB of onboard music'};\n const pair=PAIRS[q.use][q.night].map(byId);\n const payNote=q.pay==='out'?`$${pair[0].price} and $${pair[1].price} outright`:`${pair.map(p=>`${p.n} from $0 on ${PL[Math.max(p.min,1)][0]}`).join(', ')}`;\n $('quizResult').innerHTML=`<div><p class=\"text-[13px] text-white/70\">Start by comparing</p><p class=\"serif text-[30px] font-medium leading-tight\">${pair[0].n} and ${pair[1].n}</p><p class=\"mt-2 text-[14px] text-white/80\">${pair[0].n}: ${WHY[pair[0].id]}. ${pair[1].n}: ${WHY[pair[1].id]}. ${payNote}.</p></div><button data-act=\"use\" data-use=\"${q.use}\" class=\"shrink-0 h-11 px-5 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[14px] font-medium hover:bg-[#F2EB6A] transition\">Compare ${pair[0].n} and ${pair[1].n}</button>`;\n // table\n const U=USE[use];\n $('tableNote').innerHTML=`The rows that decide most purchases come first. Rows for <span class=\"bg-[#F8F38A] px-1.5 rounded\">${U.n}</span> are highlighted.`;\n $('tHead').innerHTML='<div class=\"p-5 flex items-end text-[13px] text-[#6B4F57]\">'+(mode==='out'?'Buy outright':'With '+PL[plan][0]+' membership')+'</div>'+ORDER.map(i=>{const p=byId(i);const hp=mode==='out'?'$'+p.price:(plan>=p.min?'$0 band':'Needs '+PL[p.min][0]);const fit=U.fit.includes(i);return `<div class=\"p-4 flex flex-col items-center text-center\"><img src=\"${IMG[i]}\" alt=\"Aero Fit ${p.n}\" class=\"w-14 h-14 object-contain mix-blend-multiply ${p.b?'brightness-110':''}\" decoding=\"async\" loading=\"lazy\"><p class=\"mt-2 serif text-[18px] font-medium\">${p.n}</p><p class=\"text-[13px] text-[#6B4F57]\">${hp}</p>${fit?`<p class=\"mt-1.5 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-2 py-0.5\">Good for ${U.n}</p>`:''}</div>`}).join('');\n const cell=v=>v===1?'<span class=\"text-[18px] flex justify-center\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[16px] flex justify-center text-[#C9C0C2]\"><i class=\"ti ti-minus\"></i></span>':v;\n $('tBody').innerHTML=ROWS.filter(r=>r[3]||more).map(([k,l,v],ri)=>{const hi=U.rows.includes(k);return `<div class=\"grid grid-cols-[260px_repeat(5,1fr)] text-[14px] ${ri?'border-t border-[#F3EFEC]':''} ${hi?'bg-[#FBF7C8]':''}\"><p class=\"px-5 py-4 ${hi?'font-medium':'text-[#4A2A33]'}\">${l}</p>${v.map(x=>`<div class=\"py-4 px-2 text-center\">${cell(x)}</div>`).join('')}</div>`}).join('');\n $('moreBtn').textContent=more?'Show fewer specs':'Show all 16 specs';\n}\ndocument.addEventListener('click',e=>{const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=byId(t.dataset.id);\n if(a==='use')use=t.dataset.use;else if(a==='mode')mode=t.dataset.mode;else if(a==='plan'){plan=+t.dataset.plan;mode='mem'}\n else if(a==='color')p.ci=+t.dataset.i;else if(a==='size')p.s=t.dataset.s;else if(a==='more')more=!more;\n else if(a==='q')q[t.dataset.k]=t.dataset.v;\n else if(a==='add'){cart++;$('cartCount').textContent=cart;$('cartCount').className='min-w-9 h-9 px-2 rounded-full bg-[#F8F38A] text-[13px] font-medium flex items-center justify-center';}\n render();});\nrender();\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n(function(){\n const G='https://kombai-assets-dev.b-cdn.net/generated_assets/22958db3-c0cf-4d55-af69-a56c3814f90e/';\n const H=[\n  {n:'Lite',line:'Featherweight sleep and recovery tracking',price:'$149',img:G+'3543f8cd7d9d41538a82a53b258a38b1.jpg',alt:'Aero Fit Lite on morning linen sheets'},\n  {n:'Smart',line:'Always-on display, skin temperature',price:'$199',img:G+'7a47796ecb4f4ff7a78dc7db5db4e0e9.jpg',alt:'Aero Fit Smart draped over a blush stone'},\n  {n:'Pro',line:'Built-in GPS and ECG',price:'$279',img:G+'356b3e3c8d704bf4887b81203fda5357.jpg',alt:'Runner wearing Aero Fit Pro on a track'},\n  {n:'Music',line:'500 songs, Bluetooth headphones',price:'$299',img:G+'95c52762ab0e4ac6ace4b0c585c286e0.jpg',alt:'Aero Fit Music beside wireless headphones'},\n  {n:'Ultra',line:'14 days, dual-band GPS · Ships Nov 4',price:'$399',img:G+'1554a09252854047951ad166e87cafc5.jpg',alt:'Aero Fit Ultra on a mossy summit rock'}];\n const N=H.length,track=document.getElementById('zhTrack'),hero=document.getElementById('zoomHero');\n const SZ={S:170,M:270,L:420},GAP=18;\n track.innerHTML=H.map((p,i)=>`<button class=\"zh-tile absolute left-0 top-0 rounded-[22px] overflow-hidden bg-[#E9DFD6]\" data-i=\"${i}\" aria-label=\"Show Aero Fit ${p.n}\" data-name=\"${p.n} band tile\"><img src=\"${p.img}\" alt=\"${p.alt}\" class=\"absolute inset-0 w-full h-full object-cover object-center pointer-events-none\" decoding=\"async\" loading=\"lazy\"></button>`).join('');\n const tiles=[...track.querySelectorAll('.zh-tile')];\n const mod=(n,m)=>((n%m)+m)%m;\n const off=(i,v)=>mod(i-v+2,N)-2;              // offsets -2..2, 0 = active\n function slots(){const W=hero.clientWidth,tot=SZ.S+SZ.M+SZ.L+SZ.M+3*GAP,x0=(W-tot)/2;\n  return {'-2':{x:x0,w:SZ.S},'-1':{x:x0+SZ.S+GAP,w:SZ.M},'0':{x:x0+SZ.S+SZ.M+2*GAP,w:SZ.L},'1':{x:x0+SZ.S+SZ.M+SZ.L+3*GAP,w:SZ.M}};}\n function pos(o){const sh=hero.clientHeight,W=hero.clientWidth,s=slots();let x,w;\n  if(o>=-2&&o<=1){x=s[o].x;w=s[o].w;}\n  else if(o<-2){w=SZ.S*Math.pow(0.6,-2-o);x=s['-2'].x-(w+GAP)*(-2-o)-40;}   // exits off the left edge\n  else{w=SZ.M;x=W+60+(o-2)*(SZ.M+GAP);}                                         // waits off the right edge\n  return {x,y:sh-w,width:w,height:w};}\n let v=2,busy=false,auto;\n function label(instant){const i=mod(v,N),p=H[i];\n  zhName.textContent='Aero Fit '+p.n;zhLine.textContent=p.line+' · '+p.price;\n  zhLabel.style.left=slots()['0'].x+'px';zhLabel.style.top=(hero.clientHeight-SZ.L-56)+'px';\n  if(window.gsap&&!instant){gsap.fromTo(zhLabel,{opacity:0,y:10},{opacity:1,y:0,duration:.4,delay:.35,ease:'power2.out'})}\n}\n function setAll(){tiles.forEach((t,i)=>{const s=pos(off(i,v));gsap.set(t,{x:s.x,y:s.y,width:s.width,height:s.height,opacity:1});t.style.zIndex=10+off(i,v);});label(true);}\n function step(d,user){if(busy||!d)return;busy=true;const nv=v+d;\n  tiles.forEach((t,i)=>{const o=off(i,v),n=off(i,nv);t.style.zIndex=10+n;\n   const tw={duration:.8,ease:'power3.inOut'};\n   if(o-d===n){const s=pos(n);gsap.to(t,{...tw,x:s.x,y:s.y,width:s.width,height:s.height,opacity:1});}\n   else if(d>0){const out=pos(o-d),s0=pos(n+d),s=pos(n);   // leaves on the left, re-enters from the right\n    gsap.timeline().to(t,{...tw,x:out.x,y:out.y,width:out.width,height:out.height,opacity:0}).set(t,{x:s0.x,y:s0.y,width:s0.width,height:s0.height,opacity:1}).to(t,{duration:.4,ease:'power2.out',x:s.x,y:s.y,width:s.width,height:s.height});}\n   else{const s0=pos(n+d),s=pos(n);gsap.set(t,{x:s0.x,y:s0.y,width:s0.width,height:s0.height,opacity:0});gsap.to(t,{...tw,x:s.x,y:s.y,width:s.width,height:s.height,opacity:1});}\n  });\n  v=nv;label();setTimeout(()=>busy=false,850);if(user)restart();}\n function restart(){clearInterval(auto);auto=setInterval(()=>step(1),1500);}\n setAll();\n tiles.forEach((t,i)=>t.addEventListener('click',()=>step(off(i,v),true)));\n hero.addEventListener('mouseenter',()=>clearInterval(auto));hero.addEventListener('mouseleave',restart);\n restart();\n addEventListener('resize',setAll);\n})();\n</script>\n<script>\n(function(){const f=document.getElementById('sharedFooter');if(!f)return;const sh=[...f.querySelectorAll('.fshape')];\nfunction u(){const vh=innerHeight,r=f.getBoundingClientRect(),p=Math.max(-1,Math.min(1,(vh-r.top)/vh));sh.forEach(s=>s.style.transform='translateY('+(p*(+s.dataset.depth))+'px)');}\naddEventListener('scroll',u,{passive:true});u();})();\n</script>\n",
