-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/1f026a8f11f74e0cbbfa802834c37de1.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#2A0B14]/90 via-[#2A0B14]/20 to-transparent\" data-kid=\"1-10-2-1-2\">\n                    </div>\n                    <span class=\"absolute left-8 top-8 h-8 px-3 rounded-[6px] bg-[#2A0B14] text-white text-[11px] font-semibold tracking-[0.06em] flex items-center\" data-kid=\"1-10-2-1-3\">\n                        HEALTHSPAN\n                    </span>\n                    <div class=\"absolute left-8 right-8 bottom-8\" data-kid=\"1-10-2-1-4\">\n                        <h3 class=\"serif text-[44px] leading-[1.05] font-normal tracking-[-0.02em] max-w-[480px]\" data-kid=\"1-10-2-1-4-1\">\n                            Track Healthspan and Pace of Aging\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.6] text-white/80 max-w-[440px]\" data-kid=\"1-10-2-1-4-2\">\n                            Daily habits that slow your Pace of Aging, tracked across sleep, fitness and stress.\n                        </p>\n                        <div class=\"mt-6 flex items-center gap-3\" data-kid=\"1-10-2-1-4-3\">\n                            <button class=\"h-12 px-6 rounded-full bg-[#FAF8F6] text-[#2A0B14] text-[15px] flex items-center gap-2 hover:bg-[#F8F38A] transition\" data-kid=\"1-10-2-1-4-3-1\">\n                                Get Started\n                                <i class=\"ti ti-arrow-up-right\" data-kid=\"1-10-2-1-4-3-1-1\">\n                                </i>\n                            </button>\n                            <span class=\"h-12 px-4 rounded-full bg-white/12 backdrop-blur-md text-[14px] flex items-center gap-2\" data-kid=\"1-10-2-1-4-3-2\">\n                                <span class=\"text-[20px] font-semibold\" data-kid=\"1-10-2-1-4-3-2-1\">\n                                    +12%\n                                </span>\n                                Healthspan Boosted\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <div class=\"flex flex-col gap-6\" data-kid=\"1-10-2-2\">\n                    <article class=\"flex-1 bg-[#FAF8F6] text-[#2A0B14] rounded-[16px] p-7 flex flex-col\" data-kid=\"1-10-2-2-1\">\n                        <h3 class=\"text-[22px] leading-[1.3]\" data-kid=\"1-10-2-2-1-1\">\n                            Go Deeper with 122+ Biomarkers\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-[1.6] text-[#5A3B44]\" data-kid=\"1-10-2-2-1-2\">\n                            Advanced Labs gives you insights with a clinician-reviewed, personalized Action Plan.\n                        </p>\n                        <button aria-label=\"Open\" class=\"mt-auto self-end w-11 h-11 rounded-full bg-[#2A0B14] text-white flex items-center justify-center text-[16px] hover:bg-[#45172A] transition\" data-kid=\"1-10-2-2-1-3\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-10-2-2-1-3-1\" data-name=\"arrow-up-right icon\">\n                            </i>\n                        </button>\n                    </article>\n                    <article class=\"flex-1 bg-[#FAF8F6] text-[#2A0B14] rounded-[16px] p-7 flex flex-col\" data-kid=\"1-10-2-2-2\">\n                        <h3 class=\"text-[22px] leading-[1.3]\" data-kid=\"1-10-2-2-2-1\">\n                            Biomarker progress\n                        </h3>\n                        <div class=\"mt-4 grid grid-cols-3 gap-2\" data-kid=\"1-10-2-2-2-2\">\n                            <div class=\"rounded-[10px] bg-[#F3EE85]/70 px-3 py-2.5\" data-kid=\"1-10-2-2-2-2-1\">\n                                <p class=\"text-[11px] text-[#5A3B44]\" data-kid=\"1-10-2-2-2-2-1-1\">\n                                    ApoB\n                                </p>\n                                <p class=\"text-[20px] font-semibold\" data-kid=\"1-10-2-2-2-2-1-2\">\n                                    78\n                                </p>\n                            </div>\n                            <div class=\"rounded-[10px] bg-[#BDEBC6]/70 px-3 py-2.5\" data-kid=\"1-10-2-2-2-2-2\">\n                                <p class=\"text-[11px] text-[#5A3B44]\" data-kid=\"1-10-2-2-2-2-2-1\">\n                                    HbA1c\n                                </p>\n                                <p class=\"text-[20px] font-semibold\" data-kid=\"1-10-2-2-2-2-2-2\">\n                                    5.2\n                                </p>\n                            </div>\n                            <div class=\"rounded-[10px] bg-[#F8CDB8]/70 px-3 py-2.5\" data-kid=\"1-10-2-2-2-2-3\">\n                                <p class=\"text-[11px] text-[#5A3B44]\" data-kid=\"1-10-2-2-2-2-3-1\">\n                                    Vitamin D\n                                </p>\n                                <p class=\"text-[20px] font-semibold\" data-kid=\"1-10-2-2-2-2-3-2\">\n                                    42\n                                </p>\n                            </div>\n                        </div>\n                        <button aria-label=\"Open\" class=\"mt-auto self-end w-11 h-11 rounded-full bg-[#2A0B14] text-white flex items-center justify-center text-[16px] hover:bg-[#45172A] transition\" data-kid=\"1-10-2-2-2-3\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-10-2-2-2-3-1\">\n                            </i>\n                        </button>\n                    </article>\n                    <article class=\"flex-1 bg-[#FAF8F6] text-[#2A0B14] rounded-[16px] p-7 flex flex-col\" data-kid=\"1-10-2-2-3\">\n                        <h3 class=\"text-[22px] leading-[1.3]\" data-kid=\"1-10-2-2-3-1\">\n                            Follow a personalized Action Plan\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-[1.6] text-[#5A3B44]\" data-kid=\"1-10-2-2-3-2\">\n                            Track Healthspan and Pace of Aging · Pace of Aging 0.8x, improving.\n                        </p>\n                        <button aria-label=\"Open\" class=\"mt-auto self-end w-11 h-11 rounded-full bg-[#2A0B14] text-white flex items-center justify-center text-[16px] hover:bg-[#45172A] transition\" data-kid=\"1-10-2-2-3-3\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-10-2-2-3-3-1\">\n                            </i>\n                        </button>\n                    </article>\n                </div>\n            </div>\n            <div class=\"mt-16 pt-6 border-t border-white/12 text-[12px] leading-[1.7] text-white/55 max-w-[1000px]\" data-kid=\"1-10-3\">\n                Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. If you have health concerns, consult your doctor or another qualified healthcare professional.\n            </div>\n        </section>\n        <!-- Footer with final CTA -->\n        <footer class=\"-mt-10 pt-24 pb-10 px-16 bg-[#3A1621] text-[#FAF8F6]\" data-kid=\"1-11\" data-name=\"footer with final cta\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-11-1\">\n                <a class=\"flex items-center gap-3\" data-kid=\"1-11-1-1\" href=\"#\">\n                    <img alt=\"Aero Fit logo\" class=\"w-12 h-12\" data-kid=\"1-11-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n                    <span class=\"serif text-[44px] font-medium tracking-tight text-white/85\" data-kid=\"1-11-1-1-2\" data-name=\"footer brand wordmark\">\n                        Aero Fit\n                    </span>\n                </a>\n            </div>\n            <div class=\"mt-14 grid grid-cols-[440px_1fr] gap-16\" data-kid=\"1-11-2\">\n                <div data-kid=\"1-11-2-1\">\n                    <h2 class=\"serif text-[48px] leading-[1.04] font-normal tracking-[-0.025em] text-white/90\" data-kid=\"1-11-2-1-1\" data-name=\"footer CTA headline\">\n                        Try Aero Fit for Free\n                    </h2>\n                    <p class=\"mt-4 text-[15px] leading-[1.6] text-white/65\" data-kid=\"1-11-2-1-2\" data-name=\"footer CTA subheadline\">\n                        Experience 24/7 monitoring across sleep, strain, stress and heart health with personalized daily coaching.\n                    </p>\n                    <div class=\"mt-7 flex gap-2.5\" data-kid=\"1-11-2-1-3\">\n                        <button class=\"h-12 px-6 rounded-full bg-[#F8F38A] text-[#2A0B14] text-[15px] font-medium hover:bg-[#F2EB6A] transition\" data-kid=\"1-11-2-1-3-1\">\n                            Try Aero Fit for free\n                        </button>\n                        <button class=\"h-12 px-6 rounded-full border border-white/30 text-white text-[15px] hover:bg-white/10 transition\" data-kid=\"1-11-2-1-3-2\">\n                            Join Now\n                        </button>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-4 gap-8 text-[14px]\" data-kid=\"1-11-2-2\">\n                    <div data-kid=\"1-11-2-2-1\">\n                        <p class=\"text-white/50 mb-4\" data-kid=\"1-11-2-2-1-1\">\n                            Memberships\n                        </p>\n                        <ul class=\"space-y-2.5 text-white/90\" data-kid=\"1-11-2-2-1-2\">\n                            <li data-kid=\"1-11-2-2-1-2-1\">\n                                Aero Fit One\n                            </li>\n                            <li data-kid=\"1-11-2-2-1-2-2\">\n                                Aero Fit Peak\n                            </li>\n                            <li data-kid=\"1-11-2-2-1-2-3\">\n                                Aero Fit Life\n                            </li>\n                            <li data-kid=\"1-11-2-2-1-2-4\">\n                                Compare plans\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-11-2-2-2\">\n                        <p class=\"text-white/50 mb-4\" data-kid=\"1-11-2-2-2-1\">\n                            Why Aero Fit\n                        </p>\n                        <ul class=\"space-y-2.5 text-white/90\" data-kid=\"1-11-2-2-2-2\">\n                            <li data-kid=\"1-11-2-2-2-2-1\">\n                                How it works\n                            </li>\n                            <li data-kid=\"1-11-2-2-2-2-2\">\n                                Advanced Labs\n                            </li>\n                            <li data-kid=\"1-11-2-2-2-2-3\">\n                                Healthspan\n                            </li>\n                            <li data-kid=\"1-11-2-2-2-2-4\">\n                                Heart Health\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-11-2-2-3\">\n                        <p class=\"text-white/50 mb-4\" data-kid=\"1-11-2-2-3-1\">\n                            Support\n                        </p>\n                        <ul class=\"space-y-2.5 text-white/90\" data-kid=\"1-11-2-2-3-2\">\n                            <li data-kid=\"1-11-2-2-3-2-1\">\n                                Help Center\n                            </li>\n                            <li data-kid=\"1-11-2-2-3-2-2\">\n                                Sizing\n                            </li>\n                            <li data-kid=\"1-11-2-2-3-2-3\">\n                                Accessories\n                            </li>\n                            <li data-kid=\"1-11-2-2-3-2-4\">\n                                Download App\n                            </li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"1-11-2-2-4\">\n                        <p class=\"text-white/50 mb-4\" data-kid=\"1-11-2-2-4-1\">\n                            Connect\n                        </p>\n                        <ul class=\"space-y-2.5 text-white/90\" data-kid=\"1-11-2-2-4-2\">\n                            <li data-kid=\"1-11-2-2-4-2-1\">\n                                Instagram\n                            </li>\n                            <li data-kid=\"1-11-2-2-4-2-2\">\n                                YouTube\n                            </li>\n                            <li data-kid=\"1-11-2-2-4-2-3\">\n                                Podcast\n                            </li>\n                            <li data-kid=\"1-11-2-2-4-2-4\">\n                                Contact\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-16 pt-6 border-t border-white/12 flex items-center justify-between text-[12px] text-white/50\" data-kid=\"1-11-3\">\n                <div class=\"flex gap-5\" data-kid=\"1-11-3-1\">\n                    <span data-kid=\"1-11-3-1-1\" data-name=\"footer terms link\">\n                        Terms & Conditions\n                    </span>\n                    <span data-kid=\"1-11-3-1-2\" data-name=\"footer privacy link\">\n                        Privacy Policy\n                    </span>\n                    <span data-kid=\"1-11-3-1-3\" data-name=\"footer accessibility link\">\n                        Accessibility\n                    </span>\n                </div>\n                <span data-kid=\"1-11-3-2\" data-name=\"footer copyright notice text\">\n                    © 2026 Aero Fit. All rights reserved.\n                </span>\n            </div>\n        </footer>\n    </div>\n    <script>\n        function cal(el,title,startDow,days,prevTail,cfg){\n  const d=['S','M','T','W','T','F','S'];\n  let h=`<div class=\"flex items-center justify-between mb-2\"><span class=\"w-3 h-3 rounded-full border border-[#E3DDDA] flex items-center justify-center text-[7px]\">+</span><span class=\"font-semibold text-[8px]\">${title}</span><span class=\"w-3 h-3\"></span></div><div class=\"grid grid-cols-7 gap-y-0.5 text-center\">`;\n  d.forEach(x=>h+=`<span class=\"text-[#9A8E91] h-4 leading-4\">${x}</span>`);\n  for(let i=0;i<startDow;i++)h+=`<span class=\"h-4 leading-4 text-[#D6CFCC]\">${prevTail-startDow+i+1}</span>`;\n  for(let n=1;n<=days;n++){\n    let c='h-4 leading-4 rounded relative';\n    if(cfg.band.includes(n))c+=' bg-[#FBF7C8] rounded-none';\n    if(cfg.fill.includes(n))c+=' bg-[#F8F38A] !rounded';\n    if(cfg.ring.includes(n))c+=' ring-1 ring-[#EF6A84] text-[#D1435E] !rounded bg-white';\n    const dot=cfg.dot.includes(n)?'<span class=\"absolute left-1/2 -translate-x-1/2 bottom-0 w-[2px] h-[2px] rounded-full bg-[#2A0B14]\"></span>':'';\n    h+=`<span class=\"${c}\">${n}${dot}</span>`;\n  }\n  el.innerHTML=h+'</div>';\n}\ncal(document.getElementById('cal1'),'April 2026',3,30,31,{band:[19,20,21,23,25,26,27,28,29,30],fill:[24],ring:[22],dot:[9,14,18]});\nfunction rows(el,items){\n  el.innerHTML=items.map(([ic,t,s])=>`<div class=\"flex items-center gap-2 bg-[#FAF8F6] rounded-md px-2 py-1.5\"><span class=\"w-5 h-5 rounded-full bg-white flex items-center justify-center text-[10px]\"><i class=\"ti ${ic}\"></i></span><div class=\"flex-1\"><p class=\"text-[8px] font-semibold\">${t}</p><p class=\"text-[6.5px] text-[#9A8E91]\">${s}</p></div><span class=\"text-[8px] text-[#C9C0C2]\"><i class=\"ti ti-chevron-down\"></i></span></div>`).join('');\n}\nrows(document.getElementById('mon1'),[['ti-moon','Sleep Performance','92% · 7h 48m'],['ti-battery-charging','Recovery','78% · Green'],['ti-flame','Day Strain','14.2 · Optimal']]);\nrows(document.getElementById('mon2'),[['ti-heartbeat','Resting Heart Rate','52 bpm'],['ti-wave-sine','HRV','68 ms · Above baseline'],['ti-lungs','Blood Oxygen','98% SpO₂']]);\nconst heat=document.getElementById('heat');const pat='10111011101011101110101110111011100110110111';\nlet hh='';for(let i=0;i<44;i++){const on=pat[i]==='1';hh+=`<span class=\"h-[8px] rounded-[2px] ${on?(i%3?'bg-[#F6EE7A]':'bg-[#F9F3A8]'):'bg-[#F4F1EE]'}\"></span>`}heat.innerHTML=hh;\nconst track=document.getElementById('track');\ndocument.getElementById('next').addEventListener('click',()=>track.scrollBy({left:416,behavior:'smooth'}));\ndocument.getElementById('prev').addEventListener('click',()=>track.scrollBy({left:-416,behavior:'smooth'}));\n    </script>\n</div>\n",
