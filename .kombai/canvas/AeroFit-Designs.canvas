border-2 border-[#F8F38A] object-cover\" data-kid=\"1-3-2-3-3-1\" data-name=\"customer portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/80?img=32\"/ onerror=\"__crawlAsset&&__crawlAsset(this)\">\n                    <div data-kid=\"1-3-2-3-3-2\" data-name=\"testimonial name and title group\">\n                        <cite class=\"text-[13px] font-medium not-italic text-[#2A0B14]\" data-kid=\"1-3-2-3-3-2-1\" data-name=\"testimonial customer name\">\n                            Lena Park\n                        </cite>\n                        <div class=\"mt-0.5 text-[12px] text-[#6B4F57]\" data-kid=\"1-3-2-3-3-2-2\" data-name=\"testimonial customer title\">\n                            Director of Digital Commerce, Morrow & Co.\n                        </div>\n                    </div>\n                </footer>\n            </blockquote>\n        </aside>\n    </section>\n    <div class=\"pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 translate-y-3 rounded-full bg-[#2A0B14] px-5 py-3 text-[13px] font-medium text-white opacity-0 shadow-[0_14px_40px_rgba(42,11,20,0.25)] transition\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"saved plan confirmation toast\" data-reason=\"visibility toggled by classList on continue click and timed removal\" id=\"toast\">\n        Plan saved. Taking you to secure payment.\n    </div>\n    <div aria-labelledby=\"meetingTitle\" aria-modal=\"true\" class=\"fixed inset-0 z-40 hidden items-center justify-center bg-[#2A0B14]/40 p-6 backdrop-blur-xs\" data-dynamic=\"true\" data-kid=\"1-5\" data-name=\"meeting booking modal overlay\" data-reason=\"hidden/flex classes toggled by meeting button and close scripts\" id=\"meetingModal\" role=\"dialog\">\n        <div class=\"w-full max-w-[430px] rounded-[24px] bg-white p-6 shadow-[0_30px_80px_rgba(42,11,20,0.25)]\" data-kid=\"1-5-1\" data-name=\"meeting modal dialog card\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-5-1-1\" data-name=\"meeting modal header row\">\n                <h3 class=\"serif text-[22px] font-medium\" data-kid=\"1-5-1-1-1\" data-name=\"meeting modal title\" id=\"meetingTitle\">\n                    Talk to a Growth Expert\n                </h3>\n                <button aria-label=\"Close meeting dialog\" class=\"grid size-8 place-items-center rounded-full border border-[#EFEAE6] text-[#6B4F57]\" data-kid=\"1-5-1-1-2\" data-name=\"meeting modal close button\" id=\"closeModal\">\n                    <span class=\"text-[15px]\" data-kid=\"1-5-1-1-2-1\" data-name=\"close button icon wrapper\">\n                        <i class=\"ti ti-x\" data-kid=\"1-5-1-1-2-1-1\" data-name=\"x close icon\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n            <p class=\"mt-2 text-[13px] text-[#6B4F57]\" data-kid=\"1-5-1-2\" data-name=\"meeting modal description text\">\n                Choose a 30-minute session to review your store and growth goals.\n            </p>\n            <div class=\"mt-5 grid grid-cols-2 gap-2.5\" data-kid=\"1-5-1-3\" data-name=\"meeting time slot grid\">\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-5-1-3-1\" data-name=\"meeting slot tomorrow 10:30 am\">\n                    <span class=\"block font-medium\" data-kid=\"1-5-1-3-1-1\" data-name=\"meeting slot day label\">\n                        Tomorrow\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-5-1-3-1-2\" data-name=\"meeting slot time label\">\n                        10:30 AM\n                    </span>\n                </button>\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-5-1-3-2\" data-name=\"meeting slot tomorrow 2pm\">\n                    <span class=\"block font-medium\" data-kid=\"1-5-1-3-2-1\" data-name=\"meeting slot day label\">\n                        Tomorrow\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-5-1-3-2-2\" data-name=\"meeting slot time label\">\n                        2:00 PM\n                    </span>\n                </button>\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-5-1-3-3\" data-name=\"meeting slot thursday 11am\">\n                    <span class=\"block font-medium\" data-kid=\"1-5-1-3-3-1\" data-name=\"meeting slot day label\">\n                        Thursday\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-5-1-3-3-2\" data-name=\"meeting slot time label\">\n                        11:00 AM\n                    </span>\n                </button>\n                <button class=\"rounded-[14px] bg-[#FAF8F6] p-3 text-left text-[13px] hover:bg-[#F8F38A]\" data-kid=\"1-5-1-3-4\" data-name=\"meeting slot friday 3:30pm\">\n                    <span class=\"block font-medium\" data-kid=\"1-5-1-3-4-1\" data-name=\"meeting slot day label\">\n                        Friday\n                    </span>\n                    <span class=\"mt-0.5 block text-[12px] text-[#6B4F57]\" data-kid=\"1-5-1-3-4-2\" data-name=\"meeting slot time label\">\n                        3:30 PM\n                    </span>\n                </button>\n            </div>\n        </div>\n    </div>\n</main>\n<script>\n    const prices={shopify:{analytics:1000,optimization:2000},woocommerce:{analytics:1000,optimization:2000},both:{analytics:1800,optimization:3600}};\nconst names={shopify:'Shopify',woocommerce:'WooCommerce',both:'Shopify + WooCommerce'};\nlet platform='shopify',plan='analytics',annual=true;\nconst money=v=>'$'+Math.round(v).toLocaleString('en-US');\nconst tabOn='platform-tab flex h-11 items-center justify-center gap-2 rounded-full bg-[#F8F38A] text-[13px] font-medium text-[#2A0B14] shadow-[0_2px_8px_rgba(42,11,20,0.08)]';\nconst tabOff='platform-tab flex h-11 items-center justify-center gap-2 rounded-full text-[13px] font-medium text-[#6B4F57] transition hover:bg-white/70';\nconst cardOn='plan-card relative min-h-[262px] rounded-[20px] border-[1.5px] border-[#2A0B14] bg-[radial-gradient(ellipse_at_100%_0%,#FBF4B8_0%,#FFFDF2_40%,#FFFFFF_75%)] p-5 text-left shadow-[0_14px_34px_rgba(42,11,20,0.10)]';\nconst cardOff='plan-card relative min-h-[262px] rounded-[20px] border-[1.5px] border-[#EFEAE6] bg-white p-5 text-left transition hover:border-[#D9D0CB]';\nfunction render(){\n  document.querySelectorAll('.platform-tab').forEach(t=>{const a=t.dataset.platform===platform;t.setAttribute('aria-selected',String(a));t.className=a?tabOn:tabOff;});\n  document.querySelectorAll('.plan-card').forEach(c=>{const a=c.dataset.plan===plan;c.setAttribute('aria-pressed',String(a));c.className=a?cardOn:cardOff;\n    const d=c.querySelector('.choice-dot');d.className=a?'choice-dot absolute right-5 top-5 grid size-5 place-items-center rounded-full bg-[#2A0B14]':'choice-dot absolute right-5 top-5 size-5 rounded-full border-[1.5px] border-[#D9D0CB] bg-white';d.innerHTML=a?'<span class=\"size-2 rounded-full bg-[#F8F38A]\"></span>':'';\n    const ic=c.querySelector('.plan-icon');ic.className=a?'plan-icon grid size-9 shrink-0 place-items-center rounded-full bg-[#F8F38A] text-[18px] text-[#2A0B14]':'plan-icon grid size-9 shrink-0 place-items-center rounded-full bg-[#F3EFEC] text-[18px] text-[#4A2A33]';\n    const base=prices[platform][c.dataset.plan];c.querySelector('.price').textContent=money(annual?base*.8:base);\n    const n=c.querySelector('.billing-note');n.textContent=annual?'Billed annually · save '+money(base*12*.2):'Billed monthly · cancel anytime';n.className=annual?'billing-note mt-1.5 text-[11px] font-medium text-[#1E7A52]':'billing-note mt-1.5 text-[11px] font-medium text-[#6B4F57]';});\n  document.getElementById('platformContext').textContent=names[platform]+' selected';\n  document.getElementById('selectionSummary').textContent=names[platform]+' · '+(plan==='analytics'?'Analytics':'Optimization');\n  const b=prices[platform][plan];document.getElementById('selectionPrice').textContent=money(annual?b*.8:b)+'/month, '+(annual?'billed annually':'billed monthly');\n  document.getElementById('billingToggle').setAttribute('aria-checked',String(annual));\n  document.getElementById('billingToggle').className=annual?'relative h-6 w-11 rounded-full bg-[#2A0B14]':'relative h-6 w-11 rounded-full bg-[#D9D0CB]';\n  document.getElementById('billingKnob').className=annual?'absolute right-1 top-1 size-4 rounded-full bg-[#F8F38A]':'absolute left-1 top-1 size-4 rounded-full bg-white';\n}\ndocument.querySelectorAll('.platform-tab').forEach(t=>t.addEventListener('click',()=>{platform=t.dataset.platform;render();}));\ndocument.querySelectorAll('.plan-card').forEach(c=>c.addEventListener('click',()=>{plan=c.dataset.plan;render();}));\ndocument.getElementById('billingToggle').addEventListener('click',()=>{annual=!annual;render();});\nconst toast=document.getElementById('toast');document.getElementById('continueButton').addEventListener('click',()=>{toast.classList.remove('opacity-0','translate-y-3');setTimeout(()=>toast.classList.add('opacity-0','translate-y-3'),2200);});\nconst modal=document.getElementById('meetingModal');document.getElementById('meetingButton').addEventListener('click',()=>{modal.classList.remove('hidden');modal.classList.add('flex');});\ndocument.getElementById('closeModal').addEventListener('click',()=>{modal.classList.add('hidden');modal.classList.remove('flex');});\nmodal.addEventListener('click',e=>{if(e.target===modal){modal.classList.add('hidden');modal.classList.remove('flex');}});\nrender();\n</script>\n",
