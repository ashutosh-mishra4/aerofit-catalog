pi/local/images/.kombai/canvas/assets/aerofit-mark.svg\"/>\n            <span class=\"serif text-[32px] font-medium tracking-tight\" data-kid=\"1-6-1-2\" data-name=\"footer brand wordmark\">\n                Aero Fit\n            </span>\n        </a>\n        <div class=\"mt-12 grid grid-cols-[400px_1fr] gap-16\" data-kid=\"1-6-2\" data-name=\"footer content grid\">\n            <div class=\"bg-white rounded-[22px] p-6 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"1-6-2-1\" data-name=\"newsletter signup card\">\n                <p class=\"text-[17px] font-medium\" data-kid=\"1-6-2-1-1\" data-name=\"newsletter heading\">\n                    Get health tips in your inbox\n                </p>\n                <p class=\"mt-1.5 text-[13px] leading-[1.55] text-[#6B4F57]\" data-kid=\"1-6-2-1-2\" data-name=\"newsletter description\">\n                    Sleep, recovery and training insights from the Aero Fit performance team, every week.\n                </p>\n                <form class=\"mt-5 h-[52px] rounded-full bg-[#FAF8F6] border border-[#EFEAE6] pl-5 pr-1.5 flex items-center gap-2\" data-kid=\"1-6-2-1-3\" data-name=\"newsletter email form\">\n                    <input aria-label=\"Email address\" class=\"flex-1 bg-transparent outline-hidden text-[14px] placeholder:text-[#9A8E91]\" data-kid=\"1-6-2-1-3-1\" data-name=\"email address input field\" placeholder=\"Email address\" type=\"email\"/>\n                    <button class=\"h-10 px-5 rounded-full bg-[#2A0B14] text-white text-[13px] font-medium hover:bg-[#45172A] transition\" data-kid=\"1-6-2-1-3-2\" data-name=\"subscribe button\" type=\"button\">\n                        Subscribe\n                    </button>\n                </form>\n            </div>\n            <div class=\"grid grid-cols-4 gap-8 text-[14px] pt-2\" data-kid=\"1-6-2-2\" data-name=\"footer link columns\">\n                <div data-kid=\"1-6-2-2-1\" data-name=\"shop links column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-1-1\" data-name=\"column heading Shop\">\n                        Shop\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-1-2\" data-name=\"shop links list\">\n                        <li data-kid=\"1-6-2-2-1-2-1\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-1-2-1-1\" data-name=\"shop link Aero Fit Lite\" href=\"#\">\n                                Aero Fit Lite\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-2\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-1-2-2-1\" data-name=\"shop link Aero Fit Smart\" href=\"#\">\n                                Aero Fit Smart\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-3\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-1-2-3-1\" data-name=\"shop link Aero Fit Music\" href=\"#\">\n                                Aero Fit Music\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-4\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-1-2-4-1\" data-name=\"shop link Aero Fit Pro\" href=\"#\">\n                                Aero Fit Pro\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-5\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-1-2-5-1\" data-name=\"shop link Aero Fit Ultra\" href=\"#\">\n                                Aero Fit Ultra\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-2\" data-name=\"memberships links column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-2-1\" data-name=\"column heading Memberships\">\n                        Memberships\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-2-2\" data-name=\"memberships links list\">\n                        <li data-kid=\"1-6-2-2-2-2-1\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-2-2-1-1\" data-name=\"membership link Aero Fit One\" href=\"#\">\n                                Aero Fit One\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-2\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-2-2-2-1\" data-name=\"membership link Aero Fit Peak\" href=\"#\">\n                                Aero Fit Peak\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-3\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-2-2-3-1\" data-name=\"membership link Aero Fit Life\" href=\"#\">\n                                Aero Fit Life\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-4\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-2-2-4-1\" data-name=\"membership link Compare plans\" href=\"#\">\n                                Compare plans\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-3\" data-name=\"support links column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-3-1\" data-name=\"column heading Support\">\n                        Support\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-3-2\" data-name=\"support links list\">\n                        <li data-kid=\"1-6-2-2-3-2-1\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-3-2-1-1\" data-name=\"support link Help Center\" href=\"#\">\n                                Help Center\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-2\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-3-2-2-1\" data-name=\"support link Sizing guide\" href=\"#\">\n                                Sizing guide\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-3\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-3-2-3-1\" data-name=\"support link Accessories\" href=\"#\">\n                                Accessories\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-3-2-4\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-3-2-4-1\" data-name=\"support link Download App\" href=\"#\">\n                                Download App\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-4\" data-name=\"connect links column\">\n                    <p class=\"text-[#7A5B64] font-medium mb-4\" data-kid=\"1-6-2-2-4-1\" data-name=\"column heading Connect\">\n                        Connect\n                    </p>\n                    <ul class=\"space-y-3\" data-kid=\"1-6-2-2-4-2\" data-name=\"connect links list\">\n                        <li data-kid=\"1-6-2-2-4-2-1\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-4-2-1-1\" data-name=\"connect link Instagram\" href=\"#\">\n                                Instagram\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-2\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-4-2-2-1\" data-name=\"connect link YouTube\" href=\"#\">\n                                YouTube\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-3\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-4-2-3-1\" data-name=\"connect link Podcast\" href=\"#\">\n                                Podcast\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-4-2-4\" data-name=\"list item\">\n                            <a class=\"hover:opacity-70\" data-kid=\"1-6-2-2-4-2-4-1\" data-name=\"connect link Contact\" href=\"#\">\n                                Contact\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-12 h-14 rounded-full bg-white px-6 flex items-center justify-between text-[12px] text-[#6B4F57]\" data-kid=\"1-6-3\" data-name=\"footer legal bar\">\n            <div class=\"flex gap-5\" data-kid=\"1-6-3-1\" data-name=\"legal links row\">\n                <a class=\"hover:text-[#2A0B14]\" data-kid=\"1-6-3-1-1\" data-name=\"legal link Terms\" href=\"#\">\n                    Terms & Conditions\n                </a>\n                <a class=\"hover:text-[#2A0B14]\" data-kid=\"1-6-3-1-2\" data-name=\"legal link Privacy\" href=\"#\">\n                    Privacy Policy\n                </a>\n                <a class=\"hover:text-[#2A0B14]\" data-kid=\"1-6-3-1-3\" data-name=\"legal link Accessibility\" href=\"#\">\n                    Accessibility\n                </a>\n            </div>\n            <span data-kid=\"1-6-3-2\" data-name=\"copyright notice text\">\n                © 2026 Aero Fit. All rights reserved.\n            </span>\n        </div>\n        <p class=\"mt-6 px-2 text-[11px] leading-[1.7] text-[#7A5B64] max-w-[900px]\" data-kid=\"1-6-4\" data-name=\"footer medical disclaimer text\">\n            Aero Fit features are intended for general wellness and fitness purposes. They are not intended to diagnose, treat, cure, or prevent any disease. Membership plans are billed annually with a 12-month minimum term.\n        </p>\n    </footer>\n</div>\n<script>\n    const IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'lite',n:'Lite',kind:'Screenless band',line:'No screen, no distractions. Tracks sleep, strain and recovery around the clock.',price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',b:1},\n{id:'smart',n:'Smart',kind:'Display band',line:'Everyday sleep, strain and recovery on a slim always-on display.',price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',b:1},\n{id:'music',n:'Music',kind:'Square music watch',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',price:279,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',b:1},\n{id:'pro',n:'Pro',kind:'Round sport watch',line:'Built-in GPS and ECG on a bright round screen. Train without your phone.',price:299,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',b:1},\n{id:'ultra',n:'Ultra',kind:'Adventure watch',line:'Titanium case, sapphire glass, dual-band GPS and 14 days of battery.',price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',b:1,isNew:1}];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={\n sleep:{n:'Sleep',ic:'ti-moon-stars',why:'Every model tracks sleep stages. Lite and Smart are the lightest to wear overnight, and Smart adds skin temperature for illness and cycle trends.',pair:['lite','smart'],rows:['sleep','temp','weight','battery']},\n training:{n:'Training',ic:'ti-barbell',why:'Pro and Ultra record runs and rides with built-in GPS, take ECG readings and offer the most workout types.',pair:['pro','ultra'],rows:['gps','modes','ecg','recovery']},\n music:{n:'Music',ic:'ti-music',why:'Only Music stores songs and plays them to Bluetooth headphones. Pro is the closest pick if you train with your phone anyway.',pair:['music','pro'],rows:['storage','bt','gps']},\n endurance:{n:'Endurance',ic:'ti-route',why:'Ultra lasts 14 days with dual-band GPS and 100 m water resistance. Pro is the lighter option at 10 days.',pair:['ultra','pro'],rows:['battery','gps','water','case']}};\nconst ROWS=[\n ['Battery & build',[['battery','Battery life',['5 days','7 days','6 days','10 days','14 days']],['display','Display',['None','Slim AMOLED band','1.3″ square AMOLED','1.4″ round AMOLED','1.4″ round AMOLED, sapphire']],['case','Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium']],['weight','Weight with band',['18 g','24 g','28 g','27 g','32 g']],['water','Water resistance',['50 m','50 m','50 m','50 m','100 m']]]],\n ['Health tracking',[['sleep','Sleep stages & Sleep Performance',[1,1,1,1,1]],['recovery','Recovery & Strain scores',[1,1,1,1,1]],['temp','Skin temperature',[0,1,1,1,1]],['ecg','ECG with Heart Screener',[0,0,0,1,1]],['bp','Blood Pressure Insights',[0,0,0,1,1]]]],\n ['Training',[['gps','GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band']],['modes','Workout types',['20','40','80','120','150']]]],\n ['Music',[['storage','Onboard music',[0,0,'4 GB · ~500 songs',0,0]],['bt','Bluetooth headphones',[0,0,1,0,0]]]],\n ['Price',[['outright','Buy outright',['$149','$199','$279','$299','$399']],['incl','Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only']]]]];\nlet mode='out',plan=2,use='sleep',cart=0;const cmp=new Set();\nconst $=id=>document.getElementById(id);\nfunction price(p){\n if(mode==='out')return `<p class=\"text-[24px] font-semibold leading-none\">$${p.price}</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">One-time · membership optional</p>`;\n if(plan>=p.min){const[n,mo,yr]=PL[plan];return `<p class=\"text-[24px] font-semibold leading-none\">$0 <span class=\"text-[14px] font-medium text-[#6B4F57]\">device</span></p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">With ${n} · $${mo}/mo, billed $${yr}/yr</p>`}\n return `<p class=\"text-[17px] font-semibold leading-tight\">Included with ${PL[p.min][0]}${p.min<3?' or Life':''}</p><p class=\"mt-1.5 text-[13px] text-[#6B4F57]\">Not part of ${PL[plan][0]}</p>`;\n}\nfunction headPrice(p){if(mode==='out')return '$'+p.price;return plan>=p.min?'$0 on '+PL[plan][0]:'Needs '+PL[p.min][0];}\nfunction render(){\n // chips\n $('useChips').innerHTML=Object.entries(USE).map(([k,u])=>`<button data-act=\"use\" data-use=\"${k}\" class=\"h-10 px-4 rounded-full text-[14px] font-medium flex items-center gap-1.5 transition ${k===use?'bg-[#2A0B14] text-white':'bg-white hover:bg-[#FFFDF0]'}\"><span class=\"text-[16px] flex\"><i class=\"ti ${u.ic}\"></i></span>${u.n}</button>`).join('');\n const U=USE[use];$('useWhy').textContent=U.why;\n $('usePair').textContent=U.pair.map(i=>P.find(p=>p.id===i).n).join(' and ');\n document.querySelectorAll('.modeBtn').forEach(b=>{const on=b.dataset.mode===mode;b.className='modeBtn h-10 px-5 rounded-full transition '+(on?'bg-[#2A0B14] text-white':'hover:bg-[#F3EFEC]')});\n const pr=$('planRow');pr.classList.toggle('hidden',mode==='out');pr.classList.toggle('flex',mode!=='out');\n pr.innerHTML='<span class=\"text-[#6B4F57] mr-1\">Plan</span>'+[1,2,3].map(t=>`<button data-act=\"plan\" data-plan=\"${t}\" class=\"h-9 px-3.5 rounded-full border transition ${t===plan?'border-[#2A0B14] bg-white font-medium':'border-[#E3DDDA] hover:bg-white'}\">${PL[t][0]} · $${PL[t][1]}/mo</button>`).join('');\n $('example').innerHTML=mode==='out'?'Prices in USD, free shipping and 30-day returns. Adding a membership later is optional.':`Worked example: Aero Fit Pro on Peak costs <span class=\"text-[#2A0B14] font-medium\">$0 for the band and $299 billed today</span>, renewing yearly after a 12-month minimum term.`;\n $('lineup').innerHTML=P.map(p=>{\n  const rec=U.pair.includes(p.id),blocked=mode==='mem'&&plan<p.min;\n  return `<article class=\"rounded-[22px] bg-white p-3 pb-4 flex flex-col border transition ${rec?'border-[#2A0B14] shadow-[0_14px_36px_rgba(42,11,20,0.10)]':'border-[#EFEAE6]'}\">\n   <div class=\"relative h-[210px] rounded-[16px] ${p.isNew?'bg-[radial-gradient(circle_at_50%_60%,#F8F38A_0%,#FBF4B8_45%,#F4F1EE_80%)]':'bg-[#F4F1EE]'} flex items-center justify-center overflow-hidden\">\n    <img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n}, ${p.kind.toLowerCase()} in ${p.c[p.ci][0]}\" class=\"w-[188px] h-[188px] object-contain mix-blend-multiply ${p.b?'brightness-110 contrast-[1.05]':''}\" decoding=\"async\" loading=\"lazy\">\n    ${p.isNew?'<span class=\"absolute left-3 top-3 text-[12px] font-medium bg-white rounded-full px-2.5 py-1\">Ships Nov 4</span>':''}\n    ${rec?`<span class=\"absolute left-3 bottom-3 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-2.5 py-1\">Suggested for ${U.n.toLowerCase()}</span>`:''}\n   </div>\n   <div class=\"px-1.5 mt-4 flex flex-col\">\n    <p class=\"text-[12px] font-medium uppercase tracking-[0.08em] text-[#7A5B64]\">${p.kind}</p>\n    <h3 class=\"mt-1.5 serif text-[24px] leading-none font-medium\">Aero Fit ${p.n}</h3>\n    <p class=\"mt-2 text-[14px] leading-[1.45] text-[#4A2A33] min-h-[61px]\">${p.line}</p>\n    <div class=\"mt-4 min-h-[48px]\">${price(p)}</div>\n    <p class=\"mt-5 text-[13px] text-[#6B4F57]\">Color · <span class=\"text-[#2A0B14] font-medium\">${p.c[p.ci][0]}</span></p>\n    <div class=\"mt-2 flex gap-2\">${p.c.map((c,i)=>`<button data-act=\"color\" data-id=\"${p.id}\" data-i=\"${i}\" aria-label=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${i===p.ci?'border-[#2A0B14]':'border-transparent'}\"><span class=\"block w-full h-full rounded-full\" style=\"background:${c[1]}\"></span></button>`).join('')}</div>\n    <p class=\"mt-4 text-[13px] text-[#6B4F57]\">Size · <span class=\"text-[#2A0B14] font-medium\">${{S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'}[p.s]}</span></p>\n    <div class=\"mt-2 grid grid-cols-3 gap-1.5\">${['S','M','L'].map(s=>`<button data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" class=\"h-9 rounded-full text-[13px] font-medium border transition ${s===p.s?'border-[#2A0B14] bg-[#2A0B14] text-white':'border-[#E3DDDA] hover:bg-[#F3EFEC]'}\">${s}</button>`).join('')}</div>\n    ${blocked?`<button data-act=\"plan\" data-plan=\"${p.min}\" class=\"mt-5 h-11 rounded-full border border-[#2A0B14] text-[14px] font-medium hover:bg-[#F3EFEC] transition\">Switch to ${PL[p.min][0]} for ${p.n}</button>`:`<button data-act=\"add\" data-id=\"${p.id}\" class=\"mt-5 h-11 rounded-full bg-[#2A0B14] text-white text-[14px] font-medium hover:bg-[#45172A] transition\">Add ${p.n} to cart</button>`}\n    <label class=\"mt-3 flex items-center justify-center gap-2 text-[13px] text-[#4A2A33] cursor-pointer\"><input type=\"checkbox\" data-act=\"cmp\" data-id=\"${p.id}\" ${cmp.has(p.id)?'checked':''} class=\"w-4 h-4 accent-[#2A0B14]\">Compare</label>\n   </div></article>`}).join('');\n // table\n const col=i=>cmp.has(P[i].id)?'bg-[#FAF6F2]':'';\n $('tHead').innerHTML='<div class=\"p-5 flex items-end text-[13px] text-[#6B4F57]\">Prices shown '+(mode==='out'?'to buy outright':'with membership')+'</div>'+P.map((p,i)=>`<div class=\"p-4 flex flex-col items-center text-center ${col(i)}\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n}\" class=\"w-14 h-14 object-contain mix-blend-multiply ${p.b?'brightness-110':''}\" decoding=\"async\" loading=\"lazy\"><p class=\"mt-2 serif text-[18px] font-medium\">${p.n}</p><p class=\"text-[13px] text-[#6B4F57]\">${headPrice(p)}</p></div>`).join('');\n $('tableNote').innerHTML=`Rows that matter most for <span class=\"bg-[#F8F38A] px-1.5 rounded\">${U.n.toLowerCase()}</span> are highlighted. Nothing is hidden.`;\n const cell=v=>v===1?'<span class=\"text-[18px] flex justify-center\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[16px] flex justify-center text-[#C9C0C2]\"><i class=\"ti ti-minus\"></i></span>':v;\n $('tBody').innerHTML=ROWS.map(([g,rows])=>`<div class=\"grid grid-cols-[240px_repeat(5,1fr)] pt-7 pb-2\"><p class=\"px-5 serif text-[19px] font-medium\">${g}</p>${P.map((_,i)=>`<div class=\"${col(i)}\"></div>`).join('')}</div>`+rows.map(([k,l,v])=>{const hi=U.rows.includes(k);return `<div class=\"grid grid-cols-[240px_repeat(5,1fr)] text-[14px] border-t border-[#F3EFEC] ${hi?'bg-[#FBF7C8]':''}\"><p class=\"px-5 py-3.5 text-[#4A2A33] ${hi?'font-medium text-[#2A0B14]':''}\">${l}</p>${v.map((x,i)=>`<div class=\"py-3.5 px-2 text-center ${hi?'':col(i)}\">${cell(x)}</div>`).join('')}</div>`}).join('')).join('')+'<div class=\"h-4\"></div>';\n}\ndocument.addEventListener('click',e=>{const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=P.find(x=>x.id===t.dataset.id);\n if(a==='use')use=t.dataset.use;else if(a==='mode')mode=t.dataset.mode;else if(a==='plan'){plan=+t.dataset.plan;mode='mem'}\n else if(a==='color')p.ci=+t.dataset.i;else if(a==='size')p.s=t.dataset.s;\n else if(a==='cmp'){cmp.has(p.id)?cmp.delete(p.id):cmp.add(p.id)}\n else if(a==='add'){cart++;$('cartCount').textContent=cart;$('cartCount').className='min-w-9 h-9 px-2 rounded-full bg-[#F8F38A] text-[13px] font-medium flex items-center justify-center';}\n render();});\nrender();\n</script>\n",
      "comments": [],
      "created": "2026-10-13T14:14:55.332129+00:00",
      "modified": "2026-10-13T15:08:22.220211+00:00",
