ta-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                Convertly\n            </span>\n        </div>\n        <nav aria-label=\"Checkout progress\" class=\"flex items-center gap-3 text-[13px] font-medium\" data-kid=\"1-1-2\" data-name=\"checkout progress steps\">\n            <span class=\"flex h-10 items-center gap-2 rounded-full bg-[#F3EFEC] pl-1.5 pr-4 text-[#4A2A33]\" data-kid=\"1-1-2-1\" data-name=\"completed step: store setup\">\n                <span class=\"grid size-7 place-items-center rounded-full bg-[#D2F6E6] text-[14px] text-[#1E7A52]\" data-kid=\"1-1-2-1-1\" data-name=\"completed step check badge\">\n                    <i class=\"ti ti-check\" data-kid=\"1-1-2-1-1-1\" data-name=\"checkmark icon\">\n                    </i>\n                </span>\n                Store Setup\n            </span>\n            <span class=\"h-px w-10 bg-[#D9D0CB]\" data-kid=\"1-1-2-2\" data-name=\"step connector line\">\n            </span>\n            <span class=\"flex h-10 items-center gap-2 rounded-full bg-[#F8F38A] pl-1.5 pr-4\" data-kid=\"1-1-2-3\" data-name=\"current step: plan\">\n                <span class=\"grid size-7 place-items-center rounded-full bg-[#2A0B14] text-[12px] text-white\" data-kid=\"1-1-2-3-1\" data-name=\"current step number badge\">\n                    2\n                </span>\n                Plan\n            </span>\n            <span class=\"h-px w-10 bg-[#EFEAE6]\" data-kid=\"1-1-2-4\" data-name=\"step connector line\">\n            </span>\n            <span class=\"flex h-10 items-center gap-2 rounded-full pl-1.5 pr-4 text-[#9A8E91]\" data-kid=\"1-1-2-5\" data-name=\"pending step: payment\">\n                <span class=\"grid size-7 place-items-center rounded-full border border-[#EFEAE6] text-[12px]\" data-kid=\"1-1-2-5-1\" data-name=\"pending step number badge\">\n                    3\n                </span>\n                Payment\n            </span>\n        </nav>\n        <button class=\"h-[52px] rounded-full bg-[#2A0B14] px-6 text-[14px] font-medium text-white transition hover:bg-[#45172A]\" data-kid=\"1-1-3\" data-name=\"help modal trigger button\" id=\"meetingHeader\">\n            Need help?\n        </button>\n    </header>\n    <!-- Hero -->\n    <section class=\"relative mx-4 mt-5 overflow-hidden rounded-[28px] bg-[#F3EDE9]\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"pointer-events-none absolute right-[-80px] top-[-140px] h-[460px] w-[620px] rounded-full bg-[radial-gradient(circle,#F8F38A_0%,#FBF4B8_40%,transparent_70%)] opacity-70 blur-[20px]\" data-kid=\"1-2-1\" data-name=\"decorative gradient orb\">\n        </div>\n        <div class=\"relative mx-auto flex w-[1180px] items-end justify-between gap-10 px-8 py-16\" data-kid=\"1-2-2\" data-name=\"hero content container\">\n            <div class=\"max-w-[700px]\" data-kid=\"1-2-2-1\" data-name=\"hero text block\">\n                <h1 class=\"serif mt-4 text-[60px] font-medium leading-[1.04] tracking-[-0.015em]\" data-kid=\"1-2-2-1-2\" data-name=\"hero headline text\">\n                    Choose your growth plan\n                </h1>\n                <p class=\"mt-5 max-w-[540px] text-[16px] leading-[1.55] text-[#4A2A33]\" data-kid=\"1-2-2-1-3\" data-name=\"hero description text\">\n                    Select your store platform, then choose how far you want to optimize. You can switch plans or platforms at any time.\n                </p>\n            </div>\n            <div class=\"shrink-0 rounded-[22px] bg-white/90 p-5 shadow-[0_14px_40px_rgba(42,11,20,0.10)] backdrop-blur-md\" data-kid=\"1-2-2-2\" data-name=\"billing toggle card\">\n                <span class=\"inline-block rounded-full bg-[#F8F38A] px-2.5 py-1 text-[11px] font-medium\" data-kid=\"1-2-2-2-1\" data-name=\"annual discount badge\">\n                    Save 20% annually\n                </span>\n                <label class=\"mt-3 flex items-center gap-3 text-[13px] text-[#6B4F57]\" data-kid=\"1-2-2-2-2\" data-name=\"monthly-annual toggle row\">\n                    <span data-kid=\"1-2-2-2-2-1\" data-name=\"monthly label\">\n                        Monthly\n                    </span>\n                    <button aria-checked=\"true\" aria-label=\"Toggle annual billing\" class=\"relative h-7 w-12 rounded-full bg-[#2A0B14]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2\" data-name=\"billing period toggle switch\" data-reason=\"switch background color and knob position rewritten by JS based on annual state\" id=\"billingToggle\" role=\"switch\" type=\"button\">\n                        <span class=\"absolute right-1 top-1 size-5 rounded-full bg-[#F8F38A]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"billing toggle knob\" data-reason=\"knob position and color rewritten by JS based on annual state\" id=\"billingKnob\">\n                        </span>\n                    </button>\n                    <span class=\"font-medium text-[#2A0B14]\" data-kid=\"1-2-2-2-2-3\" data-name=\"annual label\">\n                        Annual\n                    </span>\n                </label>\n            </div>\n        </div>\n    </section>\n    <!-- Plans -->\n    <section class=\"mx-auto w-[1180px] px-8 pb-14 pt-14\" data-kid=\"1-3\" data-name=\"plans section\">\n        <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-3-1\" data-name=\"platform section header\">\n            <h2 class=\"serif text-[28px] font-medium tracking-[-0.01em]\" data-kid=\"1-3-1-1\" data-name=\"platform selection heading\">\n                1. Select your store platform\n            </h2>\n            <span class=\"rounded-full bg-[#F3EFEC] px-3 py-1 text-[12px] font-medium text-[#4A2A33]\" data-dynamic=\"true\" data-kid=\"1-3-1-2\" data-name=\"selected platform context chip\" data-reason=\"text rewritten by JS to the currently selected platform\" id=\"platformContext\">\n                Shopify selected\n            </span>\n        </div>\n        <div aria-label=\"Store platform\" class=\"grid grid-cols-3 gap-1.5 rounded-full border border-[#EFEAE6] bg-white p-1.5 shadow-[0_4px_18px_rgba(42,11,20,0.05)]\" data-kid=\"1-3-2\" data-name=\"store platform tablist\" role=\"tablist\">\n            <button aria-selected=\"true\" class=\"platform-tab flex h-12 items-center justify-center gap-2 rounded-full bg-[#F8F38A] text-[14px] font-medium text-[#2A0B14]\" data-dynamic=\"true\" data-kid=\"1-3-2-1\" data-name=\"Shopify platform tab\" data-platform=\"shopify\" data-reason=\"tab class and aria-selected rewritten by JS based on selected platform\" role=\"tab\">\n                <span class=\"text-[17px]\" data-kid=\"1-3-2-1-1\" data-name=\"platform icon wrapper\">\n                    <i class=\"ti ti-shopping-bag\" data-kid=\"1-3-2-1-1-1\" data-name=\"shopping bag icon\">\n                    </i>\n                </span>\n                Shopify\n            </button>\n            <button aria-selected=\"false\" class=\"platform-tab flex h-12 items-center justify-center gap-2 rounded-full text-[14px] font-medium text-[#6B4F57] transition hover:bg-[#F3EFEC]\" data-dynamic=\"true\" data-kid=\"1-3-2-2\" data-name=\"WooCommerce platform tab\" data-platform=\"woocommerce\" data-reason=\"tab class and aria-selected rewritten by JS based on selected platform\" role=\"tab\">\n                <span class=\"text-[17px]\" data-kid=\"1-3-2-2-1\" data-name=\"platform icon wrapper\">\n                    <i class=\"ti ti-package\" data-kid=\"1-3-2-2-1-1\" data-name=\"package icon\">\n                    </i>\n                </span>\n                WooCommerce\n            </button>\n            <button aria-selected=\"false\" class=\"platform-tab flex h-12 items-center justify-center gap-2 rounded-full text-[14px] font-medium text-[#6B4F57] transition hover:bg-[#F3EFEC]\" data-dynamic=\"true\" data-kid=\"1-3-2-3\" data-name=\"Both stores platform tab\" data-platform=\"both\" data-reason=\"tab class and aria-selected rewritten by JS based on selected p