ndependent_eyewear_brand/assets/hero/bluepophero.png\" alt=\"Deep Dive colorway product\" loading=\"lazy\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n        </div>\n        <div class=\"strip-info\">\n          <div class=\"strip-info-top\">\n            <span class=\"strip-name\">Deep<br>Dive</span>\n            <span class=\"strip-tag\">Cult</span>\n          </div>\n          <ul class=\"strip-spec\">\n            <li>Polarized · Anti-Glare</li>\n            <li>Italian Bio-Acetate</li>\n            <li>29g · Cobalt Gloss</li>\n          </ul>\n          <div class=\"strip-foot\">\n            <span class=\"strip-price\">$189</span>\n            <span class=\"strip-cta\">Shop →</span>\n          </div>\n        </div>\n      </a>\n\n    </div>\n\n    <div class=\"collections-footer\">\n      <span class=\"collections-footer-label\">All 4 Colorways · In Stock</span>\n      <a href=\"#\" class=\"collections-footer-link\">View The Full Drop →</a>\n    </div>\n\n  </section>\n\n  <!-- ════════════════════════════════════════\n       THE CRAFT — \"SCROLL-HIJACK SPEC SHEET\"\n       ════════════════════════════════════════ -->\n  <section id=\"craft\">\n    <div class=\"craft-frame\">\n\n      <div class=\"craft-overlay-top\">\n        <span class=\"craft-eyebrow\">Why POPH · The Spec</span>\n        <span class=\"craft-overlay-title\">Built To Be Seen.</span>\n      </div>\n\n      <div class=\"craft-progress\" aria-hidden=\"true\">\n        <span class=\"craft-progress-dot active\">01</span>\n        <span class=\"craft-progress-dot\">02</span>\n        <span class=\"craft-progress-dot\">03</span>\n      </div>\n\n      <div class=\"craft-stages\">\n\n        <article class=\"craft-stage stage-01 stage-active\">\n          <span class=\"stage-no\">01<span class=\"of\">/03</span></span>\n          <div class=\"stage-body\">\n            <h3 class=\"stage-name\">Polarized<br>Vision</h3>\n            <p class=\"stage-desc\">A 9-layer TAC polarized film that cuts glare by 92% — engineered to sharpen color in\n              any light condition.</p>\n            <span class=\"stage-tag\">Cuts Glare 92%</span>\n          </div>\n          <div class=\"graphic-wavelength\" aria-hidden=\"true\">\n            <span></span><span></span><span></span><span></span>\n            <span></span><span></span><span></span><span></span>\n          </div>\n        </article>\n\n        <article class=\"craft-stage stage-02\">\n          <span class=\"stage-no\">02<span class=\"of\">/03</span></span>\n          <div class=\"stage-body\">\n            <h3 class=\"stage-name\">UV<br>Shielded</h3>\n            <p class=\"stage-desc\">Full-spectrum protection blocking 100% UVA and UVB rays up to 400 nanometres. Lab\n              tested. Daily tested.</p>\n            <span class=\"stage-tag\">100% UVA + UVB</span>\n          </div>\n          <svg class=\"graphic-gauge\" viewBox=\"0 0 100 100\" aria-hidden=\"true\">\n            <circle class=\"gauge-arc-bg\" cx=\"50\" cy=\"50\" r=\"42\"></circle>\n            <circle class=\"gauge-arc-fg\" cx=\"50\" cy=\"50\" r=\"42\" transform=\"rotate(-90 50 50)\"></circle>\n            <text class=\"gauge-label gauge-label-num\" x=\"50\" y=\"50\" text-anchor=\"middle\">400</text>\n            <text class=\"gauge-label gauge-label-unit\" x=\"50\" y=\"64\" text-anchor=\"middle\">NANOMETRES</text>\n          </svg>\n        </article>\n\n        <article class=\"craft-stage stage-03\">\n          <span class=\"stage-no\">03<span class=\"of\">/03</span></span>\n          <div class=\"stage-body\">\n            <h3 class=\"stage-name\">Feather<br>Light</h3>\n            <p class=\"stage-desc\">Hand-finished bio-acetate frames at just 28 grams — designed to disappear on your\n              face.</p>\n            <span class=\"stage-tag\">28g · Italian Acetate</span>\n          </div>\n          <ul class=\"graphic-list\" aria-hidden=\"true\">\n            <li>POPH Frame <strong>28g</strong></li>\n            <li>vs. A Coin <strong>4g</strong></li>\n            <li>vs. A Plum <strong>62g</strong></li>\n            <li>vs. Your Phone <strong>198g</strong></li>\n          </ul>\n        </article>\n\n      </div>\n\n      <div class=\"craft-ticker\" aria-hidden=\"true\">\n        <div class=\"craft-ticker-track\">\n          <span>POLARIZED</span><span class=\"dot\">✦</span>\n          <span>UV400</span><span class=\"dot\">✦</span>\n          <span>28G FRAMES</span><span class=\"dot\">✦</span>\n          <span>BIO-ACETATE</span><span class=\"dot\">✦</span>\n          <span>HAND FINISHED IN ITALY</span><span class=\"dot\">✦</span>\n          <span>POLARIZED</span><span class=\"dot\">✦</span>\n          <span>UV400</span><span class=\"dot\">✦</span>\n          <span>28G FRAMES</span><span class=\"dot\">✦</span>\n          <span>BIO-ACETATE</span><span class=\"dot\">✦</span>\n          <span>HAND FINISHED IN ITALY</span><span class=\"dot\">✦</span>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- ════════════════════════════════════════\n       CTA — \"TYPE COLLISION\"\n       ════════════════════════════════════════ -->\n  <section id=\"cta\">\n    <span class=\"cta-eyebrow\">SS26 — Available Now</span>\n\n    <span class=\"cta-star\" aria-hidden=\"true\">✦</span>\n\n    <span class=\"cta-word cta-word--1\">Life's</span>\n    <span class=\"cta-word cta-word--2\">Too Short</span>\n    <span class=\"cta-word cta-word--3\">For Boring</span>\n    <span class=\"cta-word cta-word--4\">Frames.</span>\n\n    <a href=\"#\" class=\"cta-sticker\">Grab A Pair <span class=\"arrow\">→</span></a>\n\n    <div class=\"cta-foot\">\n      <span>04 / 04 · End of Drop</span>\n      <span>Free Worldwide Shipping</span>\n    </div>\n  </section>\n\n  <!-- ════════════════════════════════════════\n       FOOTER — \"BACK COVER\"\n       ════════════════════════════════════════ -->\n  <footer id=\"footer\">\n\n    <div class=\"footer-colophon\">\n      <span>Issue 04<span class=\"dot\">·</span>SS26</span>\n      <span><span class=\"dot pink\">✦</span>Made For Loud Humans<span class=\"dot orange\">✦</span></span>\n      <span>POPH.CO</span>\n    </div>\n\n    <div class=\"footer-coupon-wrap\">\n      <div class=\"footer-coupon\">\n        <div>\n          <span class=\"footer-coupon-label\">First access.<br><em>Always.</em></span>\n          <span class=\"footer-coupon-sub\">New drops · restocks · exclusives</span>\n        </div>\n        <form class=\"footer-coupon-form\" onsubmit=\"return false\">\n          <input class=\"footer-coupon-input\" type=\"email\" placeholder=\"your@email.com\">\n          <button class=\"footer-coupon-btn\" type=\"submit\">Join</button>\n        </form>\n      </div>\n    </div>\n\n    <div class=\"footer-nav-row\">\n      <div>\n        <span class=\"footer-col-head\" data-c=\"orange\">Shop</span>\n        <ul class=\"footer-col-list\">\n          <li><a href=\"#\">All Frames</a></li>\n          <li><a href=\"#\">Solar Flare</a></li>\n          <li><a href=\"#\">Cherry Bomb</a></li>\n          <li><a href=\"#\">Acid Lime</a></li>\n          <li><a href=\"#\">Deep Dive</a></li>\n        </ul>\n      </div>\n      <div>\n        <span class=\"footer-col-head\" data-c=\"pink\">Collections</span>\n        <ul class=\"footer-col-list\">\n          <li><a href=\"#\">SS26 Drop</a></li>\n          <li><a href=\"#\">Best Sellers</a></li>\n          <li><a href=\"#\">New Arrivals</a></li>\n        </ul>\n      </div>\n      <div>\n        <span class=\"footer-col-head\" data-c=\"lime\">About</span>\n        <ul class=\"footer-col-list\">\n          <li><a href=\"#\">Our Story</a></li>\n          <li><a href=\"#\">Sustainability</a></li>\n          <li><a href=\"#\">Stockists</a></li>\n        </ul>\n      </div>\n      <div>\n        <span class=\"footer-col-head\" data-c=\"blue\">Help</span>\n        <ul class=\"footer-col-list\">\n          <li><a href=\"#\">Shipping</a></li>\n          <li><a href=\"#\">Returns</a></li>\n          <li><a href=\"#\">FAQ</a></li>\n          <li><a href=\"#\">Contact</a></li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"footer-mark\">\n      <span class=\"footer-mark-word\" id=\"footer-wordmark\">POPH</span>\n      <div class=\"footer-mark-row\">\n        <span class=\"footer-copy\">© 2026 POPH Eyewear · All rights reserved</span>\n        <div class=\"footer-socials\">\n          <a href=\"#\" class=\"footer-social\">Instagram</a>\n          <a href=\"#\" class=\"footer-social\">TikTok</a>\n          <a href=\"#\" class=\"footer-social\">X</a>\n        </div>\n      </div>\n    </div>\n\n  </footer>\n\n  <script>\n    /* ═══════════════════════════════════════════════════════════════════\n       HERO — slide controller (existing, untouched)\n       ═══════════════════════════════════════════════════════════════════ */\n    const slides = gsap.utils.toArray('.hero-slide');\n    const dots = gsap.utils.toArray('.hero-dot');\n    const N = slides.length;\n\n    let current = 0;\n    let animating = false;\n    let heroActive = true;\n    let canFire = true;\n\n    gsap.set(slides.slice(1), { xPercent: 100 });\n    document.body.style.overflow = 'hidden';\n    window.scrollTo(0, 0);\n\n    function textEls(slide) {\n      return slide.querySelectorAll('.slide-eyebrow, .slide-brand, .slide-tagline, .slide-ctas');\n    }\n\n    function updateUI(idx) {\n      dots.forEach((d, i) => d.classList.toggle('active', i === idx));\n      const light = idx === 1 || idx === 3;\n      const col = light ? '#F5F0E8' : '#0D0D0D';\n      document.querySelectorAll('#nav-logo, #nav-links a').forEach(el => el.style.color = col);\n      dots.forEach(d => d.style.color = col);\n    }\n\n    function goTo(newIdx) {\n      if (animating || newIdx === current) return;\n      if (newIdx < 0 || newIdx >= N) return;\n\n      const dir = newIdx > current ? 1 : -1;\n      const from = slides[current];\n      const to = slides[newIdx];\n      const fromImg = from.querySelector('.slide-image img');\n      const toImg = to.querySelector('.slide-image img');\n      const fromText = textEls(from);\n      const toText = textEls(to);\n\n      animating = true;\n\n      const tl = gsap.timeline({\n        defaults: { ease: 'power3.inOut' },\n        onComplete() {\n          current = newIdx;\n          animating = false;\n          gsap.set(fromImg, { clearProps: 'filter,opacity,scale' });\n          gsap.set(fromText, { clearProps: 'all' });\n          gsap.set(toImg, { clearProps: 'filter,opacity,scale' });\n          gsap.set(toText, { clearProps: 'all' });\n        },\n      });\n\n      if (dir > 0) {\n        /* FORWARD: defocus leaving, slide entering in from right, text-up */\n        gsap.set(to, { xPercent: 100 });\n        tl.to(fromImg, {\n          filter: 'blur(14px)', opacity: 0.45, scale: 1.04,\n          duration: 0.3, ease: 'power2.in',\n        })\n          .to(to, { xPercent: 0, duration: 0.65 })\n          .from(toText, {\n            yPercent: 115, skewY: 7, duration: 0.52, stagger: 0.09,\n            ease: 'power3.out', transformOrigin: 'left center',\n          }, '<+0.18');\n      } else {\n        /* REVERSE: true mirror of forward — text falls back down, leaving\n           slides off to the right, entering image focuses in from blurred */\n        gsap.set(toImg, { filter: 'blur(14px)', opacity: 0.45, scale: 1.04 });\n        tl.to(fromText, {\n          yPercent: 115, skewY: 7, duration: 0.52,\n          stagger: { each: 0.09, from: 'end' },\n          ease: 'power3.in', transformOrigin: 'left center',\n        })\n          .to(from, { xPercent: 100, duration: 0.65 }, '<+0.18')\n          .to(toImg, {\n            filter: 'blur(0px)', opacity: 1, scale: 1,\n            duration: 0.4, ease: 'power2.out',\n          }, '>-0.45');\n      }\n\n      updateUI(newIdx);\n    }\n\n    function exitHero() {\n      heroActive = false;\n      document.body.style.overflow = '';\n      window.scrollTo({ top: window.innerHeight, behavior: 'smooth' });\n      if (window.ScrollTrigger) requestAnimationFrame(() => ScrollTrigger.refresh());\n    }\n\n    window.addEventListener('wheel', (e) => {\n      if (!heroActive) return;\n      e.preventDefault();\n      if (!canFire || animating) return;\n      canFire = false;\n      setTimeout(() => { canFire = true; }, 1050);\n      if (e.deltaY > 0) {\n        if (current < N - 1) goTo(current + 1); else exitHero();\n      } else if (e.deltaY < 0 && current > 0) {\n        goTo(current - 1);\n      }\n    }, { passive: false });\n\n    let touchY = 0;\n    window.addEventListener('touchstart', e => { touchY = e.touches[0].clientY; }, { passive: true });\n    window.addEventListener('touchend', e => {\n      if (!heroActive) return;\n      const delta = touchY - e.changedTouches[0].clientY;\n      if (Math.abs(delta) < 40) return;\n      if (delta > 0) {\n        if (current < N - 1) goTo(current + 1); else exitHero();\n      } else if (current > 0) {\n        goTo(current - 1);\n      }\n    }, { passive: true });\n\n    window.addEventListener('keydown', e => {\n      if (!heroActive) return;\n      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {\n        if (current < N - 1) goTo(current + 1); else exitHero();\n      }\n      if ((e.key === 'ArrowUp' || e.key === 'ArrowLeft') && current > 0) goTo(current - 1);\n    });\n\n    dots.forEach((dot, i) => dot.addEventListener('click', () => { if (heroActive) goTo(i); }));\n\n    gsap.from(slides[0].querySelector('.slide-image'), {\n      xPercent: 100, duration: 1.0, ease: 'power3.out', delay: 0.1,\n    });\n    gsap.from(textEls(slides[0]), {\n      yPercent: 115, skewY: 7, duration: 0.6, stagger: 0.1,\n      ease: 'power3.out', transformOrigin: 'left center', delay: 0.55,\n    });\n    gsap.from([slides[0].querySelector('.slide-num'), slides[0].querySelector('.scroll-hint')], {\n      opacity: 0, duration: 0.5, stagger: 0.15, delay: 1.1,\n    });\n\n\n\n    /* ── Glassmorphic nav + hero dots visibility on scroll ──────────── */\n    const mainNav = document.getElementById('main-nav');\n    const heroDotsEl = document.getElementById('hero-dots');\n    window.addEventListener('scroll', () => {\n      const scrolled = window.scrollY > 60;\n      mainNav.classList.toggle('scrolled', scrolled);\n      if (scrolled) {\n        document.querySelectorAll('#nav-logo, #nav-links a').forEach(el => el.style.color = '');\n      }\n\n      const pastHero = window.scrollY > window.innerHeight * 0.6;\n      heroDotsEl.classList.toggle('hidden', pastHero);\n    }, { passive: true });\n\n    /* ═══════════════════════════════════════════════════════════════════\n       SECTION ANIMATIONS\n       ═══════════════════════════════════════════════════════════════════ */\n    gsap.registerPlugin(ScrollTrigger);\n\n    /* COLLECTIONS HEADER */\n    gsap.from('.collections-title', {\n      yPercent: 110, skewY: 6, opacity: 0,\n      duration: 0.85, ease: 'power3.out',\n      transformOrigin: 'left center',\n      scrollTrigger: { trigger: '.collections-header', start: 'top 85%' },\n    });\n    gsap.from('.collections-eyebrow', {\n      opacity: 0, y: 14, duration: 0.55, ease: 'power2.out',\n      scrollTrigger: { trigger: '.collections-header', start: 'top 85%' },\n    });\n    gsap.from('.collections-meta', {\n      opacity: 0, y: 20, duration: 0.6, ease: 'power2.out', delay: 0.15,\n      scrollTrigger: { trigger: '.collections-header', start: 'top 85%' },\n    });\n\n    /* STRIPS — each strip enters from the side it leans toward */\n    gsap.utils.toArray('.strip').forEach((strip, i) => {\n      const fromX = i % 2 === 0 ? -80 : 80;\n      gsap.from(strip, {\n        x: fromX, opacity: 0,\n        duration: 0.8, ease: 'power3.out',\n        scrollTrigger: { trigger: strip, start: 'top 88%' },\n      });\n      gsap.from(strip.querySelector('.strip-num'), {\n        opacity: 0, y: 30, duration: 0.7, ease: 'power3.out', delay: 0.15,\n        scrollTrigger: { trigger: strip, start: 'top 88%' },\n      });\n      gsap.from(strip.querySelector('.strip-bar'), {\n        scaleX: 0, transformOrigin: 'left center',\n        duration: 0.55, ease: 'power3.out', delay: 0.3,\n        scrollTrigger: { trigger: strip, start: 'top 88%' },\n      });\n    });\n\n    gsap.from('.collections-footer', {\n      opacity: 0, y: 18, duration: 0.55, ease: 'power2.out',\n      scrollTrigger: { trigger: '.collections-footer', start: 'top 92%' },\n    });\n\n    /* CRAFT — pinned scroll-hijack across 3 feature stages */\n    const craftStages = gsap.utils.toArray('.craft-stage');\n    const craftDots = gsap.utils.toArray('.craft-progress-dot');\n    const isDesktopCraft = window.matchMedia('(min-width: 769px)').matches;\n\n    if (isDesktopCraft) {\n      gsap.set(craftStages.slice(1), { xPercent: 100 });\n\n      const craftTl = gsap.timeline({ defaults: { ease: 'power2.inOut', duration: 1 } });\n      for (let i = 1; i < craftStages.length; i++) {\n        craftTl\n          .to(craftStages[i - 1], { xPercent: -100 }, '+=0.35')\n          .to(craftStages[i], { xPercent: 0 }, '<');\n      }\n\n      const N = craftStages.length;\n      ScrollTrigger.create({\n        animation: craftTl,\n        trigger: '#craft',\n        start: 'top top',\n        end: () => `+=${N * 100}%`,\n        pin: '.craft-frame',\n        scrub: 0.6,\n        anticipatePin: 1,\n        invalidateOnRefresh: true,\n        onUpdate: (self) => {\n          const idx = Math.min(Math.floor(self.progress * N), N - 1);\n          craftStages.forEach((s, i) => s.classList.toggle('stage-active', i === idx));\n          craftDots.forEach((d, i) => d.classList.toggle('active', i === idx));\n        },\n      });\n    } else {\n      /* Mobile: no pin, just trigger stage-active when each enters view */\n      craftStages.forEach((stage, i) => {\n        ScrollTrigger.create({\n          trigger: stage, start: 'top 70%',\n          onEnter: () => {\n            stage.classList.add('stage-active');\n            craftDots.forEach((d, j) => d.classList.toggle('active', j === i));\n          },\n        });\n      });\n    }\n\n    /* CTA — scattered words arrive from different vectors */\n    gsap.from('.cta-eyebrow', {\n      opacity: 0, y: -12, duration: 0.55, ease: 'power2.out',\n      scrollTrigger: { trigger: '#cta', start: 'top 80%' },\n    });\n\n    const ctaWords = [\n      { el: '.cta-word--1', x: -120, y: -40, r: -14 },\n      { el: '.cta-word--2', x: 140, y: -50, r: 12 },\n      { el: '.cta-word--3', x: -160, y: 20, r: -10 },\n      { el: '.cta-word--4', x: 0, y: 90, r: 8 },\n    ];\n\n    ctaWords.forEach((w, i) => {\n      gsap.from(w.el, {\n        opacity: 0,\n        x: `+=${w.x}`,\n        y: `+=${w.y}`,\n        rotation: `+=${w.r}`,\n        duration: 0.95,\n        ease: 'power3.out',\n        delay: 0.05 + i * 0.12,\n        scrollTrigger: { trigger: '#cta', start: 'top 75%' },\n      });\n    });\n\n    gsap.from('.cta-sticker', {\n      opacity: 0, scale: 0.4, rotation: -40,\n      duration: 0.7, ease: 'back.out(2)', delay: 0.7,\n      scrollTrigger: { trigger: '#cta', start: 'top 70%' },\n    });\n\n    gsap.from('.cta-foot > *', {\n      opacity: 0, y: 12, duration: 0.5, stagger: 0.1, ease: 'power2.out', delay: 0.3,\n      scrollTrigger: { trigger: '#cta', start: 'top 60%' },\n    });\n\n    /* FOOTER */\n    gsap.from('.footer-colophon > *', {\n      opacity: 0, y: 12, duration: 0.5, stagger: 0.08, ease: 'power2.out',\n      scrollTrigger: { trigger: '.footer-colophon', start: 'top 92%' },\n    });\n\n    gsap.from('.footer-coupon', {\n      y: 50, opacity: 0, rotation: -4,\n      duration: 0.85, ease: 'power3.out',\n      scrollTrigger: { trigger: '.footer-coupon', start: 'top 88%' },\n    });\n\n    gsap.from('.footer-nav-row > div', {\n      opacity: 0, y: 30, duration: 0.6, stagger: 0.08, ease: 'power2.out',\n      scrollTrigger: { trigger: '.footer-nav-row', start: 'top 92%' },\n    });\n\n    /* Footer bleed wordmark — horizontal drift on scroll */\n    gsap.to('#footer-wordmark', {\n      xPercent: -3,\n      ease: 'none',\n      scrollTrigger: {\n        trigger: '#footer',\n        start: 'top bottom',\n        end: 'bottom bottom',\n        scrub: 0.4,\n      },\n    });\n\n    gsap.from('.footer-mark-row > *', {\n      opacity: 0, y: 14, duration: 0.55, stagger: 0.1, ease: 'power2.out',\n      scrollTrigger: { trigger: '.footer-mark-row', start: 'top 95%' },\n    });\n  </script>\n\n\n\n",
      "overrides": {
        "htmlAttrs": "lang=\"en\"",
        "head": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>POPH — Eyewear for the Bold</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js\"></script>"
      },
