0B14] transition\" data-kid=\"1-6-4-1-5-2-2\" href=\"#\"><i class=\"ti ti-brand-youtube\" data-kid=\"1-6-4-1-5-2-2-1\"></i></a>\n<a aria-label=\"Podcast\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-6-4-1-5-2-3\" href=\"#\"><i class=\"ti ti-microphone\" data-kid=\"1-6-4-1-5-2-3-1\"></i></a>\n<a aria-label=\"Contact\" class=\"w-9 h-9 rounded-full bg-white/12 flex items-center justify-center text-[18px] hover:bg-[#F8F38A] hover:text-[#2A0B14] transition\" data-kid=\"1-6-4-1-5-2-4\" href=\"#\"><i class=\"ti ti-mail\" data-kid=\"1-6-4-1-5-2-4-1\"></i></a>\n</div>\n</div>\n</div>\n<div class=\"mt-12 pt-6 border-t border-white/15 flex justify-between items-center text-[13px] italic opacity-70\" data-kid=\"1-6-4-2\" data-name=\"fine print row\">\n<span data-kid=\"1-6-4-2-1\">© 2026 Aero Fit · membership plans are billed annually with a 12-month minimum term</span>\n<div class=\"flex gap-6\" data-kid=\"1-6-4-2-2\"><a data-kid=\"1-6-4-2-2-1\" href=\"#\">Terms &amp; Conditions</a><a data-kid=\"1-6-4-2-2-2\" href=\"#\">Privacy Policy</a><a data-kid=\"1-6-4-2-2-3\" href=\"#\">Accessibility</a></div>\n</div>\n</div>\n</footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>gsap.registerPlugin(ScrollTrigger);</script>\n<script>\n/* ───────── DATA (from the Aero Fit catalog) ───────── */\nconst IMG={lite:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/da32fd7c279245b5ab743623f57ddf23.jpg',smart:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/7754f0f6d49a4ed38f644dce2670c620.jpg',pro:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/72180f80b3a64de99cbdef213dc621cd.jpg',music:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/46a42b1d18d34403be756d1c74222484.jpg',ultra:'https://kombai-assets.b-cdn.net/generated_assets/f9b46c42-f591-4385-bfc2-9b6663bcd54f/76d7a24f75bc4dbeafec4d446b539a12.jpg'};\nconst P=[\n{id:'ultra',n:'Ultra',tag:'Ships Nov 4',line:'Titanium case, dual-band GPS and 14 days of battery for multi-day races and long training blocks.',spec:['14-day battery','Dual-band GPS','100 m water'],price:399,min:3,c:[['Titanium','#8B8A87'],['Black','#1F1F1F'],['Trail','#6B7B4E']],ci:0,s:'M',col:'#F8F38A',ink:'#2A0B14',stroke:'#D6CB3A',tile:'radial-gradient(circle at 50% 55%,#F8F38A 0%,#FBF4B8 40%,#F4F1EE 78%)'},\n{id:'pro',n:'Pro',tag:'Training',line:'Built-in GPS and ECG for structured training without your phone.',spec:['Built-in GPS','ECG Heart Screener','10-day battery'],price:279,min:2,c:[['Graphite','#2E2E30'],['Volt','#E3E86A'],['Stone','#BDB5AC']],ci:0,s:'M',col:'#6B7B4E',ink:'#FAF8F6',stroke:'#6B7B4E',tile:'radial-gradient(circle at 50% 55%,#EEF0E4 0%,#E3E7D6 55%,#D9DEC8 100%)'},\n{id:'lite',n:'Lite',tag:'Lightest',line:'Featherweight tracking for sleep, steps and daily recovery.',spec:['18 g with band','Sleep & recovery','5-day battery'],price:149,min:1,c:[['Slate','#5E6E7D'],['Black','#1F1F1F'],['Sand','#D8C8B2']],ci:0,s:'M',col:'#5E6E7D',ink:'#FAF8F6',stroke:'#5E6E7D',tile:'radial-gradient(circle at 50% 55%,#F0F2F4 0%,#E3E7EB 55%,#D6DCE2 100%)'},\n{id:'smart',n:'Smart',tag:'Everyday',line:'Everyday sleep, strain and recovery on an always-on display.',spec:['Always-on AMOLED','Skin temperature','7-day battery'],price:199,min:1,c:[['Black','#1F1F1F'],['Mist','#C8CDD2'],['Plum','#5B2439']],ci:0,s:'M',col:'#2A0B14',ink:'#FAF8F6',stroke:'#2A0B14',tile:'radial-gradient(circle at 50% 55%,#F6EEF0 0%,#EFE3E6 55%,#E6D6DA 100%)'},\n{id:'music',n:'Music',tag:'Offline',line:'Stores 500 songs and plays to Bluetooth headphones on the run.',spec:['4 GB · ~500 songs','Bluetooth audio','6-day battery'],price:299,min:2,c:[['Black','#1F1F1F'],['Ember','#C8553D'],['Ice','#DDE6EE']],ci:0,s:'M',col:'#C8553D',ink:'#FAF8F6',stroke:'#C8553D',tile:'radial-gradient(circle at 50% 55%,#FBEDE7 0%,#F6E0D8 55%,#EFD2C7 100%)'}];\nconst ORDER=['lite','smart','pro','music','ultra'];\nconst PL={1:['One',16,199],2:['Peak',25,299],3:['Life',33,399]};\nconst USE={sleep:{n:'sleep',fit:['lite','smart'],rows:['sleep','temp','weight','battery']},training:{n:'training',fit:['pro','ultra'],rows:['gps','modes','ecg','recovery']},music:{n:'music',fit:['music','pro'],rows:['storage','bt','gps']},endurance:{n:'endurance',fit:['ultra','pro'],rows:['battery','gps','water','case']}};\nconst ROWS=[\n ['battery','Battery life',['5 days','7 days','10 days','6 days','14 days'],1],\n ['gps','GPS',['Via phone','Via phone','Built-in','Built-in','Dual-band'],1],\n ['ecg','ECG with Heart Screener',[0,0,1,0,1],1],\n ['storage','Onboard music',[0,0,0,'4 GB · ~500 songs',0],1],\n ['case','Case material',['Polymer','Aluminum','Aluminum','Aluminum','Titanium'],1],\n ['weight','Weight with band',['18 g','24 g','27 g','28 g','32 g'],1],\n ['outright','Buy outright',['$149','$199','$279','$299','$399'],1],\n ['incl','Included with membership',['One, Peak, Life','One, Peak, Life','Peak, Life','Peak, Life','Life only'],1],\n ['display','Display',['Mono OLED','AMOLED','AMOLED','AMOLED','AMOLED, sapphire'],0],\n ['water','Water resistance',['50 m','50 m','50 m','50 m','100 m'],0],\n ['sleep','Sleep stages & Sleep Performance',[1,1,1,1,1],0],\n ['recovery','Recovery & Strain scores',[1,1,1,1,1],0],\n ['temp','Skin temperature',[0,1,1,1,1],0],\n ['bp','Blood Pressure Insights',[0,0,1,0,1],0],\n ['modes','Workout types',['20','40','120','80','150'],0],\n ['bt','Bluetooth headphones',[0,0,0,1,0],0]];\nconst SIZE={S:'130–160 mm',M:'150–190 mm',L:'180–220 mm'};\nlet mode='out',plan=2,use='endurance',cart=0,more=false,q={use:'training',night:'light',pay:'mem'};\nconst $=id=>document.getElementById(id);const byId=i=>P.find(p=>p.id===i);\n\n/* ───────── RENDER ───────── */\nfunction priceHTML(p){\n if(mode==='out')return `<p class=\"serif text-[52px] leading-[0.9] font-medium tracking-[-0.02em]\">$${p.price}</p><p class=\"mt-1.5 text-[12px] opacity-75\">One-time · free returns</p>`;\n if(plan>=p.min){const[n,mo,yr]=PL[plan];return `<p class=\"serif text-[52px] leading-[0.9] font-medium tracking-[-0.02em]\">$0 <span class=\"sans text-[14px] font-medium opacity-75\">band</span></p><p class=\"mt-1.5 text-[12px] opacity-75\">With ${n} · $${yr}/yr ($${mo}/mo)</p>`}\n return `<p class=\"serif text-[30px] leading-tight font-medium\">Included with ${PL[p.min][0]}</p><p class=\"mt-1.5 text-[12px] opacity-75\">Not part of ${PL[plan][0]}</p>`;\n}\nfunction renderStrips(){\n $('strips').innerHTML=P.map((p,i)=>{\n  const dark=p.ink!=='#2A0B14';const btn=dark?'bg-[#FAF8F6] text-[#2A0B14]':'bg-[#2A0B14] text-white';\n  const blocked=mode==='mem'&&plan<p.min;const fit=USE[use].fit.includes(p.id);\n  return `<article class=\"strip relative grid grid-cols-[64px_1fr_470px] h-[440px] ${i%2?'ml-[5vw]':''}\" data-name=\"${p.n} band strip\">\n   <span class=\"self-center justify-self-center [writing-mode:vertical-rl] rotate-180 text-[10px] font-semibold tracking-[0.4em] uppercase text-[#6B4F57] whitespace-nowrap\">Aero Fit · Band 0${i+1} · 2026</span>\n   <span class=\"strip-num absolute top-1/2 -translate-y-1/2 left-[5%] serif text-[400px] leading-[0.78] font-medium tracking-[-0.06em] outline-text pointer-events-none select-none z-0\" style=\"--sc:${p.stroke};--sw:2px\">0${i+1}</span>\n   <div class=\"relative z-[2] ml-auto w-[92%] max-w-[600px] rounded-l-[28px] overflow-hidden flex items-center justify-center\" style=\"background:${p.tile}\">\n    <img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n} in ${p.c[p.ci][0]}\" class=\"strip-img w-[330px] h-[330px] object-contain mix-blend-multiply brightness-110 contrast-[1.05]\" decoding=\"async\" loading=\"lazy\">\n    ${fit?`<span class=\"absolute left-5 bottom-5 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-3 py-1.5\">Good for ${USE[use].n}</span>`:''}\n    <span class=\"absolute left-5 top-5 text-[12px] font-medium bg-white rounded-full px-3 py-1.5\">${p.c[p.ci][0]}</span>\n   </div>\n   <div class=\"relative z-[3] rounded-r-[28px] p-8 flex flex-col\" style=\"background:${p.col};color:${p.ink}\">\n    <div class=\"flex items-start justify-between gap-4\"><h3 class=\"serif text-[44px] leading-[0.95] font-medium tracking-[-0.02em]\">Aero Fit<br>${p.n}</h3><span class=\"mt-1 text-[11px] font-semibold tracking-[0.2em] uppercase border-[1.5px] border-current rounded-full px-3 py-1 whitespace-nowrap\">${p.tag}</span></div>\n    <p class=\"mt-3 text-[14px] leading-[1.5] opacity-85 max-w-[360px]\">${p.line}</p>\n    <ul class=\"mt-4 flex flex-col gap-1.5\">${p.spec.map(s=>`<li class=\"text-[11px] font-semibold tracking-[0.2em] uppercase\"><span class=\"opacity-60 mr-2\">—</span>${s}</li>`).join('')}</ul>\n    <div class=\"mt-auto flex items-end justify-between gap-4\"><div>${priceHTML(p)}</div>\n     <div class=\"flex gap-1\">${p.c.map((c,j)=>`<button data-act=\"color\" data-id=\"${p.id}\" data-i=\"${j}\" aria-label=\"${c[0]}\" class=\"w-7 h-7 rounded-full p-[3px] border-2 ${j===p.ci?'border-current':'border-transparent'}\"><span class=\"block w-full h-full rounded-full ring-1 ring-black/10\" style=\"background:${c[1]}\"></span></button>`).join('')}</div></div>\n    <div class=\"mt-4 flex items-center gap-2\">\n     <div class=\"h-11 p-1 rounded-full bg-white/90 flex text-[#2A0B14]\">${['S','M','L'].map(s=>`<button data-act=\"size\" data-id=\"${p.id}\" data-s=\"${s}\" title=\"${SIZE[s]}\" class=\"w-9 rounded-full text-[13px] font-medium ${s===p.s?'bg-[#2A0B14] text-white':''}\">${s}</button>`).join('')}</div>\n     ${blocked?`<button data-act=\"plan\" data-plan=\"${p.min}\" class=\"flex-1 h-11 rounded-full border-[1.5px] border-current text-[14px] font-medium\">Switch to ${PL[p.min][0]}</button>`:`<button data-act=\"add\" data-id=\"${p.id}\" class=\"flex-1 h-11 rounded-full ${btn} text-[14px] font-medium flex items-center justify-center gap-2\">Add ${p.n} to cart <i class=\"ti ti-arrow-right\"></i></button>`}\n    </div>\n    <p class=\"mt-2 text-[11px] opacity-70\">Size ${p.s} fits wrists ${SIZE[p.s]}</p>\n   </div></article>`}).join('');\n}\nconst Q={use:[['sleep','Sleep'],['training','Training'],['music','Music on runs'],['endurance','Long days outdoors']],night:[['light','I want the lightest band'],['any',\"Weight doesn't matter\"]],pay:[['out','Buy the band outright'],['mem','Include it in a membership']]};\nconst PAIRS={sleep:{light:['lite','smart'],any:['smart','pro']},training:{light:['pro','smart'],any:['pro','ultra']},music:{light:['music','smart'],any:['music','pro']},endurance:{light:['pro','smart'],any:['ultra','pro']}};\nconst WHY={lite:'18 g, the lightest band',smart:'24 g with skin temperature',pro:'built-in GPS and ECG',ultra:'14-day battery, dual-band GPS',music:'4 GB of onboard music'};\nfunction renderQuiz(){\n document.querySelectorAll('.qopts').forEach(box=>{const k=box.dataset.k;const st=box.closest('.stage');const dark=!st.classList.contains('bg-[#F8F38A]');\n  box.innerHTML=Q[k].map(([v,l])=>{const on=q[k]===v;const cls=dark?(on?'bg-[#FAF8F6] text-[#2A0B14] border-[#FAF8F6]':'border-[#FAF8F6]/50 hover:bg-white/10'):(on?'bg-[#2A0B14] text-white border-[#2A0B14]':'border-[#2A0B14]/40 hover:bg-[#2A0B14]/5');return `<button data-act=\"q\" data-k=\"${k}\" data-v=\"${v}\" class=\"h-12 px-5 rounded-full text-[15px] font-medium border-[1.5px] transition ${cls}\">${l}</button>`}).join('')});\n const pair=PAIRS[q.use][q.night].map(byId);\n const payNote=q.pay==='out'?`$${pair[0].price} and $${pair[1].price} outright`:pair.map(p=>`${p.n} from $0 on ${PL[p.min][0]}`).join(', ');\n $('quizResult').innerHTML=`<div class=\"flex items-start justify-between gap-6\"><div><p class=\"text-[12px] font-semibold tracking-[0.24em] uppercase opacity-60\">Start by comparing</p><p class=\"mt-2 serif text-[44px] leading-[0.95] font-medium tracking-[-0.02em]\">${pair[0].n} <span class=\"italic text-[#C8553D]\">and</span> ${pair[1].n}</p></div><div class=\"flex -space-x-4 shrink-0\">${pair.map(p=>`<span class=\"w-[72px] h-[72px] rounded-full bg-white flex items-center justify-center ring-4 ring-[#F8F38A]\"><img src=\"${IMG[p.id]}\" alt=\"Aero Fit ${p.n}\" class=\"w-14 h-14 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"></span>`).join('')}</div></div>\n <ul class=\"mt-5 flex flex-col gap-2 text-[14px]\">${pair.map(p=>`<li class=\"flex justify-between border-b border-[#2A0B14]/15 pb-2\"><span class=\"font-medium\">${p.n}</span><span>${WHY[p.id]}</span></li>`).join('')}</ul>\n <div class=\"mt-5 flex items-center justify-between gap-4\"><p class=\"text-[13px] text-[#4A2A33]\">${payNote}.</p><button data-act=\"use\" data-use=\"${q.use}\" class=\"shrink-0 h-11 px-5 rounded-full bg-[#2A0B14] text-white text-[14px] font-medium flex items-center gap-2\">Compare ${pair[0].n} and ${pair[1].n} <i class=\"ti ti-arrow-right\"></i></button></div>`;\n}\nfunction renderTable(){\n const U=USE[use];\n $('useChips').innerHTML=Object.keys(USE).map(k=>`<button data-act=\"use\" data-use=\"${k}\" class=\"h-10 px-4 rounded-full text-[14px] font-medium border transition ${k===use?'bg-[#2A0B14] text-white border-[#2A0B14]':'bg-white border-[#EFEAE6] hover:bg-[#F3EFEC]'}\">${k[0].toUpperCase()+k.slice(1)}</button>`).join('');\n $('tableNote').innerHTML=`The rows that decide most purchases come first. Rows for <span class=\"bg-[#F8F38A] px-1.5 rounded\">${U.n}</span> are highlighted — switch the focus on the right.`;\n $('tHead').innerHTML='<div class=\"p-6 flex items-end text-[13px] text-[#6B4F57]\">'+(mode==='out'?'Buy outright':'With '+PL[plan][0]+' membership')+'</div>'+ORDER.map(i=>{const p=byId(i);const hp=mode==='out'?'$'+p.price:(plan>=p.min?'$0 band':'Needs '+PL[p.min][0]);const fit=U.fit.includes(i);return `<div class=\"p-5 flex flex-col items-center text-center\"><span class=\"w-[76px] h-[76px] rounded-full flex items-center justify-center\" style=\"background:${p.tile}\"><img src=\"${IMG[i]}\" alt=\"Aero Fit ${p.n}\" class=\"w-14 h-14 object-contain mix-blend-multiply brightness-110\" decoding=\"async\" loading=\"lazy\"></span><p class=\"mt-3 serif text-[22px] font-medium leading-none\">${p.n}</p><p class=\"mt-1 text-[13px] text-[#6B4F57]\">${hp}</p>${fit?`<p class=\"mt-2 text-[12px] font-medium bg-[#2A0B14] text-white rounded-full px-2.5 py-0.5\">Good for ${U.n}</p>`:''}</div>`}).join('');\n const cell=v=>v===1?'<span class=\"text-[18px] flex justify-center\"><i class=\"ti ti-check\"></i></span>':v===0?'<span class=\"text-[16px] flex justify-center text-[#C9C0C2]\"><i class=\"ti ti-minus\"></i></span>':v;\n $('tBody').innerHTML=ROWS.filter(r=>r[3]||more).map(([k,l,v],ri)=>{const hi=U.rows.includes(k);return `<div class=\"grid grid-cols-[260px_repeat(5,1fr)] text-[14px] ${ri?'border-t border-[#F3EFEC]':''} ${hi?'bg-[#FBF7C8]':''}\"><p class=\"px-6 py-4 ${hi?'font-medium':'text-[#4A2A33]'}\">${l}</p>${ORDER.map((id,j)=>{const x=v[[ 'lite','smart','pro','music','ultra'].indexOf(id)];return `<div class=\"py-4 px-2 text-center\">${cell(x)}</div>`}).join('')}</div>`}).join('');\n $('moreBtn').textContent=more?'Show fewer specs':'Show all 16 specs';\n}\nfunction renderTop(){\n document.querySelectorAll('.modeBtn').forEach(b=>{const on=b.dataset.mode===mode;b.className='modeBtn h-10 px-5 rounded-full transition '+(on?'bg-[#2A0B14] text-white':'hover:bg-[#F3EFEC]')});\n const pr=$('planRow');pr.classList.toggle('hidden',mode==='out');pr.classList.toggle('flex',mode!=='out');\n pr.innerHTML='<span class=\"text-[#6B4F57] mr-1\">Plan</span>'+[1,2,3].map(t=>`<button data-act=\"plan\" data-plan=\"${t}\" class=\"h-9 px-3.5 rounded-full border transition ${t===plan?'border-[#2A0B14] bg-white font-medium':'border-[#E3DDDA] hover:bg-white'}\">${PL[t][0]} · $${PL[t][2]}/yr</button>`).join('');\n $('lineNote').innerHTML=mode==='out'?'Every band runs the same Aero Fit app, coaching and Recovery scores. Buy one outright and add a membership any time.':`On a membership the band is included. Example: <span class=\"font-medium text-[#2A0B14]\">Pro on Peak is $0 for the band, $299 billed today</span>, 12-month minimum.`;\n}\nfunction render(){renderTop();renderStrips();renderQuiz();renderTable();}\n\n/* ───────── QUIZ STAGES ───────── */\nconst stages=gsap.utils.toArray('.stage');const progDots=gsap.utils.toArray('.prog-dot');let stageIdx=0,stageBusy=false;\ngsap.set(stages.slice(1),{xPercent:100});\nfunction goStage(n){\n if(stageBusy||n===stageIdx||n<0||n>=stages.length)return;stageBusy=true;\n const fwd=n>stageIdx;const from=stages[stageIdx],to=stages[n];\n gsap.set(to,{xPercent:fwd?100:-100,zIndex:2});gsap.set(from,{zIndex:1});\n gsap.timeline({defaults:{duration:.9,ease:'power2.inOut'},onComplete(){stageBusy=false}})\n  .to(from,{xPercent:fwd?-100:100}).to(to,{xPercent:0},'<');\n stages.forEach((s,i)=>s.classList.toggle('stage-active',i===n));\n progDots.forEach((d,i)=>d.classList.toggle('active',i===n));\n const ink=n===0?'#2A0B14':'#FAF8F6';$('quizOverlay').style.color=ink;$('quizProg').style.color=ink;\n stageIdx=n;\n}\n\n/* ───────── HERO SLIDES ───────── */\nconst slides=gsap.utils.toArray('.hero-slide');const dots=gsap.utils.toArray('.hero-dot');const N=slides.length;\nlet current=0,animating=false,zTop=N+1;\nslides.forEach((sl,i)=>{gsap.set(sl,{xPercent:0});sl.style.zIndex=i===0?zTop:1;});\nconst textEls=s=>s.querySelectorAll('.slide-eyebrow,.slide-brand,.slide-tagline,.slide-sub,.slide-ctas');\nconst INK=['#2A0B14','#FAF8F6','#FAF8F6','#FAF8F6','#FAF8F6'];\nfunction updateUI(i){dots.forEach((d,j)=>d.classList.toggle('active',i===j));$('heroDots').style.color=INK[i];}\nfunction goTo(n){                       /* always slides the next slide in from the right, on top */\n if(animating||n===current)return;animating=true;\n const from=slides[current],to=slides[n],fromImg=from.querySelector('.slide-image img');\n zTop++;to.style.zIndex=zTop;gsap.set(to,{xPercent:100});\n gsap.timeline({defaults:{ease:'power3.inOut'},onComplete(){from.style.zIndex=1;gsap.set(fromImg,{clearProps:'filter,opacity,scale'});gsap.set(textEls(to),{clearProps:'all'});current=n;animating=false;}})\n  .to(to,{xPercent:0,duration:.7})\n  .from(textEls(to),{yPercent:115,skewY:6,duration:.5,stagger:.06,ease:'power3.out',transformOrigin:'left center'},'<+0.15')\n  .from(to.querySelector('.slide-card'),{y:40,opacity:0,duration:.45,ease:'power3.out'},'<+0.1');\n updateUI(n);\n}\ndots.forEach((d,i)=>d.addEventListener('click',()=>{goTo(i);resetAuto();}));\nlet auto;function resetAuto(){clearInterval(auto);auto=setInterval(()=>goTo((current+1)%N),1500);}\nupdateUI(0);resetAuto();\nconst heroEl=$('hero');\n\n/* ───────── EVENTS ───────── */\ndocument.addEventListener('click',e=>{const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,p=byId(t.dataset.id);\n if(a==='use'){use=t.dataset.use;if(t.closest('#quizResult'))$('compare').scrollIntoView({behavior:'smooth'});}\n else if(a==='mode')mode=t.dataset.mode;else if(a==='plan'){plan=+t.dataset.plan;mode='mem'}\n else if(a==='color')p.ci=+t.dataset.i;else if(a==='size')p.s=t.dataset.s;else if(a==='more')more=!more;\n else if(a==='q'){q[t.dataset.k]=t.dataset.v;const idx=['use','night','pay'].indexOf(t.dataset.k);if(idx<2)setTimeout(()=>goStage(idx+1),380);}\n else if(a==='add'){cart++;$('cartCount').textContent=cart;$('cartCount').className='min-w-9 h-9 px-2 rounded-full bg-[#F8F38A] text-[13px] font-medium flex items-center justify-center';}\n render();});\nprogDots.forEach(d=>d.addEventListener('click',()=>goStage(+d.dataset.stage)));\nrender();\n\n/* ───────── INTRO + SCROLL ANIMATIONS ───────── */\ngsap.from(slides[0].querySelector('.slide-image'),{xPercent:30,opacity:0,duration:1,ease:'power3.out',delay:.1});\ngsap.from(textEls(slides[0]),{yPercent:115,skewY:7,duration:.65,stagger:.1,ease:'power3.out',transformOrigin:'left center',delay:.5});\ngsap.from(slides[0].querySelector('.slide-card'),{y:40,opacity:0,duration:.6,ease:'power3.out',delay:1});\n\ngsap.from('.lineup-title',{yPercent:30,skewY:5,opacity:0,duration:.85,ease:'power3.out',transformOrigin:'left center',scrollTrigger:{trigger:'.lineup-header',start:'top 85%'}});\ngsap.from(['.lineup-eyebrow','.lineup-meta'],{opacity:0,y:18,duration:.6,stagger:.12,ease:'power2.out',scrollTrigger:{trigger:'.lineup-header',start:'top 85%'}});\nScrollTrigger.batch('.strip',{start:'top 90%',once:true,onEnter:els=>els.forEach((el,i)=>{const idx=[...el.parentNode.children].indexOf(el);gsap.from(el,{x:idx%2?80:-80,opacity:0,duration:.8,ease:'power3.out',delay:i*.08});gsap.from(el.querySelector('.strip-num'),{opacity:0,y:30,duration:.7,ease:'power3.out',delay:.15+i*.08});})});\ngsap.from('.compare-title',{yPercent:30,skewY:5,opacity:0,duration:.85,ease:'power3.out',transformOrigin:'left center',scrollTrigger:{trigger:'.compare-header',start:'top 85%'}});\n\nconst ctaWords=[{el:'.cta-w1',x:-120,y:-40,r:-14},{el:'.cta-w2',x:140,y:-50,r:12},{el:'.cta-w3',x:-160,y:20,r:-10},{el:'.cta-w4',x:0,y:90,r:8}];\nctaWords.forEach((w,i)=>gsap.from(w.el,{opacity:0,x:`+=${w.x}`,y:`+=${w.y}`,rotation:`+=${w.r}`,duration:.95,ease:'power3.out',delay:.05+i*.12,scrollTrigger:{trigger:'#cta',start:'top 75%'}}));\ngsap.from('.cta-foot > *',{opacity:0,y:12,duration:.5,stagger:.1,ease:'power2.out',delay:.3,scrollTrigger:{trigger:'#cta',start:'top 60%'}});\n</script>\n<script>\n(function(){const f=document.getElementById('sharedFooter');if(!f)return;const sh=[...f.querySelectorAll('.fshape')];\nfunction u(){const vh=innerHeight,r=f.getBoundingClientRect(),p=Math.max(-1,Math.min(1,(vh-r.top)/vh));sh.forEach(s=>s.style.transform='translateY('+(p*(+s.dataset.depth))+'px)');}\naddEventListener('scroll',u,{passive:true});u();})();\n</script>\n",
